string createRemakeItems(string qcIdTxt)
{
	// Turns QC rejections into work: one new Plan_Item per rejected line, on the
	// SAME plan, for the rejected quantity, with its own Material_Requirement
	// rows so the store issues cloth again and the supervisor runs every stage
	// from Cutting.
	//
	// Called from a workflow on Quality_Check (On Successful Form Submit and On
	// Edit) with the QC record id. A plain Deluge function, NOT a Custom API -
	// no widget calls it.
	//
	// WHY NEW ITEMS AND NOT A RE-RUN OF THE OLD ONES. saveProductionPhase finds a
	// stage log with Stage_Log[Plan_Item == itemId && Phase_Name == phaseName]
	// and UPDATES it - one row per item per phase, with no notion of a second
	// pass. Re-running Cutting on the original item would overwrite the first
	// run's operator, times and quantities: the original production record would
	// be destroyed in order to record the remake. New Plan_Item ids mean new
	// stage logs, new requirements, new waste - nothing is overwritten.
	//
	// WHY THE SAME PLAN AND NOT A SECOND ONE. saveProductionPhase mirrors plan
	// completion onto the sales order, and that is only correct because one order
	// produces exactly one plan. A second plan against the same order would
	// complete the order when the FIRST plan finished.
	//
	// STATUSES MOVE BACKWARDS, deliberately. Plan and order both return to
	// "In Progress" - no new status value anywhere. That is what puts the plan
	// back on the store's issue list and the supervisor's screen, and what makes
	// the order drop off the QC lookup (filtered on Production Complete) until
	// the remake is done. When it finishes, saveProductionPhase mirrors the order
	// forward again and it reappears for the next QC round. The forward-only
	// guard already accepts "In Progress", so none of that needed changing.
	//
	// IDEMPOTENT. A QC record saved twice must not create the work twice. Each
	// QC_Items row gets Remake_Item written back to it, and a row that already
	// has one is skipped.

	res = "Nothing to do";
	madeCount = 0;
	skipCount = 0;
	failCount = 0;
	logLines = list();

	try
	{
	idTxt = ifnull(qcIdTxt,"").toString().trim();
	if(idTxt == "" || idTxt.isNumber() == false)
	{
		return "ERROR: missing or non-numeric Quality_Check id ('" + idTxt + "')";
	}
	qcId = idTxt.toLong();

	// Next free Line_No per plan, filled on first sight. One order produces one
	// plan today, but keying it means a remake spanning two would still number
	// correctly rather than colliding.
	nextLine = Map();
	touchedPlans = Map();
	orderId = null;

	for each  qc in Quality_Check[ID == qcId]
	{
		if(qc.Sales_Order != null)
		{
			orderId = qc.Sales_Order;
		}

		for each  qcRow in qc.QC_Items
		{
			// Creator fields that were never written are EMPTY, not null, and
			// toDecimal() throws on empty - normalise to string first.
			rejStr = ifnull(qcRow.Rejected_Quantity,"0").toString().trim();
			if(rejStr == "")
			{
				rejStr = "0";
			}
			accStr = ifnull(qcRow.Accepted_Quantity,"0").toString().trim();
			if(accStr == "")
			{
				accStr = "0";
			}
			rejQty = rejStr.toDecimal().toLong();
			accQty = accStr.toDecimal().toLong();

			rowItemName = ifnull(qcRow.Item_Name,"").toString();

			//--------------------------------------------------------------
			// PROCESSED IS THE GUARD, and it has to be a flag of its own.
			//
			// Remake_Item cannot do this job: a row with nothing rejected
			// never gets one, and those rows still write accepted counts onto
			// the item. Without an explicit flag, saving the QC record twice
			// added the same accepted and rejected quantities a second time -
			// 90 accepted became 180. That is not a cosmetic double-count: it
			// pushes accepted + rejected past produced, so the next round
			// treats the item as fully inspected and drops it, and the order
			// reads as whole when the customer is still short.
			//
			// Same pattern resolveDispute uses on its resolution lines.
			//--------------------------------------------------------------
			if(ifnull(qcRow.Processed,false) == true)
			{
				skipCount = skipCount + 1;
				logLines.add("SKIP (already processed) -> " + rowItemName);
			}
			//--------------------------------------------------------------
			// The Plan_Item link is hidden on the form, so a failure to
			// populate it is invisible on screen. It is NOT allowed to be
			// invisible here: a rejection that quietly produces no remake
			// leaves the customer short with nothing saying why.
			//
			// Deliberately NOT marked processed - the link can be filled in
			// and the record re-saved, and this row should then run properly
			// rather than being skipped for ever.
			//--------------------------------------------------------------
			else if(qcRow.Plan_Item == null)
			{
				if(rejQty > 0)
				{
					failCount = failCount + 1;
					logLines.add("FAIL (no Plan_Item on the QC line, cannot remake) -> " + rowItemName + " | rejected " + rejQty);
				}
				else
				{
					logLines.add("SKIP (no Plan_Item, nothing rejected) -> " + rowItemName);
				}
			}
			else
			{
				srcItemId = qcRow.Plan_Item;

				//----------------------------------------------------------
				// Record the inspection on the item itself, rejected or not.
				// qcAutoPopulate decides what to list in the NEXT round by
				// asking whether an item has been inspected, and it has to be
				// able to ask that before any new QC record exists.
				//
				// ADDED, not replaced. An item can be inspected across more
				// than one round, and the totals are cumulative.
				//----------------------------------------------------------
				for each  srcItem in Plan_Item[ID == srcItemId]
				{
					haveAcc = ifnull(srcItem.Qty_Accepted,"0").toString().trim();
					if(haveAcc == "")
					{
						haveAcc = "0";
					}
					haveRej = ifnull(srcItem.Qty_Rejected,"0").toString().trim();
					if(haveRej == "")
					{
						haveRej = "0";
					}
					srcItem.Qty_Accepted = haveAcc.toDecimal().toLong() + accQty;
					srcItem.Qty_Rejected = haveRej.toDecimal().toLong() + rejQty;
				}

				if(rejQty <= 0)
				{
					logLines.add("OK (nothing rejected) -> " + rowItemName + " | accepted " + accQty);
					qcRow.Processed = true;
				}
				else if(qcRow.Remake_Item != null)
				{
					// Already handled on an earlier save of this record.
					skipCount = skipCount + 1;
					logLines.add("SKIP (remake already exists) -> " + rowItemName + " | rejected " + rejQty);
					qcRow.Processed = true;
				}
				else
				{
					//--------------------------------------------------
					// Read the item being remade. Everything the new item
					// needs comes off it - including the BOM, which is
					// COPIED rather than re-resolved from the item master.
					// If someone edits the BOM between the first run and
					// the remake, re-resolving would build the replacement
					// to a different spec than the piece it replaces.
					//--------------------------------------------------
					srcPlanId = null;
					srcSku = null;
					srcBom = null;
					srcName = "";
					rootId = null;

					for each  src in Plan_Item[ID == srcItemId]
					{
						srcPlanId = src.Plan;
						srcSku = src.Item_Sku;
						srcBom = src.BOM;
						srcName = ifnull(src.Item_Name,"").toString();

						// Remake_Of always points at the ROOT line, never at
						// the previous remake. A remake of a remake still
						// hangs off the original, so "how many of line 3 have
						// been accepted in total" is one flat query instead of
						// a recursive walk - and Deluge has no recursion.
						rootId = srcItemId;
						if(src.Remake_Of != null)
						{
							rootId = src.Remake_Of;
						}
					}

					if(srcPlanId == null)
					{
						failCount = failCount + 1;
						logLines.add("FAIL (Plan_Item " + srcItemId + " not found) -> " + rowItemName);
					}
					else
					{
						planKey = srcPlanId.toString();

						// Highest Line_No on this plan, once. Ascending sort,
						// so the last one read is the largest.
						lineNow = ifnull(nextLine.get(planKey),"").toString().trim();
						if(lineNow == "")
						{
							maxLine = 0;
							planItemsAsc = Plan_Item[Plan == srcPlanId] sort by Line_No;
							for each  pl in planItemsAsc
							{
								maxLine = ifnull(pl.Line_No,0);
							}
							lineNow = maxLine.toString();
						}
						newLineNo = lineNow.toDecimal().toLong() + 1;
						nextLine.put(planKey,newLineNo.toString());
						touchedPlans.put(planKey,"1");

						//------------------------------------------
						// The remake item.
						//
						// Qty_Ordered is the REJECTED quantity - what
						// still has to be made, not what the customer
						// bought. Every report that sums "ordered"
						// filters Is_Remake out, so the plan does not
						// start claiming a 100-piece order was 110.
						//------------------------------------------
						newItemId = insert into Plan_Item
						[
							Plan=srcPlanId
							Item_Name=srcName
							Qty_Ordered=rejQty
							Qty_Produced=0
							Qty_Accepted=0
							Qty_Rejected=0
							Item_Status="Awaiting_Material"
							Line_No=newLineNo
							Is_Remake=true
							Remake_Reason="QC_Reject"
							Added_User=zoho.loginuser
						];

						// Lookups after the insert - a null one fails the
						// whole insert block.
						for each  ni in Plan_Item[ID == newItemId]
						{
							if(srcSku != null)
							{
								ni.Item_Sku = srcSku;
							}
							if(srcBom != null)
							{
								ni.BOM = srcBom;
							}
							ni.Remake_Of = rootId;
							ni.QC_Ref = qcId;
						}

						//------------------------------------------
						// Its material. Same shared function
						// createProductionPlans uses, so the remake is
						// costed by exactly the same arithmetic as the
						// original - fabric width, cut size, whole rows.
						// A second copy of that maths would drift, and
						// the drift would be silent until the store came
						// up short.
						//------------------------------------------
						matCount = 0;
						if(srcBom != null)
						{
							matsJson = thisapp.buildItemRequirements(srcBom.toString(),rejQty.toString(),"remake of " + srcName + " (QC " + qcId + ")");
							matsList = matsJson.toJSONList();

							// Assigned_To on the requirement is the store's
							// filter, so it comes off the plan rather than
							// being left null and invisible.
							planSup = null;
							for each  plS in Production_Planning[ID == srcPlanId]
							{
								planSup = plS.Assigned_To;
							}

							for each  mRaw in matsList
							{
								mm = mRaw.toMap();

								newReqId = insert into Material_Requirement
								[
									Plan=srcPlanId
									Plan_Item=newItemId
									Material_Name=mm.get("name")
									Is_Fabric=mm.get("isFab")
									Unit=mm.get("unit")
									Required_Qty=mm.get("req")
									Issued_Qty=0
									Received_Qty=0
									Cut_Size_Length=mm.get("cutLen")
									Cut_Size_Width=mm.get("cutWid")
									Required_Pieces=mm.get("pcs")
									Pieces_From_Waste=0
									Pieces_From_Raw=0
									Added_User=zoho.loginuser
								];

								for each  mrq in Material_Requirement[ID == newReqId]
								{
									mrq.Material=mm.get("mat").toString().toLong();
									if(planSup != null)
									{
										mrq.Assigned_To=planSup;
									}
								}
								matCount = matCount + 1;
							}
						}
						else
						{
							// Cannot happen through the front door -
							// createProductionPlans now rejects an order whose
							// item has no BOM - but an item planned before that
							// rule existed could still reach here.
							logLines.add("WARN (no BOM on the item, remake has no material) -> " + srcName);
						}

						// Written back LAST, once the item and its material
						// exist. This is the idempotency guard, so it must not
						// be set until there is genuinely something to skip.
						qcRow.Remake_Item = newItemId;

						madeCount = madeCount + 1;
						// Marked LAST, once the item, its material and the
						// audit link all exist. Set any earlier and a failure
						// part-way through would lock the row out of a retry.
						qcRow.Processed = true;

						logLines.add("REMAKE line " + newLineNo + " -> " + srcName + " | qty " + rejQty + " | materials " + matCount);
					}
				}
			}
		}
	}

	//------------------------------------------------------------------------
	// Re-open the plan and the order, only if something was actually made.
	//
	// LAST, after every item and requirement is written. Moved earlier, a
	// failure part-way through would leave a plan that says it owes material
	// with no requirement rows behind it.
	//------------------------------------------------------------------------
	if(madeCount > 0)
	{
		for each  pk in touchedPlans.keys()
		{
			for each  plR in Production_Planning[ID == pk.toLong()]
			{
				// Only forward from Production Complete. A plan already back at
				// work is left where it is - "In Progress" is production's to
				// own, and Pending or Partially Received would be a step
				// backwards, not forwards.
				pStNow = ifnull(plR.Order_Status,"").toString();
				if(pStNow == "Production Complete")
				{
					plR.Order_Status = "In Progress";
				}
			}
		}

		if(orderId != null)
		{
			for each  soR in Sales_Order[ID == orderId]
			{
				// Same rule. An order that has already moved past QC - packed,
				// dispatched - is not dragged back by a late QC edit.
				sStNow = ifnull(soR.Order_Status,"").toString();
				if(sStNow == "Production Complete")
				{
					soR.Order_Status = "In Progress";
				}
				else
				{
					logLines.add("NOTE (order is '" + sStNow + "', left alone) -> remake items still created");
				}
			}
		}
	}

	//------------------------------------------------------------------------
	// IS ANYTHING STILL WAITING FOR QC?
	//
	// Runs after EVERY QC save, whether or not this round created remakes -
	// because a round that rejected some still inspected everything that was in
	// front of it, and a round that created a remake batch has not produced
	// anything new for that batch yet.
	//
	// RECOMPUTED, never assumed. An item finished while the QC record was open
	// is produced-but-uninspected and must keep the order in the picker; simply
	// clearing the flag on save would drop it and there would be no way back in,
	// because the order would no longer be selectable to correct itself.
	//
	// Same test qcAutoPopulate lists on - produced beyond accepted plus rejected
	// - so the picker and the subform cannot disagree.
	//------------------------------------------------------------------------
	if(orderId != null)
	{
		stillToInspect = false;

		for each  plQ in Production_Planning[Sales_Order == orderId]
		{
			for each  itQ in Plan_Item[Plan == plQ.ID]
			{
				// A Creator numeric never written is EMPTY, not null, and
				// toDecimal() throws on it.
				prodQ2 = ifnull(itQ.Qty_Produced,"0").toString().trim();
				if(prodQ2 == "")
				{
					prodQ2 = "0";
				}
				accQ2 = ifnull(itQ.Qty_Accepted,"0").toString().trim();
				if(accQ2 == "")
				{
					accQ2 = "0";
				}
				rejQ2 = ifnull(itQ.Qty_Rejected,"0").toString().trim();
				if(rejQ2 == "")
				{
					rejQ2 = "0";
				}

				if(accQ2.toDecimal() + rejQ2.toDecimal() < prodQ2.toDecimal())
				{
					stillToInspect = true;
				}
			}
		}

		for each  soQ in Sales_Order[ID == orderId]
		{
			soQ.Ready_For_QC = stillToInspect;
		}
		logLines.add("Ready_For_QC -> " + stillToInspect);
	}

	//------------------------------------------------------------------------
	// AND THE OTHER OUTCOME: the order passing QC for good.
	//
	// This lives here, not in a separate form workflow, because both outcomes
	// write the same field. A workflow that set "QC Passed" on every submit
	// would fight this function on any round that had rejections - the order
	// would read as passed while production restarted on it - and which one won
	// would come down to the order the workflow engine happened to run them in.
	// One writer, one decision.
	//
	// THE TEST IS PER ORIGINAL LINE, not per item and not a plan-wide total.
	// A line is satisfied when everything accepted for it - its own acceptances
	// plus every remake that hangs off it - reaches what the customer ordered.
	// Remake_Of always points at the root, so that is one flat query per line.
	//
	// Only when this round created nothing and failed nothing. A round that
	// produced remakes clearly is not a pass, and a round with a failed line is
	// a round we cannot draw any conclusion from at all.
	//------------------------------------------------------------------------
	if(madeCount == 0 && failCount == 0 && orderId != null)
	{
		orderWhole = true;
		checkedAny = false;

		//------------------------------------------------------------------
		// AN ORDER CLOSED SHORT IS WHOLE.
		//
		// Pieces lost in production that nobody is going to make again leave the
		// line permanently under its ordered quantity, and the test below would
		// refuse to pass it for ever - the order hangs at Production Complete
		// with an empty QC subform and no way forward.
		//
		// Short_Closed is somebody deciding, on the record, that 8 is the final
		// answer. It is on Sales_Order rather than the plan because it is a
		// commercial call about what the customer is getting, not a shop-floor
		// one - and it is deliberately NOT something this function can set
		// itself.
		//------------------------------------------------------------------
		shortClosed = false;
		for each  soSC in Sales_Order[ID == orderId]
		{
			if(ifnull(soSC.Short_Closed,false) == true)
			{
				shortClosed = true;
			}
		}

		//------------------------------------------------------------------
		// NOTHING PASSES WHILE THE ORDER IS STILL BEING MADE.
		//
		// The accepted-versus-ordered test below is about QUANTITY and cannot
		// see this. A batch that has produced nothing has no acceptances to be
		// short of, so it is invisible to a test that only reads counters -
		// and Short_Closed makes even the quantity test unconditionally true.
		//
		// So: short-close an order that still has a production-loss batch at
		// Awaiting_Material and it went straight to QC Passed, while the store
		// held a live Material_Requirement for that batch and it sat on the
		// supervisor's screen as outstanding work.
		//
		// Item_Status == "Complete" is the same test saveProductionPhase uses
		// to decide the plan is done, so this cannot disagree with it.
		//
		// APPLIES EVEN WHEN SHORT-CLOSED, deliberately. Short_Closed means
		// "the customer is getting fewer than they ordered" - it is an answer
		// about QUANTITY. It is not a statement that unfinished work has
		// stopped, and treating it as one is what let a queued batch pass.
		// The batch has to be removed before the order can close.
		//
		// This does NOT interfere with the case Short_Closed was built for:
		// pieces lost with no remake opened leave the original item Complete,
		// so nothing here blocks and the quantity test forgives the shortfall.
		//------------------------------------------------------------------
		stillMaking = false;

		for each  plM in Production_Planning[Sales_Order == orderId]
		{
			for each  itM in Plan_Item[Plan == plM.ID]
			{
				stM = ifnull(itM.Item_Status,"").toString().trim();
				if(stM != "Complete")
				{
					stillMaking = true;
					logLines.add("STILL IN PRODUCTION -> " + ifnull(itM.Item_Name,"").toString() + " | status '" + stM + "'");
				}
			}
		}

		for each  plW in Production_Planning[Sales_Order == orderId]
		{
			// Every item, filtered in code rather than by the query. Is_Remake
			// was added to a form that already had records, and a Creator field
			// that was never written is EMPTY, not false - so a query on
			// Is_Remake == false would silently miss every item planned before
			// the field existed, and those are exactly the original lines.
			for each  rootIt in Plan_Item[Plan == plW.ID]
			{
				if(ifnull(rootIt.Is_Remake,false) == false)
				{
					checkedAny = true;

					ordStr = ifnull(rootIt.Qty_Ordered,"0").toString().trim();
					if(ordStr == "")
					{
						ordStr = "0";
					}
					accStr2 = ifnull(rootIt.Qty_Accepted,"0").toString().trim();
					if(accStr2 == "")
					{
						accStr2 = "0";
					}
					accTotal = accStr2.toDecimal().toLong();

					for each  chIt in Plan_Item[Remake_Of == rootIt.ID]
					{
						chStr = ifnull(chIt.Qty_Accepted,"0").toString().trim();
						if(chStr == "")
						{
							chStr = "0";
						}
						accTotal = accTotal + chStr.toDecimal().toLong();
					}

					if(accTotal < ordStr.toDecimal().toLong() && shortClosed == false)
					{
						orderWhole = false;
						logLines.add("NOT WHOLE -> " + ifnull(rootIt.Item_Name,"").toString() + " | accepted " + accTotal + " of " + ordStr);
					}
				}
			}
		}

		if(checkedAny == true && orderWhole == true && stillMaking == false)
		{
			for each  soP in Sales_Order[ID == orderId]
			{
				// FORWARD ONLY, the same rule saveProductionPhase applies to this
				// field. An order already packed or dispatched is not dragged
				// back to QC Passed by someone reopening an old QC record.
				sStP = ifnull(soP.Order_Status,"").toString();
				if(sStP == "Production Complete" || sStP == "In Progress")
				{
					soP.Order_Status = "QC Passed";
					if(shortClosed == true)
				{
					logLines.add("QC PASSED (closed short) -> order " + orderId);
				}
				else
				{
					logLines.add("QC PASSED -> order " + orderId + " | every line accepted in full");
				}
				}
				else
				{
					logLines.add("NOTE (order is '" + sStP + "', not moved to QC Passed)");
				}
			}
		}
		else if(stillMaking == true)
		{
			logLines.add("NOT PASSED -> the order still has items in production (see STILL IN PRODUCTION above)");
		}
	}

	res = "Done. Remade: " + madeCount + ", Skipped (already remade): " + skipCount + ", FAILED: " + failCount;
	logLines.add(res);
	info logLines;
	}
	catch (e)
	{
		res = "ERROR: " + e.toString();
		logLines.add(res);
		info logLines;
	}

	return res;
}
