string getSupervisorProductionHistory(string supervisorId, string dateTxt)
{
	// What this supervisor actually produced on a given day.
	// POST: supervisorId, dateTxt - the day, as "dd-MMM-yyyy".
	//
	// ONE DAY, not a range. A supervisor's history is a SHIFT LOG - "what did I
	// get through today" - where the store's is an audit trail that legitimately
	// spans weeks. Different question, so a different control, and a single day
	// also bounds the work naturally.
	//
	// SIGNATURE CHANGED: this took fromTxt and toTxt. The Custom API's argument
	// list must be changed to match, or every call fails.
	//
	// Dates arrive pre-formatted because Deluge parses "dd-MMM-yyyy" the same
	// way whatever the org's locale is, while "01-08-2026" is a different day in
	// the US than it is here.
	//
	// DRIVEN OFF Stage_Log, not off completed plans. Two reasons:
	//
	//  - A stage log has a date of its own, so the range means "work done in
	//    these days" rather than "orders whose plan was raised then". Those are
	//    different questions and only the first is a production history.
	//  - It bounds the query. Walking every completed plan ever would grow
	//    without limit; this reads only the days asked for.
	//
	// Stages are grouped under the item they belong to, because a supervisor
	// thinks in items - "the napkins" - not in isolated stage rows.
	//
	// CHECKING SITS BETWEEN PRODUCTION AND COMPLETION, so two things in here
	// changed meaning rather than just gaining a value:
	//
	//  - Production finishing is now Awaiting_Check, NOT Complete. Complete means
	//    "inspected and signed off" and is written only by saveItemCheck. The
	//    produced total therefore counts BOTH states - counting Complete alone
	//    would read 0 pcs finished on the very day the work was finished, which is
	//    the day this screen is almost always looking at.
	//  - An item at Awaiting_Check has left his hands. statusLabel says so in
	//    words, so the widget does not have to re-derive it and cannot fall back
	//    to "still in production" for a batch that is on the inspector's rack.
	//
	// The check OUTCOME travels with the item when there is one - approved,
	// rejected, sent to alteration, who inspected it and when. That is the honest
	// answer to "where did that order go"; without it a supervisor sees his batch
	// vanish into Complete with no idea how much of it survived.
	//
	// Item_Check is read ONE QUERY PER ITEM, which is safe only because the item
	// set is already bounded twice over: itemOrder holds the items touched by a
	// Done stage log on ONE day, and only those on plans assigned to THIS
	// supervisor. It is a shift's worth of cards, not a table scan. It is
	// narrowed once more to items at Complete - an item can only carry a check
	// once one has been done, and a check is what writes Complete.
	//
	// EVERY LOOKUP IN HERE IS CACHED. This function used to run a
	// Production_Planning query per stage log just to test whose plan it was -
	// including for logs that turned out not to be his - plus an Employee query
	// per log and a Raw_Material query per received line. That is one query per
	// ROW, so the cost grew with how much had been done rather than with how much
	// is being shown. It is the shape that trips the statement-execution limit,
	// and that limit is NOT catchable: it kills the script, so the try/catch never
	// runs and the widget gets a bare 500 with no error card to explain it.

	itemsJson = "";
	recvJson = "";
	totalStages = 0;
	totalOut = 0;
	totalRecvLines = 0;

	// Same debug wrapper as the other functions - Creator collapses every
	// runtime failure into a generic "code 9430", so catch the real message.
	try
	{
	supTxt = ifnull(supervisorId,"").toString().trim();
	if(supTxt == "" || supTxt.isNumber() == false)
	{
		return "{\"errors\":[],\"items\":[],\"receipts\":[],\"stageCount\":0,\"producedTotal\":0,\"receiptLines\":0}";
	}
	supId = supTxt.toLong();

	dDay = dateTxt.trim().toDate();

	if(dDay > zoho.currentdate)
	{
		return "{\"errors\":[\"Cannot look at a future date\"],\"items\":[],\"receipts\":[],\"stageCount\":0,\"producedTotal\":0,\"receiptLines\":0}";
	}

	//--------------------------------------------------------------------------
	// Caches. Filled on first sight, read for free after that.
	//
	// planOwner doubles as the ownership test. A miss is remembered as "0" rather
	// than left empty, so a plan with no supervisor assigned is not re-queried on
	// every one of its stage logs - an unassigned plan would otherwise be the
	// most expensive kind there is.
	//--------------------------------------------------------------------------
	planOwner = Map();
	planNoMap = Map();
	planSoMap = Map();
	empCache = Map();

	// Only finished stages. A stage still running is work in hand, not history,
	// and it is already on the Production tab.
	//
	// NEWEST first. Log_Date is the same for every row on a one-day view, so it
	// can order nothing here - Added_Time is stamped at insert and gives the real
	// sequence of the shift.
	logs = Stage_Log[Log_Date == dDay && Stage_Status == "Done"] sort by Added_Time desc;
	info "stage logs on day: " + logs.count();

	// Grouped by Plan_Item. Because the logs arrive newest-first, an item enters
	// itemOrder at its most RECENT stage - so the cards read most-recently-worked
	// first, which is what he is looking for when he opens this.
	stagesByItem = Map();
	itemOrder = List();

	for each  lg in logs
	{
		itmId = lg.Plan_Item;
		if(itmId != null)
		{
			// Ownership is the plan's, not the log's - a log records who ran the
			// machine, which is not the same as whose order it was.
			planKey = ifnull(lg.Plan,"").toString();
			ownerTxt = ifnull(planOwner.get(planKey),"").toString();

			if(ownerTxt == "" && planKey != "")
			{
				for each  pl in Production_Planning[ID == lg.Plan]
				{
					ownerTxt = ifnull(pl.Assigned_To,"").toString();
					planNoMap.put(planKey,ifnull(pl.Plan_No,"").toString());

					soCache = "";
					for each  so in Sales_Order[ID == pl.Sales_Order]
					{
						soCache = ifnull(so.Sales_Order,"").toString().replaceAll("\"","'");
					}
					planSoMap.put(planKey,soCache);
				}

				// "0" is the remembered miss - never a real record id.
				if(ownerTxt == "")
				{
					ownerTxt = "0";
				}
				planOwner.put(planKey,ownerTxt);
			}

			mine = false;
			if(ownerTxt == supId.toString())
			{
				mine = true;
			}

			if(mine == true)
			{
				key = itmId + "";

				//------------------------------------------------------
				// WHO WORKED IT.
				//
				// A stage is split between several operators now, so the
				// name comes off the shares - the header's own Operator is
				// only filled on a stage logged before the split existed,
				// and on nothing written since.
				//
				// Queried only when the header has no operator, so an old
				// row still costs nothing. Several names are joined with a
				// comma: this is one row per STAGE, and what the supervisor
				// is looking for is which of his men were on it.
				//------------------------------------------------------
				opKey = ifnull(lg.Operator,"").toString();
				opName = ifnull(empCache.get(opKey),"").toString();

				if(opName == "" && opKey != "")
				{
					for each  emp in Employee[ID == lg.Operator]
					{
						opName = ifnull(emp.Employee_Name,"").toString().replaceAll("\"","'");
					}
					empCache.put(opKey,opName);
				}

				if(opKey == "")
				{
					for each  agH in Stage_Assignment[Stage_Log == lg.ID]
					{
						agKey = ifnull(agH.Operator,"").toString();
						if(agKey != "")
						{
							agName = ifnull(empCache.get(agKey),"").toString();
							if(agName == "")
							{
								for each  empA in Employee[ID == agH.Operator]
								{
									agName = ifnull(empA.Employee_Name,"").toString().replaceAll("\"","'");
								}
								empCache.put(agKey,agName);
							}

							if(agName != "")
							{
								if(opName == "")
								{
									opName = agName;
								}
								else
								{
									opName = opName + ", " + agName;
								}
							}
						}
					}
				}

				logDateTxt = "";
				if(lg.Log_Date != null)
				{
					logDateTxt = lg.Log_Date.toString("dd-MMM-yyyy");
				}

				row = "{\"phase\":\"" + ifnull(lg.Phase_Name,"").toString().replaceAll("\"","'") + "\",\"operator\":\"" + opName + "\",\"date\":\"" + logDateTxt + "\",\"start\":\"" + ifnull(lg.Start_Time,"").toString() + "\",\"end\":\"" + ifnull(lg.End_Time,"").toString() + "\",\"qtyIn\":" + ifnull(lg.Qty_In,0) + ",\"qtyOut\":" + ifnull(lg.Qty_Out,0) + "}";

				existing = stagesByItem.get(key);
				if(existing == null)
				{
					stagesByItem.put(key,row);
					itemOrder.add(key);
				}
				else
				{
					// PREPENDED, not appended. The logs arrive newest-first, so
					// prepending puts the stages back into the order the work
					// actually happened - Cutting, then Stitching, then Finishing.
					// A production flow printed backwards is unreadable, however
					// much the CARDS want to be newest-first.
					stagesByItem.put(key,row + "," + existing);
				}

				totalStages = totalStages + 1;
			}
		}
	}

	//--------------------------------------------------------------------
	// One card per item, with its stages nested.
	//
	// qtyOrdered and qtyProduced are facts about the WHOLE item, not about the
	// day being shown - an item's stages run across days, so a card holding one
	// day's stitching next to a produced figure earned over three days would
	// read as "I made that today". The widget labels them as whole-item; they
	// are sent unchanged because the item's progress is what makes the day's
	// stages mean anything.
	//--------------------------------------------------------------------
	for each  k in itemOrder
	{
		itemName = "";
		qtyOrdered = 0;
		qtyProduced = 0;
		itemStatus = "";
		soNo = "";
		planNo = "";

		for each  itm in Plan_Item[ID == k.toLong()]
		{
			itemName = ifnull(itm.Item_Name,"").toString().replaceAll("\"","'");
			qtyOrdered = ifnull(itm.Qty_Ordered,0);
			qtyProduced = ifnull(itm.Qty_Produced,0);
			itemStatus = ifnull(itm.Item_Status,"").toString();

			// Straight out of the cache the stage pass filled - the plan behind
			// an item is the same plan its logs pointed at.
			iPlanKey = ifnull(itm.Plan,"").toString();
			planNo = ifnull(planNoMap.get(iPlanKey),"").toString();
			soNo = ifnull(planSoMap.get(iPlanKey),"").toString();
		}

		// Counted for finished items - and finished now means Awaiting_Check as
		// well as Complete. Production ends at the last stage; Complete is what
		// the INSPECTOR writes afterwards. Counting Complete alone would report
		// 0 pcs finished on the very day the work was done, which is the day
		// this screen is almost always looking at.
		if(itemStatus == "Complete" || itemStatus == "Awaiting_Check")
		{
			totalOut = totalOut + qtyProduced;
		}

		//------------------------------------------------------------
		// WHERE THE BATCH ACTUALLY IS, in words.
		//
		// Said here rather than left to the widget, because the widget would have
		// to re-derive it and its existing fallback is "still in production" -
		// which is exactly wrong for a batch sitting on the inspector's rack.
		//------------------------------------------------------------
		statusTxt = itemStatus;
		if(itemStatus == "Awaiting_Check")
		{
			statusTxt = "Waiting for checking";
		}
		else if(itemStatus == "Complete")
		{
			statusTxt = "Checked and signed off";
		}
		else if(itemStatus == "In_Production")
		{
			statusTxt = "In production";
		}

		//------------------------------------------------------------
		// THE CHECK OUTCOME, when there is one.
		//
		// Without it a supervisor watches his batch vanish into Complete with no
		// idea how much of it survived - and the rejected pieces come back to him
		// as a new batch with no visible connection to the one he finished.
		//
		// ONE QUERY PER ITEM, safe only because the item set is bounded twice
		// over: items touched by a Done stage log on the days asked for, on plans
		// belonging to THIS supervisor. A shift's worth of cards, not a scan. It
		// is narrowed once more to Complete - a check is what writes that status,
		// so nothing else can carry one.
		//------------------------------------------------------------
		chkJson = "null";
		if(itemStatus == "Complete")
		{
			for each  icRec in Item_Check[Plan_Item == k.toLong()]
			{
				icInsp = "";
				if(icRec.Inspector != null)
				{
					// A lookup holds a record id - toString() gives the id, not
					// the name. This exact mistake shipped 18-digit ids to the UI
					// twice, so the master record is fetched.
					for each  icEmp in Employee[ID == icRec.Inspector]
					{
						icInsp = ifnull(icEmp.Employee_Name,"").toString().replaceAll("\"","'");
					}
				}

				icDate = "";
				if(icRec.Check_Date != null)
				{
					icDate = icRec.Check_Date.toString("dd-MMM-yyyy");
				}

				chkJson = "{\"round\":" + ifnull(icRec.Round,0) + ",\"inspected\":" + ifnull(icRec.Qty_Inspected,0) + ",\"approved\":" + ifnull(icRec.Qty_Approved,0) + ",\"rejected\":" + ifnull(icRec.Qty_Rejected,0) + ",\"alteration\":" + ifnull(icRec.Qty_Alteration,0) + ",\"inspector\":\"" + icInsp + "\",\"checkedOn\":\"" + icDate + "\"}";
			}
		}

		if(itemsJson != "")
		{
			itemsJson = itemsJson + ",";
		}
		// IDs forced to string - 18-digit ids break JSON.parse otherwise.
		itemsJson = itemsJson + "{\"id\":\"" + k + "\",\"item\":\"" + itemName + "\",\"salesOrder\":\"" + soNo + "\",\"planNo\":\"" + planNo + "\",\"qtyOrdered\":" + qtyOrdered + ",\"qtyProduced\":" + qtyProduced + ",\"status\":\"" + itemStatus + "\",\"statusLabel\":\"" + statusTxt + "\",\"check\":" + chkJson + ",\"stages\":[" + stagesByItem.get(k) + "]}";
	}

	//--------------------------------------------------------------------
	// What came IN over the same days.
	//
	// "What did I do today" is only half the question - the other half is what
	// the store handed him to do it with, and until now that lived only on the
	// store's screen. Same date, same call: two round trips for one question
	// would be two chances for the two halves to disagree about which day they
	// were showing.
	//
	// Bounded by Issue_Date exactly as the stage logs are bounded by Log_Date,
	// so adding this cannot turn a safe day into a statement-limit failure.
	//
	// The date is when the STORE issued it, which is the only date a handover
	// has. The status says whether he has confirmed it since, so a row that has
	// not been answered is visible here rather than only on the Receive tab.
	//
	// NO plan or sales order on these rows, for the same reason the store's own
	// History dropped them: a handover is one press of Issue against a
	// SUPERVISOR, and issueMaterials fans that quantity across every open plan
	// he has. Material_Issue.Plan holds only the first plan that took an
	// allocation, so naming it claimed "this material went to this order" when it
	// routinely went to three. What he received and how much is the whole of what
	// a handover can honestly say.
	//--------------------------------------------------------------------
	// Newest first, on Added_Time for the same reason as the stage logs: every
	// handover on a one-day view shares an Issue_Date, so only the insert stamp
	// can order them.
	//
	// ONE PRESS = ONE ROW, both eras.
	//   NEW  - Source_System == "JS_API": issueMaterialsHandover writes one
	//          Material_Issue per press, Issue_Lines at material x lot grain
	//          (NO Plan_Item on the line - the per-item split is gone; those
	//          lines fold into the widget's "unassigned" bucket, same as a
	//          legacy line that never resolved an item).
	//   OLD  - Batch_Head == true: first chunk, siblings merged by Batch_Voucher.
	// Two positive == matches OR'd - an empty field just fails to match.
	issues = Material_Issue[Issued_To == supId && Issue_Date == dDay && (Batch_Head == true || Source_System == "JS_API")] sort by Added_Time desc;
	info "handover batches on day: " + issues.count();

	// The material catalogue, fetched ONCE, rather than a Raw_Material query per
	// received line. Issue_Lines.Material is a LOOKUP whose display column is the
	// SKU, so Creator's own form renders it as "RM-00005" - but Deluge reads a
	// lookup as the record id. The id is the map key, never a displayed value.
	//
	// Built only when there is something to look up. A day with no handovers -
	// most days, for most supervisors - does not pay for the catalogue at all.
	matNameMap = Map();
	if(issues.count() > 0)
	{
		for each  rmC in Raw_Material[ID != 0]
		{
			rmName = ifnull(rmC.Material_Display_Name,"").toString().trim();
			if(rmName == "")
			{
				rmName = ifnull(rmC.Name,"").toString().trim();
			}
			matNameMap.put(rmC.ID.toString(),rmName.replaceAll("\"","'"));
		}
	}

	// WHICH ITEM EACH ISSUE LINE WAS FOR - the "how this handover was divided"
	// detail the card expands to. Issue_Lines.Plan_Item is stamped by
	// issueMaterials on every line it can resolve one for, so the item id is
	// read straight off the line and no Material_Requirement hop is needed.
	//
	// This is HONEST per line, unlike Material_Issue.Plan on the header - that
	// holds only the first plan the fan-out touched, which is why the header
	// carries no order. A LINE has exactly one Plan_Item, so it can name it.
	//
	// Id-keyed maps (name, sku, status) filled together in one indexed query per
	// DISTINCT item on the page, read for free after that - a handover of a
	// common trim names the same few items on many lines. SEPARATE maps rather
	// than one "name|sku|status" string because Item_Name is flattened with
	// " | " and a delimiter split would break on a name that contains a pipe. A
	// seen item with an empty status is remembered in itemSeenMap so it is not
	// re-queried. Same shape as planOwner / empCache / matNameMap above.
	//
	// Item_Sku is itself a LOOKUP to Item_Master, so resolving the SKU text is a
	// SECOND hop per distinct item - still bounded by items-on-the-day and paid
	// once each because of the cache.
	itemNameMap = Map();
	itemSkuMap = Map();
	itemStatMap = Map();
	itemSeenMap = Map();

	for each  mi in issues
	{
		// NEW: one row = one press. OLD: head + Batch_Voucher siblings.
		if(ifnull(mi.Source_System,"").toString().trim() == "JS_API")
		{
			batchChunks = Material_Issue[ID == mi.ID];
		}
		else
		{
			batchKey = ifnull(mi.Batch_Voucher,"").toString().trim();
			if(batchKey == "")
			{
				batchKey = ifnull(mi.Voucher_No,"").toString().trim();
			}
			batchChunks = Material_Issue[Batch_Voucher == batchKey] sort by Added_Time;
		}

		rLines = "";
		rSiv = "";
		earliestDate = null;
		earliestTime = "";
		earliestAdded = null;

		for each  bc in batchChunks
		{
			bcSiv = ifnull(bc.Voucher_No,"").toString().trim().replaceAll("\"","'");
			if(bcSiv != "")
			{
				if(rSiv != "")
				{
					rSiv = rSiv + ",";
				}
				rSiv = rSiv + "\"" + bcSiv + "\"";
			}

			bcAdded = bc.Added_Time;
			if(earliestAdded == null || (bcAdded != null && bcAdded < earliestAdded))
			{
				earliestAdded = bcAdded;
				earliestDate = bc.Issue_Date;
				earliestTime = ifnull(bc.Issue_Time,"").toString();
			}

			for each  rln in bc.Issue_Lines
			{
				// Creator fields that were never written are EMPTY, not null, and
				// toDecimal() throws on empty - normalise to string first.
				rqStr = ifnull(rln.Qty,"0").toString().trim();
				if(rqStr == "")
				{
					rqStr = "0";
				}

				rKey = "";
				if(rln.Material != null)
				{
					rKey = rln.Material.toString();
				}
				rName = ifnull(matNameMap.get(rKey),"").toString();

				// Falls back to whatever the line itself recorded. Handovers written
				// before issueMaterials was fixed have the SKU sitting in
				// Material_Name, and a material later removed from the catalogue
				// misses the map entirely - in both cases the line's own text beats
				// an empty cell.
				if(rName == "")
				{
					rName = ifnull(rln.Material_Name,"").toString().trim().replaceAll("\"","'");
				}

				// The item this line's quantity was cut for. Plan_Item is a
				// LOOKUP - toString() gives the record id, which is the map key.
				// Empty on a pre-Plan_Item handover or a line issued without one;
				// the "" key just misses the map and the line carries blank item
				// fields, which the widget folds into an "unassigned" bucket.
				rItemKey = "";
				if(rln.Plan_Item != null)
				{
					rItemKey = rln.Plan_Item.toString().trim();
				}
				rItemName = "";
				rItemSku = "";
				rItemStat = "";
				if(rItemKey != "" && rItemKey.isNumber() == true)
				{
					if(ifnull(itemSeenMap.get(rItemKey),"").toString() == "")
					{
						// Cache the miss first, so an unreadable id is not
						// re-queried on every line that names it.
						itemSeenMap.put(rItemKey,"1");
						itemNameMap.put(rItemKey,"");
						itemSkuMap.put(rItemKey,"");
						itemStatMap.put(rItemKey,"");
						for each  piC in Plan_Item[ID == rItemKey.toLong()]
						{
							piName = ifnull(piC.Item_Name,"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");
							itemNameMap.put(rItemKey,piName);
							itemStatMap.put(rItemKey,ifnull(piC.Item_Status,"").toString().trim());

							// Item_Sku is a LOOKUP - the master record carries the
							// SKU text. Empty when the line has no item mapped.
							piSkuKey = ifnull(piC.Item_Sku,"").toString().trim();
							if(piSkuKey != "" && piSkuKey.isNumber() == true)
							{
								for each  imR in Item_Master[ID == piSkuKey.toLong()]
								{
									itemSkuMap.put(rItemKey,ifnull(imR.SKU,"").toString().trim().replaceAll("\"","'"));
								}
							}
						}
					}
					rItemName = ifnull(itemNameMap.get(rItemKey),"").toString();
					rItemSku = ifnull(itemSkuMap.get(rItemKey),"").toString();
					rItemStat = ifnull(itemStatMap.get(rItemKey),"").toString();
				}

				if(rLines != "")
				{
					rLines = rLines + ",";
				}
				rLines = rLines + "{\"material\":\"" + rName + "\",\"qty\":" + rqStr.toDecimal() + ",\"unit\":\"" + ifnull(rln.Unit,"").toString() + "\",\"itemId\":\"" + rItemKey + "\",\"itemName\":\"" + rItemName + "\",\"itemSku\":\"" + rItemSku + "\",\"itemStatus\":\"" + rItemStat + "\"}";
				totalRecvLines = totalRecvLines + 1;
			}
		}

		rDate = "";
		if(earliestDate != null)
		{
			rDate = earliestDate.toString("dd-MMM-yyyy");
		}

		if(recvJson != "")
		{
			recvJson = recvJson + ",";
		}
		// id / voucher are the HEAD's; sivNumbers lists every chunk. IDs forced
		// to string - 18-digit ids break JSON.parse otherwise.
		recvJson = recvJson + "{\"id\":\"" + mi.ID + "\",\"voucher\":\"" + ifnull(mi.Voucher_No,"").toString() + "\",\"sivNumbers\":[" + rSiv + "],\"date\":\"" + rDate + "\",\"time\":\"" + earliestTime + "\",\"status\":\"" + ifnull(mi.Issue_Status,"").toString() + "\",\"lines\":[" + rLines + "]}";
	}
	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"items\":[],\"receipts\":[],\"stageCount\":0,\"producedTotal\":0,\"receiptLines\":0}";
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	return "{\"errors\":[],\"items\":[" + itemsJson + "],\"receipts\":[" + recvJson + "],\"stageCount\":" + totalStages + ",\"producedTotal\":" + totalOut + ",\"receiptLines\":" + totalRecvLines + "}";
}
