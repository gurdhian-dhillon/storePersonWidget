string getProductionWidgetData(string supervisorId, string planId, string itemPageJson)
{
	// SCOPED TO ONE SUPERVISOR. Custom API, POST, three arguments.
	//
	// This used to take no argument and return every live plan in the factory,
	// with the widget throwing away everything but the one supervisor it was
	// showing. Each item costs a handful of queries - its requirements, its
	// stage logs, its waste movements and their children, its BOM and its
	// master record - so the cost was every supervisor's entire day's work,
	// fetched to render one man's screen.
	//
	// The statement-execution limit is NOT catchable: it kills the script and
	// the widget gets a bare HTTP 500 with no error card at all. This is the
	// single biggest lever on staying under it.
	//
	// An EMPTY supervisorId still returns everything, deliberately - nothing
	// else calls this today, but a cross-floor view would want exactly that,
	// and refusing would make it a different function.
	//
	// planId NARROWS IT FURTHER, to the one order actually on screen.
	//
	// The dropdown needs a line per plan - number, order, date, status. The
	// SCREEN needs one plan's items, and everything expensive hangs off an
	// item: its requirements, its stage logs, its waste movements and their
	// children, its BOM and its master record. Sending every plan in full meant
	// paying for a supervisor's whole week to draw the one order he is looking
	// at.
	//
	// So every plan comes back as a light row, and exactly one comes back with
	// items. Empty planId gives the detail to the FIRST plan, which is the one
	// the widget auto-selects - so a first load still needs only one call.
	//
	// itemPageJson NARROWS THE DETAILED PLAN TO ONE PAGE OF ITEMS.
	//
	// A Faire wholesale order is one plan with ~100-110 Plan_Item rows. Drawing
	// every card at once is an unusable scroll, and every item costs a handful
	// of queries - its requirements, stage logs, waste movements and their
	// children, BOM, master record - so a hundred of them in one execution is
	// also the direction the uncatchable statement limit lies in.
	//
	// A SINGLE JSON STRING so future paging tweaks never need another Creator
	// Custom API config change:
	//   {"skip":0,"limit":10,"focusItemId":"","search":""}
	//   skip / limit  - the window into the filtered item list. limit defaults
	//                   to 10 and is capped at 50.
	//   focusItemId   - "make the page holding this item the one returned",
	//                   for openItemId after a save that moved focus off-page.
	//   search        - substring match on item name AND sku, case-insensitive.
	//                   Narrows the list BEFORE paging, so the pager counts what
	//                   is actually drawn.
	//
	// The filter that hides finished originals once a plan carries QC remake
	// work (the widget used to do this) moves here too, so itemTotal and the
	// page agree with each other.
	//
	// itemTotal / itemSkip / itemLimit come back on the response for the pager.
	// The focused plan's light row also carries itemStats - id count and four
	// integers computed over the WHOLE Plan_Item list, no child queries - so
	// renderPlanHeader keeps describing the whole plan while the cards show one
	// page.
	errJson = "";
	plansJson = "";
	empsJson = "";
	supsJson = "";
	partyJson = "";

	// Paging inputs, parsed once. A Custom API argument is always a string and
	// may arrive "" - toMap() on an empty string throws, so it is guarded.
	pgSkip = 0;
	pgLimit = 10;
	pgFocus = "";
	pgSearch = "";
	pgRaw = ifnull(itemPageJson,"").toString().trim();
	if(pgRaw != "" && pgRaw != "{}")
	{
		pgMap = pgRaw.toMap();
		if(pgMap != null)
		{
			pgSkipS = ifnull(pgMap.get("skip"),"0").toString().trim();
			if(pgSkipS == "" || pgSkipS.isNumber() == false) { pgSkipS = "0"; }
			pgSkip = pgSkipS.toDecimal().toLong();
			if(pgSkip < 0) { pgSkip = 0; }

			pgLimS = ifnull(pgMap.get("limit"),"10").toString().trim();
			if(pgLimS == "" || pgLimS.isNumber() == false) { pgLimS = "10"; }
			pgLimit = pgLimS.toDecimal().toLong();
			if(pgLimit <= 0) { pgLimit = 10; }
			if(pgLimit > 50) { pgLimit = 50; }

			pgFocus = ifnull(pgMap.get("focusItemId"),"").toString().trim();
			pgSearch = ifnull(pgMap.get("search"),"").toString().trim().toLowerCase();
		}
	}

	try
	{
		//------------------------------------------------------------------
		// Third parties: fetched once at the top level, matched to stages in
		// the WIDGET by exact string.
		//
		// A query on Applicable_Stages would have to use "contains", which is a
		// SUBSTRING match, and the stage names collide - "Machine Embroidery"
		// sits inside "Manual Machine Embroidery". Substring matching would
		// offer the wrong parties for a stage.
		//
		// Inactive parties are sent too and never offered by the widget, so a
		// party that has vanished from the picker can still be named on the
		// stage it is holding rather than simply being absent.
		//------------------------------------------------------------------
		for each tp in Third_Party[ID != 0] sort by Party_Name
		{
			// Iterated as a list rather than split off toString() - a
			// multi-select rendered to a string is not a shape worth relying
			// on, and an empty one is EMPTY, not null, so it is guarded first.
			tpStgJson = "";
			tpStgRaw = ifnull(tp.Applicable_Stages,"");
			if(tpStgRaw.toString().trim() != "")
			{
				for each tstg in tpStgRaw
				{
					tstgTxt = tstg.toString().trim().replaceAll("\"","'");
					if(tstgTxt != "")
					{
						if(tpStgJson != "") { tpStgJson = tpStgJson + ","; }
						tpStgJson = tpStgJson + "\"" + tstgTxt + "\"";
					}
				}
			}

			if(partyJson != "") { partyJson = partyJson + ","; }
			// Ids forced to string - an 18-digit id breaks JSON.parse.
			partyJson = partyJson + "{\"id\":\"" + tp.ID + "\",\"name\":\"" + ifnull(tp.Party_Name,"").toString().replaceAll("\"","'") + "\",\"contact\":\"" + ifnull(tp.Contact_Person,"").toString().replaceAll("\"","'") + "\",\"phone\":\"" + ifnull(tp.Phone,"").toString().replaceAll("\"","'") + "\",\"status\":\"" + ifnull(tp.Status,"") + "\",\"stages\":[" + tpStgJson + "]}";
		}

		// MACHINES ARE NO LONGER TRACKED. Each operator works a fixed machine,
		// so "which machine" is answered by "which operator" and the picker was
		// asking a question nobody on the floor had to think about. The whole
		// Machine_Master block that stood here is gone, along with the machines
		// array this used to return.
		//
		// Machine_Master itself is left alone in Creator, still holding what it
		// held. Nothing reads or writes it from production any more.

		// 0. WHO THE ADMIN HAS PUT ON WHICH STAGE, inverted into operator ->
		//    stages. He answers the question stage-first - "Cutting: Aman,
		//    Arjun" - and the picker asks it operator-first, so it is turned
		//    round once here rather than re-scanned per stage card.
		//
		//    UNIONED across records, never newest-wins. Stage cannot carry a
		//    Unique constraint - Creator does not offer one on a Drop Down - so
		//    duplicates are refused by a validation and coped with here. Picking
		//    a winner would leave the losing record sitting in the report looking
		//    authoritative while doing nothing, and union degrades the safe way:
		//    a looser picker, never an empty one.
		//
		//    Is_Active is read in the query. If that field is ever deleted from
		//    the form this line breaks loudly, which is the right way round -
		//    silently ignoring a suspended rule would not be noticed.
		opStages = Map();
		for each oa in Operator_Assignment[Is_Active == true]
		{
			oaStage = ifnull(oa.Stage,"").toString().trim();
			if(oaStage != "")
			{
				// A record with no operators is NOT "restrict to nobody" - it is
				// the same as no record, so it contributes nothing and the stage
				// falls through to the unrestricted case in the widget. This loop
				// simply does not run for one.
				for each oaOp in oa.Operators
				{
					oaKey = oaOp.toString();
					oaList = opStages.get(oaKey);
					if(oaList == null)
					{
						oaList = List();
					}
					if(oaList.contains(oaStage) == false)
					{
						oaList.add(oaStage);
					}
					opStages.put(oaKey,oaList);
				}
			}
		}

		// 1. Every employee, for the Operator picker inside a stage card.
		//
		//    STILL EVERY employee, deliberately. This list is not only the
		//    picker - it is the widget's whole directory, used to name the
		//    operator on a finished stage log and the supervisor on a plan.
		//    Narrowing it here would blank both, so a man who has since changed
		//    designation would vanish from work he actually did. The stage filter
		//    belongs in the widget, exactly as it already does for third
		//    parties.
		//
		//    role is the Designation text, so the widget can fall back to "all
		//    operators" on a stage the admin has not assigned.
		for each emp in Employee[ID != 0] sort by Employee_Name
		{
			empStgJson = "";
			empStgList = opStages.get(emp.ID + "");
			if(empStgList != null)
			{
				for each estg in empStgList
				{
					if(empStgJson != "") { empStgJson = empStgJson + ","; }
					empStgJson = empStgJson + "\"" + estg.toString().replaceAll("\"","'") + "\"";
				}
			}
			if(empsJson != "") { empsJson = empsJson + ","; }
			// Employee_Name escaped - it was not, and one apostrophe-free name
			// with a double quote in it would have broken JSON.parse for the
			// entire screen.
			empsJson = empsJson + "{\"id\":\"" + emp.ID + "\",\"name\":\"" + ifnull(emp.Employee_Name,"").toString().replaceAll("\"","'") + "\",\"role\":\"" + ifnull(emp.Designation,"").toString().replaceAll("\"","'") + "\",\"stages\":[" + empStgJson + "]}";
		}

		// 2. Every plan that is still live work, INCLUDING ones the store has
		//    not issued against yet.
		//
		//    "Pending" was excluded, which meant an order assigned to a
		//    supervisor was invisible to him until the store happened to send
		//    material. He could not see how much work was coming, or that an
		//    order existed at all - the first he knew of it was cloth arriving.
		//
		//    The widget already renders these correctly: an item at
		//    Awaiting_Material shows a disabled "Waiting on Store" instead of a
		//    Start button, so seeing the order does not let him start it early.
		//
		//    Production Complete stays out. That is history and has its own tab.
		supTxt = ifnull(supervisorId,"").toString().trim();

		if(supTxt != "" && supTxt.isNumber())
		{
			supFilt = supTxt.toLong();
			pendingPlans = Production_Planning[Assigned_To == supFilt && (Order_Status == "Pending" || Order_Status == "Material Ready" || Order_Status == "Partially Received" || Order_Status == "In Progress")] sort by Added_Time;
		}
		else
		{
			pendingPlans = Production_Planning[Order_Status == "Pending" || Order_Status == "Material Ready" || Order_Status == "Partially Received" || Order_Status == "In Progress"] sort by Added_Time;
		}

		// 3. Supervisors for the FILTER dropdown are only those who actually
		//    have such a plan. Listing every employee there means picking a name
		//    and landing on an empty screen with nothing to say why.
		seenSup = Map();
		for each  sp in pendingPlans
		{
			spId = sp.Assigned_To;
			if(spId != null && seenSup.get(spId + "") == null)
			{
				seenSup.put(spId + "","1");
				spName = "Unknown";
				for each  spEmp in Employee[ID == spId]
				{
					spName = spEmp.Employee_Name;
				}
				if(supsJson != "") { supsJson = supsJson + ","; }
				supsJson = supsJson + "{\"id\":\"" + spId + "\",\"name\":\"" + spName + "\"}";
			}
		}

		//------------------------------------------------------------------
		// Which plan gets its items.
		//
		// VERIFIED AGAINST THE SET WE JUST FETCHED, never trusted as given. The
		// widget holds the last plan it was showing, and changing supervisor
		// reloads the tab before that selection is cleared - so it arrives here
		// naming a plan belonging to somebody else. Matching nothing, every plan
		// came back header-only and the screen read "No Items Found" on a plan
		// that has items.
		//
		// Falls back to the first, which is what the widget auto-selects anyway.
		//------------------------------------------------------------------
		wantPlan = 0;
		wantTxt = ifnull(planId,"").toString().trim();
		if(wantTxt != "" && wantTxt.isNumber())
		{
			wantPlan = wantTxt.toLong();
		}

		firstPlan = 0;
		wantIsHis = false;
		for each  pChk in pendingPlans
		{
			if(firstPlan == 0)
			{
				firstPlan = pChk.ID;
			}
			if(wantPlan != 0 && pChk.ID == wantPlan)
			{
				wantIsHis = true;
			}
		}
		if(wantIsHis == false)
		{
			wantPlan = firstPlan;
		}

		for each plan in pendingPlans
		{
			soNo = "";
			for each so in Sales_Order[ID == plan.Sales_Order] {
				soNo = so.Sales_Order;
			}

			itemsJson = "";

			// EVERY OTHER PLAN IS A HEADER ONLY. It is in the dropdown, not on
			// the screen, and nothing the dropdown shows comes from an item.
			hasDetail = "false";
			if(plan.ID == wantPlan)
			{
				hasDetail = "true";
			}

			planItems = Plan_Item[ID == 0];

			// itemStats travels on the FOCUSED plan's light row and nowhere
			// else. renderPlanHeader used to sum the items it received - "to
			// produce", "produced", "N of M complete" - which a one-page slice
			// breaks. These four integers are computed over the whole Plan_Item
			// list with NO child queries (just the item's own fields), so the
			// header keeps describing the whole plan for the cost of one cheap
			// scan.
			statCount = 0;
			statToProduce = 0;
			statProduced = 0;
			statDone = 0;
			statRemake = 0;

			// itemTotal / the page window, for the pager.
			itemTotal = 0;
			itemSkipOut = pgSkip;

			// Which item ids are on this page. Built before the expensive loop so
			// the detail build can skip everything outside the window.
			pgInclude = Map();

			if(plan.ID == wantPlan)
			{
				// Plan_Item is its own form now, not a subform - so this is a
				// query against the plan rather than a walk of nested rows.
				planItems = Plan_Item[Plan == plan.ID] sort by Line_No;

				//----------------------------------------------------------
				// PASS A - the light scan. Stats over the whole plan, plus the
				// FILTERED, ORDERED id list the pager pages through.
				//
				// The filter that hides finished originals once a plan carries
				// QC remake work moved here from the widget: an item is on the
				// list unless the plan has any remake AND this item is a
				// finished (Complete) original. Search narrows it further, on
				// name and sku.
				//
				// SKU is a lookup, so a search on it needs the master record -
				// resolved here ONLY when a search term is present and only for
				// non-remake items, so an unsearched load pays nothing for it.
				//----------------------------------------------------------
				planHasRemake = false;
				for each  rmScan in planItems
				{
					if(ifnull(rmScan.Is_Remake,false) == true)
					{
						planHasRemake = true;
					}
				}

				pgOrder = List();
				pgIdx = 0;

				for each  itmA in planItems
				{
					aIsRemake = ifnull(itmA.Is_Remake,false);
					aStatus = ifnull(itmA.Item_Status,"").toString().trim();
					aQty = ifnull(itmA.Qty_Ordered,0);
					aProd = ifnull(itmA.Qty_Produced,0);

					// Stats first - always the whole plan, never the filtered
					// or paged view. Originals only for the order totals; the
					// remake pieces get their own figure.
					if(aIsRemake == false)
					{
						statCount = statCount + 1;
						statToProduce = statToProduce + aQty;
						if(aStatus == "Complete")
						{
							statDone = statDone + 1;
						}
					}
					else
					{
						if(aStatus != "Complete")
						{
							statRemake = statRemake + aQty;
						}
					}
					statProduced = statProduced + aProd;

					// The visibility filter - same rule the widget applied.
					aVisible = true;
					if(planHasRemake == true && aIsRemake == false && aStatus == "Complete")
					{
						aVisible = false;
					}

					if(aVisible == true && pgSearch != "")
					{
						aName = ifnull(itmA.Item_Name,"").toString().toLowerCase();
						aHit = aName.contains(pgSearch);
						if(aHit == false)
						{
							aSkuTxt = "";
							for each  imS in Item_Master[ID == itmA.Item_Sku]
							{
								aSkuTxt = ifnull(imS.SKU,"").toString().toLowerCase();
							}
							if(aSkuTxt.contains(pgSearch))
							{
								aHit = true;
							}
						}
						if(aHit == false)
						{
							aVisible = false;
						}
					}

					if(aVisible == true)
					{
						pgOrder.add(itmA.ID.toString());
						if(pgFocus != "" && itmA.ID.toString() == pgFocus)
						{
							// Land the window on the page holding the focused
							// item. Integer division floors before the multiply.
							pgSkip = (pgIdx / pgLimit).floor() * pgLimit;
						}
						pgIdx = pgIdx + 1;
					}
				}

				itemTotal = pgOrder.size();
				if(pgSkip >= itemTotal && itemTotal > 0)
				{
					// A stale skip - the list shrank under it. Fall back to the
					// last page rather than returning nothing.
					pgSkip = ((itemTotal - 1) / pgLimit).floor() * pgLimit;
				}
				itemSkipOut = pgSkip;

				pgEnd = pgSkip + pgLimit;
				pgN = 0;
				for each  incId in pgOrder
				{
					if(pgN >= pgSkip && pgN < pgEnd)
					{
						pgInclude.put(incId,"1");
					}
					pgN = pgN + 1;
				}
			}

			// isRemake goes with each item so the widget can hide the finished
			// originals from the stage list while the header still counts the
			// whole plan - and so a supervisor handed cloth for something he
			// already finished is told it is a QC remake rather than left to
			// wonder.
			//
			// PASS B - the expensive build, PAGE-WINDOW ONLY. An item not in
			// pgInclude contributes nothing: its requirements, stage logs, waste
			// movements, BOM and master record are never touched.
			for each itm in planItems
			{
				// OUTSIDE THE PAGE WINDOW - skip the whole expensive build. The
				// only stage not started has no Stage_Log row, so "no row" is a
				// real state and there is nothing cheaper to do here than
				// nothing. Guarded with an if rather than a break: Deluge has no
				// reliable break in a for-each.
				pgOn = ifnull(pgInclude.get(itm.ID.toString()),"").toString();
				if(pgOn == "1")
				{
				// Item_Sku is a LOOKUP to Item_Master, so the field itself holds a
				// record id. This shipped the id as "sku" on every item, which
				// nobody noticed only because nothing rendered it. The code the
				// shop floor recognises lives on the master record.
				sku = "";
				for each  imR in Item_Master[ID == itm.Item_Sku]
				{
					sku = ifnull(imR.SKU,"").toString().replaceAll("\"","'");
				}

				// Read once here rather than inline in the JSON line, because the
				// alteration gate below reads it too. An EMPTY Remake_Reason means
				// a rejection, never an alteration - a batch of unknown cause must
				// not be sent down a path expecting Alteration_Stage rows that do
				// not exist.
				rmkTxt = ifnull(itm.Remake_Reason,"").toString().trim();

				//------------------------------------------------------------
				// AN ALTERATION BATCH TAKES ITS PHASES FROM Alteration_Stage.
				//
				// An ordinary item's stage list is its BOM's. A batch cannot use
				// that - it runs the two stages the checker named, not the whole
				// eight - so when Alteration_Stage has rows they ARE the phase
				// list and the BOM is not read at all.
				//
				// THE GATE EXISTS FOR THE STATEMENT LIMIT, which is NOT
				// catchable: it kills the script and the widget gets a bare HTTP
				// 500 with no error card. Only ONE plan gets its items, but every
				// item on it costs a handful of queries already, and this adds up
				// to three more.
				//
				// "Has Alteration_Stage rows" cannot be answered without a query,
				// so the gate is the cheapest thing that CANNOT be true without
				// it: every alteration batch is created as a remake
				// (Is_Remake = true, Remake_Reason = "Alteration"), so an ordinary
				// item skips the query entirely and costs exactly what it costs
				// today. A remake pays one query to find out it is not one. Both
				// fields are read because either alone would be a single point of
				// failure, and both are already being read for the JSON.
				//
				// The AUTHORITY is still "has rows", exactly as it is in
				// closeAlterationBatch - the gate only decides whether to ask.
				//------------------------------------------------------------
				altRmkTxt = ifnull(itm.Is_Remake,false).toString().trim();

				altGate = false;
				if(altRmkTxt == "true")
				{
					altGate = true;
				}
				if(rmkTxt == "Alteration")
				{
					altGate = true;
				}

				altHasRows = false;
				altOpen = 0;
				altMatShort = 0;

				phasesJson = "";

				if(altGate == true)
				{
					// "sort by" on its own assignment - inline in a for-each
					// header it does not reliably parse, and a function that will
					// not save is indistinguishable from one that saved and did
					// nothing. Same read closeAlterationBatch makes of the same
					// rows, deliberately.
					altRows = Alteration_Stage[Plan_Item == itm.ID] sort by Sequence_No;

					for each  altR in altRows
					{
						altHasRows = true;

						altStgTxt = ifnull(altR.Stage_Name,"").toString().trim();

						// A Number field that was never written is EMPTY, not
						// null - ifnull does not catch it and toDecimal() throws.
						altSeqS = ifnull(altR.Sequence_No,"0").toString().trim();
						if(altSeqS == "") { altSeqS = "0"; }
						altPlanS = ifnull(altR.Planned_Qty,"0").toString().trim();
						if(altPlanS == "") { altPlanS = "0"; }

						// Matched on EXACT string, never "contains": the stage
						// names collide as substrings - "Machine Embroidery" sits
						// inside "Manual Machine Embroidery" - and a contains
						// match would accept the wrong stage's log as this one's.
						//
						// A stage with no Stage_Log row at all has not been
						// started. Stage_Status has only two values and the row is
						// created at Start, so "no row" is the third state and it
						// belongs on the open side.
						altDone = false;
						if(altStgTxt != "")
						{
							for each  altLog in Stage_Log[Plan_Item == itm.ID && Phase_Name == altStgTxt]
							{
								if(ifnull(altLog.Stage_Status,"").toString().trim() == "Done")
								{
									altDone = true;
								}
							}
						}
						if(altDone == false)
						{
							altOpen = altOpen + 1;
						}

						if(phasesJson != "") { phasesJson = phasesJson + ","; }
						// plannedQty is what makes this an alteration phase to the
						// widget. ORDINARY BOM PHASES MUST NOT CARRY IT - its
						// presence is the only thing telling the two shapes apart,
						// and putting it on every stage would draw all production
						// as rework.
						phasesJson = phasesJson + "{\"sequence\":" + altSeqS.toDecimal().toLong() + ",\"operation\":\"" + altStgTxt.replaceAll("\"","'") + "\",\"plannedQty\":" + altPlanS.toDecimal().toLong() + "}";
					}
				}

				bomId = itm.BOM;

				// Fetch BOM Phases. Not read at all for a batch that named its own
				// stages above - the two lists are alternatives, never merged.
				if (bomId != null && altHasRows == false)
				{
					for each bomRec in BOM[ID == bomId]
					{
						for each stage in bomRec.Production_Stages
						{
							if(phasesJson != "") { phasesJson = phasesJson + ","; }
							phasesJson = phasesJson + "{\"sequence\":" + ifnull(stage.Sequence_No,0) + ",\"operation\":\"" + stage.Operation + "\"}";
						}
					}
				}

				// Requirements are keyed on the Plan_Item record now, so this is
				// a direct query rather than filtering a plan-wide list by SKU.
				//
				//------------------------------------------------------------
				// COMBINED PER MATERIAL, CUT SIZE AND SOURCE.
				//
				// TWO RULES AT ONCE, and they pull in opposite directions:
				//
				//  COMBINE within a source. Three damage reports on one thread
				//  put three lines reading 8, 8 and 8 Cone on this table. He is
				//  standing at a table deciding what to lay out - the cones are
				//  one box and the answer he wants is 24. Requests are the
				//  STORE's unit of work, not his.
				//
				//  SEPARATE across sources. The plan's own 80 Cone and the 24 he
				//  asked for after ruining some are not one figure. Added
				//  together the reissue disappears into a number that reads as
				//  always having been planned, and the material he has to account
				//  for stops being visible at all.
				//
				// Cut size is in the key too, because two rows of the same cloth
				// cut to different sizes are genuinely different work and their
				// piece counts are not addable.
				//------------------------------------------------------------
				mAgg = Map();
				mOrder = List();

				for each mrA in Material_Requirement[Plan_Item == itm.ID]
				{
					//------------------------------------------------------
					// STILL WAITING ON CLOTH? Counted in THIS pass rather than
					// in a query of its own.
					//
					// closeAlterationBatch refuses while any requirement is
					// short, so the widget must not offer the button - but this
					// function is already the most expensive in the app and the
					// statement limit is not catchable. The rows are in hand
					// here, so the test is free.
					//
					// Outside the Material != null guard on purpose: a row with
					// no material still represents something owed, and skipping
					// it would let the batch close while the store had an open
					// line against it.
					//------------------------------------------------------
					// THE SAME THREE-PART TEST receiveMaterials and
					// closeAlterationBatch use. FABRIC IS SATISFIED IN CUT
					// PIECES, NOT METRES - a fabric row whose pieces came off
					// offcuts never reaches its Required_Qty in metres and is
					// never meant to, so comparing metres here would grey out
					// the close button FOR EVER on exactly the batches that
					// went best.
					aReqS = ifnull(mrA.Required_Qty,"0").toString().trim();
					if(aReqS == "") { aReqS = "0"; }
					aIssS = ifnull(mrA.Issued_Qty,"0").toString().trim();
					if(aIssS == "") { aIssS = "0"; }
					aRcvS = ifnull(mrA.Received_Qty,"0").toString().trim();
					if(aRcvS == "") { aRcvS = "0"; }

					aRowOpen = false;
					if(aRcvS.toDecimal() < aIssS.toDecimal())
					{
						aRowOpen = true;
					}
					if(ifnull(mrA.Is_Fabric,false) == true)
					{
						aReqPcs = ifnull(mrA.Required_Pieces,0);
						aGotPcs = ifnull(mrA.Pieces_From_Waste,0) + ifnull(mrA.Pieces_From_Raw,0);
						if(aReqPcs <= 0 || aGotPcs < aReqPcs)
						{
							aRowOpen = true;
						}
					}
					else
					{
						if(aIssS.toDecimal() < aReqS.toDecimal())
						{
							aRowOpen = true;
						}
					}
					if(aRowOpen == true)
					{
						altMatShort = altMatShort + 1;
					}

					if(mrA.Material != null)
					{
						// A Creator field never written is EMPTY, not null, so
						// every row planned before Source existed reads "Plan" -
						// which is exactly what those rows are.
						aSrc = ifnull(mrA.Source,"").toString().trim();
						if(aSrc == "")
						{
							aSrc = "Plan";
						}

						aKey = mrA.Material + "|" + ifnull(mrA.Cut_Size_Width,0) + "x" + ifnull(mrA.Cut_Size_Length,0) + "|" + aSrc;

						aCur = mAgg.get(aKey);
						if(aCur == null)
						{
							aCur = Map();
							aCur.put("materialId",mrA.Material + "");
							aCur.put("name",ifnull(mrA.Material_Name,"").toString().replaceAll("\"","'"));
							aCur.put("unit",ifnull(mrA.Unit,"").toString());
							aCur.put("isFabric",ifnull(mrA.Is_Fabric,false));
							aCur.put("cutWidth",ifnull(mrA.Cut_Size_Width,0));
							aCur.put("cutLength",ifnull(mrA.Cut_Size_Length,0));
							aCur.put("received",0.0);
							aCur.put("reqPieces",0);
							aCur.put("fromWaste",0);
							aCur.put("fromRaw",0);

							// Set once, from the key. Every row under this entry
							// has the same source by construction, so there is
							// nothing to accumulate.
							aIsRe = "false";
							if(aSrc == "Reissue")
							{
								aIsRe = "true";
							}
							aCur.put("isReissue",aIsRe);
							mOrder.add(aKey);
						}

						aCur.put("received",aCur.get("received") + ifnull(mrA.Received_Qty,0));
						aCur.put("reqPieces",aCur.get("reqPieces") + ifnull(mrA.Required_Pieces,0));
						aCur.put("fromWaste",aCur.get("fromWaste") + ifnull(mrA.Pieces_From_Waste,0));
						aCur.put("fromRaw",aCur.get("fromRaw") + ifnull(mrA.Pieces_From_Raw,0));

						mAgg.put(aKey,aCur);
					}
				}

				matsJson = "";
				for each aK in mOrder
				{
					mr = mAgg.get(aK);

					if(matsJson != "") { matsJson = matsJson + ","; }
					// Cut detail carried for fabric. The supervisor is about to
					// cut this cloth and the metre figure alone does not tell
					// him what to cut - he needs the piece size and how many.
					// piecesFromWaste / piecesFromRaw carried so the cutting screen
					// can say WHERE the cloth came from. Without them a fabric line
					// reads as one undifferentiated requirement, and the supervisor
					// has no way to tell that half his pieces are coming off
					// offcuts he has to handle differently.
					matsJson = matsJson + "{\"materialId\":\"" + mr.get("materialId") + "\",\"name\":\"" + mr.get("name") + "\",\"received\":" + mr.get("received") + ",\"unit\":\"" + mr.get("unit") + "\",\"isFabric\":" + mr.get("isFabric") + ",\"isWaste\":false,\"isReissue\":" + mr.get("isReissue") + ",\"requiredPieces\":" + mr.get("reqPieces") + ",\"piecesFromWaste\":" + mr.get("fromWaste") + ",\"piecesFromRaw\":" + mr.get("fromRaw") + ",\"cutWidth\":" + mr.get("cutWidth") + ",\"cutLength\":" + mr.get("cutLength") + "}";
				}

				// Waste pieces carry their own Plan_Item now, so no cross-match
				// against the requirement list is needed to find the item's own.
				// STEP 4b: Issued movements keyed on the Plan_Item, so no walk of
				// the plan's subform and no filtering by item afterwards.
				wasteJson = "";
				itemIssued = Waste_Movement[Plan_Item == itm.ID && Movement_Type == "Issued"];

				for each wi in itemIssued
				{
					// Received is summed from the movements pointing back at this
					// issue rather than read off a counter.
					wRecv = 0;
					for each rv in Waste_Movement[Parent_Movement == wi.ID && Movement_Type == "Received"]
					{
						wRecv = wRecv + ifnull(rv.Piece_Count,0);
					}

					// The material comes off the piece the movement points at.
					wName = "Waste";
					wSkuId = null;
					for each wmRec in Waste_Master[ID == wi.Waste_Piece]
					{
						wSkuId = wmRec.SKU;
					}
					for each rmw in Raw_Material[ID == wSkuId]
					{
						rmwName = ifnull(rmw.Material_Display_Name,"").toString().trim();
						if(rmwName == "")
						{
							rmwName = ifnull(rmw.Name,"").toString();
						}
						wName = rmwName.replaceAll("\"","'") + " (Waste)";
					}

					if(wasteJson != "") { wasteJson = wasteJson + ","; }
					// isWaste, the piece's own size, and how many cuts it yields.
					// The row used to carry only a name ending in "(Waste)" and a
					// received count, so on the cutting screen an offcut was
					// indistinguishable from a short delivery of fresh cloth -
					// and the piece he has to lay out was nowhere on the page.
					wasteJson = wasteJson + "{\"materialId\":\"" + wSkuId + "\",\"name\":\"" + wName + "\",\"received\":" + wRecv + ",\"unit\":\"pcs\",\"isFabric\":false,\"isWaste\":true,\"requiredPieces\":0,\"piecesFromWaste\":0,\"piecesFromRaw\":0,\"sent\":" + ifnull(wi.Piece_Count,0) + ",\"pieceWidth\":" + ifnull(wi.Piece_Width,0) + ",\"pieceLength\":" + ifnull(wi.Piece_Length,0) + ",\"yields\":" + ifnull(wi.Pieces_Yielded,0) + ",\"cutWidth\":" + ifnull(wi.Cut_Size_Width,0) + ",\"cutLength\":" + ifnull(wi.Cut_Size_Length,0) + "}";
				}
				
				// Combine mats and waste
				allMatsJson = matsJson;
				if (allMatsJson != "" && wasteJson != "") { allMatsJson = allMatsJson + "," + wasteJson; }
				else if (allMatsJson == "") { allMatsJson = wasteJson; }

				// Stage logs - now their own records, queried by Plan_Item
				// rather than filtered out of a subform by SKU.
				logsJson = "";
				for each trk in Stage_Log[Plan_Item == itm.ID] sort by Sequence_No
				{
					if(logsJson != "") { logsJson = logsJson + ","; }
					opId = "";
					if (trk.Operator != null) {
						opId = trk.Operator;
					}
					//------------------------------------------------------
					// THE SHARES THIS STAGE WAS SPLIT INTO.
					//
					// One row per operator, in the order they were put on the
					// work. A stage nobody has been assigned to sends an empty
					// array, which is also every stage logged before the split
					// existed - so an old finished stage still renders from the
					// header's own operator and figures.
					//
					// "sort by" on its own assignment. Inline in a for-each
					// header it does not reliably parse, and a function that
					// will not save is indistinguishable from one that saved
					// and did nothing.
					//------------------------------------------------------
					stageShares = Stage_Assignment[Stage_Log == trk.ID] sort by Added_Time;

					asgJson = "";
					for each  ag in stageShares
					{
						agOp = "";
						if(ag.Operator != null) { agOp = ag.Operator; }

						//----------------------------------------------------
						// A THIRD PARTY IS A SHARE LIKE ANY OTHER.
						//
						// Its row carries a party instead of an operator, and the
						// dates the pieces left and came back. The widget draws it
						// in the same table as the men - which is the point: a
						// stage split 40 to a vendor and 60 across two operators
						// has one place that says where all 100 are.
						//
						// `party` empty is an ordinary operator share. Nothing is
						// inferred from the operator being empty instead, because
						// a stage opened before anyone was put on it has neither.
						//----------------------------------------------------
						agParty = "";
						if(ag.Third_Party != null) { agParty = ag.Third_Party; }
						agSent = "";
						if(ag.Sent_On != null) { agSent = ag.Sent_On.toString("dd-MMM-yyyy"); }
						agBack = "";
						if(ag.Returned_On != null) { agBack = ag.Returned_On.toString("dd-MMM-yyyy"); }

						//----------------------------------------------------
						// REMARKS IS A MULTI LINE FIELD, SO IT IS FLATTENED
						// BEFORE IT GOES INTO JSON.
						//
						// A raw newline inside a JSON string literal is not an
						// escaping nicety - it is invalid JSON, and the widget
						// gets "bad control character in string literal" with a
						// column number and nothing else. Nothing on the Deluge
						// side fails, so there is no error card and no 9430
						// either; the whole tab simply will not parse.
						//
						// Two writers put newlines in here and BOTH are correct
						// to: sendToThirdParty stores what the supervisor typed
						// into a textarea, and receiveFromThirdParty appends its
						// return note under it with a "\n" so the field reads as
						// a log in Creator. The record keeps its line breaks -
						// only the copy crossing JSON is flattened, because a
						// JSON string is a single line by definition.
						//
						// " | " rather than a space: several appended notes run
						// into one unreadable sentence otherwise.
						//----------------------------------------------------
						agRemTxt = ifnull(ag.Remarks,"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");

						if(asgJson != "") { asgJson = asgJson + ","; }
						asgJson = asgJson + "{\"id\":\"" + ag.ID + "\",\"operator\":\"" + agOp + "\",\"party\":\"" + agParty + "\",\"osRef\":\"" + ifnull(ag.Outsource_Ref,"").toString().replaceAll("\"","'") + "\",\"sentOn\":\"" + agSent + "\",\"returnedOn\":\"" + agBack + "\",\"assigned\":" + ifnull(ag.Assigned_Qty,0) + ",\"qtyOut\":" + ifnull(ag.Qty_Out,0) + ",\"start\":\"" + ifnull(ag.Start_Time,"") + "\",\"end\":\"" + ifnull(ag.End_Time,"") + "\",\"status\":\"" + ifnull(ag.Assignment_Status,"") + "\",\"remarks\":\"" + agRemTxt + "\"}";
					}

					// Outsourcing rides on the SAME stage row. A stage sent out is
					// still one stage - it has a start, an end, a Qty_In and a
					// Qty_Out - so a second record would have duplicated all of
					// that to add three fields.
					trkParty = "";
					if(trk.Third_Party != null) { trkParty = trk.Third_Party; }
					trkSent = "";
					if(trk.Sent_On != null) { trkSent = trk.Sent_On.toString("dd-MMM-yyyy"); }
					trkBack = "";
					if(trk.Returned_On != null) { trkBack = trk.Returned_On.toString("dd-MMM-yyyy"); }

					// Flattened for the same reason as the share's remarks above -
					// saveProductionPhase and receiveFromThirdParty both write
					// newlines into this one. Phase_Name is a picklist value, not
					// typed, so it is left alone.
					trkRemTxt = ifnull(trk.Remarks,"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");

					logsJson = logsJson + "{\"id\":\"" + trk.ID + "\",\"phase\":\"" + trk.Phase_Name + "\",\"operator\":\"" + opId + "\",\"assigns\":[" + asgJson + "],\"outsourced\":" + ifnull(trk.Is_Outsourced,false) + ",\"party\":\"" + trkParty + "\",\"sentOn\":\"" + trkSent + "\",\"outsourceRef\":\"" + ifnull(trk.Outsource_Ref,"").toString().replaceAll("\"","'") + "\",\"returnedOn\":\"" + trkBack + "\",\"start\":\"" + ifnull(trk.Start_Time,"") + "\",\"end\":\"" + ifnull(trk.End_Time,"") + "\",\"qtyIn\":" + ifnull(trk.Qty_In,0) + ",\"qtyOut\":" + ifnull(trk.Qty_Out,0) + ",\"status\":\"" + ifnull(trk.Stage_Status,"") + "\",\"remarks\":\"" + trkRemTxt + "\"}";
				}

				//------------------------------------------------------------
				// EXPECTED WASTE, THE ARITHMETIC ONLY.
				//
				// production.js used to fire getExpectedWaste once per visible
				// item on render - ~110 POSTs on a Faire order, most of them
				// bounced 429 by Creator's per-minute cap. Folded in here so a
				// page of 10 items costs zero extra calls.
				//
				// THIS IS NOT THE WHOLE OF getExpectedWaste. That function also
				// resolves which LOT each remnant goes back to, which means
				// walking Material_Issue and its Issue_Lines subform and
				// Raw_Material_Lot - the heavy part, and the reason it could not
				// simply be looped. The inline "Expected waste" cell renders
				// only count / length x width (production.js), so NONE of the
				// lot machinery is needed here. The cutting-waste DIALOG still
				// calls the standalone getExpectedWaste, which still does all of
				// it - fresh cloth is treated as one continuous block for the
				// prediction cell, and the exact per-lot split stays in the
				// dialog.
				//
				// Grain is fixed: cut width across the piece width, cut length
				// along its length, never rotated. Same two passes as
				// getExpectedWaste - the received waste pieces first, then fresh
				// fabric for whatever they did not cover.
				expWasteJson = "";
				expPcsCut = ifnull(itm.Qty_Ordered,0);

				for each  ewK in mOrder
				{
					ewM = mAgg.get(ewK);
					if(ewM.get("isFabric") == true && expPcsCut > 0)
					{
						ewMatId = ewM.get("materialId");
						ewCutW = ewM.get("cutWidth");
						ewCutL = ewM.get("cutLength");

						ewFabWcm = 0.0;
						for each  ewRm in Raw_Material[ID == ewMatId.toLong()]
						{
							// Stored as TEXT, in inches.
							ewWv = ewRm.Fabric_Width_Inches;
							if(ewWv != null && ewWv.trim() != "")
							{
								ewFabWcm = ewWv.trim().toDecimal() * 2.54;
							}
						}

						if(ewCutW > 0 && ewCutL > 0 && ewFabWcm > 0)
						{
							ewGen = "";
							ewRemain = expPcsCut;

							//--------------------------------------------------
							// Pass 1 - the waste pieces he actually received.
							// itemIssued was already fetched above for wasteJson.
							//--------------------------------------------------
							for each  ewWi in itemIssued
							{
								ewAvail = 0;
								for each  ewRv in Waste_Movement[Parent_Movement == ewWi.ID && Movement_Type == "Received"]
								{
									ewAvail = ewAvail + ifnull(ewRv.Piece_Count,0);
								}

								ewWMat = "";
								for each  ewWmRec in Waste_Master[ID == ewWi.Waste_Piece]
								{
									ewWMat = ifnull(ewWmRec.SKU,"").toString();
								}

								ewPieceW = ifnull(ewWi.Piece_Width,0);
								ewPieceL = ifnull(ewWi.Piece_Length,0);

								if(ewRemain > 0 && ewAvail > 0 && ewWMat == ewMatId.toString() && ewPieceW >= ewCutW && ewPieceL >= ewCutL)
								{
									ewPerRow = (ewPieceW / ewCutW).floor();
									ewMaxRows = (ewPieceL / ewCutL).floor();
									ewCap = ewPerRow * ewMaxRows;
									ewSideW = ewPieceW - (ewPerRow * ewCutW);

									ewFull = (ewRemain / ewCap).floor();
									if(ewFull > ewAvail) { ewFull = ewAvail; }
									if(ewFull > 0)
									{
										ewUsedLen = ewMaxRows * ewCutL;
										if(ewSideW > 0)
										{
											if(ewGen != "") { ewGen = ewGen + ","; }
											ewGen = ewGen + "{\"count\":" + ewFull + ",\"length\":" + ewUsedLen + ",\"width\":" + ewSideW + "}";
										}
										ewFullTail = ewPieceL - ewUsedLen;
										if(ewFullTail > 0)
										{
											if(ewGen != "") { ewGen = ewGen + ","; }
											ewGen = ewGen + "{\"count\":" + ewFull + ",\"length\":" + ewFullTail + ",\"width\":" + ewPieceW + "}";
										}
										ewRemain = ewRemain - (ewFull * ewCap);
										ewAvail = ewAvail - ewFull;
									}

									if(ewRemain > 0 && ewAvail > 0)
									{
										ewTake = ewRemain;
										ewPartRows = (ewTake / ewPerRow).floor();
										ewLastRow = ewTake - (ewPartRows * ewPerRow);
										ewRows = ewPartRows;
										if(ewLastRow > 0) { ewRows = ewRows + 1; }
										ewLenUsed = ewRows * ewCutL;

										if(ewPartRows > 0 && ewSideW > 0)
										{
											if(ewGen != "") { ewGen = ewGen + ","; }
											ewGen = ewGen + "{\"count\":1,\"length\":" + (ewPartRows * ewCutL) + ",\"width\":" + ewSideW + "}";
										}
										if(ewLastRow > 0)
										{
											ewPartW = ewPieceW - (ewLastRow * ewCutW);
											if(ewPartW > 0)
											{
												if(ewGen != "") { ewGen = ewGen + ","; }
												ewGen = ewGen + "{\"count\":1,\"length\":" + ewCutL + ",\"width\":" + ewPartW + "}";
											}
										}
										ewTailL = ewPieceL - ewLenUsed;
										if(ewTailL > 0)
										{
											if(ewGen != "") { ewGen = ewGen + ","; }
											ewGen = ewGen + "{\"count\":1,\"length\":" + ewTailL + ",\"width\":" + ewPieceW + "}";
										}
										ewRemain = 0;
									}
								}
							}

							//--------------------------------------------------
							// Pass 2 - fresh fabric for whatever is left, as one
							// continuous block (the per-lot split is dialog-only).
							//--------------------------------------------------
							if(ewRemain > 0)
							{
								ewPerRowR = (ewFabWcm / ewCutW).floor();
								if(ewPerRowR > 0)
								{
									ewSideWR = ewFabWcm - (ewPerRowR * ewCutW);
									ewFullRowsR = (ewRemain / ewPerRowR).floor();
									ewLastRowR = ewRemain - (ewFullRowsR * ewPerRowR);

									if(ewFullRowsR > 0 && ewSideWR > 0)
									{
										if(ewGen != "") { ewGen = ewGen + ","; }
										ewGen = ewGen + "{\"count\":1,\"length\":" + (ewFullRowsR * ewCutL) + ",\"width\":" + ewSideWR + "}";
									}
									if(ewLastRowR > 0)
									{
										ewPartWR = ewFabWcm - (ewLastRowR * ewCutW);
										if(ewPartWR > 0)
										{
											if(ewGen != "") { ewGen = ewGen + ","; }
											ewGen = ewGen + "{\"count\":1,\"length\":" + ewCutL + ",\"width\":" + ewPartWR + "}";
										}
									}
									ewRemain = 0;
								}
							}

							if(expWasteJson != "") { expWasteJson = expWasteJson + ","; }
							expWasteJson = expWasteJson + "{\"materialId\":\"" + ewMatId + "\",\"waste\":[" + ewGen + "]}";
						}
					}
				}

				if(itemsJson != "") { itemsJson = itemsJson + ","; }
				// isRemake carried so the card can say so. A supervisor handed
				// cloth for something he already finished deserves to be told it
				// is a QC remake rather than left to wonder.
				//------------------------------------------------------------
				// THE TWO FLAGS THE ALTERATION CARD IS DRAWN FROM.
				//
				// isAlteration decides whether the card renders as a batch at
				// all - only its named stages, a "Request material" action, and
				// no Qty_Out box on any stage.
				//
				// canCloseAlteration decides only whether the CLOSE button is
				// enabled. closeAlterationBatch re-tests both conditions itself
				// and returns STAGES_OPEN or MATERIAL_PENDING, because it is a
				// Custom API and callable from anywhere - this flag is the
				// courtesy of not offering a button that would be refused.
				//------------------------------------------------------------
				isAltTxt = "false";
				canCloseTxt = "false";
				if(altHasRows == true)
				{
					isAltTxt = "true";
					if(altOpen == 0 && altMatShort == 0)
					{
						canCloseTxt = "true";
					}
				}

				itemsJson = itemsJson + "{\"id\":\"" + itm.ID + "\",\"sku\":\"" + sku + "\",\"name\":\"" + itm.Item_Name + "\",\"qty\":" + ifnull(itm.Qty_Ordered,0) + ",\"status\":\"" + ifnull(itm.Item_Status,"") + "\",\"produced\":" + ifnull(itm.Qty_Produced,0) + ",\"isRemake\":" + ifnull(itm.Is_Remake,false) + ",\"remakeReason\":\"" + ifnull(itm.Remake_Reason,"").toString().trim() + "\",\"isAlteration\":" + isAltTxt + ",\"canCloseAlteration\":" + canCloseTxt + ",\"phases\":[" + phasesJson + "],\"materials\":[" + allMatsJson + "],\"logs\":[" + logsJson + "],\"expectedWaste\":{\"fabrics\":[" + expWasteJson + "]}}";
				}
			}

			// Formatted here rather than in the widget - a raw Creator date
			// crossing JSON is one more thing to parse and get wrong.
			planDateTxt = "";
			if(plan.Plan_Start_Date != null)
			{
				planDateTxt = plan.Plan_Start_Date.toString("dd-MMM-yyyy");
			}

			// itemStats and the paging figures are only meaningful on the
			// focused plan - every other row's stat scan never ran, so they are
			// zero and the widget must not read them. hasDetail already tells it
			// which row is the real one.
			statsJson = "{\"count\":" + statCount + ",\"toProduce\":" + statToProduce + ",\"produced\":" + statProduced + ",\"doneCount\":" + statDone + ",\"remakeQty\":" + statRemake + "}";

			if(plansJson != "") { plansJson = plansJson + ","; }
			plansJson = plansJson + "{\"id\":\"" + plan.ID + "\",\"planNo\":\"" + plan.Plan_No + "\",\"salesOrder\":\"" + soNo + "\",\"planDate\":\"" + planDateTxt + "\",\"orderStatus\":\"" + ifnull(plan.Order_Status,"") + "\",\"assignedTo\":\"" + ifnull(plan.Assigned_To,"") + "\",\"hasDetail\":" + hasDetail + ",\"itemStats\":" + statsJson + ",\"itemTotal\":" + itemTotal + ",\"itemSkip\":" + itemSkipOut + ",\"itemLimit\":" + pgLimit + ",\"items\":[" + itemsJson + "]}";
		}
	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}

	return "{\"errors\":[],\"plans\":[" + plansJson + "],\"operators\":[" + empsJson + "],\"supervisors\":[" + supsJson + "],\"parties\":[" + partyJson + "]}";
}
