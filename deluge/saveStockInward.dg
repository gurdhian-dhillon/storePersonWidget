string saveStockInward(string inwardJson)
{
	// Store person books arriving cloth into a lot.
	//
	//   { "materialId":"123",
	//     "lotId":"901",            // empty => create a new lot
	//     "lotNumber":"L3",         // new lot only - TYPED, and must be unique
	//     "lotLabel":"darker roll", // new lot only
	//     "rolls":[ {"label":"L3-R1","length":38}, {"label":"L3-R2","length":42} ],
	//     "remarks":"" }
	//
	// ROLLS, NOT A LUMP QUANTITY. lot-rolls-model.md Step 6. Arriving cloth is
	// physical rolls landing on the shelf, and cutting instructions are per roll
	// - a lump metres figure with no roll behind it cannot be issued at all under
	// the rolls model. So the payload now carries the rolls themselves, TYPED by
	// the store person (he reads the label off the physical roll), and AT LEAST
	// ONE IS REQUIRED - there is no "amount with no roll" any more. qty is
	// derived as their sum; nothing is booked by lump sum any longer.
	//
	// EACH ROLL'S LABEL MUST BE UNIQUE WITHIN THE LOT - same rule as the lot
	// number, checked here even though the widget already checks it on blur
	// against getStoreLots' rollLabels, because a Custom API is callable from
	// anywhere and stale client data must not be trusted to enforce it.
	//
	// THE LOT HOLDS THE TRUTH, Raw_Material HOLDS A MAINTAINED TOTAL. Both are
	// written here, in one pass, so they cannot disagree. The parent is not a
	// derived roll-up on purpose: recomputing a sum per material on every screen
	// load is a query per material, and that is the road to the statement limit.
	//
	// FABRIC ONLY. An accessory has no lots and must not get one - its Quantity is
	// its stock exactly as before.
	//
	// ONE EXIT, AT THE BOTTOM, and it is not a style choice. Deluge's "all paths
	// return" check does NOT count a return that lives inside try/catch, so a
	// function whose every return sat in the try failed to save with
	// "Missing return statement" reported against line 3 - the first line of the
	// body, nowhere near anything actually wrong. So nothing returns early:
	// errTxt is set, every later block is guarded on it being empty, and the one
	// return is after the catch. Same shape as issueMaterials.

	res = "";
	errTxt = "";

	try
	{
		inp = inwardJson.toMap();

		matId = ifnull(inp.get("materialId"),"").toString().trim();
		lotId = ifnull(inp.get("lotId"),"").toString().trim();
		// Escaped here, once, so the uniqueness test below compares like with
		// like: what is stored and what is checked have been through the same
		// transformation.
		lotNumIn = ifnull(inp.get("lotNumber"),"").toString().trim().replaceAll("\"","'");
		lotLabel = ifnull(inp.get("lotLabel"),"").toString().trim().replaceAll("\"","'");
		remarks = ifnull(inp.get("remarks"),"").toString().trim().replaceAll("\"","'");

		// ARRIVING CLOTH IS ALWAYS UNWASHED. There is no choice on the screen and
		// no choice here: fabric is bought greige and washed in-house, so booking
		// it in as washed would be claiming a step that never happened - and it
		// is washing that shifts the tone, which is the whole reason lots exist.
		//
		// The only way into Wash_Quantity is the wash flow. A "state" in the
		// payload from an older widget is ignored rather than honoured.
		state = "Unwash";

		//------------------------------------------------------------------
		// THE ROLLS. AT LEAST ONE IS REQUIRED - stock with no roll behind it
		// cannot be cut under the rolls model, so there is no "amount with
		// no roll" input path any more. Each entry needs a label (typed by
		// the store person, off the physical roll) and a length > 0. qty is
		// their sum - it drives the existing Wash/Unwash + parent-total
		// arithmetic below unchanged.
		//------------------------------------------------------------------
		rollsIn = ifnull(inp.get("rolls"),"[]").toString().toJSONList();

		qty = 0.0;
		rollLabelsIn = List();

		for each  rlRaw in rollsIn
		{
			rlM = rlRaw.toMap();
			rlLbl = ifnull(rlM.get("label"),"").toString().trim().replaceAll("\"","'");
			rlLenS = ifnull(rlM.get("length"),"0").toString().trim();
			if(rlLenS == "")
			{
				rlLenS = "0";
			}
			rlLen = rlLenS.toDecimal();

			if(errTxt == "" && rlLbl == "")
			{
				errTxt = "Every roll needs a label";
			}
			if(errTxt == "" && rlLen <= 0)
			{
				errTxt = "Roll " + rlLbl + " needs a length greater than zero";
			}

			// DUPLICATE WITHIN THIS SUBMISSION. Checked upper-cased and
			// trimmed, same as the lot-number clash below - "l3-r1" beside
			// "L3-R1" would read as two different rolls on screen when it
			// is not.
			if(errTxt == "")
			{
				rlKey = rlLbl.toUpperCase();
				dupHere = false;
				for each  seenLbl in rollLabelsIn
				{
					if(seenLbl == rlKey)
					{
						dupHere = true;
					}
				}
				if(dupHere == true)
				{
					errTxt = "Roll " + rlLbl + " is entered twice";
				}
			}

			if(errTxt == "")
			{
				rollLabelsIn.add(rlLbl.toUpperCase());
				qty = qty + rlLen;
			}
		}

		if(errTxt == "" && rollsIn.size() == 0)
		{
			errTxt = "At least one roll is required";
		}

		if(errTxt == "" && matId == "")
		{
			errTxt = "No material given";
		}
		if(errTxt == "" && qty <= 0)
		{
			errTxt = "Quantity must be more than zero";
		}

		// Initialised BEFORE the guarded blocks. A name first assigned inside an
		// if is not safe to read after it when that branch did not run.
		matName = "";
		isFab = false;
		unallocHave = 0.0;
		// Width1, cm - seeded onto a NEW lot below, same formula seedLotRolls.dg
		// uses (Fabric_Width_Inches x 2.54). Fetched here, in the point lookup
		// this function already does per material, rather than a second one.
		widthCm = 0.0;

		if(errTxt == "")
		{
			// A query result needs .count() - .size() is a List method.
			matRecs = Raw_Material[ID == matId.toLong()];
			if(matRecs.count() == 0)
			{
				errTxt = "Material not found";
			}
			else
			{
				for each  rmChk in matRecs
				{
					matName = ifnull(rmChk.SKU,"").toString().replaceAll("\"","'");

					// Tested AS TEXT. A Decision box gives a boolean, a yes/no
					// dropdown gives the string "Yes", an untouched field gives
					// EMPTY - and comparing any of the last two against the
					// boolean true is silently false, which would refuse stock
					// for a material that really is fabric.
					fabTxt = ifnull(rmChk.Is_Fabric,"").toString().trim().toLowerCase();
					isFab = false;
					if(fabTxt == "true" || fabTxt == "yes" || fabTxt == "1" || fabTxt == "y")
					{
						isFab = true;
					}

					uaS = ifnull(rmChk.Unallocated_Qty,"0").toString().trim();
					if(uaS == "")
					{
						uaS = "0";
					}
					unallocHave = uaS.toDecimal();

					wiTxt = ifnull(rmChk.Fabric_Width_Inches,"").toString().trim();
					if(wiTxt != "" && wiTxt.isNumber() == true)
					{
						widthCm = wiTxt.toDecimal() * 2.54;
					}
				}
			}
		}

		if(errTxt == "" && isFab != true)
		{
			errTxt = matName + " is not a fabric - lots apply to fabric only";
		}

		//--------------------------------------------------------------------
		// Which lot. An existing one has to belong to THIS material and be
		// Active; a blocked lot is quarantined and must not quietly grow.
		//--------------------------------------------------------------------
		targetLot = 0;
		lotNumOut = "";

		if(errTxt == "")
		{
			if(lotId != "")
			{
				lotRecs = Raw_Material_Lot[ID == lotId.toLong()];
				if(lotRecs.count() == 0)
				{
					errTxt = "Lot not found";
				}
				else
				{
					for each  lchk in lotRecs
					{
						if(ifnull(lchk.Material,"").toString().trim() != matId)
						{
							errTxt = "That lot belongs to a different material";
						}
						else if(ifnull(lchk.Status,"Active").toString().trim() == "Blocked")
						{
							errTxt = "That lot is blocked and cannot take stock";
						}
						else
						{
							targetLot = lchk.ID;
							lotNumOut = ifnull(lchk.Lot_Number,"").toString().replaceAll("\"","'");
						}
					}
				}
			}
			else
			{
				//------------------------------------------------------------
				// NEW LOT. The number is TYPED by the store person - it is his
				// label for a tone he can see, and no rule we invent would match
				// what he writes on the roll.
				//
				// UNIQUE WITHIN THE MATERIAL, not globally. Two different fabrics
				// may both sensibly have a lot "1"; forbidding that would make him
				// invent numbers to dodge collisions with cloth he is not even
				// looking at. Within one material it must be unique or every later
				// reference is ambiguous - which lot did that offcut come from.
				//
				// Compared UPPER-CASED and trimmed, so "l1" cannot slip in beside
				// "L1" and read as a different lot on screen when it is not.
				//------------------------------------------------------------
				if(lotNumIn == "")
				{
					errTxt = "Give the new lot a number";
				}
				else
				{
					wantKey = lotNumIn.toUpperCase();
					clash = false;

					for each  lseq in Raw_Material_Lot[Material == matId.toLong()]
					{
						lnTxt = ifnull(lseq.Lot_Number,"").toString().trim().toUpperCase();
						if(lnTxt == wantKey)
						{
							// No reliable break in Deluge - the loop runs on and
							// the flag carries the answer out.
							clash = true;
						}
					}

					if(clash == true)
					{
						errTxt = "Lot " + lotNumIn + " already exists for " + matName;
					}
					else
					{
						lotNumOut = lotNumIn;

						newLotId = insert into Raw_Material_Lot
						[
							Material=matId.toLong()
							Lot_Number=lotNumOut
							Lot_Label=lotLabel
							Unwash_Quantity=0
							Wash_Quantity=0
							In_Transit_Qty=0
							Disputed_Qty=0
							Status="Active"
							Remarks=remarks
							Width1=widthCm
						];
						targetLot = newLotId.toLong();
						info "new lot " + lotNumOut + " for " + matName + " id=" + targetLot;
					}
				}
			}
		}

		if(errTxt == "" && targetLot == 0)
		{
			errTxt = "Could not resolve a lot to book against";
		}

		//------------------------------------------------------------------
		// ROLL LABELS VS WHAT IS ALREADY ON THIS LOT. A brand-new lot has
		// none to clash with, so this only ever fires on the existing-lot
		// path - but it is not gated on that, it simply finds nothing to
		// clash with there. The widget already checked this on blur against
		// getStoreLots' rollLabels; this is the same rule enforced server-
		// side, because a Custom API is callable from anywhere and stale
		// client data must not be trusted alone.
		//------------------------------------------------------------------
		if(errTxt == "" && targetLot != 0)
		{
			for each  lotChkRoll in Raw_Material_Lot[ID == targetLot]
			{
				for each  exRollChk in lotChkRoll.Lot_Rolls
				{
					exLbl = ifnull(exRollChk.Roll_Label,"").toString().trim().toUpperCase();
					if(exLbl != "")
					{
						for each  newLbl in rollLabelsIn
						{
							if(newLbl == exLbl)
							{
								errTxt = "Roll " + exLbl + " already exists on this lot";
							}
						}
					}
				}
			}
		}

		if(errTxt == "")
		{
			//----------------------------------------------------------------
			// THE INVENTORY SEAM, and it is a no-op today.
			//
			// Unallocated_Qty is always 0 until the Zoho Inventory sync exists,
			// so fromNew below is always the whole quantity and the parent total
			// rises with the lot - which is what booking new cloth into Creator
			// means now.
			//
			// Once the sync lands, a purchase receipt raises the PARENT total
			// before anyone has been to the rack, and the difference sits in
			// Unallocated_Qty waiting to be given a tone. Booking that cloth into
			// a lot must NOT raise the parent again - it is already counted. So
			// the split: whatever this quantity can take out of Unallocated_Qty
			// is a move, and only the remainder is genuinely new stock.
			//
			// Handling both at once means the seam needs no second code path
			// later, and a part-allocated arrival does not need one either.
			//----------------------------------------------------------------
			fromUnalloc = qty;
			if(fromUnalloc > unallocHave)
			{
				fromUnalloc = unallocHave;
			}
			if(fromUnalloc < 0)
			{
				fromUnalloc = 0;
			}
			fromNew = qty - fromUnalloc;

			lotUnwashOut = 0.0;
			lotWashOut = 0.0;

			for each  lotRec in Raw_Material_Lot[ID == targetLot]
			{
				lcuS = ifnull(lotRec.Unwash_Quantity,"0").toString().trim();
				if(lcuS == "")
				{
					lcuS = "0";
				}
				lcwS = ifnull(lotRec.Wash_Quantity,"0").toString().trim();
				if(lcwS == "")
				{
					lcwS = "0";
				}

				if(state == "Wash")
				{
					lotRec.Wash_Quantity = lcwS.toDecimal() + qty;
					lotUnwashOut = lcuS.toDecimal();
					lotWashOut = lcwS.toDecimal() + qty;
				}
				else
				{
					lotRec.Unwash_Quantity = lcuS.toDecimal() + qty;
					lotUnwashOut = lcuS.toDecimal() + qty;
					lotWashOut = lcwS.toDecimal();
				}

				//------------------------------------------------------------
				// THE ROLLS THEMSELVES, lot-rolls-model.md Step 6. One row per
				// entry the store person typed - never a lump qty row. A roll
				// has no wash state (washing follows the CUT, not the roll -
				// see the doc's "what washing does to a roll"), so these are
				// written for BOTH Wash and Unwash bookings alike: either way,
				// these are physical rolls that just landed and need to be
				// cuttable.
				//
				// Labels are ALREADY UPPER-CASED in rollLabelsIn (from the
				// clash checks above) - stored as typed instead, from a
				// second pass over the raw payload, so the record on the
				// rack reads exactly what he wrote, not a normalised copy.
				//------------------------------------------------------------
				for each  rlRaw2 in rollsIn
				{
					rlM2 = rlRaw2.toMap();
					rlLblOut = ifnull(rlM2.get("label"),"").toString().trim().replaceAll("\"","'");
					rlLenOutS = ifnull(rlM2.get("length"),"0").toString().trim();
					if(rlLenOutS == "")
					{
						rlLenOutS = "0";
					}
					rlLenOut = rlLenOutS.toDecimal();

					newRollRow = Raw_Material_Lot.Lot_Rolls();
					newRollRow.Roll_Label = rlLblOut;
					newRollRow.Roll_Length = rlLenOut;
					newRollRow.Roll_Status = "Available";
					newRollRow.Origin = "Purchased";
					newRollRow.Source_Receipt = "INWARD";
					lotRec.Lot_Rolls.insert(newRollRow);
				}
			}

			matUnwashOut = 0.0;
			matWashOut = 0.0;

			for each  rmUpd in Raw_Material[ID == matId.toLong()]
			{
				mcuS = ifnull(rmUpd.Unwash_Quantity,"0").toString().trim();
				if(mcuS == "")
				{
					mcuS = "0";
				}
				mcwS = ifnull(rmUpd.Wash_Quantity,"0").toString().trim();
				if(mcwS == "")
				{
					mcwS = "0";
				}

				// THE WHOLE qty LANDS ON THE STATE COUNTER, same as the lot
				// above - fromNew/fromUnalloc only decide how much of it came
				// OUT OF Unallocated_Qty, never how much reaches Wash/Unwash.
				// Crediting fromNew alone left a pure Unallocated->lot move
				// (fromUnalloc == qty, fromNew == 0) adding nothing here: the
				// metres landed on the lot's roll but no parent counter ever
				// held them, so Quantity (Wash+Unwash+Unallocated) fell short
				// of the rack by exactly the moved amount.
				if(state == "Wash")
				{
					rmUpd.Wash_Quantity = mcwS.toDecimal() + qty;
					matUnwashOut = mcuS.toDecimal();
					matWashOut = mcwS.toDecimal() + qty;
				}
				else
				{
					rmUpd.Unwash_Quantity = mcuS.toDecimal() + qty;
					matUnwashOut = mcuS.toDecimal() + qty;
					matWashOut = mcwS.toDecimal();
				}

				if(fromUnalloc > 0)
				{
					rmUpd.Unallocated_Qty = unallocHave - fromUnalloc;
				}
				qA = ifnull(rmUpd.Unallocated_Qty,"0").toString().trim();
				rmUpd.Quantity = matWashOut + matUnwashOut + if(qA=="",0.0,qA.toDecimal());
			}

			// Ids forced to string - 18-digit ids break JSON.parse on the widget.
			res = "{\"success\":true,\"lotId\":\"" + targetLot + "\",\"lotNumber\":\"" + lotNumOut + "\",\"material\":\"" + matName + "\",\"state\":\"" + state + "\",\"added\":" + qty + ",\"lotUnwash\":" + lotUnwashOut + ",\"lotWash\":" + lotWashOut + ",\"materialUnwash\":" + matUnwashOut + ",\"materialWash\":" + matWashOut + ",\"fromUnallocated\":" + fromUnalloc + "}";
		}
	}
	catch (e)
	{
		// Creator reports every runtime failure to a widget as a generic code 9430,
		// so the real message has to travel back inside the payload.
		errTxt = "DELUGE: " + e.toString();
	}

	if(res == "")
	{
		if(errTxt == "")
		{
			errTxt = "Nothing was booked";
		}
		res = "{\"success\":false,\"error\":\"" + errTxt.replaceAll("\"","'") + "\"}";
	}

	return res;
}
