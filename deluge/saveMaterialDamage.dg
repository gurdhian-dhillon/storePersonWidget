string saveMaterialDamage(string payloadJson)
{
	// Records material the supervisor ruined during production, and what he wants
	// replaced. Writes a DRAFT - nothing reaches the store until he raises it
	// from the Reissue tab.
	//
	// Custom API, POST, one argument: payloadJson.
	//   { "planId":"1", "planItemId":"9", "supervisorId":"5",
	//     "stageLogId":"", "phaseName":"Cutting",
	//     "damagedPieces":"3", "note":"needle cut through 3 panels",
	//     "lines":[ {"matId":"11","name":"Linen / Sylph Green","unit":"Mtr",
	//                "isFab":true,"qty":1.2,"pieces":3,
	//                "cutLen":55,"cutWid":40,"reissue":true} ] }
	//
	// WHY A DRAFT AND NOT A REQUIREMENT STRAIGHT AWAY. Material_Requirement is
	// read by getStoreMaterialRequirements, issueMaterials, getStoreCounts and
	// the offcut allocator. A "draft" status on it would have to be filtered out
	// of every one of them, and a single missed filter turns an un-raised draft
	// into phantom demand on the store's issue screen. A separate form cannot
	// leak: raising is the only thing that ever creates a requirement, and it is
	// one-way.
	//
	// TWO INDEPENDENT FACTS PER REPORT, and conflating them was the mistake this
	// form exists to avoid:
	//   Damaged_Pieces - garments/panels spoiled. Can be 0: a wash care label
	//                    torn while being attached ruins no garment at all, and
	//                    that case is most of what this is for.
	//   Damage_Lines   - material gone. Also stands alone.
	// Hanging material damage off a piece loss would miss every label, cone and
	// elastic ruined without spoiling a garment.
	//
	// Needs a form called Material_Damage with these link names:
	//   Plan             Lookup   -> Production_Planning
	//   Plan_Item        Lookup   -> Plan_Item
	//   Item_Name        Single Line
	//   Sales_Order_No   Single Line
	//   Supervisor       Lookup   -> Employee
	//   Stage_Log        Lookup   -> Stage_Log        (optional)
	//   Phase_Name       Single Line                  (optional)
	//   Damaged_Pieces   Number
	//   Damage_Reason    Single Line
	//   Note             Multi Line
	//   Reported_On      Date
	//   Status           Dropdown - Open / Closed     (default Open)
	//   Damage_Lines     Subform  - Material (Lookup -> Raw_Material),
	//                               Material_Name, Unit  (Single Line)
	//                               Is_Fabric            (Decision box)
	//                               Damaged_Qty          (Decimal)
	//                               Damaged_Pieces       (Number)
	//                               Cut_Size_Length      (Number)
	//                               Cut_Size_Width       (Number)
	//                               Reissue_Status       (Dropdown -
	//                                   Pending / Requested / Not_Needed)
	//                               Requirement          (Lookup ->
	//                                   Material_Requirement)
	//
	// Item_Name and Sales_Order_No are DENORMALISED on purpose. The Reissue tab
	// lists drafts across every plan he is on; resolving each one through
	// Plan_Item -> Plan -> Sales_Order would be three queries per row, and the
	// statement-execution limit is not catchable - it kills the script and the
	// widget sees a bare 500 with no error card.

	res = "{\"success\":false,\"error\":\"Nothing was saved\"}";

	try
	{
	inp = payloadJson.toMap();

	itemIdTxt = ifnull(inp.get("planItemId"),"").toString().trim();
	if(itemIdTxt == "" || itemIdTxt.isNumber() == false)
	{
		return "{\"success\":false,\"error\":\"Missing or non-numeric planItemId\"}";
	}
	itemId = itemIdTxt.toLong();

	planIdTxt = ifnull(inp.get("planId"),"").toString().trim();
	supIdTxt = ifnull(inp.get("supervisorId"),"").toString().trim();
	stageIdTxt = ifnull(inp.get("stageLogId"),"").toString().trim();
	phaseTxt = ifnull(inp.get("phaseName"),"").toString().trim();
	noteTxt = ifnull(inp.get("note"),"").toString();
	reasonTxt = ifnull(inp.get("reason"),"").toString().trim();

	// Creator fields that were never written are EMPTY, not null.
	dpStr = ifnull(inp.get("damagedPieces"),"0").toString().trim();
	if(dpStr == "")
	{
		dpStr = "0";
	}
	damagedPieces = dpStr.toDecimal().toLong();
	if(damagedPieces < 0)
	{
		damagedPieces = 0;
	}

	// Does he intend to make these pieces again?
	//
	// STILL READ, NEVER ACTED ON. "needsRemake" was the supervisor saying whether
	// the lost pieces should be made again, and answering it wrongly - or closing
	// the dialog before reaching it - was one of the three ways an order ended
	// short. coverProductionLoss decides that now, from the stage logs, and there
	// is no way to decline it.
	//
	// The field is accepted and echoed back rather than rejected, so a widget that
	// has not been re-uploaded yet still saves its damage report instead of
	// failing on an argument the server no longer wants.
	wantRemake = ifnull(inp.get("needsRemake"),false);
	remakeWanted = false;
	if(wantRemake == true || wantRemake.toString() == "true")
	{
		remakeWanted = true;
	}

	linesRaw = ifnull(inp.get("lines"),list());

	// size() is right - linesRaw is a List, not a query result.
	if(linesRaw.size() == 0 && damagedPieces == 0)
	{
		return "{\"success\":false,\"error\":\"Nothing to record - no pieces and no material\"}";
	}

	//----------------------------------------------------------------------
	// The names shown on the Reissue tab, resolved ONCE here rather than on
	// every read. Item_Sku is a lookup holding a record id, so it cannot be
	// chained through - the master record has to be fetched.
	//----------------------------------------------------------------------
	itemName = "";
	planIdNum = 0;
	itemFound = false;
	for each  pi in Plan_Item[ID == itemId]
	{
		itemFound = true;
		itemName = ifnull(pi.Item_Name,"").toString();
		if(pi.Plan != null)
		{
			planIdNum = pi.Plan;
		}
	}

	if(itemFound == false)
	{
		return "{\"success\":false,\"error\":\"Item " + itemId + " not found\"}";
	}

	// The payload's planId is trusted only as a fallback; the item's own plan is
	// the truth, because an item cannot be on a plan it does not point at.
	if(planIdNum == 0 && planIdTxt != "" && planIdTxt.isNumber())
	{
		planIdNum = planIdTxt.toLong();
	}

	soNoTxt = "";
	if(planIdNum != 0)
	{
		for each  plR in Production_Planning[ID == planIdNum]
		{
			if(plR.Sales_Order != null)
			{
				for each  soR in Sales_Order[ID == plR.Sales_Order]
				{
					soNoTxt = ifnull(soR.Sales_Order,"").toString();
				}
			}
		}
	}

	//----------------------------------------------------------------------
	// The header. Lookups are set AFTER the insert - a null one fails the
	// whole insert block, and every lookup here can legitimately be missing.
	//----------------------------------------------------------------------
	newId = insert into Material_Damage
	[
		Item_Name=itemName
		Sales_Order_No=soNoTxt
		Phase_Name=phaseTxt
		Damaged_Pieces=damagedPieces
		Damage_Reason=reasonTxt
		Note=noteTxt
		Reported_On=zoho.currentdate
		Status="Open"
		Added_User=zoho.loginuser
	];

	damageId = newId.toLong();

	lineCount = 0;
	pendingLines = 0;
	logLines = "";

	for each  dmg in Material_Damage[ID == damageId]
	{
		dmg.Plan_Item = itemId;
		if(planIdNum != 0)
		{
			dmg.Plan = planIdNum;
		}
		if(supIdTxt != "" && supIdTxt.isNumber())
		{
			dmg.Supervisor = supIdTxt.toLong();
		}
		if(stageIdTxt != "" && stageIdTxt.isNumber())
		{
			dmg.Stage_Log = stageIdTxt.toLong();
		}

		rows = Collection();

		for each  lnRaw in linesRaw
		{
			ln = lnRaw.toMap();

			matIdTxt = ifnull(ln.get("matId"),"").toString().trim();

			qStr = ifnull(ln.get("qty"),"0").toString().trim();
			if(qStr == "")
			{
				qStr = "0";
			}
			pStr = ifnull(ln.get("pieces"),"0").toString().trim();
			if(pStr == "")
			{
				pStr = "0";
			}
			clStr = ifnull(ln.get("cutLen"),"0").toString().trim();
			if(clStr == "")
			{
				clStr = "0";
			}
			cwStr = ifnull(ln.get("cutWid"),"0").toString().trim();
			if(cwStr == "")
			{
				cwStr = "0";
			}

			lnQty = qStr.toDecimal();
			lnPcs = pStr.toDecimal().toLong();

			// A line with nothing on it is not a record of anything. Skipping it
			// here keeps the Reissue tab free of rows that can never be raised.
			if(matIdTxt != "" && matIdTxt.isNumber() && (lnQty > 0 || lnPcs > 0))
			{
				// Ticked means he wants it replaced. Unticked is a real and
				// useful answer - "3 were ruined, I have spares" - so it is
				// recorded as Not_Needed rather than dropped, which is what
				// keeps the damage figure complete.
				wantR = ifnull(ln.get("reissue"),false);
				rStatus = "Not_Needed";
				if(wantR == true || wantR.toString() == "true")
				{
					rStatus = "Pending";
				}

				dRow = Material_Damage.Damage_Lines();
				dRow.Material=matIdTxt.toLong();
				dRow.Material_Name=ifnull(ln.get("name"),"").toString();
				dRow.Unit=ifnull(ln.get("unit"),"").toString();
				dRow.Is_Fabric=ifnull(ln.get("isFab"),false);
				dRow.Damaged_Qty=lnQty;
				dRow.Damaged_Pieces=lnPcs;
				dRow.Cut_Size_Length=clStr.toDecimal().toLong();
				dRow.Cut_Size_Width=cwStr.toDecimal().toLong();
				dRow.Reissue_Status=rStatus;
				rows.insert(dRow);

				lineCount = lineCount + 1;
				if(rStatus == "Pending")
				{
					pendingLines = pendingLines + 1;
				}
			}
		}

		// New subform rows go in as a collection in one call - assigning to the
		// subform directly does not work.
		dmg.Damage_Lines.insert(rows);
	}

	//----------------------------------------------------------------------
	// THE REMAKE BATCH IS NO LONGER THIS FUNCTION'S TO OPEN.
	//
	// It used to be, and only when remakeWanted was ticked. That made a modal
	// the single thing standing between a lost garment and an order shipping
	// short: cancel the dialog or untick the box and the pieces were gone, the
	// item completed with a reduced Qty_Produced, and nothing anywhere said so.
	// The widget's own comment admitted it - "without it the order simply ends
	// short".
	//
	// coverProductionLoss owns it now, and saveProductionPhase calls it the
	// moment a stage closes with fewer pieces out than in. By the time a damage
	// report gets here the batch already exists, because the widget only opens
	// this dialog after the phase has saved.
	//
	// THIS STILL HAS TO ASK, and not just for tidiness. Material_Damage
	// .Remake_Item is what raiseReissueRequest follows to point the replacement
	// CLOTH at the batch instead of at the original item - miss it and the store
	// is asked twice for one event, once for the ruined material and again for
	// the batch's own BOM. So it asks coverProductionLoss which batch this loss
	// belongs to and writes that down.
	//
	// Calling it a second time is safe: it is idempotent, deriving coverage from
	// the stage logs rather than adding a number handed to it, so it returns the
	// existing batch and writes nothing. That is exactly why it can be called
	// from both places.
	//
	// A DAMAGE REPORT WITH NO STAGE SHORTFALL OPENS NOTHING, which is correct.
	// Damaged_Qty means "material that had to be replaced", not "garments
	// destroyed" - a torn label ruins no piece. If garments really were lost the
	// stage closes short and the batch appears from there.
	//----------------------------------------------------------------------
	remakeId = 0;

	if(damagedPieces > 0)
	{
		//------------------------------------------------------------------
		// WHICH BATCH DO THESE PIECES BELONG TO?
		//
		// Asked, never decided here. coverProductionLoss derives the answer from
		// the stage logs, so it returns the batch saveProductionPhase already
		// opened when the stage closed short - and writes nothing, because the
		// loss is already covered by then.
		//
		// Safe to call even when it was called seconds ago: it sets coverage TO
		// the derived loss rather than adding a number handed to it. The old code
		// added damagedPieces to whatever was there, which is exactly why it had
		// to be the only caller and why cancelling this dialog lost the pieces.
		//
		// Its own try/catch - the damage record is already written, and a failure
		// to resolve the batch must not report a saved report as failed.
		//------------------------------------------------------------------
		try
		{
			covRaw = thisapp.coverProductionLoss(itemId.toString());
			covMap = covRaw.toMap();

			// Booleans crossing JSON are compared as TEXT - a Map holding a mix of
			// Boolean and String is one more chance at a mixed-type comparison.
			if(ifnull(covMap.get("success"),"false").toString().trim() == "true")
			{
				bTxt = ifnull(covMap.get("batchId"),"0").toString().trim();
				if(bTxt == "")
				{
					bTxt = "0";
				}

				remakeId = bTxt.toLong();
				logLines = "loss cover -> " + covRaw;
			}
			else
			{
				logLines = "loss cover REFUSED -> " + covRaw;
			}
		}
		catch (eCov)
		{
			logLines = "loss cover THREW: " + eCov.toString();
		}

		// Written on the damage record so raiseReissueRequest knows which item
		// the material is really for.
		if(remakeId > 0)
		{
			for each  dmgU in Material_Damage[ID == damageId]
			{
				dmgU.Remake_Item = remakeId;
			}
		}
	}

	info logLines;

	res = "{\"success\":true,\"damageId\":\"" + damageId + "\",\"lines\":" + lineCount + ",\"remakeItem\":\"" + remakeId + "\",\"gotRemakeFlag\":" + remakeWanted + ",\"gotPieces\":" + damagedPieces + "}";
	}
	catch (e)
	{
		res = "{\"success\":false,\"error\":\"" + e.toString().replaceAll("\"","'") + "\"}";
	}

	return res;
}
