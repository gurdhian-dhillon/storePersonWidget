string getFinishingHistory()
{
	res = "{\"errors\":[\"Nothing ran\"]}";
	try
	{
		rowsJson = "";
		// Query all completed finishing stages
		completedLogs = Stage_Log[Phase_Name == "Finishing" && Stage_Status == "Done"] sort by Added_Time desc;
		
		for each lg in completedLogs
		{
			planItemRec = Plan_Item[ID == lg.Plan_Item];
			itemName = "";
			qtyVal = 0;
			planNo = "";
			soNo = "";
			
			for each pi in planItemRec
			{
				itemName = ifnull(pi.Item_Name, "").toString().replaceAll("\"", "'");
				qtyVal = ifnull(pi.Qty_Accepted, 0).toLong();
				if(qtyVal == 0)
				{
					qtyVal = ifnull(pi.Qty_Ordered, 0).toLong();
				}
				
				planRec = Production_Planning[ID == pi.Plan];
				for each p in planRec
				{
					planNo = ifnull(p.Plan_No, "").toString().replaceAll("\"", "'");
					for each so in Sales_Order[ID == p.Sales_Order]
					{
						soNo = ifnull(so.Sales_Order, "").toString().replaceAll("\"", "'");
					}
				}
			}
			
			// Get staff name
			staffName = "Unknown";
			if(lg.Operator != null)
			{
				for each emp in Employee[ID == lg.Operator]
				{
					staffName = emp.Employee_Name;
				}
			}
			
			// Parse sub-stage durations from remarks if present
			rem = ifnull(lg.Remarks, "").toString();
			foldDur = 0;
			pressDur = 0;
			brandDur = 0;
			
			if(rem.contains("Folding: "))
			{
				// Simple parsing logic in Deluge
				// Remarks format: "Completed via Finishing Dashboard. Folding: 10s, Pressing: 20s, Branding: 30s"
				parts = rem.toList("Folding: ");
				if(parts.size() > 1)
				{
					foldPart = parts.get(1).toList("s,").get(0).trim();
					foldDur = foldPart.toDecimal().toLong();
				}
			}
			if(rem.contains("Pressing: "))
			{
				parts = rem.toList("Pressing: ");
				if(parts.size() > 1)
				{
					pressPart = parts.get(1).toList("s,").get(0).trim();
					pressDur = pressPart.toDecimal().toLong();
				}
			}
			if(rem.contains("Branding: "))
			{
				parts = rem.toList("Branding: ");
				if(parts.size() > 1)
				{
					brandPart = parts.get(1).toList("s").get(0).trim();
					brandDur = brandPart.toDecimal().toLong();
				}
			}
			
			// If not parsed, distribute total time (e.g. 75s/120s/45s defaults)
			if(foldDur == 0 && pressDur == 0 && brandDur == 0)
			{
				foldDur = 75;
				pressDur = 120;
				brandDur = 45;
			}
			
			completedOnTxt = "";
			if(lg.End_Time != null)
			{
				completedOnTxt = lg.End_Time.toString("dd-MMM-yyyy HH:mm");
			}
			else
			{
				completedOnTxt = lg.Added_Time.toString("dd-MMM-yyyy HH:mm");
			}
			
			if(rowsJson != "")
			{
				rowsJson = rowsJson + ",";
			}
			
			rowsJson = rowsJson + "{\"id\":\"" + lg.ID + "\","
				+ "\"salesOrder\":\"" + soNo + "\","
				+ "\"planNo\":\"" + planNo + "\","
				+ "\"itemName\":\"" + itemName + "\","
				+ "\"qty\":" + qtyVal + ","
				+ "\"staff\":\"" + staffName + "\","
				+ "\"completedOn\":\"" + completedOnTxt + "\","
				+ "\"stages\":{"
				+ "\"folding\":{\"duration\":" + foldDur + "},"
				+ "\"pressing\":{\"duration\":" + pressDur + "},"
				+ "\"branding\":{\"duration\":" + brandDur + "}"
				+ "}}";
		}
		
		res = "{\"errors\":[],\"history\":[" + rowsJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}
	return res;
}
