string getFinishingHistory(string payloadJson)
{
	// The last 50 finishing jobs, newest first.
	//
	// FINISHED JOBS ONLY - Finishing_Status == "Done". Anything else is somebody's
	// open work, not history: it belongs on the queue, where getFinishingItems
	// returns it with its stamps so the operator can resume. Done means done and
	// anything else means still open, the same rule all six readers apply.
	//
	// SUPERVISOR IS AN OPTIONAL FILTER, and only here. The queue refuses to answer
	// without one - handing every open batch in the building to whoever loaded the
	// screen first is how two finishers end up on the same pile. History is
	// read-only and finished, so nothing goes wrong if it is read unfiltered, and
	// an empty payload therefore returns everything rather than nothing.
	//
	// The supervisor is Production_Planning.Assigned_To, the same field
	// getPackingQueue and getFinishingItems resolve, reached through
	// Finishing_Data -> Plan_Item -> Production_Planning. That walk already
	// happens here for the plan number, so the filter costs no extra query.
	//
	// THE PAGE IS 50 Finishing_Data ROWS, THEN FILTERED - not the last 50 of HIS.
	// The range is applied by the query and both the Done test and the supervisor
	// test run after it, so a supervisor whose work is buried under other people's
	// sees fewer than 50 rows. That is the existing shape of this function, not
	// something the filter introduced; paging per supervisor needs the plan on the
	// query, which Finishing_Data does not carry.
	//
	// THE DURATION MATHS IS WRITTEN ONCE AND RUN THREE TIMES. It used to be
	// copied out per stage, three near-identical eighty-line blocks, and the
	// pressing copy had drifted: it read the FOLDING end's minutes
	// (peSecs = peHour * 3600 + feMin * 60 + peSec) because the variable above it
	// had been renamed in two places out of three. Self-consistent, so it never
	// threw - it just reported the wrong number, and there was no way to see that
	// by reading one copy.
	//
	// AM/PM IS STILL PARSED. saveFinishingStage now writes HH:mm:ss, but rows
	// written by hand or by the old widget can carry a 12-hour string, and a
	// misread "2:15 PM" is a fourteen-hour stage.
	//
	// MIDNIGHT WRAPS. The sub-stage fields are Time, not Date-Time, so they hold
	// a clock reading with no date and a night-shift stage ends "before" it
	// starts. A negative difference gets 24 hours added - which is right for any
	// stage under a day, and no finishing stage is not. Finishing_Start_Time and
	// Finishing_End_Time are full Date-Times and are the fields to trust for when
	// the work actually happened.

	res = "{\"errors\":[\"Nothing ran\"]}";

	try
	{
		// The filter is held as TEXT and compared against Assigned_To as text.
		// Assigned_To is a lookup holding a record id while ID is a long, and
		// comparing them as-is is a mixed-type comparison, which throws rather
		// than returning false. Empty means no filter.
		supFilter = "";
		raw = ifnull(payloadJson,"").toString().trim();

		if(raw != "")
		{
			inp = raw.toMap();
			supIdTxt = ifnull(inp.get("supervisorId"),"").toString().trim();

			if(supIdTxt != "" && supIdTxt.isNumber() == true)
			{
				supFilter = supIdTxt;
			}
		}

		rowsJson = "";

		// sort by on its own assignment, never inline in a for each header.
		// Paged - this is the one function in the finishing module that reads
		// history rather than work in hand, so it is the one that has to be.
		completedRuns = Finishing_Data[ID != 0] sort by Added_Time desc range from 0 to 49;

		stageNames = List();
		stageNames.add("folding");
		stageNames.add("pressing");
		stageNames.add("branding");

		for each  run in completedRuns
		{
			if(ifnull(run.Finishing_Status,"").toString().trim() == "Done")
			{
				itemName = "";
				planNo = "";
				soNo = "";
				rowSupKey = "";

				for each  pi in Plan_Item[ID == run.Plan_Item]
				{
					nameClean = ifnull(pi.Item_Name,"").toString();
					nameClean = nameClean.replaceAll("(Alteration Batch)","");
					nameClean = nameClean.replaceAll("(alteration batch)","");
					nameClean = nameClean.replaceAll("Alteration Batch","");
					nameClean = nameClean.replaceAll("alteration batch","");
					itemName = nameClean.replaceAll("\"","'").trim();

					for each  p in Production_Planning[ID == pi.Plan]
					{
						planNo = ifnull(p.Plan_No,"").toString().replaceAll("\"","'");

						// The plan is the only route to a supervisor - nothing
						// downstream of checking carries one - and this walk is
						// already being made for the plan number, so the filter
						// costs nothing extra.
						if(p.Assigned_To != null)
						{
							rowSupKey = p.Assigned_To.toString();
						}

						if(p.Sales_Order != null)
						{
							for each  so in Sales_Order[ID == p.Sales_Order]
							{
								soNo = ifnull(so.Sales_Order,"").toString().replaceAll("\"","'");
							}
						}
					}
				}

				// A row whose plan has nobody on it belongs to nobody, so it drops
				// out of a filtered read rather than being handed to whichever
				// supervisor happens to be picked. Unfiltered it still shows.
				keepRow = true;

				if(supFilter != "" && rowSupKey != supFilter)
				{
					keepRow = false;
				}

				// Guarded HERE rather than at the append, so a row this read is
				// not going to show never runs the duration maths at all. The
				// statement-execution limit is not catchable.
				if(keepRow == true)
				{
					staffName = "Unknown";
					if(run.Operator != null)
					{
						for each  emp in Employee[ID == run.Operator]
						{
							staffName = ifnull(emp.Employee_Name,"").toString().replaceAll("\"","'");
						}
					}

					qtyVal = ifnull(run.Qty_Finished,0).toLong();

					completedOnTxt = "";
					if(run.Finishing_End_Time != null)
					{
						completedOnTxt = run.Finishing_End_Time.toString("dd-MMM-yyyy HH:mm:ss");
					}
					else
					{
						completedOnTxt = run.Added_Time.toString("dd-MMM-yyyy HH:mm:ss");
					}

					//----------------------------------------------------------
					// The six stamps, gathered by name so the maths below can run
					// over them instead of being written out three times.
					//----------------------------------------------------------
					startByStage = Map();
					endByStage = Map();

					startByStage.put("folding",ifnull(run.Folding_Start_Time,"").toString());
					endByStage.put("folding",ifnull(run.Folding_End_Time,"").toString());
					startByStage.put("pressing",ifnull(run.Pressing_Start_Time,"").toString());
					endByStage.put("pressing",ifnull(run.Pressing_End_Time,"").toString());
					startByStage.put("branding",ifnull(run.Branding_Start_Time,"").toString());
					endByStage.put("branding",ifnull(run.Branding_End_Time,"").toString());

					durByStage = Map();

					for each  stgNm in stageNames
					{
						durByStage.put(stgNm,"null");

						rawStart = ifnull(startByStage.get(stgNm),"").toString().trim();
						rawEnd = ifnull(endByStage.get(stgNm),"").toString().trim();

						if(rawStart != "" && rawEnd != "")
						{
							// A Time field can render as "14:23:05" or as
							// "2:23:05 PM". The clock part is whichever whitespace
							// separated piece carries a colon; the meridiem is read
							// off the whole string.
							clockStart = "";
							for each  pcS in rawStart.toList(" ")
							{
								if(pcS.contains(":"))
								{
									clockStart = pcS;
								}
							}

							clockEnd = "";
							for each  pcE in rawEnd.toList(" ")
							{
								if(pcE.contains(":"))
								{
									clockEnd = pcE;
								}
							}

							if(clockStart != "" && clockEnd != "")
							{
								sParts = clockStart.toList(":");
								eParts = clockEnd.toList(":");

								if(sParts.size() >= 2 && eParts.size() >= 2)
								{
									sHour = sParts.get(0).toLong();
									sMin = sParts.get(1).toLong();
									sSec = 0;

									if(sParts.size() > 2)
									{
										sSecTxt = sParts.get(2).replaceAll("[^0-9]","");
										if(sSecTxt != "")
										{
											sSec = sSecTxt.toLong();
										}
									}

									if(rawStart.toLowerCase().contains("pm") && sHour < 12)
									{
										sHour = sHour + 12;
									}
									else if(rawStart.toLowerCase().contains("am") && sHour == 12)
									{
										sHour = 0;
									}

									eHour = eParts.get(0).toLong();
									eMin = eParts.get(1).toLong();
									eSec = 0;

									if(eParts.size() > 2)
									{
										eSecTxt = eParts.get(2).replaceAll("[^0-9]","");
										if(eSecTxt != "")
										{
											eSec = eSecTxt.toLong();
										}
									}

									if(rawEnd.toLowerCase().contains("pm") && eHour < 12)
									{
										eHour = eHour + 12;
									}
									else if(rawEnd.toLowerCase().contains("am") && eHour == 12)
									{
										eHour = 0;
									}

									diffSecs = (eHour * 3600 + eMin * 60 + eSec) - (sHour * 3600 + sMin * 60 + sSec);

									if(diffSecs < 0)
									{
										diffSecs = diffSecs + 86400;
									}

									durByStage.put(stgNm,diffSecs.toString());
								}
							}
						}
					}

					if(rowsJson != "")
					{
						rowsJson = rowsJson + ",";
					}

					rowsJson = rowsJson + "{\"id\":\"" + run.ID + "\","
						+ "\"salesOrder\":\"" + soNo + "\","
						+ "\"planNo\":\"" + planNo + "\","
						+ "\"itemName\":\"" + itemName + "\","
						+ "\"qty\":" + qtyVal + ","
						+ "\"staff\":\"" + staffName + "\","
						+ "\"completedOn\":\"" + completedOnTxt + "\","
						+ "\"stages\":{"
						+ "\"folding\":{\"start\":\"" + ifnull(startByStage.get("folding"),"").toString() + "\",\"end\":\"" + ifnull(endByStage.get("folding"),"").toString() + "\",\"duration\":" + ifnull(durByStage.get("folding"),"null").toString() + "},"
						+ "\"pressing\":{\"start\":\"" + ifnull(startByStage.get("pressing"),"").toString() + "\",\"end\":\"" + ifnull(endByStage.get("pressing"),"").toString() + "\",\"duration\":" + ifnull(durByStage.get("pressing"),"null").toString() + "},"
						+ "\"branding\":{\"start\":\"" + ifnull(startByStage.get("branding"),"").toString() + "\",\"end\":\"" + ifnull(endByStage.get("branding"),"").toString() + "\",\"duration\":" + ifnull(durByStage.get("branding"),"null").toString() + "}"
						+ "}}";
				}
			}
		}

		res = "{\"errors\":[],\"history\":[" + rowsJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}

	return res;
}
