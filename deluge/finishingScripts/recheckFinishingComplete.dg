string recheckFinishingComplete(string orderIdTxt)
{
	// Decides whether a sales order has fully completed the Finishing stage,
	// and moves it to "Finishing Complete" when it has.
	//
	// This is called by completeFinishingJob.dg every time a single checking batch
	// finishes. It evaluates the entire Sales Order to see if that was the last batch.

	verdict = "NOTHING RAN";

	try
	{
		idTxt = ifnull(orderIdTxt,"").toString().trim();

		if(idTxt == "" || idTxt.isNumber() == false)
		{
			verdict = "SKIP: missing or non-numeric orderId ('" + idTxt + "')";
		}
		else
		{
			orderId = idTxt.toLong();

			// 1. Read the current status of the order
			orderFound = false;
			statusNow = "";

			for each soChk in Sales_Order[ID == orderId]
			{
				orderFound = true;
				statusNow = ifnull(soChk.Order_Status,"").toString().trim();
			}

			if(orderFound == false)
			{
				verdict = "SKIP: no Sales_Order " + orderId;
			}
			else if (statusNow != "Checking Passed" && statusNow != "Finishing Complete" && statusNow != "Packed")
			{
				// If it hasn't even passed checking, it cannot be finishing complete yet.
				// Or if it's already past finishing (e.g. Dispatched), we skip.
				verdict = "NO MOVE: order " + orderId + " is '" + statusNow + "'";
			}
				// 2. Sum the total quantity ordered in this Sales Order
				totalOrderedQty = 0;
				for each so in Sales_Order[ID == orderId]
				{
					for each soRow in so.Item_Table
					{
						totalOrderedQty = totalOrderedQty + ifnull(soRow.Quantity, 0).toLong();
					}
				}

				// 3. Check if every approved Item_Check has a corresponding Finishing_Data record
				// and sum the total finished quantity (ignoring duplicates)
				allFinished = true;
				checksFound = false;
				totalFinishedQty = 0;
				unfinishedBatches = "";

				for each chk in Item_Check[Sales_Order == orderId && Qty_Approved > 0]
				{
					checksFound = true;
					if(Finishing_Data[Item_Check == chk.ID].count() > 0)
					{
						totalFinishedQty = totalFinishedQty + ifnull(chk.Qty_Approved, 0).toLong();
					}
					else
					{
						allFinished = false;
						if (unfinishedBatches != "") { unfinishedBatches = unfinishedBatches + ", "; }
						unfinishedBatches = unfinishedBatches + chk.ID.toString();
					}
				}

				if (checksFound == false) 
				{
					verdict = "SKIP: order " + orderId + " has no approved checks";
				}
				else if (allFinished == false)
				{
					verdict = "NOT YET: still finishing checks -> " + unfinishedBatches;
				}
				else if (totalFinishedQty < totalOrderedQty)
				{
					verdict = "NOT YET: total finished quantity (" + totalFinishedQty + ") is less than total ordered quantity (" + totalOrderedQty + ")";
				}
				else
				{
					// 4. All checks and total quantities finished! Update the Sales Order
					for each soSet in Sales_Order[ID == orderId]
					{
						soSet.Order_Status = "Finishing Complete";
					}
					verdict = "PASSED: order " + orderId + " is now Finishing Complete (Finished " + totalFinishedQty + " / Ordered " + totalOrderedQty + ")";
				}
		}
	}
	catch (e)
	{
		verdict = "ERROR: " + e.toString();
	}

	info "recheckFinishingComplete -> " + verdict;
	return verdict;
}
