string getFinishingItems(string payloadJson)
{
	// The finishing queue for one SUPERVISOR: every production batch of his that
	// has come off the floor and still owes thread cutting and pressing, across
	// every plan he owns, whether nobody has touched it or somebody is part way
	// through.
	//
	// FINISHING COMES BEFORE CHECKING, so this reads Plan_Item, not Item_Check. A
	// batch is offered the moment production closes its last stage - that is
	// Item_Status == "Awaiting_Check" with Qty_Produced above zero - and it leaves
	// this queue when its Finishing_Data reads Done, at which point getCheckingQueue
	// starts offering it to the inspector. A remake and an alteration batch are
	// Plan_Items like any other, so they come through here again on their own.
	//
	// IT TAKES A SUPERVISOR, NOT A PLAN. The floor does not work a plan at a time -
	// finishing is per BATCH, and batches arrive from production one at a time
	// while other lines of the same order are still being cut. Making the finisher
	// pick a plan first meant he had to already know which plan the pile in front of
	// him came from, and a batch on a plan he had not selected was invisible.
	//
	// THE SUPERVISOR IS Production_Planning.Assigned_To, resolved exactly the way
	// getPackingQueue and getCheckingQueue resolve it - createProductionPlans stamps
	// it, and the store list, the receive screen and production all read it from
	// there.
	//
	// NO SUPERVISOR MEANS AN EMPTY QUEUE, NEVER EVERYTHING. An unfiltered read
	// here would put every open batch in the building in front of whoever loaded
	// the screen before the picker settled, and two finishers would start the same
	// pile. A missing id is a screen that has not finished loading, not a request
	// for all work.
	//
	// ONE CARD PER Plan_Item, AND NO GROUPING. A remake batch repeats its
	// original's name and SKU, and an alteration batch has its name scrubbed of
	// the "(Alteration Batch)" suffix below, so merging by name would join three
	// physically separate piles that arrived on different days and stamp every
	// Finishing_Data row they produced with one identical set of times.
	//
	// AN OPEN JOB COMES BACK WITH ITS TIMES. status "In_Progress" plus whatever
	// sub-stage stamps exist, so a refresh, a closed tab or a handover to the next
	// shift resumes where the last person stopped instead of offering the batch as
	// untouched.
	//
	// "FINISHED" IS Finishing_Status == "Done", not "a row exists". Done means
	// done; anything else means the job is still open and resumable. Written this
	// way round so a row carrying neither value stays ON the queue, where somebody
	// can see it, rather than vanishing as finished work.
	//
	// Finishing_Data IS READ ONE BATCH AT A TIME, at the point each batch is
	// reached, never as a whole-form pass: the form grows one row per batch for
	// ever and the statement-execution limit is NOT catchable - it kills the
	// script and the widget gets a bare 500 with no error card. The query is only
	// made for a batch that is already at Awaiting_Check, so it is bounded by work
	// on the floor, not by history.
	//
	// STILL UNBOUNDED, deliberately and on the record: it queries Plan_Item once
	// per plan the supervisor has ever been given - including plans whose orders
	// shipped months ago. Same debt docs/scaling.md lists elsewhere. Filtering the
	// plans by Order_Status was considered and left alone, because a plan sitting
	// on the wrong status would then hide real work with nothing on screen to say
	// so.

	res = "{\"errors\":[\"Nothing ran\"]}";

	try
	{
		raw = ifnull(payloadJson,"").toString().trim();

		if(raw == "")
		{
			return "{\"errors\":[],\"queue\":[]}";
		}

		inp = raw.toMap();
		supIdTxt = ifnull(inp.get("supervisorId"),"").toString().trim();

		if(supIdTxt == "" || supIdTxt.isNumber() == false)
		{
			return "{\"errors\":[],\"queue\":[]}";
		}

		supId = supIdTxt.toLong();

		//------------------------------------------------------------------
		// His plans, with their plan number and order number resolved once
		// each - both are the same for every batch on a plan, and fetching
		// them per batch was two queries to learn something already known.
		//------------------------------------------------------------------
		planKeys = List();
		planNoByPlan = Map();
		soNoByPlan = Map();

		// sort by on its own assignment, never inline in a for each header.
		// Oldest plan first, so the longest-waiting work is at the top.
		myPlans = Production_Planning[Assigned_To == supId] sort by Added_Time;

		for each  pl in myPlans
		{
			planKeyTxt = pl.ID.toString();
			planKeys.add(planKeyTxt);
			planNoByPlan.put(planKeyTxt,ifnull(pl.Plan_No,"").toString().replaceAll("\"","'"));

			soTxt = "";

			if(pl.Sales_Order != null)
			{
				for each  so in Sales_Order[ID == pl.Sales_Order]
				{
					soTxt = ifnull(so.Sales_Order,"").toString().replaceAll("\"","'");
				}
			}

			soNoByPlan.put(planKeyTxt,soTxt);
		}

		//------------------------------------------------------------------
		// The batches. Item SKU is cached per Item_Sku id and filled in the
		// first time a batch needs it, because many batches share a product.
		// skuSeen records WHICH ids have been resolved: a product with no SKU
		// resolves to "", which a Map cannot tell apart from an id never looked
		// up, so without it every such product is re-queried on every batch.
		//------------------------------------------------------------------
		skuByMaster = Map();
		skuSeen = List();

		rowsJson = "";

		for each  planKeyOne in planKeys
		{
			// sort by on its own assignment, never inline in a for each header.
			// Oldest batch first within the plan.
			batches = Plan_Item[Plan == planKeyOne.toLong() && Item_Status == "Awaiting_Check"] sort by Added_Time;

			for each  pi in batches
			{
				// A Creator numeric never written is an EMPTY STRING, not null,
				// and toDecimal() throws on it.
				prodS = ifnull(pi.Qty_Produced,"0").toString().trim();
				if(prodS == "")
				{
					prodS = "0";
				}
				batchQty = prodS.toDecimal().toLong();

				if(batchQty > 0)
				{
					itemKeyTxt = pi.ID.toString();

					//------------------------------------------------------
					// THIS BATCH'S FINISHING ROW, read once. Done takes it off
					// the queue; anything else is the open row to resume.
					// startFinishingJob reuses any non-Done row rather than
					// adding a second one, so there is at most one open row per
					// batch and these puts cannot fight each other.
					//------------------------------------------------------
					isDone = false;
					finIdOut = "0";
					tcStart = "";
					tcEnd = "";
					prStart = "";
					prEnd = "";

					for each  fd in Finishing_Data[Plan_Item == pi.ID]
					{
						if(ifnull(fd.Finishing_Status,"").toString().trim() == "Done")
						{
							isDone = true;
						}
						else
						{
							finIdOut = fd.ID.toString();

							if(fd.Thread_Cutting_Start_Time != null)
							{
								tcStart = fd.Thread_Cutting_Start_Time.toString();
							}
							if(fd.Thread_Cutting_End_Time != null)
							{
								tcEnd = fd.Thread_Cutting_End_Time.toString();
							}
							if(fd.Pressing_Start_Time != null)
							{
								prStart = fd.Pressing_Start_Time.toString();
							}
							if(fd.Pressing_End_Time != null)
							{
								prEnd = fd.Pressing_End_Time.toString();
							}
						}
					}

					if(isDone == false)
					{
						// The suffix is scrubbed so an alteration batch reads as
						// the product the finisher recognises. It does NOT merge
						// it with anything - the batches stay separate cards.
						nameClean = ifnull(pi.Item_Name,"").toString();
						nameClean = nameClean.replaceAll("(Alteration Batch)","");
						nameClean = nameClean.replaceAll("(alteration batch)","");
						nameClean = nameClean.replaceAll("Alteration Batch","");
						nameClean = nameClean.replaceAll("alteration batch","");
						nameClean = nameClean.replaceAll("\"","'").trim();

						// Item_Sku is a LOOKUP holding a record id, not the SKU
						// text, so it has to be resolved through the master or the
						// screen shows an 18-digit id.
						masterKey = ifnull(pi.Item_Sku,"").toString().trim();
						skuOut = "";

						if(masterKey != "" && masterKey.isNumber())
						{
							if(skuSeen.contains(masterKey) == false)
							{
								skuSeen.add(masterKey);
								skuByMaster.put(masterKey,"");

								for each  imRec in Item_Master[ID == masterKey.toLong()]
								{
									skuByMaster.put(masterKey,ifnull(imRec.SKU,"").toString().replaceAll("\"","'"));
								}
							}

							skuOut = ifnull(skuByMaster.get(masterKey),"").toString();
						}

						// An open row hands back its id and its stamps so the
						// operator resumes; a batch nobody has touched has no row
						// yet, so finishingId is 0 and startFinishingJob opens
						// one on the first press.
						finStatus = "Pending";

						if(finIdOut != "0")
						{
							finStatus = "In_Progress";
						}

						if(rowsJson != "")
						{
							rowsJson = rowsJson + ",";
						}

						// Ids stringified - an 18-digit id breaks JSON.parse on
						// the widget side.
						rowsJson = rowsJson + "{\"id\":\"" + itemKeyTxt + "\","
							+ "\"finishingId\":\"" + finIdOut + "\","
							+ "\"planItemId\":\"" + itemKeyTxt + "\","
							+ "\"salesOrder\":\"" + ifnull(soNoByPlan.get(planKeyOne),"").toString() + "\","
							+ "\"planNo\":\"" + ifnull(planNoByPlan.get(planKeyOne),"").toString() + "\","
							+ "\"itemName\":\"" + nameClean + "\","
							+ "\"sku\":\"" + skuOut + "\","
							+ "\"qty\":" + batchQty + ","
							+ "\"status\":\"" + finStatus + "\","
							+ "\"stages\":{"
							+ "\"threadcutting\":{\"start\":\"" + tcStart + "\",\"end\":\"" + tcEnd + "\"},"
							+ "\"pressing\":{\"start\":\"" + prStart + "\",\"end\":\"" + prEnd + "\"}"
							+ "}}";
					}
				}
			}
		}

		res = "{\"errors\":[],\"queue\":[" + rowsJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}

	return res;
}
