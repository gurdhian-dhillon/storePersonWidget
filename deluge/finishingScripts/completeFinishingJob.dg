string completeFinishingJob(string payloadJson)
{
	// Closes one open Finishing_Data row - the last press on the finishing screen
	// - and then asks the order whether that was the last batch it was waiting
	// for.
	//
	// FINISHING RUNS BEFORE CHECKING NOW, so the row belongs to a Plan_Item, not
	// to an Item_Check. Closing it is what releases the batch to the checker:
	// getCheckingQueue offers a batch only once its Finishing_Data reads Done.
	//
	// IT NO LONGER INSERTS. startFinishingJob opens the row when the first stage
	// starts and saveFinishingStage stamps each sub-stage as it happens; by the
	// time this runs, everything except the pressing end and the closing figures
	// is already on the record.
	//
	// IT DOES NOT TOUCH Plan_Item.Item_Status, AND THAT IS THE POINT. The batch
	// stays at Awaiting_Check from the end of production until saveItemCheck
	// writes Complete, and "finished" is Finishing_Data carrying Finishing_Status
	// == "Done". Earlier versions wrote an off-picklist "Finishing Done" there and
	// stopped the plan and the order from ever completing. One fact, one place,
	// nothing to drift.
	//
	// QTY_FINISHED IS READ FROM THE BATCH, NOT FROM THE PAYLOAD. What production
	// made is what goes to the checker; a figure the screen could set is a figure
	// that can disagree with the batch it belongs to. Finishing has no way to
	// record a piece ruined at the press - that would need its own shortfall
	// capture, the way a production stage has one. The checker rejects it
	// instead and the batch is remade.
	//
	// IDEMPOTENT. A row that is already closed returns success without writing
	// again, and the order is still re-evaluated - so a retry after a lost
	// response finishes the job rather than doubling it or leaving the order
	// stranded one status short.

	res = "{\"success\":false,\"error\":\"Nothing ran\"}";

	try
	{
		inp = payloadJson.toMap();
		finIdStr = ifnull(inp.get("finishingId"),"").toString().trim();

		if(finIdStr == "" || finIdStr.isNumber() == false)
		{
			return "{\"success\":false,\"error\":\"Missing or invalid finishingId\"}";
		}

		finId = finIdStr.toLong();

		rowFound = false;
		rowStatus = "";
		itemId = null;
		pressingEndSet = false;

		for each  fdChk in Finishing_Data[ID == finId]
		{
			rowFound = true;
			rowStatus = ifnull(fdChk.Finishing_Status,"").toString().trim();
			itemId = fdChk.Plan_Item;

			if(fdChk.Pressing_End_Time != null)
			{
				pressingEndSet = true;
			}
		}

		if(rowFound == false)
		{
			return "{\"success\":false,\"error\":\"No Finishing_Data " + finId + "\"}";
		}

		if(itemId == null)
		{
			return "{\"success\":false,\"error\":\"Finishing_Data " + finId + " has no Plan_Item behind it\"}";
		}

		// The batch, its plan and the plan's order, resolved once. The order comes
		// through the plan - Production_Planning.Sales_Order - because that is the
		// one link every batch has.
		batchQty = 0;
		planId = null;
		orderId = null;

		for each  pi in Plan_Item[ID == itemId]
		{
			prodS = ifnull(pi.Qty_Produced,"0").toString().trim();
			if(prodS == "")
			{
				prodS = "0";
			}
			batchQty = prodS.toDecimal().toLong();

			if(pi.Plan != null)
			{
				planId = pi.Plan;
			}
		}

		if(planId != null)
		{
			for each  plF in Production_Planning[ID == planId]
			{
				if(plF.Sales_Order != null)
				{
					orderId = plF.Sales_Order;
				}
			}
		}

		closedNow = false;

		if(rowStatus != "Done")
		{
			endStampTxt = zoho.currenttime.toString("HH:mm:ss");

			for each  fdSet in Finishing_Data[ID == finId]
			{
				// Pressing is the last stage, and the last press is one round
				// trip: stamped here rather than in a separate saveFinishingStage
				// call, so there is no window in which the pressing end is
				// recorded but the job is still open.
				if(pressingEndSet == false)
				{
					fdSet.Pressing_End_Time = endStampTxt;
				}

				fdSet.Finishing_End_Time = zoho.currenttime;
				fdSet.Qty_Finished = batchQty;
				fdSet.Finishing_Status = "Done";
			}

			closedNow = true;

			//----------------------------------------------------------
			// AND THEN IT IS READ BACK, because the one write in that block
			// that can fail silently is the one everything depends on.
			//
			// Finishing_Status is a Dropdown. A value the code writes that the
			// picklist does not offer is not an error in Creator - it simply
			// does not stick. The other three writes here are a Time, a
			// Date-Time and a Number and they land regardless, so the symptom is
			// a batch with all its stamps, a Qty_Finished, and a status that is
			// still In_Progress: finished work that never leaves the finishing
			// queue and never reaches the checker, with nothing anywhere saying
			// why.
			//
			// One extra query per completed job to turn a silent corruption into
			// a message naming the cause.
			//----------------------------------------------------------
			statusAfter = "";

			for each  fdBack in Finishing_Data[ID == finId]
			{
				statusAfter = ifnull(fdBack.Finishing_Status,"").toString().trim();
			}

			if(statusAfter != "Done")
			{
				return "{\"success\":false,\"error\":\"The finishing job was stamped but would not close: Finishing_Status read back as '" + statusAfter.replaceAll("\"","'") + "' instead of 'Done'. The Finishing_Data.Finishing_Status dropdown is missing the choice 'Done' - add it exactly, with no spaces, then press Complete again.\"}";
			}
		}

		// THE ORDER IS RECOMPUTED BY recheckOrderComplete, which owns both
		// "Finishing Complete" and "Checking Passed" in one pass - a batch
		// finishing may be the last thing the order was waiting for to reach
		// Finishing Complete.
		//
		// Run for a retry as well as a first close. If the previous attempt wrote
		// the row and then lost the response, the order still has to be asked -
		// otherwise it sits one status short with nothing on any screen to press.
		//
		// It never throws; it returns its failure as text. Records are already
		// written by this point and Deluge has no transaction to roll back, so a
		// late step failing must not make a finished job report itself failed.
		verdict = "no order resolved";

		if(orderId != null)
		{
			verdict = thisapp.recheckOrderComplete(orderId.toString());
		}

		info "completeFinishingJob: finishing " + finId + " (item " + itemId + ", qty " + batchQty + ", closedNow=" + closedNow + ") -> " + verdict;

		msgTxt = "Finished " + batchQty + " pieces";
		if(closedNow == false)
		{
			msgTxt = "This batch was already recorded as finished";
		}

		res = "{\"success\":true,\"finishingId\":\"" + finId + "\",\"qty\":" + batchQty + ",\"closedNow\":" + closedNow + ",\"message\":\"" + msgTxt + "\"}";
	}
	catch (e)
	{
		res = "{\"success\":false,\"error\":\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"}";
	}

	return res;
}
