string completeFinishingJob(string payloadJson)
{
	res = "{\"success\":false,\"error\":\"Nothing was saved\"}";
	try
	{
		inp = payloadJson.toMap();
		checkIdStr = ifnull(inp.get("itemCheckId"),"").toString().trim();
		staffName = ifnull(inp.get("staffName"),"").toString().trim();
		
		// Sub-stage Times (formatted string HH:mm:ss from JS)
		foldingStartStr = ifnull(inp.get("foldingStart"),"").toString().trim();
		foldingEndStr = ifnull(inp.get("foldingEnd"),"").toString().trim();
		pressingStartStr = ifnull(inp.get("pressingStart"),"").toString().trim();
		pressingEndStr = ifnull(inp.get("pressingEnd"),"").toString().trim();
		brandingStartStr = ifnull(inp.get("brandingStart"),"").toString().trim();
		brandingEndStr = ifnull(inp.get("brandingEnd"),"").toString().trim();
		
		// Overall start/end Date-Times (formatted string yyyy-MM-dd HH:mm:ss from JS)
		finishingStartStr = ifnull(inp.get("finishingStart"),"").toString().trim();
		finishingEndStr = ifnull(inp.get("finishingEnd"),"").toString().trim();
		
		finStart = if(finishingStartStr == "", null, finishingStartStr.toTime("yyyy-MM-dd HH:mm:ss"));
		finEnd = if(finishingEndStr == "", null, finishingEndStr.toTime("yyyy-MM-dd HH:mm:ss"));
		
		if (checkIdStr == "")
		{
			return "{\"success\":false,\"error\":\"Missing itemCheckId\"}";
		}
		
		// Find the employee ID for the staff name
		empId = null;
		for each emp in Employee[Employee_Name == staffName]
		{
			empId = emp.ID;
		}
		
		ordersToRecheck = List();
		// checkIdStr contains a comma-separated list of check IDs
		checkIdsList = checkIdStr.toList(",");
		for each checkIdVal in checkIdsList
		{
			checkId = checkIdVal.trim().toLong();
			
			// Resolve Qty Approved and Plan Item from this specific check record
			checkQty = 0;
			itemId = null;
			planId = null;
			for each chk in Item_Check[ID == checkId]
			{
				itemId = chk.Plan_Item;
				if(chk.Plan != null)
				{
					planId = chk.Plan;
				}
				checkQty = ifnull(chk.Qty_Approved, 0).toLong();
				if (chk.Sales_Order != null && !ordersToRecheck.contains(chk.Sales_Order.toString()))
				{
					ordersToRecheck.add(chk.Sales_Order.toString());
				}
			}
			
			// Insert finishing record into new 'Finishing_Data' form
			newFin = insert into Finishing_Data
			[
				Plan_Item = itemId
				Item_Check = checkId
				Folding_Start_Time = foldingStartStr
				Folding_End_Time = foldingEndStr
				Pressing_Start_Time = pressingStartStr
				Pressing_End_Time = pressingEndStr
				Branding_Start_Time = brandingStartStr
				Branding_End_Time = brandingEndStr
				Finishing_Start_Time = finStart
				Finishing_End_Time = finEnd
				Qty_Finished = checkQty
			];
			
			finId = newFin.toLong();
			
			// Update Operator lookup since lookups can be null and fail in block
			for each f in Finishing_Data[ID == finId]
			{
				if(empId != null)
				{
					f.Operator = empId;
				}
			}

			// Update Plan_Item status to Finishing Done
			for each pi in Plan_Item[ID == itemId]
			{
				pi.Item_Status = "Finishing Done";
			}
		}

		for each oId in ordersToRecheck
		{
			thisapp.recheckFinishingComplete(oId);
		}
		
		
		res = "{\"success\":true,\"message\":\"Finishing records saved successfully\"}";
	}
	catch (e)
	{
		res = "{\"success\":false,\"error\":\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"}";
	}
	return res;
}

