string getFinishingPlans()
{
	res = "{\"errors\":[\"Nothing ran\"]}";
	try
	{
		plansJson = "";
		addedPlans = List();
		
		// Fetch unique plan numbers that have checked items requiring finishing (approved ones only)
		checks = Item_Check[Qty_Approved > 0] sort by Added_Time desc;
		for each chk in checks
		{
			planNo = "";
			planIdStr = "";
			salesOrderNo = "";
			for each p in Production_Planning[ID == chk.Plan]
			{
				planNo = ifnull(p.Plan_No, "").toString().replaceAll("\"", "'");
				planIdStr = p.ID.toString();
				for each so in Sales_Order[ID == p.Sales_Order]
				{
					salesOrderNo = ifnull(so.Sales_Order, "").toString().replaceAll("\"", "'");
				}
			}
			
			if (planNo != "")
			{
				// Check if this plan already completed finishing for this item check
				isDone = false;
				for each lg in Finishing_Data[Item_Check == chk.ID]
				{
					isDone = true;
				}
				
				if (!isDone)
				{
					if (!addedPlans.contains(planNo))
					{
						if (plansJson != "")
						{
							plansJson = plansJson + ",";
						}
						plansJson = plansJson + "{\"id\":\"" + planIdStr + "\",\"planNo\":\"" + planNo + "\",\"salesOrder\":\"" + salesOrderNo + "\"}";
						addedPlans.add(planNo);
					}
				}
			}
		}
		
		res = "{\"errors\":[],\"plans\":[" + plansJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}
	return res;
}
