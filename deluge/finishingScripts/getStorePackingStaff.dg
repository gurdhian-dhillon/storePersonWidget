string getStorePackingStaff(string payloadJson)
{
	res = "{\"errors\":[\"Nothing ran\"]}";
	try
	{
		// 1. Fetch supervisors (Designation == "Supervisor")
		supsJson = "";
		for each emp in Employee[Designation == "Supervisor" && Status == "Active"]
		{
			if(supsJson != "")
			{
				supsJson = supsJson + ",";
			}
			empName = ifnull(emp.Employee_Name, "").toString().trim().replaceAll("\"", "'");
			supsJson = supsJson + "{\"id\":\"" + emp.ID + "\",\"name\":\"" + empName + "\"}";
		}
		
		// Fallback for supervisors: if none found, query all active employees
		if(supsJson == "")
		{
			for each emp in Employee[Status == "Active"]
			{
				if(supsJson != "")
				{
					supsJson = supsJson + ",";
				}
				empName = ifnull(emp.Employee_Name, "").toString().trim().replaceAll("\"", "'");
				supsJson = supsJson + "{\"id\":\"" + emp.ID + "\",\"name\":\"" + empName + "\"}";
			}
		}
		
		// 2. Fetch operators/packing staff
		opsJson = "";
		storeDeptId = 0;
		for each dept in Department[Department_Name.contains("Store") || Department_Name.contains("store")]
		{
			storeDeptId = dept.ID;
		}
		
		hasOps = false;
		if(storeDeptId != 0)
		{
			for each emp in Employee[Department == storeDeptId && Status == "Active"]
			{
				if(emp.Designation == "Packing Staff" || emp.Designation == "Packing Person" || emp.Designation == "Packaging Person" || emp.Designation == "Operator")
				{
					hasOps = true;
					if(opsJson != "")
					{
						opsJson = opsJson + ",";
					}
					empName = ifnull(emp.Employee_Name, "").toString().trim().replaceAll("\"", "'");
					opsJson = opsJson + "{\"id\":\"" + emp.ID + "\",\"name\":\"" + empName + "\"}";
				}
			}
		}
		
		if(hasOps == false)
		{
			for each emp in Employee[Status == "Active"]
			{
				if(emp.Designation == "Packing Staff" || emp.Designation == "Packing Person" || emp.Designation == "Packaging Person" || emp.Designation == "Operator")
				{
					if(opsJson != "")
					{
						opsJson = opsJson + ",";
					}
					empName = ifnull(emp.Employee_Name, "").toString().trim().replaceAll("\"", "'");
					opsJson = opsJson + "{\"id\":\"" + emp.ID + "\",\"name\":\"" + empName + "\"}";
				}
			}
		}
		
		res = "{\"errors\":[],\"supervisors\":[" + supsJson + "],\"staff\":[" + opsJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}
	return res;
}
