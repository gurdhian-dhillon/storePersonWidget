string cancelPrintJob(string payloadJson)
{
	// The cloth went out and came back UNPRINTED. This puts it back.
	//
	//   { "jobId":"555", "reason":"printer returned it unprinted" }
	//
	// THE PIECES WERE PHYSICALLY CUT AT SEND. You cannot un-cut them, so this
	// does NOT wind the original source rolls back up. The returned bundle
	// re-enters the source lot as ONE NEW Lot_Rolls row - full-width cloth, same
	// width, just shorter, which is RAW MATERIAL by the "width unchanged = raw
	// material" rule, NOT Waste_Master (booking usable cloth as waste corrupts
	// Pieces_From_Waste and the scrap report - CLAUDE.md "What NOT to do" #2).
	//
	// One lump row, not one per piece: nothing needs per-piece detail on a
	// bounced bundle, and a 20 m job of 3 m pieces would otherwise add 7 rows.
	// The allocator's shortest-first drain consolidates the rack over the next
	// few issues anyway.
	//
	// The metres also go back to Wash_Quantity or Unwash_Quantity - THE COUNTER
	// THEY CAME OFF, which is the only thing Source_State is stored for. Putting
	// greige cloth back as washed would claim a wash that never happened. Both
	// move together with the new roll, so Σ Roll_Length == shelf columns holds.
	//
	// AT_PRINTER ONLY, forward-only: a Received job has moved the cloth into
	// another material and there is nothing to give back; a Cancelled job would
	// double-credit.
	//
	// Source_Rolls on the job is NOT read here - it is the audit record of what
	// was cut, not a wind-back instruction.
	//
	// ONE EXIT, AT THE BOTTOM. Deluge's "all paths return" check does NOT count a
	// return inside try/catch. Same shape as saveStockInward.

	res = "";
	errTxt = "";

	try
	{
		inp = payloadJson.toMap();

		jobIdTxt = ifnull(inp.get("jobId"),"").toString().trim();
		reason = ifnull(inp.get("reason"),"").toString().trim().replaceAll("\"","'");

		if(jobIdTxt == "" || jobIdTxt.isNumber() == false)
		{
			errTxt = "No print job given";
		}

		//--------------------------------------------------------------------
		// THE JOB. Names first assigned inside an if are not safe to read after
		// it when that branch did not run. Lookups hold record ids - kept as
		// text, converted at the point of use.
		//--------------------------------------------------------------------
		srcMatTxt = "";
		srcLotTxt = "";
		srcState = "";
		metresSent = 0.0;

		if(errTxt == "")
		{
			jobRecs = Print_Job[ID == jobIdTxt.toLong()];
			if(jobRecs.count() == 0)
			{
				errTxt = "Print job not found";
			}
			else
			{
				for each  jchk in jobRecs
				{
					jStat = ifnull(jchk.Job_Status,"").toString().trim();
					if(jStat != "At_Printer")
					{
						errTxt = "That job is " + jStat + " - only a job still at the printer can be cancelled";
					}
					else
					{
						srcMatTxt = ifnull(jchk.Source_Material,"").toString().trim();
						srcLotTxt = ifnull(jchk.Source_Lot,"").toString().trim();
						srcState = ifnull(jchk.Source_State,"").toString().trim();

						msS = ifnull(jchk.Metres_Sent,"0").toString().trim();
						if(msS == "")
						{
							msS = "0";
						}
						metresSent = msS.toDecimal();
					}
				}
			}
		}

		// Source_State refused when blank rather than guessed. sendToPrint always
		// writes it, so a blank one means the record was damaged. Guessing Wash
		// books greige as washed; guessing Unwash sends washed cloth back through
		// the wash. Both silent.
		if(errTxt == "" && srcState != "Wash" && srcState != "Unwash")
		{
			errTxt = "That job does not say which counter the cloth came off - set Source_State on it before cancelling";
		}

		if(errTxt == "" && metresSent <= 0)
		{
			errTxt = "That job has no metres against it - nothing to put back";
		}

		//--------------------------------------------------------------------
		// THE LEDGER. Lot AND parent, same pass, so they cannot disagree.
		//
		// The SKU total does not change - the cloth was always ours; it moves
		// back out of In_Print_Qty and onto the shelf it left. A job raised
		// without a source lot still settles its parent.
		//--------------------------------------------------------------------
		lotWashOut = 0.0;
		lotInPrintOut = 0.0;
		newRollLabel = "";

		if(errTxt == "")
		{
			if(srcLotTxt != "")
			{
				for each  plotUpd in Raw_Material_Lot[ID == srcLotTxt.toLong()]
				{
					lipS = ifnull(plotUpd.In_Print_Qty,"0").toString().trim();
					if(lipS == "")
					{
						lipS = "0";
					}
					lwS = ifnull(plotUpd.Wash_Quantity,"0").toString().trim();
					if(lwS == "")
					{
						lwS = "0";
					}
					luS = ifnull(plotUpd.Unwash_Quantity,"0").toString().trim();
					if(luS == "")
					{
						luS = "0";
					}
					lotNumTxt = ifnull(plotUpd.Lot_Number,"").toString().trim().replaceAll("\"","'");

					// Clamped at zero rather than refused - the cloth is
					// physically back either way.
					lipNow = lipS.toDecimal() - metresSent;
					if(lipNow < 0)
					{
						info "cancelPrintJob: lot " + srcLotTxt + " In_Print_Qty would go negative - clamped";
						lipNow = 0;
					}
					plotUpd.In_Print_Qty = lipNow;
					lotInPrintOut = lipNow;

					if(srcState == "Wash")
					{
						lotWashOut = lwS.toDecimal() + metresSent;
						plotUpd.Wash_Quantity = lotWashOut;
					}
					else
					{
						plotUpd.Unwash_Quantity = luS.toDecimal() + metresSent;
						lotWashOut = lwS.toDecimal();
					}

					// THE NEW ROLL. Metres_Sent of full-width cut pieces, back on
					// the lot as one Available roll. Origin "Returned". Labelled
					// off the lot number + the job, so it is traceable and cannot
					// collide with an existing roll.
					newRollLabel = lotNumTxt + "-C" + jobIdTxt;
					if(lotNumTxt == "")
					{
						newRollLabel = "LOT" + srcLotTxt + "-C" + jobIdTxt;
					}

					cRow = Raw_Material_Lot.Lot_Rolls();
					cRow.Roll_Label = newRollLabel;
					cRow.Roll_Length = metresSent;
					cRow.Roll_Status = "Available";
					cRow.Origin = "Returned";
					cRow.Source_Receipt = jobIdTxt;
					plotUpd.Lot_Rolls.insert(cRow);
				}
			}

			if(srcMatTxt != "")
			{
				for each  pmatUpd in Raw_Material[ID == srcMatTxt.toLong()]
				{
					mipS = ifnull(pmatUpd.In_Print_Qty,"0").toString().trim();
					if(mipS == "")
					{
						mipS = "0";
					}
					mwS = ifnull(pmatUpd.Wash_Quantity,"0").toString().trim();
					if(mwS == "")
					{
						mwS = "0";
					}
					muS = ifnull(pmatUpd.Unwash_Quantity,"0").toString().trim();
					if(muS == "")
					{
						muS = "0";
					}

					mipNow = mipS.toDecimal() - metresSent;
					if(mipNow < 0)
					{
						info "cancelPrintJob: material " + srcMatTxt + " In_Print_Qty would go negative - clamped";
						mipNow = 0;
					}
					pmatUpd.In_Print_Qty = mipNow;

					if(srcState == "Wash")
					{
						pmatUpd.Wash_Quantity = mwS.toDecimal() + metresSent;
					}
					else
					{
						pmatUpd.Unwash_Quantity = muS.toDecimal() + metresSent;
					}
					qW = ifnull(pmatUpd.Wash_Quantity,"0").toString().trim();
					qU = ifnull(pmatUpd.Unwash_Quantity,"0").toString().trim();
					qA = ifnull(pmatUpd.Unallocated_Qty,"0").toString().trim();
					pmatUpd.Quantity = if(qW=="",0.0,qW.toDecimal()) + if(qU=="",0.0,qU.toDecimal()) + if(qA=="",0.0,qA.toDecimal());
				}
			}
		}

		//--------------------------------------------------------------------
		// STAMP THE JOB, last. The reason is APPENDED to Remarks, never written
		// over them.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			for each  jUpd in Print_Job[ID == jobIdTxt.toLong()]
			{
				jUpd.Job_Status = "Cancelled";

				addR = zoho.currentdate.toString("dd-MMM HH:mm") + " - cancelled";
				if(reason != "")
				{
					addR = addR + ": " + reason;
				}
				oldR = ifnull(jUpd.Remarks,"").toString();
				if(oldR != "")
				{
					addR = oldR + "\n" + addR;
				}
				jUpd.Remarks = addR;
			}

			info "cancelPrintJob: job " + jobIdTxt + " cancelled, " + metresSent + " Mtr back to " + srcState + " on lot as roll " + newRollLabel;

			res = "{\"success\":true,\"restoredTo\":\"" + srcState + "\",\"metres\":" + metresSent + ",\"newRollLabel\":\"" + newRollLabel.replaceAll("\"","'") + "\",\"lotWash\":" + lotWashOut + ",\"lotInPrint\":" + lotInPrintOut + "}";
		}
	}
	catch (e)
	{
		errTxt = "DELUGE: " + e.toString();
	}

	if(res == "")
	{
		if(errTxt == "")
		{
			errTxt = "Nothing was cancelled";
		}
		res = "{\"success\":false,\"error\":\"" + errTxt.replaceAll("\"","'") + "\"}";
	}

	return res;
}
