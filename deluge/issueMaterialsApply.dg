string issueMaterialsApply(string supervisorId, string issuesJson, string applyKey)
{
	// FAN-OUT ONLY. This is issueMaterials with the Material_Issue write REMOVED.
	// It applies the allocation to the requirement rows and moves stock; it does
	// NOT create the handover record. issueMaterialsHandover does that, once,
	// after every chunk of a press has been applied.
	//
	// WHY SPLIT. A big press touches 1000+ Material_Requirement rows - chunked by
	// the widget for payload size and statement safety, exactly as before. But
	// the handover record is only ~200 material-x-lot lines and wants to be ONE
	// Material_Issue, not one per chunk with Batch_Voucher glue. Splitting the
	// apply from the record write is what lets both be true: the apply stays
	// chunked, the record is a single separate call.
	//
	// applyKey is a client-generated id for one press (timestamp + random). It IS
	// stored here - stamped onto every Material_Requirement and Waste_Movement
	// row this call touches, so getIssueApplyStatus can find them again if this
	// call's own response is lost (statement-limit kill, network drop). The
	// caller also collects the wasteMvIds this function returns directly and
	// hands them to issueMaterialsHandover, which stamps the SIV on them once
	// the voucher exists.
	//
	// Sections 1-4 (allocation apply, remnant picks, lot stock, parent stock) are
	// a VERBATIM copy of issueMaterials. The only removals are: the Material_Issue
	// insert, the Issue_Lines gather/insert, the voucher numbering, the
	// Batch_Voucher block, the Waste_Movement Voucher back-fill (moved to
	// issueMaterialsHandover), and the notification mail (moved there too).
	//
	// An issue line is (unchanged from issueMaterials):
	//
	//   { "materialId":"123", "source":"Plan"|"Reissue", "isFabric":true,
	//     "cutWidth":55, "cutLength":55,
	//     "allocations":[
	//       { "mrqId":"777", "planId":"50", "planItemId":"888",
	//         "giveQty":5.50, "giveRaw":10, "giveWaste":4, "issuedLot":"901" } ],
	//     "lotMoves":[
	//       { "lotId":"901", "qty":11.00,
	//         "rolls":[ {"rollId":"1234","label":"L2-R1","metres":9.0} ] } ],
	//       -- "isPieces"/"pieces" (the old Fabric_Piece "cut at issue" fields)
	//          are no longer read. Printed fabric is ordinary short Lot_Rolls
	//          now (docs/printing-v2-plan.md); the allocator never sends them.
	//     "wastePicks":[
	//       { "wasteId":"456", "pieces":3, "planId":"50", "planItemId":"888",
	//         "yieldPer":2, "pieceWidth":300, "pieceLength":400 } ],
	//     "issueLines":[ ... ] }   -- issueLines is IGNORED here, it is for the
	//                                 handover call
	//
	// WRITE-CONTRACT:
	//  - Material_Requirement: Issued_Qty, Pieces_From_Raw, Pieces_From_Waste,
	//    Issued_Lot, Roll_Label (both written only when empty - the tone pin).
	//    Roll_Label is Step 4's prerequisite (lot-rolls-model.md): getExpectedWaste
	//    reads it to predict a tail per ROLL instead of per lot. Derived from
	//    each allocation's own "rolls" array (a.rolls) - the one label if this
	//    row drew from a single roll, or every roll it drew from joined
	//    "L2-R1 5m, L2-R2 1.05m" the same way the allocator's own display reads.
	//    Empty for a row served entirely by offcuts, same as Issued_Lot.
	//  - Waste_Master: Piece_Count down, In_Transit_Count up, Status="Issued" when
	//    emptied.
	//  - Waste_Movement "Issued": Piece_Count/Width/Length, Cut_Size_Width/Length,
	//    Pieces_Yielded, Waste_Piece, Plan, Plan_Item, Moved_By, Carton_Number.
	//    Voucher is left BLANK - issueMaterialsHandover fills it.
	//  - Raw_Material_Lot: Wash_Quantity down, In_Transit_Qty up.
	//  - Raw_Material: Wash_Quantity/Quantity down, In_Transit_Qty up.
	errJson = "";
	okJson = "";
	// The Waste_Movement "Issued" rows this chunk writes (one per waste pick,
	// across every material). Their Voucher is filled by
	// issueMaterialsHandover once the SIV exists - the caller unions these
	// ids across chunks and passes them there.
	//
	// Declared HERE, above the try, not inside it. Both lists must exist and be
	// readable from the catch block even if the function throws before a single
	// row is touched (e.g. a bad supervisorId) - the catch below reads them
	// unconditionally to report exactly what applied before any failure.
	wasteMvIds = List();
	// Requirement rows this call actually applied. Echoed back so the happy
	// path needs no reconcile query at all - the widget only has to ask
	// getIssueApplyStatus when a chunk gave it no answer.
	appliedMrq = List();
	// DEBUG WRAPPER: Creator reports every runtime failure as a generic
	// "code 9430 - There is an error while executing Custom API." Catching it
	// here surfaces the real Deluge message in the widget console instead.
	try
	{
		supId = supervisorId.trim().toLong();
		issues = issuesJson.toJSONList();
		keyTxt = ifnull(applyKey,"").toString().trim();
		info "issueMaterialsApply supId=" + supId + " issueCount=" + issues.size() + " applyKey=" + keyTxt;
		for each  issue in issues
		{
			// toJSONList() yields JSON objects, NOT Deluge Maps - .get() silently
			// returns null on those. .toMap() converts to a real Map first.
			im = issue.toMap();
			matId = im.get("materialId").toString();
			cwStr = ifnull(im.get("cutWidth"),"0").toString().trim();
			if(cwStr == "")
			{
				cwStr = "0";
			}
			clStr = ifnull(im.get("cutLength"),"0").toString().trim();
			if(clStr == "")
			{
				clStr = "0";
			}
			cutW = cwStr.toDecimal();
			cutL = clStr.toDecimal();
			allocs = ifnull(im.get("allocations"),"[]").toString().toJSONList();
			lotMoves = ifnull(im.get("lotMoves"),"[]").toString().toJSONList();
			picks = ifnull(im.get("wastePicks"),"[]").toString().toJSONList();
			matRec = Raw_Material[ID == matId.toLong()];
			if(matRec.count() == 0)
			{
				if(errJson != "")
				{
					errJson = errJson + ",";
				}
				errJson = errJson + "\"Material " + matId + " not found\"";
			}
			else
			{
				matName = ifnull(matRec.SKU,"").toString();
				isFab = matRec.Is_Fabric;
				if(isFab == true)
				{
					stkStr = ifnull(matRec.Wash_Quantity,"0").toString().trim();
				}
				else
				{
					stkStr = ifnull(matRec.Quantity,"0").toString().trim();
				}
				if(stkStr == "")
				{
					stkStr = "0";
				}
				available = stkStr.toDecimal();
				//--------------------------------------------------------------
				// 1. APPLY EACH ALLOCATION - one point lookup per requirement.
				//--------------------------------------------------------------
				issuedTotal = 0.0;
				piecesFromWasteTot = 0;
				piecesFromRawTot = 0;
				// RETRY GUARD FOR SECTIONS 2 AND 3 (waste picks, lot moves, roll
				// decrement). None of those carry their own Apply_Key the way
				// Material_Requirement does, so they cannot answer "did THIS
				// move already" on their own. Approximated instead off section
				// 1: if every allocation on this material line turns out to
				// already carry this press's Apply_Key, the whole line is a
				// pure retry of an already-landed chunk, and everything named in
				// its picks/lotMoves already moved with it - re-running would
				// move it a second time. Any allocation that is genuinely new
				// makes the whole line's moves due again.
				//
				// ASSUMES A RETRIED CHUNK IS ALL-OLD OR ALL-NEW, NEVER MIXED.
				// True because a retry replays the WHOLE chunk verbatim under
				// the same applyKey - either the first attempt's response was
				// lost after every row landed (all-old) or the call never
				// completed (all-new). The one way this could see a genuine
				// mixed line is main.js's isRateLimited() false-triggering on
				// error TEXT that happens to contain a match ("429" inside a
				// SKU like RM-4291) for a call that in fact failed outright with
				// SOME rows applied and some not - a real partial failure
				// misclassified as a retryable rate limit. Low probability
				// (main.js's own comment already accepts the false-positive
				// risk, "costs one wait"), not fixed here - narrowing that
				// matcher is a change to shared retry logic outside this fix's
				// scope. If it is ever tightened, this assumption is why.
				anyNewAlloc = false;
				for each  alloc in allocs
				{
					a = alloc.toMap();
					mrqId = ifnull(a.get("mrqId"),"").toString().trim();
					gqStr = ifnull(a.get("giveQty"),"0").toString().trim();
					if(gqStr == "")
					{
						gqStr = "0";
					}
					grStr = ifnull(a.get("giveRaw"),"0").toString().trim();
					if(grStr == "")
					{
						grStr = "0";
					}
					gwStr = ifnull(a.get("giveWaste"),"0").toString().trim();
					if(gwStr == "")
					{
						gwStr = "0";
					}
					giveQty = gqStr.toDecimal();
					giveRaw = grStr.toDecimal().toLong();
					giveWaste = gwStr.toDecimal().toLong();
					issLotStr = ifnull(a.get("issuedLot"),"").toString().trim();
					// THE ROLL(S) THIS ROW'S FRESH CLOTH CAME OFF, lot-rolls-model.md
					// Step 4's prerequisite. issueMaterialsHandover only ever learns
					// the AGGREGATE roll picture for a whole material x lot line,
					// which can span many requirement rows - so this is the one place
					// that still has the per-REQUIREMENT breakdown the allocator
					// computed (main.js's rollsByMrq, forwarded here as a.rolls).
					// Built the same way buildHandoverSummary's rollLabel is: the
					// single label, or every roll this row drew from joined the same
					// way the allocator's own on-screen summary reads.
					// READ THE READY-BUILT STRING, exactly as issueMaterialsHandover
					// reads its own `rollLabel` field. The old code tried to parse
					// a.get("rolls") (a nested array) with .toString().toJSONList()
					// - and .toString() on a Deluge list-of-maps is
					// "[{label=R1, metres=6.75}]", NOT valid JSON, so .toJSONList()
					// yielded nothing and Material_Requirement.Roll_Label was
					// silently never written even though Issue_Lines.Roll_Label
					// (fed the same way the handover is) always got it. The widget
					// now sends the string; `rolls` stays only for the per-roll
					// metre decrement in section 3.
					rowRollLabel = ifnull(a.get("rollLabel"),"").toString().replaceAll("\"","'").trim();
					mrqRecs = Material_Requirement[ID == mrqId.toLong()];
					if(mrqId == "" || mrqRecs.count() == 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + ": requirement " + mrqId + " not found\"";
					}
					else
					{
						for each  mrq in mrqRecs
						{
							// RETRY GUARD. If this exact row already carries THIS
							// press's Apply_Key, the counters below already ran for
							// it - a rate-limit retry replays the same chunk under
							// the same applyKey when the first attempt's response
							// was lost but its writes landed. Re-adding giveQty a
							// second time would double Issued_Qty and every stock
							// move that follows. Skip the counters, still count the
							// row as applied so the response (and appliedMrq) stay
							// correct.
							alreadyApplied = keyTxt != "" && ifnull(mrq.Apply_Key,"").toString().trim() == keyTxt;
							if(alreadyApplied == false)
							{
								// THE FAN-OUT WATERMARK, WRITTEN FIRST ON PURPOSE.
								//
								// This row now carries the id of the press that moved it, so
								// getIssueApplyStatus can tell the handover EXACTLY which rows
								// fanned out - instead of the widget inferring it from which
								// HTTP calls came back. The statement limit is NOT catchable:
								// it kills the script mid-chunk with no response at all, so a
								// chunk that "failed" may still have applied most of its rows.
								// Without this they move stock and get no Issue_Line, and that
								// material can never be received - it sits in In_Transit_Qty
								// for ever with nothing anywhere saying so.
								//
								// FIRST, BEFORE THE COUNTERS, and the order is the whole
								// argument. Dying between them loses one row either way.
								// Key-then-counters leaves a row STAMPED but not yet counted:
								// getIssueApplyStatus and the handover pick it up, the
								// supervisor sees it as issued, and if the stock in fact never
								// moved he disputes it on receipt - which is what the dispute
								// flow exists for. Counters-then-key is the invisible outcome:
								// stock already moved OUT of the row but no key means
								// getIssueApplyStatus never finds it and it is silently
								// stranded in In_Transit_Qty for ever. A visible disagreement
								// beats an invisible one.
								if(keyTxt != "")
								{
									mrq.Apply_Key=keyTxt;
								}
								mrq.Issued_Qty=ifnull(mrq.Issued_Qty,0) + giveQty;
								if(isFab == true)
								{
									mrq.Pieces_From_Raw=ifnull(mrq.Pieces_From_Raw,0) + giveRaw;
									mrq.Pieces_From_Waste=ifnull(mrq.Pieces_From_Waste,0) + giveWaste;
									// WRITTEN ONLY WHEN EMPTY. The first lot decides the
									// tone; a second write would rewrite history, and the
									// widget reads this back to pin the next issue.
									if(issLotStr != "" && ifnull(mrq.Issued_Lot,"").toString().trim() == "")
									{
										mrq.Issued_Lot=issLotStr.toLong();
									}
									// SAME TONE-PIN RULE, for the roll(s). A row served
									// entirely by offcuts has no rolls at all - rowRollLabel
									// stays "" and nothing is written, exactly as Issued_Lot
									// is left alone when issLotStr is empty.
									if(rowRollLabel != "" && ifnull(mrq.Roll_Label,"").toString().trim() == "")
									{
										mrq.Roll_Label=rowRollLabel;
									}
								}
							}
						}
						appliedMrq.add(mrqId);
						if(alreadyApplied == false)
						{
							issuedTotal = issuedTotal + giveQty;
							piecesFromWasteTot = piecesFromWasteTot + giveWaste;
							piecesFromRawTot = piecesFromRawTot + giveRaw;
							anyNewAlloc = true;
						}
					}
				}
				// No allocations on this line at all (should not happen for a
				// lotMoves-bearing line in practice, but never silently skip a
				// roll decrement for a shape this guard was not designed to
				// judge) - default to "due", the behaviour before this guard
				// existed.
				if(allocs.size() == 0)
				{
					anyNewAlloc = true;
				}
				//--------------------------------------------------------------
				// 2. CONSUME REMNANT PICKS. One point lookup per Waste_Master.
				//--------------------------------------------------------------
				physicalPcs = 0;
				for each  pkRaw in picks
				{
					pk = pkRaw.toMap();
					wId = ifnull(pk.get("wasteId"),"").toString().trim();
					pcStr = ifnull(pk.get("pieces"),"0").toString().trim();
					if(pcStr == "")
					{
						pcStr = "0";
					}
					takePcs = pcStr.toDecimal().toLong();
					ypStr = ifnull(pk.get("yieldPer"),"0").toString().trim();
					if(ypStr == "")
					{
						ypStr = "0";
					}
					yieldPer = ypStr.toDecimal().toLong();
					pwStr = ifnull(pk.get("pieceWidth"),"0").toString().trim();
					if(pwStr == "")
					{
						pwStr = "0";
					}
					plStr = ifnull(pk.get("pieceLength"),"0").toString().trim();
					if(plStr == "")
					{
						plStr = "0";
					}
					// PER-PICK CUT SIZE. A SKU issue line no longer carries one
					// cut - it spans several - so the Waste_Movement's Cut_Size_*
					// comes from the pick's own target item. Falls back to the
					// wrapper cutW/cutL for an older widget that did not send it.
					pkCwStr = ifnull(pk.get("cutW"),"").toString().trim();
					if(pkCwStr == "")
					{
						pkCutW = cutW;
					}
					else
					{
						pkCutW = pkCwStr.toDecimal();
					}
					pkClStr = ifnull(pk.get("cutL"),"").toString().trim();
					if(pkClStr == "")
					{
						pkCutL = cutL;
					}
					else
					{
						pkCutL = pkClStr.toDecimal();
					}
					pkPlanStr = ifnull(pk.get("planId"),"").toString().trim();
					pkItemStr = ifnull(pk.get("planItemId"),"").toString().trim();
					wRecs = Waste_Master[ID == wId.toLong()];
					if(wId == "" || wRecs.count() == 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + ": waste piece " + wId + " not found\"";
					}
					else if(takePcs <= 0)
					{
						info "issueMaterialsApply: waste pick " + wId + " asked 0 pieces - skipped";
					}
					else if(anyNewAlloc == false)
					{
						// RETRY GUARD, same class as section 3's. A rate-limit
						// retry replays this whole chunk under the same applyKey
						// when the first attempt's writes landed but its response
						// was lost - section 1 already found every allocation on
						// this line pre-stamped and set anyNewAlloc false. Without
						// this, a retried pick would consume Waste_Master a second
						// time AND mint a second "Issued" Waste_Movement carrying
						// the SAME Apply_Key - getIssueApplyStatus would then hand
						// the handover two movement ids for one physical pick,
						// each independently receivable: double-receivable waste.
						info "issueMaterialsApply: waste pick " + wId + " skipped - this line already applied under key " + keyTxt;
					}
					else
					{
						pkCarton = "";
						for each  wRec in wRecs
						{
							haveStr = ifnull(wRec.Piece_Count,"0").toString().trim();
							if(haveStr == "")
							{
								haveStr = "0";
							}
							transStr2 = ifnull(wRec.In_Transit_Count,"0").toString().trim();
							if(transStr2 == "")
							{
								transStr2 = "0";
							}
							// The carton the store racked this offcut in, captured
							// here where the Waste_Master row is already open, and
							// stamped onto the Issued movement below so History
							// shows "where it was" with no hop back to the master.
							pkCarton = ifnull(wRec.Carton_Number,"").toString().trim();
							leftPcs = haveStr.toDecimal().toLong() - takePcs;
							if(leftPcs < 0)
							{
								if(errJson != "")
								{
									errJson = errJson + ",";
								}
								errJson = errJson + "\"" + matName + ": waste piece " + wId + " only has " + haveStr.toDecimal().toLong() + ", asked " + takePcs + " - clamped\"";
								info "issueMaterialsApply: waste " + wId + " would go negative - clamped to 0";
								leftPcs = 0;
							}
							wRec.Piece_Count=leftPcs;
							wRec.In_Transit_Count=transStr2.toDecimal().toLong() + takePcs;
							if(leftPcs <= 0)
							{
								wRec.Status="Issued";
							}
						}
						physicalPcs = physicalPcs + takePcs;
						// An Issued movement replaces the Waste_Issued subform row.
						// No Received_Count here - receipt is its own movement
						// pointing back at this one. Voucher is left blank and
						// filled by issueMaterialsHandover.
						//
						// Apply_Key is stamped INSIDE this insert, not in a follow-up
						// update loop - same watermark as the requirement rows above,
						// same reason. A statement-limit kill right after the insert
						// would otherwise leave the row created with a blank key,
						// findable by nothing: getIssueApplyStatus filters on
						// Apply_Key, so an un-stamped movement never reaches the
						// handover and its SIV is never filled in. Stamping it in the
						// same statement as the insert removes that window entirely.
						newMvId = insert into Waste_Movement
						[
							Movement_Type="Issued"
							Piece_Width=pwStr.toDecimal()
							Piece_Length=plStr.toDecimal()
							Piece_Count=takePcs
							Cut_Size_Width=pkCutW
							Cut_Size_Length=pkCutL
							Pieces_Yielded=takePcs * yieldPer
							Moved_On=zoho.currentdate
							Added_User=zoho.loginuser
							Apply_Key=keyTxt
						];
						for each  mv in Waste_Movement[ID == newMvId.toLong()]
						{
							mv.Waste_Piece=wId.toLong();
							if(pkPlanStr != "")
							{
								mv.Plan=pkPlanStr.toLong();
							}
							if(pkItemStr != "")
							{
								mv.Plan_Item=pkItemStr;
							}
							mv.Moved_By=supId;
							if(pkCarton != "")
							{
								mv.Carton_Number=pkCarton;
							}
						}
						wasteMvIds.add(newMvId.toString());
					}
				}
				//--------------------------------------------------------------
				// 3. MOVE LOT STOCK. One point lookup per lot, per piece.
				//--------------------------------------------------------------
				for each  lmRaw in lotMoves
				{
					lm = lmRaw.toMap();
					lotId = ifnull(lm.get("lotId"),"").toString().trim();
					lqStr = ifnull(lm.get("qty"),"0").toString().trim();
					if(lqStr == "")
					{
						lqStr = "0";
					}
					moveQty = lqStr.toDecimal();
					lotRecs = Raw_Material_Lot[ID == lotId.toLong()];
					if(lotId == "" || lotRecs.count() == 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + ": lot " + lotId + " not found\"";
					}
					else if(anyNewAlloc == false)
					{
						// RETRY GUARD FOR THE WHOLE LOT MOVE, 3a AND 3b TOGETHER.
						// A rate-limit retry replays this chunk under the same
						// applyKey when the first attempt's writes landed but its
						// response was lost - section 1 above already detected
						// that (every allocation on this line already carried
						// this Apply_Key) and set anyNewAlloc false. Skipping ONLY
						// the roll decrement here and letting Wash_Quantity
						// decrement again would desync the two invariants against
						// each other worse than either alone: Wash_Quantity wrong
						// by one extra moveQty, Roll_Length correct, and
						// verifyLotSync has no way to tell which one lied. Both
						// move together, or neither does.
						info "issueMaterialsApply: lot " + lotId + " move skipped - this line already applied under key " + keyTxt;
					}
					else
					{
						for each  lotMv in lotRecs
						{
							lmwS = ifnull(lotMv.Wash_Quantity,"0").toString().trim();
							if(lmwS == "")
							{
								lmwS = "0";
							}
							lmtS = ifnull(lotMv.In_Transit_Qty,"0").toString().trim();
							if(lmtS == "")
							{
								lmtS = "0";
							}
							newWash = lmwS.toDecimal() - moveQty;
							if(newWash < 0)
							{
								if(errJson != "")
								{
									errJson = errJson + ",";
								}
								errJson = errJson + "\"" + matName + ": lot " + ifnull(lotMv.Lot_Number,lotId).toString() + " has " + lmwS.toDecimal() + " washed, asked " + moveQty + " - clamped\"";
								info "issueMaterialsApply: lot " + lotId + " Wash_Quantity would go negative - clamped to 0";
								newWash = 0;
							}
							lotMv.Wash_Quantity=newWash;
							lotMv.In_Transit_Qty=lmtS.toDecimal() + moveQty;
						}
						//----------------------------------------------------
						// 3b. DECREMENT THE NAMED ROLL(S). lot-rolls-model.md
						// Step 5. The lot-level Wash_Quantity above is the
						// existing invariant readers still depend on; this is
						// the ADDITIONAL per-roll ledger the allocator's roll
						// choice depends on being kept in sync.
						//
						// THROUGH THE PARENT, NOT A BARE SUBFORM QUERY.
						// Lot_Rolls is a subform nested under Raw_Material_Lot
						// (lot-rolls-model.md Step 0) - it is not a standalone
						// form, and querying it directly ("Lot_Rolls[ID == …]")
						// would be the first place in this repo to do that.
						// Every other writer (seedLotRolls.dg) reaches a
						// Lot_Rolls row only through its parent -
						// lotRec.Lot_Rolls.insert(...), for each in
						// lotRec.Lot_Rolls - so this hops through the SAME
						// lotRecs query result the Wash_Quantity block above
						// already opened, re-iterated under a second loop
						// variable (lotMv2, not lotMv) rather than a bare
						// Lot_Rolls[ID==...] query. This re-iterates lotRecs a
						// second time SEQUENTIALLY, after the first for-each has
						// fully closed - not the "two live iterators over the
						// same list" failure mode CLAUDE.md documents, which is
						// simultaneous iteration. Still unverified here (no
						// Execute yet) alongside the parent-hop pattern itself.
						//
						// RE-READ FRESH, INSIDE THIS EXECUTION, IMMEDIATELY
						// BEFORE THE DECREMENT - the concurrency rule in the
						// doc. The allocator read Roll_Length once, on the
						// widget, before this call; two issues racing the same
						// roll would both see it at full length there. Reading
						// it again here, right before writing, is what a
						// second concurrent issue actually sees.
						//
						// CAP AND ERROR, NEVER SPILL. If the payload asks for
						// more than THIS roll currently holds, clamp to what
						// is there and report it - never take the shortfall
						// off a different roll. The allocator read the same
						// rolls the widget displayed, so this firing means the
						// data moved between read and write (a concurrent
						// issue, a receive, a dispute correction) - a
						// concurrency failure to report, not a shortfall to
						// solve here.
						//----------------------------------------------------
						rollsIn = ifnull(lm.get("rolls"),"[]").toString().toJSONList();
						for each  rlRaw in rollsIn
						{
							rl = rlRaw.toMap();
							rlId = ifnull(rl.get("rollId"),"").toString().trim();
							rlLabel = ifnull(rl.get("label"),"").toString().trim();
							rlMtrStr = ifnull(rl.get("metres"),"0").toString().trim();
							if(rlMtrStr == "")
							{
								rlMtrStr = "0";
							}
							rlMtr = rlMtrStr.toDecimal();
							if(rlId != "" && rlId.isNumber() == true && rlMtr > 0)
							{
								rollFound = false;
								for each  lotMv2 in lotRecs
								{
									for each  rollRow in lotMv2.Lot_Rolls
									{
										if(rollRow.ID.toString() == rlId)
										{
											rollFound = true;
											rlHaveStr = ifnull(rollRow.Roll_Length,"0").toString().trim();
											if(rlHaveStr == "")
											{
												rlHaveStr = "0";
											}
											rlHave = rlHaveStr.toDecimal();
											rlTake = rlMtr;
											if(rlTake > rlHave)
											{
												if(errJson != "")
												{
													errJson = errJson + ",";
												}
												errJson = errJson + "\"" + matName + ": roll " + ifnull(rollRow.Roll_Label,rlLabel).toString() + " has " + rlHave + "m, asked " + rlMtr + "m - clamped, check for a concurrent issue\"";
												info "issueMaterialsApply: roll " + rlId + " Roll_Length would go negative - clamped to 0";
												rlTake = rlHave;
											}
											rlLeft = rlHave - rlTake;
											rollRow.Roll_Length = rlLeft;
											if(rlLeft <= 0)
											{
												rollRow.Roll_Status = "Consumed";
											}
										}
									}
								}
								if(rollFound == false)
								{
									if(errJson != "")
									{
										errJson = errJson + ",";
									}
									errJson = errJson + "\"" + matName + ": roll " + rlLabel + " (" + rlId + ") not found on lot " + lotId + "\"";
								}
							}
						}
						// FABRIC_PIECE "cut pieces at issue" WRITER REMOVED HERE.
						// Printed fabric is ordinary short Lot_Rolls now
						// (docs/printing-v2-plan.md) - the allocator has hard-coded
						// every lotLines[].pieces = [] since the rolls migration, so
						// this branch (isPieces == true, a populated lm.get("pieces"))
						// could never fire from any live caller; tools/print-cut.test.js
						// pinned that asymmetry until this cleanup landed. The 3a/3b
						// blocks above (Wash_Quantity/In_Transit_Qty, the named-roll
						// decrement) are the live path for every lot move, printed or
						// not, and are unchanged.
					}
				}
				//--------------------------------------------------------------
				// 4. MOVE PARENT Raw_Material STOCK - once per material line.
				//
				// Move the stock, do NOT consume it. The shelf figure drops so the
				// same cloth cannot be promised to a second supervisor, but the
				// company still owns it - it is on a trolley, not in a garment. It
				// is consumed only when the supervisor confirms receipt.
				//--------------------------------------------------------------
				balance = available - issuedTotal;
				if(isFab == true)
				{
					matRec.Wash_Quantity=balance;
					qU = ifnull(matRec.Unwash_Quantity,"0").toString().trim();
					qA = ifnull(matRec.Unallocated_Qty,"0").toString().trim();
					matRec.Quantity=balance + if(qU == "",0.0,qU.toDecimal()) + if(qA == "",0.0,qA.toDecimal());
				}
				else
				{
					matRec.Quantity=balance;
				}
				transStr = ifnull(matRec.In_Transit_Qty,"0").toString().trim();
				if(transStr == "")
				{
					transStr = "0";
				}
				matRec.In_Transit_Qty=transStr.toDecimal() + issuedTotal;
				if(okJson != "")
				{
					okJson = okJson + ",";
				}
				// IDs forced to string - 18-digit ids break JSON.parse otherwise.
				okJson = okJson + "{\"materialId\":\"" + matId + "\",\"sku\":\"" + matName + "\",\"qty\":" + issuedTotal + ",\"balance\":" + balance + ",\"wastePiecesIssued\":" + physicalPcs + ",\"piecesFromWaste\":" + piecesFromWasteTot + ",\"piecesFromRaw\":" + piecesFromRawTot + "}";
			}
		}
	}
	catch (e)
	{
		// Surfaces as an alert in the widget via the existing errors[] handling.
		//
		// appliedMrq / wasteMvIds are NOT reset here - Deluge has no block scope,
		// so whatever this call accumulated before the throw is still sitting in
		// those two lists, declared at the top of the outer try. A caught
		// exception (a bad record, a type surprise) after N rows already applied
		// must still report those N: hardcoding empty arrays here was the exact
		// silent-stranding bug the applyKey watermark exists to close, on a
		// second path - the widget saw zero applied, moved on, and never asked
		// getIssueApplyStatus because the response looked complete, not missing.
		errTxt = "DELUGE: " + e.toString().replaceAll("\"","'");
		wmJson2 = "";
		for each  w in wasteMvIds
		{
			if(wmJson2 != "")
			{
				wmJson2 = wmJson2 + ",";
			}
			wmJson2 = wmJson2 + "\"" + w + "\"";
		}
		amJson2 = "";
		for each  am in appliedMrq
		{
			if(amJson2 != "")
			{
				amJson2 = amJson2 + ",";
			}
			amJson2 = amJson2 + "\"" + am + "\"";
		}
		return "{\"errors\":[\"" + errTxt + "\"],\"issued\":[],\"wasteMvIds\":[" + wmJson2 + "],\"appliedMrqIds\":[" + amJson2 + "]}";
	}
	// Built by hand - List.toString() does not reliably wrap in [].
	// wasteMvIds: the Waste_Movement rows this chunk created. The caller unions
	// them across chunks and passes them to issueMaterialsHandover, which stamps
	// the SIV on each once the voucher record exists.
	wmJson = "";
	for each  w in wasteMvIds
	{
		if(wmJson != "")
		{
			wmJson = wmJson + ",";
		}
		wmJson = wmJson + "\"" + w + "\"";
	}
	amJson = "";
	for each  am in appliedMrq
	{
		if(amJson != "")
		{
			amJson = amJson + ",";
		}
		amJson = amJson + "\"" + am + "\"";
	}
	return "{\"errors\":[" + errJson + "],\"issued\":[" + okJson + "],\"wasteMvIds\":[" + wmJson + "],\"appliedMrqIds\":[" + amJson + "]}";
}
