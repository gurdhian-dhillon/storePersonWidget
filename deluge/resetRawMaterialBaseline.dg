string resetRawMaterialBaseline(string dryRun)
{
	res = "{\"errors\":[\"Nothing ran\"]}";
	try
	{
		writeAllowed = true;
		dr = ifnull(dryRun,"").toString().trim().toLowerCase();
		if(dr == "true" || dr == "yes" || dr == "1")
		{
			writeAllowed = false;
		}
		updated = 0;
		missing = 0;
		missTxt = "";
		rowsJson = "";
		for each  specTxt in {"RM-00001|1|1037.60|0.00|1037.60","RM-00002|1|3161.28|0.00|3161.28","RM-00003|1|1600.00|0.00|1600.00","RM-00004|1|1770.50|0.00|1770.50","RM-00005|1|1236.20|0.00|1236.20","RM-00006|1|1474.15|0.00|1474.15","RM-00007|1|1700.00|0.00|1700.00","RM-00008|1|1756.35|0.00|1756.35","RM-00009|1|1107.20|0.00|1107.20","RM-00010|1|1685.54|0.00|1685.54","RM-00011|1|2131.60|0.00|2131.60","RM-00012|0|5780.00|0.00|0.00","RM-00013|0|3652.00|0.00|0.00","RM-00014|0|12888.00|0.00|0.00","RM-00015|0|7500.00|0.00|0.00","RM-00016|0|8795.00|0.00|0.00","RM-00017|0|316.00|0.00|0.00","RM-00018|0|10440.00|0.00|0.00","RM-00019|0|12888.00|0.00|0.00","RM-00020|0|4562.00|0.00|0.00","RM-00021|0|260.00|0.00|0.00","RM-00022|0|180.00|0.00|0.00","RM-00023|1|495.80|0.00|495.80"}
		{
			parts = specTxt.toList("|");
			sku = parts.get(0).toString().trim();
			isFab = parts.get(1).toString().trim() == "1";
			totQ = parts.get(2).toString().toDecimal();
			unwQ = parts.get(3).toString().toDecimal();
			wshQ = parts.get(4).toString().toDecimal();
			found = false;
			for each  rmRec in Raw_Material[SKU == sku]
			{
				found = true;
				if(writeAllowed == true)
				{
					if(isFab == true)
					{
						rmRec.Unwash_Quantity = unwQ;
						rmRec.Wash_Quantity = wshQ;
					}
					rmRec.Quantity = totQ;
					rmRec.In_Transit_Qty = 0;
					rmRec.Disputed_Qty = 0;
					rmRec.In_Wash_Qty = 0;
					rmRec.Unallocated_Qty = 0;
				}
				updated = updated + 1;
			}
			if(found == false)
			{
				missing = missing + 1;
				if(missTxt != "")
				{
					missTxt = missTxt + ", ";
				}
				missTxt = missTxt + sku;
			}
			else
			{
				if(rowsJson != "")
				{
					rowsJson = rowsJson + ",";
				}
				rowsJson = rowsJson + "{\"sku\":\"" + sku + "\",\"total\":" + totQ + ",\"unwash\":" + unwQ + ",\"wash\":" + wshQ + "}";
			}
		}
		res = "{\"errors\":[],\"dryRun\":" + (!writeAllowed).toString() + ",\"updated\":" + updated + ",\"skuNotFound\":" + missing + ",\"missing\":\"" + missTxt + "\",\"rows\":[" + rowsJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}
	return res;
}
