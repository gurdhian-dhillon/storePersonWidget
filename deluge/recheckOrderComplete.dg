string recheckOrderComplete(string orderIdTxt)
{
	// Recomputes where a sales order should be, and moves it there. It owns BOTH
	// post-production statuses: "Finishing Complete" and "Checking Passed".
	//
	// THE ORDER IS PRODUCTION COMPLETE -> FINISHING COMPLETE -> CHECKING PASSED ->
	// PACKED. Finishing (thread cutting, pressing) now runs BEFORE checking, and
	// folding, branding and boxing happen on the packing screen after it. So
	// Finishing Complete means every batch is off the floor and has had its
	// finishing closed; Checking Passed means every item is Complete and the
	// ordered quantity has been accepted. Packing only takes an order that has
	// Checking Passed.
	//
	// A PLAIN DELUGE FUNCTION, NOT A CUSTOM API. Nothing calls it from a widget -
	// it is called through thisapp by every function that can change the answer:
	//
	//   saveItemCheck          - the last step of every check
	//   closeAlterationBatch   - a batch closing with 0 survivors, which never
	//                            reaches a check at all
	//   saveProductionPhase    - an item completing with 0 produced, same reason
	//   completeFinishingJob   - a batch finished, and it may be the last one
	//   Sales_Order workflow   - on edit, when Short_Closed is ticked
	//
	// THE FINISHING TEST IS IN HERE, NOT IN A SECOND FUNCTION. It briefly lived
	// in recheckFinishingComplete, called from this one - which made the chain
	// saveItemCheck -> recheckOrderComplete -> recheckFinishingComplete two
	// levels of thisapp deep, something nothing else in this app does. Folding it
	// in removes the question rather than betting on the answer, and it kills the
	// ordering problem with it: there is no longer a pair of functions that have
	// to be called in the right sequence for an order to reach packing. One
	// function, one pass, both statuses. **recheckFinishingComplete is deleted.**
	//
	// FIVE CALLERS, ONE WRITER. The old design kept this logic inside
	// createRemakeItems and relied on the Quality_Check record being re-saved to
	// re-run it. There is no such record now, so nothing can be re-saved - every
	// path that can satisfy an order has to say so itself. Miss one and the order
	// hangs at "Production Complete" for ever with nothing on any screen to press.
	//
	// THE TEST IS PER ORIGINAL LINE, not per item and not a plan-wide total. A
	// line is satisfied when everything accepted for it - its own acceptances plus
	// every batch that hangs off it - reaches what the customer ordered. Remake_Of
	// always points at the ROOT line, never at the previous batch, so this is one
	// flat pass instead of a recursive walk, and Deluge has no recursion.
	//
	// IT NEVER THROWS. Its own try/catch, returning the failure as text. Callers
	// invoke it AFTER they have already written records, and Deluge has no
	// transaction to roll back - so an exception here would make a completed check
	// report itself failed, the user would retry, and the idempotency guard would
	// refuse the retry. Same reasoning as the try/catch around sendmail in
	// createProductionPlans: a late step failing must not invalidate a finished
	// one. The return string is for the caller's info log.

	verdict = "NOTHING RAN";

	try
	{
		idTxt = ifnull(orderIdTxt,"").toString().trim();

		if(idTxt == "" || idTxt.isNumber() == false)
		{
			verdict = "SKIP: missing or non-numeric orderId ('" + idTxt + "')";
		}
		else
		{
			orderId = idTxt.toLong();

			// Read before anything is decided. Short_Closed is somebody deciding on
			// the record that fewer pieces is the final answer - it forgives the
			// quantity test and nothing else.
			orderFound = false;
			shortClosed = false;
			statusNow = "";

			for each  soChk in Sales_Order[ID == orderId]
			{
				orderFound = true;
				statusNow = ifnull(soChk.Order_Status,"").toString().trim();

				if(ifnull(soChk.Short_Closed,false) == true)
				{
					shortClosed = true;
				}
			}

			if(orderFound == false)
			{
				verdict = "SKIP: no Sales_Order " + orderId;
			}
			else
			{
				//----------------------------------------------------------
				// ONE PASS over every item on the order, gathering both answers
				// at once: whether anything is still being made, and how much has
				// been accepted against each original line.
				//
				// Deliberately NOT a query per root line. An order with ten lines
				// and three batches each would be thirty extra queries, and the
				// statement-execution limit is not catchable - it kills the script
				// and the caller sees a bare 500 with no error card.
				//
				// Ids are forced to string on BOTH sides of the key. Remake_Of is
				// a lookup holding a record id and ID is a long; comparing them
				// as-is is a mixed-type comparison, which throws.
				//----------------------------------------------------------
				orderedByRoot = Map();
				acceptedByRoot = Map();
				nameByRoot = Map();
				rootKeys = List();

				itemCount = 0;
				stillMaking = false;
				inProduction = false;
				awaitingFinish = false;
				openNames = "";
				productionNames = "";
				finishNames = "";
				orphanNames = "";

				for each  plR in Production_Planning[Sales_Order == orderId]
				{
					// FINISHING IS READ ONCE PER PLAN, NOT ONCE PER BATCH. Every
					// finished batch calls this function, so a query per
					// Awaiting_Check item inside the walk costs about n squared
					// halves across an order - on a 110-batch order that is the
					// shape that reaches the uncatchable statement limit. One
					// query on Finishing_Data.Plan returns every Done batch of
					// the plan, held as a list of item ids AS STRINGS.
					doneItemKeys = List();

					for each  fdP in Finishing_Data[Plan == plR.ID && Finishing_Status == "Done"]
					{
						if(fdP.Plan_Item != null)
						{
							doneItemKeys.add(fdP.Plan_Item.toString());
						}
					}

					for each  itR in Plan_Item[Plan == plR.ID]
					{
						itemCount = itemCount + 1;

						stTxt = ifnull(itR.Item_Status,"").toString().trim();

						// Awaiting_Check counts as still making. It is the whole
						// point of the status: an item nobody has inspected has not
						// finished, whatever production thinks. stillMaking is the
						// CHECKING test - anything short of Complete holds
						// Checking Passed back.
						if(stTxt != "Complete")
						{
							stillMaking = true;

							if(openNames != "")
							{
								openNames = openNames + ", ";
							}
							openNames = openNames + ifnull(itR.Item_Name,"").toString() + " (" + stTxt + ")";
						}

						// THE FINISHING TEST SPLITS THAT SAME STATUS IN TWO.
						// Awaiting_Check means production is over, and finishing
						// now runs between that and the inspector, so an
						// Awaiting_Check batch is either waiting to be finished
						// or finished and waiting to be checked - told apart by
						// its Finishing_Data row reading Done. Anything before
						// Awaiting_Check is still on the floor. Complete has
						// been through both, since saveItemCheck refuses an
						// unfinished batch.
						//
						// The test is a list lookup against the plan's Done batches,
						// read once above, so it costs no query per batch.
						if(stTxt == "Awaiting_Check")
						{
							if(doneItemKeys.contains(itR.ID.toString()) == false)
							{
								awaitingFinish = true;

								if(finishNames != "")
								{
									finishNames = finishNames + ", ";
								}
								finishNames = finishNames + ifnull(itR.Item_Name,"").toString();
							}
						}
						else if(stTxt != "Complete")
						{
							inProduction = true;

							if(productionNames != "")
							{
								productionNames = productionNames + ", ";
							}
							productionNames = productionNames + ifnull(itR.Item_Name,"").toString() + " (" + stTxt + ")";
						}

						// A Creator numeric never written is an EMPTY STRING, not
						// null, and toDecimal() throws on it.
						accS = ifnull(itR.Qty_Accepted,"0").toString().trim();
						if(accS == "")
						{
							accS = "0";
						}

						isRm = ifnull(itR.Is_Remake,false);

						rootKey = itR.ID.toString();
						if(isRm == true && itR.Remake_Of != null)
						{
							rootKey = itR.Remake_Of.toString();
						}

						// A batch with no Remake_Of cannot be attributed to a line,
						// so its acceptances would be silently lost. Cannot happen
						// through saveItemCheck, which always stamps the root - but
						// it is exactly the kind of loss that must not be quiet.
						if(isRm == true && itR.Remake_Of == null)
						{
							if(orphanNames != "")
							{
								orphanNames = orphanNames + ", ";
							}
							orphanNames = orphanNames + ifnull(itR.Item_Name,"").toString();
						}

						// Map values kept as strings throughout - a Map holding a
						// mix of Decimal and String is one more chance at a
						// mixed-type comparison further down.
						haveAcc = ifnull(acceptedByRoot.get(rootKey),"0").toString().trim();
						if(haveAcc == "")
						{
							haveAcc = "0";
						}
						acceptedByRoot.put(rootKey,(haveAcc.toDecimal() + accS.toDecimal()).toString());

						// ORDERED comes only from original lines. A batch replaces
						// pieces the customer already bought, so counting its
						// Qty_Ordered would turn a 100-piece order into 110.
						//
						// Is_Remake reads EMPTY, not false, on anything written
						// before the field existed, so the false test is the right
						// way round - those records are original lines.
						if(isRm == false)
						{
							ordS = ifnull(itR.Qty_Ordered,"0").toString().trim();
							if(ordS == "")
							{
								ordS = "0";
							}

							orderedByRoot.put(rootKey,ordS);
							nameByRoot.put(rootKey,ifnull(itR.Item_Name,"").toString());

							if(rootKeys.contains(rootKey) == false)
							{
								rootKeys.add(rootKey);
							}
						}
					}
				}

				//----------------------------------------------------------
				// Is every original line satisfied?
				//----------------------------------------------------------
				checkedAny = false;
				whole = true;
				shortLines = "";

				for each  rk in rootKeys
				{
					checkedAny = true;

					ordTxt = ifnull(orderedByRoot.get(rk),"0").toString().trim();
					if(ordTxt == "")
					{
						ordTxt = "0";
					}
					accTxt = ifnull(acceptedByRoot.get(rk),"0").toString().trim();
					if(accTxt == "")
					{
						accTxt = "0";
					}

					ordN = ordTxt.toDecimal();
					accN = accTxt.toDecimal();

					if(accN < ordN && shortClosed == false)
					{
						whole = false;

						if(shortLines != "")
						{
							shortLines = shortLines + "; ";
						}
						shortLines = shortLines + ifnull(nameByRoot.get(rk),"").toString() + " " + accN + " of " + ordN;
					}
				}

				if(itemCount == 0)
				{
					verdict = "SKIP: order " + orderId + " has no plan items";
				}
				else if(checkedAny == false)
				{
					verdict = "SKIP: order " + orderId + " has no original lines";
				}
				else
				{
					//--------------------------------------------------
					// TWO STATUSES CAN FOLLOW, IN ORDER, AND BOTH ARE DECIDED IN
					// THIS ONE PASS: "Finishing Complete", then "Checking Passed".
					//
					// FINISHING RUNS BEFORE CHECKING. A batch comes off the
					// floor, is thread-cut and pressed, and only then is it
					// inspected. So the order reads Production Complete while
					// batches are still being finished, Finishing Complete once
					// every batch that exists has been, and Checking Passed once
					// the inspector has accepted the whole quantity.
					//
					// FORWARD ONLY. This runs on every finishing close and every
					// check, and once a test is satisfied it stays satisfied - so
					// an unguarded write would drag an order back from Packed or
					// Dispatched and put it in front of packing a second time.
					// Same rule saveProductionPhase applies to the order and
					// resolveDispute applies to the plan. The one legitimate
					// backward move is saveItemCheck pulling an order to In
					// Progress when a rejection opens a new batch, and that is
					// its own write, not this function's.
					//--------------------------------------------------
					verdict = "NO MOVE: order " + orderId + " is '" + statusNow + "'";

					//--------------------------------------------------
					// 1. FINISHING COMPLETE: every batch is off the floor AND
					// every batch that is waiting for the checker has had its
					// finishing closed.
					//
					// Neither half stands alone. A batch still being cut has no
					// finishing row to be missing, so a test that only read
					// Finishing_Data would pass an order that is mostly unmade.
					// And Short_Closed does NOT forgive either half - it is an
					// answer about quantity, not a statement that unfinished
					// work has stopped.
					//
					// There is no quantity test here, deliberately. Pieces lost
					// in production are replaced by a Production_Loss batch
					// sitting at Awaiting_Material, which is "in production"
					// above and holds the order back for the same reason, so
					// quantity is already enforced by the batches themselves.
					// Counting accepted pieces is the CHECKER's test, below.
					//--------------------------------------------------
					if(inProduction == true)
					{
						verdict = "NOT YET: still in production -> " + productionNames;
					}
					else if(awaitingFinish == true)
					{
						verdict = "NOT YET: waiting for finishing -> " + finishNames;
					}
					else if(statusNow == "Production Complete" || statusNow == "In Progress")
					{
						for each  soFin in Sales_Order[ID == orderId]
						{
							soFin.Order_Status = "Finishing Complete";
						}

						statusNow = "Finishing Complete";

						verdict = "FINISHING COMPLETE: order " + orderId;
					}

					//--------------------------------------------------
					// 2. CHECKING PASSED: every item Complete - saveItemCheck is
					// the only writer of that - and every original line's
					// quantity accepted, or Short_Closed.
					//
					// Complete implies finished, since saveItemCheck refuses a
					// batch whose Finishing_Data is not Done, so this needs no
					// second look at finishing. It is allowed to fire from any of
					// the three open statuses so that an order whose finishing
					// close was lost still moves once its last check lands.
					//--------------------------------------------------
					if(stillMaking == true)
					{
						//--------------------------------------------------
						// NOTHING PASSES WHILE THE ORDER IS STILL BEING MADE,
						// FINISHED OR CHECKED.
						//
						// The quantity test cannot see this. A batch that has
						// produced nothing yet has no acceptances to be short of,
						// so it is invisible to a test that only reads counters -
						// and Short_Closed makes that test unconditionally true.
						//
						// APPLIES EVEN WHEN SHORT-CLOSED, deliberately.
						// Short_Closed is an answer about QUANTITY - "the customer
						// is getting fewer than they ordered". It is not a
						// statement that unfinished work has stopped, and treating
						// it as one is what once let a queued batch pass while the
						// store still held a live requirement for it.
						//--------------------------------------------------
						verdict = verdict + " | CHECKING: still open -> " + openNames;
					}
					else if(whole == false)
					{
						verdict = verdict + " | CHECKING: short -> " + shortLines;
					}
					else if(statusNow == "Finishing Complete" || statusNow == "Production Complete" || statusNow == "In Progress")
					{
						for each  soSet in Sales_Order[ID == orderId]
						{
							soSet.Order_Status = "Checking Passed";
						}

						statusNow = "Checking Passed";

						verdict = verdict + " | PASSED: order " + orderId;
						if(shortClosed == true)
						{
							verdict = verdict + " (closed short)";
						}
					}
				}

				if(orphanNames != "")
				{
					verdict = verdict + " | WARNING, batch with no Remake_Of, its acceptances counted against nothing: " + orphanNames;
				}
			}
		}
	}
	catch (e)
	{
		// Swallowed on purpose - see the header. The caller has already written
		// records and must not be told they failed.
		verdict = "ERROR: " + e.toString();
	}

	info "recheckOrderComplete -> " + verdict;

	return verdict;
}
