string receiveFromPrint(string payloadJson)
{
	// The printer sends the cloth back. Printed stock comes into existence here:
	// the source metres leave In_Print_Qty, the printed metres land on a lot of
	// the target SKU, and EVERY RETURNED PIECE BECOMES ONE Lot_Rolls ROW
	// (Origin "Printed") - an ordinary short roll, no Fabric_Piece.
	//
	//   { "jobId":"555",
	//     "lotId":"",                       // empty => create the printed lot
	//     "lotNumber":"P1", "lotLabel":"",  // new lot only - TYPED, unique
	//     "pieces":[ {"lineIndex":0,"label":"L2-P1","state":"Wash"}, ... ],
	//     "remarks":"" }
	//
	// THE RETURN IS pieces[] - ONE ENTRY PER PHYSICAL PIECE that came back, each
	// carrying the ROLL LABEL the store person read off the cloth and the state
	// (washed / greige). There is NO count field: the count of a sent size is how
	// many pieces name that lineIndex here. A piece the printer lost simply has
	// no entry.
	//
	// ROLL LABELS ARE TYPED, NEVER GENERATED. He writes them on the cloth and
	// enters them here. Must be non-empty, unique within this receipt, and not
	// already on a Lot_Rolls row of this printed material - a Custom API is
	// callable from anywhere.
	//
	// THE RECEIVE LENGTH IS NOT AN INPUT. A piece comes back the length it left -
	// printing does not shorten cloth - so length is taken from the job's own
	// Send_Lines and over-return per size is capped at what that row sent. An
	// over-return is impossible by construction.
	//
	// TWO LAYERS, ONE OWNER EACH, each a MAINTAINED sum of the one below:
	//     Raw_Material      metres per SKU
	//     Raw_Material_Lot  metres per tone, per state ( == Σ Roll_Length )
	// Recomputing a sum per material on every screen load is a query per material
	// - the road to the statement limit, which is NOT catchable and shows as a
	// bare 500.
	//
	// AT_PRINTER ONLY. A job already Received has moved the cloth into another
	// material; running this twice would mint the rolls again and drive the
	// source lot's In_Print_Qty negative.
	//
	// Metres_Sent - Metres_Returned is REAL LOSS - shrinkage and pieces the
	// printer ruined. Returned so the screen can state it, NOT a Stock_Dispute:
	// that model is store<->supervisor and has no vendor direction.
	//
	// ONE EXIT, AT THE BOTTOM. Deluge's "all paths return" check does NOT count a
	// return inside try/catch. So nothing returns early: errTxt is set, later
	// blocks guard on it being empty, one return after the catch. Same shape as
	// saveStockInward.

	res = "";
	errTxt = "";

	try
	{
		inp = payloadJson.toMap();

		jobIdTxt = ifnull(inp.get("jobId"),"").toString().trim();
		lotIdTxt = ifnull(inp.get("lotId"),"").toString().trim();
		lotNumIn = ifnull(inp.get("lotNumber"),"").toString().trim().replaceAll("\"","'");
		lotLabel = ifnull(inp.get("lotLabel"),"").toString().trim().replaceAll("\"","'");
		remarks = ifnull(inp.get("remarks"),"").toString().trim().replaceAll("\"","'");

		piecesRaw = ifnull(inp.get("pieces"),list());

		if(jobIdTxt == "" || jobIdTxt.isNumber() == false)
		{
			errTxt = "No print job given";
		}
		if(errTxt == "" && piecesRaw.size() == 0)
		{
			errTxt = "Nothing came back - if the whole run is lost, say so on the job rather than receiving it";
		}

		//--------------------------------------------------------------------
		// THE JOB. Names first assigned inside an if are not safe to read after
		// it when that branch did not run. Lookup fields hold RECORD IDS, so
		// .toString() gives the id, not the label - kept as text, converted at
		// the point of use.
		//--------------------------------------------------------------------
		srcMatTxt = "";
		srcLotTxt = "";
		printedMatTxt = "";
		metresSent = 0.0;

		// WHAT WENT OUT, off the job's Send_Lines - length and sent-count per
		// size, two parallel lists indexed together.
		sentLenList = List();
		sentCntList = List();
		piecesSent = 0;

		if(errTxt == "")
		{
			jobRecs = Print_Job[ID == jobIdTxt.toLong()];
			if(jobRecs.count() == 0)
			{
				errTxt = "Print job not found";
			}
			else
			{
				for each  jchk in jobRecs
				{
					jStat = ifnull(jchk.Job_Status,"").toString().trim();
					if(jStat != "At_Printer")
					{
						errTxt = "That job is " + jStat + " - only a job still at the printer can be received";
					}
					else
					{
						srcMatTxt = ifnull(jchk.Source_Material,"").toString().trim();
						srcLotTxt = ifnull(jchk.Source_Lot,"").toString().trim();
						printedMatTxt = ifnull(jchk.Printed_Material,"").toString().trim();

						msS = ifnull(jchk.Metres_Sent,"0").toString().trim();
						if(msS == "")
						{
							msS = "0";
						}
						metresSent = msS.toDecimal();

						for each  slChk in jchk.Send_Lines
						{
							slLenS = ifnull(slChk.Piece_Length_Cm,"0").toString().trim();
							if(slLenS == "")
							{
								slLenS = "0";
							}
							slCntS = ifnull(slChk.Piece_Count,"0").toString().trim();
							if(slCntS == "")
							{
								slCntS = "0";
							}

							sentLenList.add(slLenS.toDecimal());
							sentCntList.add(slCntS.toDecimal());
							piecesSent = piecesSent + slCntS.toDecimal();
						}
					}
				}
			}
		}

		if(errTxt == "" && sentLenList.size() == 0)
		{
			errTxt = "That job has no send lines - nothing to check the return against";
		}
		if(errTxt == "" && printedMatTxt == "")
		{
			errTxt = "That job has no printed material on it - nothing to receive into";
		}

		//--------------------------------------------------------------------
		// The printed SKU's width in cm, for Width1 on a new lot - every other
		// lot writer (saveStockInward, seedRawMaterialStock) seeds it and the
		// roll allocator reads it. Fabric_Width_Inches is TEXT; a material with
		// none stored yields 0 rather than blocking the receipt.
		//--------------------------------------------------------------------
		printedWidthCm = 0.0;
		if(errTxt == "" && printedMatTxt != "")
		{
			for each  pwRec in Raw_Material[ID == printedMatTxt.toLong()]
			{
				pwIn = ifnull(pwRec.Fabric_Width_Inches,"").toString().trim();
				if(pwIn != "")
				{
					printedWidthCm = pwIn.toDecimal() * 2.54;
				}
			}
		}

		//--------------------------------------------------------------------
		// THE PIECES. Validated IN FULL before anything is written - a
		// half-booked receipt would leave the source lot debited and rolls
		// missing.
		//
		// Per size: count named here (capped at sent), and the ONE state that
		// size came back in (a size cannot be half washed half greige on one
		// receipt - the Receive_Lines row carries a single State). Held in Maps
		// keyed by the lineIndex string.
		//
		// Labels: unique within the receipt AND not already on any Lot_Rolls row
		// of this printed material.
		//--------------------------------------------------------------------
		metresReturned = 0.0;
		washMetres = 0.0;
		unwashMetres = 0.0;
		piecesReturned = 0;

		cntByIdx = Map();
		stateByIdx = Map();
		seenLabels = List();
		existingLabels = List();

		if(errTxt == "")
		{
			for each  elRec in Raw_Material_Lot[Material == printedMatTxt.toLong()]
			{
				for each  elRoll in elRec.Lot_Rolls
				{
					elLbl = ifnull(elRoll.Roll_Label,"").toString().trim().toUpperCase();
					if(elLbl != "")
					{
						existingLabels.add(elLbl);
					}
				}
			}
		}

		if(errTxt == "")
		{
			for each  pcRaw in piecesRaw
			{
				if(errTxt == "")
				{
					pc = pcRaw.toMap();
					pcIdxS = ifnull(pc.get("lineIndex"),"").toString().trim();
					pcLbl = ifnull(pc.get("label"),"").toString().trim().replaceAll("\"","'");
					pcSt = ifnull(pc.get("state"),"").toString().trim();

					if(pcIdxS == "" || pcIdxS.isNumber() == false)
					{
						errTxt = "A returned piece does not say which size it is - reload the screen";
					}
					else if(pcLbl == "")
					{
						errTxt = "Every returned piece needs a roll label - what is written on the cloth";
					}
					else if(pcSt != "Wash" && pcSt != "Unwash")
					{
						errTxt = "Every returned piece must say washed or unwashed";
					}
					else if(seenLabels.contains(pcLbl.toUpperCase()))
					{
						errTxt = "Roll label " + pcLbl + " is used twice in this receipt";
					}
					else if(existingLabels.contains(pcLbl.toUpperCase()))
					{
						errTxt = "Roll label " + pcLbl + " already exists on this printed material";
					}
					else
					{
						pcIdx = pcIdxS.toLong();
						if(pcIdx < 0 || pcIdx >= sentLenList.size())
						{
							errTxt = "A returned piece does not match anything that was sent - reload the screen";
						}
						else
						{
							seenLabels.add(pcLbl.toUpperCase());

							nowCnt = ifnull(cntByIdx.get(pcIdxS),0) + 1;
							cntByIdx.put(pcIdxS,nowCnt);

							priorSt = ifnull(stateByIdx.get(pcIdxS),"");
							if(priorSt == "")
							{
								stateByIdx.put(pcIdxS,pcSt);
							}
							else if(priorSt != pcSt)
							{
								errTxt = "The pieces of one size must all be washed or all unwashed - reload the screen";
							}

							if(errTxt == "" && nowCnt > sentCntList.get(pcIdx))
							{
								errTxt = "Only " + sentCntList.get(pcIdx) + " pieces of " + sentLenList.get(pcIdx) + " cm went out - more cannot come back";
							}

							if(errTxt == "")
							{
								// 100.0, not 100 - integer division truncates.
								pcMtr = sentLenList.get(pcIdx) / 100.0;
								metresReturned = metresReturned + pcMtr;
								piecesReturned = piecesReturned + 1;
								if(pcSt == "Wash")
								{
									washMetres = washMetres + pcMtr;
								}
								else
								{
									unwashMetres = unwashMetres + pcMtr;
								}
							}
						}
					}
				}
			}
		}

		if(errTxt == "" && metresReturned <= 0)
		{
			errTxt = "Nothing came back - if the whole run is lost, say so on the job rather than receiving it";
		}

		//--------------------------------------------------------------------
		// WHICH LOT the printed cloth goes on. A print run IS a lot: tone
		// depends on the source lot AND the ink batch. An existing lot has to
		// belong to THIS printed material.
		//--------------------------------------------------------------------
		targetLot = 0;
		lotNumOut = "";

		if(errTxt == "")
		{
			if(lotIdTxt != "")
			{
				lotRecs = Raw_Material_Lot[ID == lotIdTxt.toLong()];
				if(lotRecs.count() == 0)
				{
					errTxt = "Lot not found";
				}
				else
				{
					for each  lchk in lotRecs
					{
						if(ifnull(lchk.Material,"").toString().trim() != printedMatTxt)
						{
							errTxt = "That lot belongs to a different material";
						}
						else if(ifnull(lchk.Status,"Active").toString().trim() == "Blocked")
						{
							errTxt = "That lot is blocked and cannot take stock";
						}
						else
						{
							targetLot = lchk.ID;
							lotNumOut = ifnull(lchk.Lot_Number,"").toString().trim().replaceAll("\"","'");
						}
					}
				}
			}
			else
			{
				// NEW LOT. The number is TYPED - it has to match what is written
				// on the cloth. UNIQUE WITHIN THE MATERIAL (two fabrics may both
				// have a lot "1"). Compared UPPER-CASED and trimmed so "p1"
				// cannot slip in beside "P1". Checked HERE, not only on screen -
				// a Custom API is callable from anywhere.
				if(lotNumIn == "")
				{
					errTxt = "Give the new printed lot a number";
				}
				else
				{
					wantKey = lotNumIn.toUpperCase();
					clash = false;

					for each  lseq in Raw_Material_Lot[Material == printedMatTxt.toLong()]
					{
						lnTxt = ifnull(lseq.Lot_Number,"").toString().trim().toUpperCase();
						if(lnTxt == wantKey)
						{
							clash = true;
						}
					}

					if(clash == true)
					{
						errTxt = "Lot " + lotNumIn + " already exists for that printed material";
					}
					else
					{
						lotNumOut = lotNumIn;

						// Every quantity starts at 0 - the metres are added below
						// by the same pass that writes the rolls. NO Form field -
						// printed cloth is short rolls like any other lot.
						newLotId = insert into Raw_Material_Lot
						[
							Material=printedMatTxt.toLong()
							Lot_Number=lotNumOut
							Lot_Label=lotLabel
							Width1=printedWidthCm
							Unwash_Quantity=0
							In_Wash_Qty=0
							Wash_Quantity=0
							In_Print_Qty=0
							In_Transit_Qty=0
							Disputed_Qty=0
							Status="Active"
							Remarks=remarks
						];
						targetLot = newLotId.toLong();

						// Lookups set AFTER the insert - a null one fails the
						// whole block, and a job with no source lot has none.
						for each  newLot in Raw_Material_Lot[ID == targetLot]
						{
							newLot.Print_Job = jobIdTxt.toLong();
							if(srcLotTxt != "")
							{
								newLot.Source_Lot = srcLotTxt.toLong();
							}
						}

						info "new printed lot " + lotNumOut + " id=" + targetLot + " for material " + printedMatTxt;
					}
				}
			}
		}

		if(errTxt == "" && targetLot == 0)
		{
			errTxt = "Could not resolve a printed lot to book against";
		}

		//--------------------------------------------------------------------
		// THE ROLLS. One Lot_Rolls row per entry in pieces[], labelled with the
		// TYPED label from the payload - never generated. Inserted through the
		// parent - Lot_Rolls is a subform, reached as lotRec.Lot_Rolls.insert().
		//--------------------------------------------------------------------
		rollRows = 0;

		if(errTxt == "")
		{
			for each  lotRR in Raw_Material_Lot[ID == targetLot]
			{
				rollColl = Collection();

				for each  pcRaw2 in piecesRaw
				{
					pc2 = pcRaw2.toMap();
					pIdxS = ifnull(pc2.get("lineIndex"),"0").toString().trim();
					pIdx2 = pIdxS.toLong();
					pLbl2 = ifnull(pc2.get("label"),"").toString().trim().replaceAll("\"","'");
					pSt2 = ifnull(pc2.get("state"),"").toString().trim();

					pLenM = sentLenList.get(pIdx2) / 100.0;

					rRow = Raw_Material_Lot.Lot_Rolls();
					rRow.Roll_Label = pLbl2;
					rRow.Roll_Length = pLenM;
					rRow.Roll_Status = "Available";
					rRow.Origin = "Printed";
					rRow.Source_Receipt = jobIdTxt;
					rollColl.insert(rRow);
					rollRows = rollRows + 1;
				}

				if(rollRows > 0)
				{
					lotRR.Lot_Rolls.insert(rollColl);
				}
			}
		}

		//--------------------------------------------------------------------
		// THE LEDGER. Source side: the cloth left the rack when the job was
		// sent (Wash/Unwash down, In_Print_Qty up, rolls decremented), so
		// receiving it just clears In_Print_Qty. Nothing goes back to the
		// source counters - the metres have become another material.
		//
		// Clamped at zero rather than refused - the cloth is physically back
		// either way, and a negative counter is further from the truth.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			if(srcLotTxt != "")
			{
				for each  plotUpd in Raw_Material_Lot[ID == srcLotTxt.toLong()]
				{
					lipS = ifnull(plotUpd.In_Print_Qty,"0").toString().trim();
					if(lipS == "")
					{
						lipS = "0";
					}
					lipNow = lipS.toDecimal() - metresSent;
					if(lipNow < 0)
					{
						info "receiveFromPrint: source lot " + srcLotTxt + " In_Print_Qty would go negative - clamped";
						lipNow = 0;
					}
					plotUpd.In_Print_Qty = lipNow;
				}
			}

			if(srcMatTxt != "")
			{
				for each  pmatUpd in Raw_Material[ID == srcMatTxt.toLong()]
				{
					mipS = ifnull(pmatUpd.In_Print_Qty,"0").toString().trim();
					if(mipS == "")
					{
						mipS = "0";
					}
					mipNow = mipS.toDecimal() - metresSent;
					if(mipNow < 0)
					{
						info "receiveFromPrint: source material " + srcMatTxt + " In_Print_Qty would go negative - clamped";
						mipNow = 0;
					}
					pmatUpd.In_Print_Qty = mipNow;
				}
			}
		}

		//--------------------------------------------------------------------
		// The printed side. Each state's metres land on its own counter - a
		// receipt carrying both is normal and neither total may absorb the
		// other. Σ Roll_Length now equals Wash + Unwash for the new lot (the
		// rolls were just inserted at the same metres).
		//--------------------------------------------------------------------
		lotWashOut = 0.0;
		lotUnwashOut = 0.0;

		if(errTxt == "")
		{
			for each  plotNew in Raw_Material_Lot[ID == targetLot]
			{
				pwS = ifnull(plotNew.Wash_Quantity,"0").toString().trim();
				if(pwS == "")
				{
					pwS = "0";
				}
				puS = ifnull(plotNew.Unwash_Quantity,"0").toString().trim();
				if(puS == "")
				{
					puS = "0";
				}
				lotWashOut = pwS.toDecimal() + washMetres;
				lotUnwashOut = puS.toDecimal() + unwashMetres;
				plotNew.Wash_Quantity = lotWashOut;
				plotNew.Unwash_Quantity = lotUnwashOut;
			}

			for each  pmatNew in Raw_Material[ID == printedMatTxt.toLong()]
			{
				mwS = ifnull(pmatNew.Wash_Quantity,"0").toString().trim();
				if(mwS == "")
				{
					mwS = "0";
				}
				muS = ifnull(pmatNew.Unwash_Quantity,"0").toString().trim();
				if(muS == "")
				{
					muS = "0";
				}
				pmatNew.Wash_Quantity = mwS.toDecimal() + washMetres;
				pmatNew.Unwash_Quantity = muS.toDecimal() + unwashMetres;
				qW = ifnull(pmatNew.Wash_Quantity,"0").toString().trim();
				qU = ifnull(pmatNew.Unwash_Quantity,"0").toString().trim();
				qA = ifnull(pmatNew.Unallocated_Qty,"0").toString().trim();
				pmatNew.Quantity = if(qW=="",0.0,qW.toDecimal()) + if(qU=="",0.0,qU.toDecimal()) + if(qA=="",0.0,qA.toDecimal());
			}
		}

		//--------------------------------------------------------------------
		// STAMP THE JOB, last, so a failure above leaves it At_Printer and the
		// receipt can simply be done again.
		//
		// Receive_Lines is a SECOND subform and never an edit of Send_Lines -
		// counts drop because the printer ruins pieces. EVERY sent size gets a
		// receive row, including the ones that came back as nothing (count 0),
		// so the two subforms line up and a missing piece reads as a size that
		// was checked. The count and state are DERIVED from the pieces above.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			for each  jUpd in Print_Job[ID == jobIdTxt.toLong()]
			{
				rows = Collection();

				sizeI = 0;
				for each  sLen in sentLenList
				{
					sizeKey = sizeI.toString();
					gotCnt = ifnull(cntByIdx.get(sizeKey),0);
					gotState = ifnull(stateByIdx.get(sizeKey),"");

					rRow2 = Print_Job.Receive_Lines();
					rRow2.Piece_Length_Cm = sLen;
					rRow2.Piece_Count = gotCnt;
					rRow2.State = gotState;
					rows.insert(rRow2);

					sizeI = sizeI + 1;
				}

				jUpd.Receive_Lines.insert(rows);

				jUpd.Metres_Returned = metresReturned;
				jUpd.Returned_On = zoho.currentdate;
				jUpd.Printed_Lot = targetLot;
				jUpd.Job_Status = "Received";

				// NOTHING DERIVED IS STORED ON THE HEADER beyond Metres_Returned.
				// Metres lost is Metres_Sent - Metres_Returned, both on the
				// record; pieces sent/returned are sums over the two subforms.

				if(remarks != "")
				{
					oldR = ifnull(jUpd.Remarks,"").toString();
					addR = zoho.currentdate.toString("dd-MMM HH:mm") + " - received: " + remarks;
					if(oldR != "")
					{
						addR = oldR + "\n" + addR;
					}
					jUpd.Remarks = addR;
				}
			}

			// REAL LOSS, WHOLE PIECES. The length cannot change, so every missing
			// metre is a piece the printer lost or ruined. Reported, not
			// disputed.
			lossQty = metresSent - metresReturned;
			piecesLost = piecesSent - piecesReturned;

			if(piecesLost > 0)
			{
				info "print job " + jobIdTxt + " short by " + piecesLost + " pieces (" + lossQty + " Mtr) - written off against the source SKU";
			}

			res = "{\"success\":true,\"printedLotId\":\"" + targetLot + "\",\"lotNumber\":\"" + lotNumOut + "\",\"metresSent\":" + metresSent + ",\"metresReturned\":" + metresReturned + ",\"loss\":" + lossQty + ",\"piecesSent\":" + piecesSent + ",\"piecesReturned\":" + piecesReturned + ",\"piecesLost\":" + piecesLost + ",\"lotWash\":" + lotWashOut + ",\"lotUnwash\":" + lotUnwashOut + ",\"rollRows\":" + rollRows + "}";
		}
	}
	catch (e)
	{
		errTxt = "DELUGE: " + e.toString();
	}

	if(res == "")
	{
		if(errTxt == "")
		{
			errTxt = "Nothing was received";
		}
		res = "{\"success\":false,\"error\":\"" + errTxt.replaceAll("\"","'") + "\"}";
	}

	return res;
}
