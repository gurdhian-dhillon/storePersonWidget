string saveWasteFromCutting(string planId, string planItemId, string phaseName, string piecesJson)
{
	// Supervisor's post-cutting return. The widget shows him the remnants
	// calcCutPlan predicted, he edits sizes, discards what is not worth keeping,
	// and submits. Kept rows land as Pending_Receipt; discarded rows are still
	// written, as Scrapped, so scrap stays reportable instead of vanishing.
	//
	// piecesJson:
	// [ {"sku":"1234","width":40,"length":165,"count":1,"keep":true,"remarks":""}, ... ]
	//
	// keep=false rows are NOT skipped. Deleting them would make "how much did we
	// throw away this month" unanswerable.
	//
	// STEP 4 of the migration: every piece now also gets a Waste_Movement row, and
	// that row carries the Stage_Log it came out of. That link is the idempotency
	// key. Waste is saved BEFORE the phase closes, so a failed phase save leaves the
	// stage open to retry - and until now the retry wrote a second set of remnants
	// that nothing downstream could tell from real cloth, because a Waste_Master row
	// carries no source. One movement already logged against this stage means the
	// declaration has happened, so a repeat is refused rather than duplicated.

	errJson = "";
	keptCount = 0;
	scrapCount = 0;
	unlottedCount = 0;
	wasDuplicate = false;

	// Same debug wrapper as issueMaterials - Creator collapses every runtime
	// failure into a generic "code 9430", so the real message has to be caught.
	try
	{
	pieces = piecesJson.toJSONList();
	info "planId=" + planId + " planItemId=" + planItemId + " phase=" + phaseName + " pieceCount=" + pieces.size();

	//----------------------------------------------------------------------
	// Resolve the stage this declaration belongs to. Start already created the
	// log, so it exists by the time cutting ends.
	//----------------------------------------------------------------------
	itemIdStr = ifnull(planItemId,"").toString().trim();
	phName = ifnull(phaseName,"").toString().trim();

	//----------------------------------------------------------------------
	// WHICH LOT THIS ITEM'S CLOTH CAME OFF.
	//
	// An offcut is cut from a specific lot, and that is the only provenance a
	// remnant will ever have - Waste_Master records what the piece IS, never
	// where it came from. The handover lines are the only place that knows,
	// because the lot is stamped there as the cloth crosses the counter.
	//
	// Read via the SUPERVISOR rather than the plan. Material_Issue.Plan holds
	// the first plan a handover touched, so an issue spanning two plans is
	// stamped with one of them and filtering on it would miss the other's lines
	// entirely. The line itself carries Plan_Item, which is exact.
	//
	// TWO LOTS FOR ONE ITEM MEANS NO LOT IS WRITTEN. That only happens when the
	// store split the issue across lots, and there is then no way to tell which
	// of them a given remnant was cut from. Stamping the bigger one would put a
	// tone on the piece that might be a lie, and a remnant offered later as the
	// wrong shade is exactly what lots exist to prevent. Left empty and counted,
	// so the gap is visible rather than invented.
	//----------------------------------------------------------------------
	lotForMat = Map();
	ambigMat = List();

	planIdTxt = ifnull(planId,"").toString().trim();
	wSupId = 0;

	// Declared out here beside wSupId, not inside the block below: a payload
	// with no plan id never enters that block, and the scan further down reads
	// this either way.
	wPlanStart = null;

	if(planIdTxt != "" && planIdTxt.isNumber() == true)
	{
		for each  wPlan in Production_Planning[ID == planIdTxt.toLong()]
		{
			wSupId = ifnull(wPlan.Assigned_To,0);

			// Bounds the handover scan below. Written as zoho.currentdate by
			// createProductionPlans, so it is a plain Date like Issue_Date.
			wPlanStart = wPlan.Plan_Start_Date;
		}
	}

	if(wSupId != 0 && itemIdStr != "")
	{
		//--------------------------------------------------------------
		// BOUNDED BY THE PLAN'S OWN START DATE. Same walk, same bound and
		// same reasoning as getExpectedWaste - see the long note there.
		//
		// It matters more here because THIS IS A WRITE PATH: the
		// statement-execution limit is not catchable, so an unbounded scan
		// that outgrew it would take the supervisor's waste declaration down
		// with it, with a bare HTTP 500 and no error card.
		//
		// A handover cannot carry a line for an item of this plan before the
		// plan existed, so nothing the Plan_Item test below would have kept
		// is filtered out. An empty Plan_Start_Date falls back to the old
		// unbounded query rather than to a date.
		//--------------------------------------------------------------
		wIssues = Material_Issue[Issued_To == wSupId];

		if(wPlanStart != null)
		{
			wIssues = Material_Issue[Issued_To == wSupId && Issue_Date >= wPlanStart];
		}

		for each  wIss in wIssues
		{
			for each  wLn in wIss.Issue_Lines
			{
				if(ifnull(wLn.Plan_Item,"").toString().trim() == itemIdStr)
				{
					lnMatW = ifnull(wLn.Material,"").toString().trim();
					lnLotW = ifnull(wLn.Lot,"").toString().trim();

					if(lnMatW != "" && lnLotW != "")
					{
						prevLotW = ifnull(lotForMat.get(lnMatW),"").toString();
						if(prevLotW == "")
						{
							lotForMat.put(lnMatW,lnLotW);
						}
						else if(prevLotW != lnLotW && ambigMat.contains(lnMatW) == false)
						{
							ambigMat.add(lnMatW);
							info "two lots issued for item " + itemIdStr + " material " + lnMatW + " - offcut provenance left blank";
						}
					}
				}
			}
		}
	}

	stageId = 0;
	stageOperator = null;
	if(itemIdStr != "" && phName != "")
	{
		for each  sl in Stage_Log[Plan_Item == itemIdStr.toLong() && Phase_Name == phName]
		{
			stageId = sl.ID;
			stageOperator = sl.Operator;
		}
	}

	// Anything already logged against this stage means the supervisor has been
	// here before. Refuse rather than declare the same cloth twice.
	if(stageId != 0)
	{
		if(Waste_Movement[Stage_Log == stageId].count() > 0)
		{
			wasDuplicate = true;
		}
	}

	if(wasDuplicate == false)
	{
	// WITHIN ONE DECLARATION, IDENTICAL PIECES ARE ONE ROW.
	//
	// Cutting routinely throws off several remnants of the same size off the
	// same lot - the side strip repeated down a marker, three tails the same
	// length. The predicted list already merges those in the widget; a
	// hand-added row or a post-edit collision did not, and neither did anything
	// server-side, so three identical offcuts became three Waste_Master rows of
	// Piece_Count 1. That is three picks for the allocator, three green lines on
	// the issue screen, three rows on the pending-receipt list and a dispute per
	// row if the store is short.
	//
	// Merged on SKU + width + length + lot + status. Lot is in the key so a
	// remnant only ever folds into another off the SAME dye lot - two blank-lot
	// pieces (issue split across lots, provenance unknowable) fold together, and
	// never into a lotted one. Status is in the key so a kept piece never lands
	// in a Scrapped row.
	//
	// ONLY within this call. The wasDuplicate guard above means no row from a
	// previous declaration of this stage can exist, so there is nothing older to
	// merge into and no risk of one supervisor's cut inflating another's. A hit
	// adds the count to the existing Waste_Master AND to its one movement -
	// getWastePendingReceipt and getOrderConsumption read Piece_Count off the
	// movement, so the two must stay in step.
	seenKey = Map();
	rowNo = 0;
	for each  pcRaw in pieces
	{
		rowNo = rowNo + 1;
		// toJSONList() yields JSON objects, NOT Deluge Maps - .get() silently
		// returns null on those. .toMap() converts to a real Map first.
		pm = pcRaw.toMap();

		skuId = ifnull(pm.get("sku"),"").toString().trim();

		wStr = ifnull(pm.get("width"),"0").toString().trim();
		if(wStr == "")
		{
			wStr = "0";
		}
		lStr = ifnull(pm.get("length"),"0").toString().trim();
		if(lStr == "")
		{
			lStr = "0";
		}
		cStr = ifnull(pm.get("count"),"0").toString().trim();
		if(cStr == "")
		{
			cStr = "0";
		}
		pw = wStr.toDecimal();
		pl = lStr.toDecimal();
		pc = cStr.toDecimal().toLong();

		keepFlag = ifnull(pm.get("keep"),"false").toString().trim().toLowerCase();
		remarks = ifnull(pm.get("remarks"),"").toString();

		// An explicit lot in the payload wins - that is the supervisor telling
		// us which roll this came off when only he can know. Otherwise it is
		// derived, and only when the answer is unambiguous.
		pieceLot = ifnull(pm.get("lotId"),"").toString().trim();
		if(pieceLot == "" && ambigMat.contains(skuId) == false)
		{
			pieceLot = ifnull(lotForMat.get(skuId),"").toString().trim();
		}

		matRecs = Raw_Material[ID == skuId.toLong()];

		if(skuId == "" || matRecs.count() == 0)
		{
			if(errJson != "")
			{
				errJson = errJson + ",";
			}
			errJson = errJson + "\"Row " + rowNo + ": material " + skuId + " not found\"";
		}
		else if(pw <= 0 || pl <= 0 || pc <= 0)
		{
			if(errJson != "")
			{
				errJson = errJson + ",";
			}
			errJson = errJson + "\"Row " + rowNo + ": width, length and count must all be greater than zero\"";
		}
		else
		{
			newStatus = "Scrapped";
			moveType = "Scrapped";
			if(keepFlag == "true")
			{
				newStatus = "Pending_Receipt";
				moveType = "Declared";
			}

			// The merge key. pieceLot is already resolved above ("" when the
			// item's cloth came off two lots and nothing can say which). Decimals
			// stringify stably here - 62.56 is "62.56" every time.
			mergeKey = skuId + "|" + pw + "|" + pl + "|" + pieceLot + "|" + newStatus;

			priorRaw = seenKey.get(mergeKey);

			if(priorRaw != null)
			{
				// SAME PIECE, ALREADY WRITTEN THIS CALL. Add to the row and its
				// movement rather than making a second of each. No `continue` -
				// Deluge has no reliable loop skip, so this is an else, same as
				// the `break`-becomes-`if` rule.
				priorParts = priorRaw.toString().toList("|");
				priorWasteId = priorParts.get(0);
				priorMoveId = priorParts.get(1);

				for each  wAdd in Waste_Master[ID == priorWasteId.toLong()]
				{
					wpcS = ifnull(wAdd.Piece_Count,"0").toString().trim();
					if(wpcS == "")
					{
						wpcS = "0";
					}
					wAdd.Piece_Count = wpcS.toDecimal().toLong() + pc;

					// Keep the note readable rather than replaced. " | " for the
					// same reason receiveFromThirdParty appends that way - several
					// notes run into one sentence otherwise.
					if(remarks.trim() != "")
					{
						exR = ifnull(wAdd.Remarks,"").toString().trim();
						if(exR == "")
						{
							wAdd.Remarks = remarks;
						}
						else if(exR.contains(remarks.trim()) == false)
						{
							wAdd.Remarks = exR + " | " + remarks;
						}
					}
				}

				for each  mAdd in Waste_Movement[ID == priorMoveId.toLong()]
				{
					mpcS = ifnull(mAdd.Piece_Count,"0").toString().trim();
					if(mpcS == "")
					{
						mpcS = "0";
					}
					mAdd.Piece_Count = mpcS.toDecimal().toLong() + pc;
				}

				// Counts track PIECES, not rows - the widget reports these back
				// and "1 kept" over three folded pieces would read as a loss.
				if(newStatus == "Pending_Receipt")
				{
					keptCount = keptCount + pc;
				}
				else
				{
					scrapCount = scrapCount + pc;
				}
			}
			else
			{
				// Remarks carries only what the supervisor typed. Source tracking
				// lives on the Waste_Movement row below, not smuggled into text.
				newWasteId = insert into Waste_Master
				[
					SKU=skuId.toLong()
					Piece_Width=pw
					Piece_Length=pl
					Piece_Count=pc
					Status=newStatus
					Remarks=remarks
				];

				// Confirm the id resolves before linking to it. If it does not, the
				// movement is still written - losing the link is bad, losing the
				// whole event is worse.
				wpId = 0;
				for each  wchk in Waste_Master[ID == newWasteId.toLong()]
				{
					wpId = wchk.ID;

					// Lookup set after the insert - a null cannot go in the block,
					// and an unresolvable lot is a legitimate outcome here.
					if(pieceLot != "")
					{
						wchk.Lot = pieceLot.toLong();
					}
				}

				if(pieceLot == "")
				{
					unlottedCount = unlottedCount + 1;
				}

				newMoveId = insert into Waste_Movement
				[
					Movement_Type=moveType
					Piece_Width=pw
					Piece_Length=pl
					Piece_Count=pc
					Moved_On=zoho.currentdate
					Remarks=remarks
					Added_User=zoho.loginuser
				];

				// Lookups set after the insert - a null cannot go in the insert
				// block, and any of these four can legitimately be missing.
				for each  mv in Waste_Movement[ID == newMoveId.toLong()]
				{
					if(wpId != 0)
					{
						mv.Waste_Piece = wpId;
					}
					if(planId.toString().trim() != "")
					{
						mv.Plan = planId.toString().trim().toLong();
					}
					if(itemIdStr != "")
					{
						mv.Plan_Item = itemIdStr.toLong();
					}
					if(stageId != 0)
					{
						mv.Stage_Log = stageId;
					}
					if(stageOperator != null)
					{
						mv.Moved_By = stageOperator;
					}
				}

				// Record the key so a later identical row this call folds into
				// this one. Both ids kept - the movement count has to move with
				// the master count.
				seenKey.put(mergeKey,newWasteId + "|" + newMoveId);

				if(newStatus == "Pending_Receipt")
				{
					keptCount = keptCount + pc;
				}
				else
				{
					scrapCount = scrapCount + pc;
				}
			}
		}
	}
	}

	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"kept\":0,\"scrapped\":0,\"duplicate\":false}";
	}

	// A duplicate is NOT an error. The stage is being retried after the phase
	// save failed; the waste is already recorded and the widget should carry on
	// and close the stage.
	dupStr = "false";
	if(wasDuplicate == true)
	{
		dupStr = "true";
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	// unlotted: pieces saved without a lot, because the item's cloth came off
	// two of them and nothing can say which. Reported rather than guessed.
	return "{\"errors\":[" + errJson + "],\"kept\":" + keptCount + ",\"scrapped\":" + scrapCount + ",\"unlotted\":" + unlottedCount + ",\"duplicate\":" + dupStr + "}";
}
