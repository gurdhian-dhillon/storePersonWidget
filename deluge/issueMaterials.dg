string issueMaterials(string supervisorId, string issuesJson, string voucherIn)
{
	// ALLOCATION-APPLIER. This function no longer decides anything.
	//
	// CHUNKED HANDOVERS. One press of Issue against a supervisor holding a big
	// backlog produces hundreds of allocations - too large for a single
	// invokeCustomApi payload (Creator trims it). The widget splits it into
	// chunks of ~100 allocations and calls this once per chunk, sequentially.
	//
	// ONE Material_Issue PER CHUNK, not one per press. An earlier version shared
	// a single voucher across every chunk (voucherIn threaded the number back so
	// later chunks appended). That put 1800+ rows in one Issue_Lines subform,
	// and every reader that walks it - getSupervisorMaterials above all - blew
	// the statement-execution limit on that one record. So each chunk now mints
	// its own SIV-NNNNN and every downstream subform walk stays bounded to ~100
	// lines. receiveMaterials already keys on materialId across all of a
	// supervisor's vouchers, postTransferOrders already posts one order per
	// voucher (and already suffixes for partial receipts), so N small vouchers
	// per press is a shape they all handle.
	//
	// voucherIn is now vestigial - always "" from the widget, ignored here. It
	// stays only because Creator Custom API arguments cannot be removed without
	// breaking the config.
	//
	// The stock moves (mrq counters, lots, waste, parent Raw_Material) are
	// applied per chunk regardless - they are idempotent per allocation and a
	// chunk that half-applied then failed leaves exactly what it wrote, same as
	// before.
	//
	// The widget (app/js/lot-allocator.js) already computes the whole fabric
	// allocation - which lot every order is cut from, how many fresh metres come
	// off it, which remnants are picked, which Fabric_Piece rows and cut lengths,
	// in priority order, with every contention rule. This function used to
	// RE-DERIVE that decision server-side by fanning each material across every
	// open plan of the supervisor, nesting Material_Requirement queries inside a
	// per-material loop. Thirteen materials against a hundred open plans was
	// thousands of queries for one button, and Zoho's statement-execution limit
	// is not catchable - it killed the script and the widget saw a bare HTTP 500
	// with no error card.
	//
	// Now the widget sends an explicit per-requirement allocation and this
	// function APPLIES it with point lookups by record id. Cost is O(rows in this
	// handover), independent of how many plans are open. Same shape the accessory
	// "allocations" array has always used - it is now the path for everything.
	//
	// An issue line is:
	//
	//   { "materialId":"123", "source":"Plan"|"Reissue", "isFabric":true,
	//     "cutWidth":55, "cutLength":55,
	//     "allocations":[
	//       { "mrqId":"777", "planId":"50", "planItemId":"888",
	//         "giveQty":5.50, "giveRaw":10, "giveWaste":4, "issuedLot":"901" } ],
	//     "lotMoves":[
	//       { "lotId":"901", "qty":11.00, "isPieces":false,
	//         "pieces":[ {"pieceId":"abc","count":3,"cutLengthCm":300} ] } ],
	//     "wastePicks":[
	//       { "wasteId":"456", "pieces":3, "planId":"50", "planItemId":"888",
	//         "yieldPer":2, "pieceWidth":300, "pieceLength":400 } ],
	//     "issueLines":[
	//       { "mrqId":"777", "planItemId":"888", "lotId":"901", "qty":5.50,
	//         "unit":"Mtr", "cutW":55, "cutL":55, "note":"", "overrideFrom":"" } ] }
	//
	// TRUST THE WIDGET. The only server-side guards left are the two that stop a
	// genuinely broken write: an unknown record id (point lookup finds nothing),
	// and a stock field that would go negative (clamped to 0, reported, the
	// physical move still tracked). Everything else is the widget's to get right.
	//
	// WRITE-CONTRACT KEPT for receiveMaterials / getStoreIssueHistory /
	// postTransferOrders / getOrderConsumption:
	//  - Material_Requirement: Issued_Qty, Pieces_From_Raw, Pieces_From_Waste,
	//    Issued_Lot (written only when empty - the tone pin).
	//  - Waste_Master: Piece_Count down, In_Transit_Count up, Status="Issued" when
	//    emptied.
	//  - Waste_Movement "Issued": Piece_Count/Width/Length, Cut_Size_Width/Length,
	//    Pieces_Yielded, Waste_Piece, Plan, Plan_Item, Moved_By.
	//  - Raw_Material_Lot: Wash_Quantity down, In_Transit_Qty up.
	//  - Raw_Material: Wash_Quantity/Quantity down, In_Transit_Qty up.
	//  - Material_Issue: Voucher_No (SIV-NNNNN), Issue_Status="Issued",
	//    Transfer_Status="Pending", Issued_To, Issue_Date, Issue_Time, Plan.
	//  - Material_Issue.Issue_Lines: Material, Material_Name (display name), Qty,
	//    Unit, Cut_Size_Width/Length, Settled_Qty=0, Lot, Lot_Override_From/Note,
	//    Requirement, Plan_Item. Transferred_Qty left unset.
	errJson = "";
	okJson = "";
	voucherOut = "";
	// The batch key for this press - chunk 1's SIV, echoed on every chunk. The
	// widget threads it into the next chunk's voucherIn so all of one press's
	// Material_Issue rows carry the same Batch_Voucher.
	batchVoucherOut = "";
	// DEBUG WRAPPER: Creator reports every runtime failure as a generic
	// "code 9430 - There is an error while executing Custom API." Catching it
	// here surfaces the real Deluge message in the widget console instead.
	try
	{
		supId = supervisorId.trim().toLong();
		issues = issuesJson.toJSONList();
		voucherPrev = ifnull(voucherIn,"").toString().trim();
		info "supId=" + supId + " issueCount=" + issues.size() + " voucherIn=" + voucherPrev;
		// Gathered here, written once at the end - a subform row needs its parent
		// to exist first, and the parent cannot be created until we know there is
		// anything to record.
		issueLines = List();
		primaryPlanId = 0;
		// The Waste_Movement "Issued" rows this chunk writes (one per waste pick,
		// across every material). Their Voucher is back-filled once the SIV is
		// minted below - the SIV does not exist yet at the point they are
		// inserted. getStoreIssueHistory keys the offcut side of a handover on
		// this Voucher, so it must land on every one.
		wasteMvIds = List();
		for each  issue in issues
		{
			// toJSONList() yields JSON objects, NOT Deluge Maps - .get() silently
			// returns null on those. .toMap() converts to a real Map first.
			im = issue.toMap();
			matId = im.get("materialId").toString();
			cwStr = ifnull(im.get("cutWidth"),"0").toString().trim();
			if(cwStr == "")
			{
				cwStr = "0";
			}
			clStr = ifnull(im.get("cutLength"),"0").toString().trim();
			if(clStr == "")
			{
				clStr = "0";
			}
			cutW = cwStr.toDecimal();
			cutL = clStr.toDecimal();
			allocs = ifnull(im.get("allocations"),"[]").toString().toJSONList();
			lotMoves = ifnull(im.get("lotMoves"),"[]").toString().toJSONList();
			picks = ifnull(im.get("wastePicks"),"[]").toString().toJSONList();
			lineSpecs = ifnull(im.get("issueLines"),"[]").toString().toJSONList();
			matRec = Raw_Material[ID == matId.toLong()];
			if(matRec.count() == 0)
			{
				if(errJson != "")
				{
					errJson = errJson + ",";
				}
				errJson = errJson + "\"Material " + matId + " not found\"";
			}
			else
			{
				matName = ifnull(matRec.SKU,"").toString();
				matDisp = ifnull(matRec.Material_Display_Name,"").toString().trim();
				if(matDisp == "")
				{
					matDisp = ifnull(matRec.Name,"").toString().trim();
				}
				if(matDisp == "")
				{
					matDisp = matName;
				}
				isFab = matRec.Is_Fabric;
				unitStr = ifnull(matRec.Unit,"").toString();
				if(isFab == true)
				{
					stkStr = ifnull(matRec.Wash_Quantity,"0").toString().trim();
				}
				else
				{
					stkStr = ifnull(matRec.Quantity,"0").toString().trim();
				}
				if(stkStr == "")
				{
					stkStr = "0";
				}
				available = stkStr.toDecimal();
				//--------------------------------------------------------------
				// 1. APPLY EACH ALLOCATION - one point lookup per requirement.
				//--------------------------------------------------------------
				issuedTotal = 0.0;
				piecesFromWasteTot = 0;
				piecesFromRawTot = 0;
				for each  alloc in allocs
				{
					a = alloc.toMap();
					mrqId = ifnull(a.get("mrqId"),"").toString().trim();
					gqStr = ifnull(a.get("giveQty"),"0").toString().trim();
					if(gqStr == "")
					{
						gqStr = "0";
					}
					grStr = ifnull(a.get("giveRaw"),"0").toString().trim();
					if(grStr == "")
					{
						grStr = "0";
					}
					gwStr = ifnull(a.get("giveWaste"),"0").toString().trim();
					if(gwStr == "")
					{
						gwStr = "0";
					}
					giveQty = gqStr.toDecimal();
					giveRaw = grStr.toDecimal().toLong();
					giveWaste = gwStr.toDecimal().toLong();
					planIdStr = ifnull(a.get("planId"),"").toString().trim();
					issLotStr = ifnull(a.get("issuedLot"),"").toString().trim();
					if(primaryPlanId == 0 && planIdStr != "")
					{
						primaryPlanId = planIdStr.toLong();
					}
					mrqRecs = Material_Requirement[ID == mrqId.toLong()];
					if(mrqId == "" || mrqRecs.count() == 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + ": requirement " + mrqId + " not found\"";
					}
					else
					{
						for each  mrq in mrqRecs
						{
							mrq.Issued_Qty=ifnull(mrq.Issued_Qty,0) + giveQty;
							if(isFab == true)
							{
								mrq.Pieces_From_Raw=ifnull(mrq.Pieces_From_Raw,0) + giveRaw;
								mrq.Pieces_From_Waste=ifnull(mrq.Pieces_From_Waste,0) + giveWaste;
								// WRITTEN ONLY WHEN EMPTY. The first lot decides the
								// tone; a second write would rewrite history, and the
								// widget reads this back to pin the next issue.
								if(issLotStr != "" && ifnull(mrq.Issued_Lot,"").toString().trim() == "")
								{
									mrq.Issued_Lot=issLotStr.toLong();
								}
							}
						}
						issuedTotal = issuedTotal + giveQty;
						piecesFromWasteTot = piecesFromWasteTot + giveWaste;
						piecesFromRawTot = piecesFromRawTot + giveRaw;
					}
				}
				//--------------------------------------------------------------
				// 2. CONSUME REMNANT PICKS. One point lookup per Waste_Master.
				//--------------------------------------------------------------
				physicalPcs = 0;
				for each  pkRaw in picks
				{
					pk = pkRaw.toMap();
					wId = ifnull(pk.get("wasteId"),"").toString().trim();
					pcStr = ifnull(pk.get("pieces"),"0").toString().trim();
					if(pcStr == "")
					{
						pcStr = "0";
					}
					takePcs = pcStr.toDecimal().toLong();
					ypStr = ifnull(pk.get("yieldPer"),"0").toString().trim();
					if(ypStr == "")
					{
						ypStr = "0";
					}
					yieldPer = ypStr.toDecimal().toLong();
					pwStr = ifnull(pk.get("pieceWidth"),"0").toString().trim();
					if(pwStr == "")
					{
						pwStr = "0";
					}
					plStr = ifnull(pk.get("pieceLength"),"0").toString().trim();
					if(plStr == "")
					{
						plStr = "0";
					}
					// PER-PICK CUT SIZE. A SKU issue line no longer carries one
					// cut - it spans several - so the Waste_Movement's Cut_Size_*
					// comes from the pick's own target item. Falls back to the
					// wrapper cutW/cutL for an older widget that did not send it.
					pkCwStr = ifnull(pk.get("cutW"),"").toString().trim();
					if(pkCwStr == "")
					{
						pkCutW = cutW;
					}
					else
					{
						pkCutW = pkCwStr.toDecimal();
					}
					pkClStr = ifnull(pk.get("cutL"),"").toString().trim();
					if(pkClStr == "")
					{
						pkCutL = cutL;
					}
					else
					{
						pkCutL = pkClStr.toDecimal();
					}
					pkPlanStr = ifnull(pk.get("planId"),"").toString().trim();
					pkItemStr = ifnull(pk.get("planItemId"),"").toString().trim();
					wRecs = Waste_Master[ID == wId.toLong()];
					if(wId == "" || wRecs.count() == 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + ": waste piece " + wId + " not found\"";
					}
					else if(takePcs <= 0)
					{
						info "issueMaterials: waste pick " + wId + " asked 0 pieces - skipped";
					}
					else
					{
						pkCarton = "";
						for each  wRec in wRecs
						{
							haveStr = ifnull(wRec.Piece_Count,"0").toString().trim();
							if(haveStr == "")
							{
								haveStr = "0";
							}
							transStr2 = ifnull(wRec.In_Transit_Count,"0").toString().trim();
							if(transStr2 == "")
							{
								transStr2 = "0";
							}
							// The carton the store racked this offcut in, captured
							// here where the Waste_Master row is already open, and
							// stamped onto the Issued movement below so History
							// shows "where it was" with no hop back to the master.
							pkCarton = ifnull(wRec.Carton_Number,"").toString().trim();
							leftPcs = haveStr.toDecimal().toLong() - takePcs;
							if(leftPcs < 0)
							{
								if(errJson != "")
								{
									errJson = errJson + ",";
								}
								errJson = errJson + "\"" + matName + ": waste piece " + wId + " only has " + haveStr.toDecimal().toLong() + ", asked " + takePcs + " - clamped\"";
								info "issueMaterials: waste " + wId + " would go negative - clamped to 0";
								leftPcs = 0;
							}
							wRec.Piece_Count=leftPcs;
							wRec.In_Transit_Count=transStr2.toDecimal().toLong() + takePcs;
							if(leftPcs <= 0)
							{
								wRec.Status="Issued";
							}
						}
						physicalPcs = physicalPcs + takePcs;
						// STEP 4b: an Issued movement replaces the Waste_Issued subform
						// row. No Received_Count here - receipt is its own movement
						// pointing back at this one.
						newMvId = insert into Waste_Movement
						[
							Movement_Type="Issued"
							Piece_Width=pwStr.toDecimal()
							Piece_Length=plStr.toDecimal()
							Piece_Count=takePcs
							Cut_Size_Width=pkCutW
							Cut_Size_Length=pkCutL
							Pieces_Yielded=takePcs * yieldPer
							Moved_On=zoho.currentdate
							Added_User=zoho.loginuser
						];
						for each  mv in Waste_Movement[ID == newMvId.toLong()]
						{
							mv.Waste_Piece=wId.toLong();
							if(pkPlanStr != "")
							{
								mv.Plan=pkPlanStr.toLong();
							}
							if(pkItemStr != "")
							{
								mv.Plan_Item=pkItemStr;
							}
							mv.Moved_By=supId;
							if(pkCarton != "")
							{
								mv.Carton_Number=pkCarton;
							}
						}
						// Voucher is back-filled after the SIV is minted (below).
						wasteMvIds.add(newMvId.toString());
					}
				}
				//--------------------------------------------------------------
				// 3. MOVE LOT STOCK. One point lookup per lot, per piece.
				//--------------------------------------------------------------
				for each  lmRaw in lotMoves
				{
					lm = lmRaw.toMap();
					lotId = ifnull(lm.get("lotId"),"").toString().trim();
					lqStr = ifnull(lm.get("qty"),"0").toString().trim();
					if(lqStr == "")
					{
						lqStr = "0";
					}
					moveQty = lqStr.toDecimal();
					isPieces = ifnull(lm.get("isPieces"),"false").toString().trim() == "true";
					lotRecs = Raw_Material_Lot[ID == lotId.toLong()];
					if(lotId == "" || lotRecs.count() == 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + ": lot " + lotId + " not found\"";
					}
					else
					{
						for each  lotMv in lotRecs
						{
							lmwS = ifnull(lotMv.Wash_Quantity,"0").toString().trim();
							if(lmwS == "")
							{
								lmwS = "0";
							}
							lmtS = ifnull(lotMv.In_Transit_Qty,"0").toString().trim();
							if(lmtS == "")
							{
								lmtS = "0";
							}
							newWash = lmwS.toDecimal() - moveQty;
							if(newWash < 0)
							{
								if(errJson != "")
								{
									errJson = errJson + ",";
								}
								errJson = errJson + "\"" + matName + ": lot " + ifnull(lotMv.Lot_Number,lotId).toString() + " has " + lmwS.toDecimal() + " washed, asked " + moveQty + " - clamped\"";
								info "issueMaterials: lot " + lotId + " Wash_Quantity would go negative - clamped to 0";
								newWash = 0;
							}
							lotMv.Wash_Quantity=newWash;
							lotMv.In_Transit_Qty=lmtS.toDecimal() + moveQty;
						}
						if(isPieces == true)
						{
							pcList = ifnull(lm.get("pieces"),"[]").toString().toJSONList();
							for each  pcRaw in pcList
							{
								pcM = pcRaw.toMap();
								pcId = ifnull(pcM.get("pieceId"),"").toString().trim();
								pcCntS = ifnull(pcM.get("count"),"0").toString().trim();
								if(pcCntS == "")
								{
									pcCntS = "0";
								}
								pcTake = pcCntS.toDecimal().toLong();
								pcCutS = ifnull(pcM.get("cutLengthCm"),"0").toString().trim();
								if(pcCutS == "")
								{
									pcCutS = "0";
								}
								pcCutLen = pcCutS.toDecimal();
								pcRecs = Fabric_Piece[ID == pcId.toLong()];
								if(pcId == "" || pcRecs.count() == 0)
								{
									if(errJson != "")
									{
										errJson = errJson + ",";
									}
									errJson = errJson + "\"" + matName + ": fabric piece " + pcId + " not found\"";
								}
								else if(pcTake > 0)
								{
									for each  fpMv in pcRecs
									{
										fpMvS = ifnull(fpMv.Piece_Count,"0").toString().trim();
										if(fpMvS == "")
										{
											fpMvS = "0";
										}
										fpOrigLenS = ifnull(fpMv.Piece_Length_Cm,"0").toString().trim();
										if(fpOrigLenS == "")
										{
											fpOrigLenS = "0";
										}
										if(pcCutLen <= 0)
										{
											pcCutLen = fpOrigLenS.toDecimal();
										}
										fpMvLeft = fpMvS.toDecimal().toLong() - pcTake;
										isClamped = false;
										if(fpMvLeft < 0)
										{
											if(errJson != "")
											{
												errJson = errJson + ",";
											}
											errJson = errJson + "\"" + matName + ": piece " + pcId + " only has " + fpMvS.toDecimal().toLong() + ", asked " + pcTake + " - clamped\"";
											info "issueMaterials: piece " + pcId + " would go negative - clamped";
											fpMvLeft = 0;
											isClamped = true;
										}
										fpMv.Piece_Count=fpMvLeft;
										fpMvRemainder = fpOrigLenS.toDecimal() - pcCutLen;
										if(fpMvRemainder > 0 && isClamped == false)
										{
											insert into Fabric_Piece
											[
												Added_User=zoho.loginuser
												Material=fpMv.Material
												Lot=fpMv.Lot
												Piece_Length_Cm=fpMvRemainder
												Piece_Width_Cm=fpMv.Piece_Width_Cm
												Piece_Count=pcTake
												State=fpMv.State
												Piece_Status="Available"
												Carton_Number=fpMv.Carton_Number
												Print_Job=fpMv.Print_Job
											]
										}
									}
								}
							}
						}
					}
				}
				//--------------------------------------------------------------
				// 4. MOVE PARENT Raw_Material STOCK - once per material line.
				//
				// Move the stock, do NOT consume it. The shelf figure drops so the
				// same cloth cannot be promised to a second supervisor, but the
				// company still owns it - it is on a trolley, not in a garment. It
				// is consumed only when the supervisor confirms receipt.
				//--------------------------------------------------------------
				balance = available - issuedTotal;
				if(isFab == true)
				{
					matRec.Wash_Quantity=balance;
					qU = ifnull(matRec.Unwash_Quantity,"0").toString().trim();
					qA = ifnull(matRec.Unallocated_Qty,"0").toString().trim();
					matRec.Quantity=balance + if(qU == "",0.0,qU.toDecimal()) + if(qA == "",0.0,qA.toDecimal());
				}
				else
				{
					matRec.Quantity=balance;
				}
				transStr = ifnull(matRec.In_Transit_Qty,"0").toString().trim();
				if(transStr == "")
				{
					transStr = "0";
				}
				matRec.In_Transit_Qty=transStr.toDecimal() + issuedTotal;
				//--------------------------------------------------------------
				// 5. GATHER THE Issue_Lines ROWS. The widget already expanded
				// PRINTED_PIECE lines one-per-physical-piece, so this is a
				// straight copy - no reconstruction from a fan.
				//--------------------------------------------------------------
				for each  lsRaw in lineSpecs
				{
					ls = lsRaw.toMap();
					lnMap = Map();
					lnMap.put("matId",matId);
					lnMap.put("matDisp",matDisp);
					lnMap.put("unit",unitStr);
					lqS = ifnull(ls.get("qty"),"0").toString().trim();
					if(lqS == "")
					{
						lqS = "0";
					}
					lnMap.put("qty",lqS.toDecimal());
					lcwS = ifnull(ls.get("cutW"),"0").toString().trim();
					if(lcwS == "")
					{
						lcwS = "0";
					}
					lclS = ifnull(ls.get("cutL"),"0").toString().trim();
					if(lclS == "")
					{
						lclS = "0";
					}
					lnMap.put("cutW",lcwS.toDecimal());
					lnMap.put("cutL",lclS.toDecimal());
					lnMap.put("lot",ifnull(ls.get("lotId"),"").toString().trim());
					lnMap.put("note",ifnull(ls.get("note"),"").toString().trim().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," "));
					lnMap.put("fromLot",ifnull(ls.get("overrideFrom"),"").toString().trim());
					lnMap.put("req",ifnull(ls.get("mrqId"),"").toString().trim());
					lnMap.put("planItem",ifnull(ls.get("planItemId"),"").toString().trim());
					issueLines.add(lnMap);
				}
				if(okJson != "")
				{
					okJson = okJson + ",";
				}
				// IDs forced to string - 18-digit ids break JSON.parse otherwise.
				okJson = okJson + "{\"materialId\":\"" + matId + "\",\"sku\":\"" + matName + "\",\"qty\":" + issuedTotal + ",\"balance\":" + balance + ",\"wastePiecesIssued\":" + physicalPcs + ",\"piecesFromWaste\":" + piecesFromWasteTot + ",\"piecesFromRaw\":" + piecesFromRawTot + "}";
			}
		}
		//------------------------------------------------------------------------
		// Write the handover record. Deliberately in its own try/catch: by this
		// point stock has already been decremented and balances already moved, so a
		// failure to LOG the handover must never fail the handover itself. Losing
		// the audit row is bad; rolling back cloth that is physically on the counter
		// is worse, and Deluge has no transaction to roll back with anyway.
		//------------------------------------------------------------------------
		try
		{
			if(issueLines.size() > 0)
			{
				//------------------------------------------------------------
				// THE VOUCHER NUMBER. One per CHUNK now (see the header note) -
				// each press of Issue that is big enough to be split produces
				// several SIV-NNNNN records, one per ~100-line chunk, so no
				// Issue_Lines subform grows past a size its readers can walk.
				//
				//
				// GENERATED HERE, NOT BY A FORM WORKFLOW. An "on add" workflow
				// using input.Voucher_No fires only when a human opens the Creator
				// form and types a record. Nothing ever does: every Material_Issue
				// in this app is created by the insert below, so a workflow would
				// leave every voucher blank. Same reason Plan_No is built inside
				// createProductionPlans rather than on the form.
				//
				// SORTED ON ID, NOT ON Voucher_No, AND THAT IS NOT A DETAIL.
				//
				// "sort by Voucher_No desc" is a TEXT sort. Zero padding makes it
				// agree with the numeric order only while the width stays the same -
				// the moment SIV-100000 exists beside SIV-99999, text order puts
				// SIV-9... above SIV-1..., the highest reads as 99999, and the next
				// handover is issued SIV-100000 for the SECOND time. A duplicate
				// voucher number that nothing would notice until two transfer orders
				// quoted it.
				//
				// Record ids are monotonic, so the newest row always holds the
				// highest number whatever its width, and the ceiling disappears.
				//
				// TEN ROWS, NOT ONE. Sorting by id means the top row is the NEWEST,
				// not the highest - and a row with an empty Voucher_No at the top
				// would restart numbering at 1 and duplicate everything. Nothing
				// writes a blank today, but a record added by hand in Creator would,
				// and so would this very field the day before it was filled in.
				// Walking a few rows and keeping the largest costs nothing and
				// cannot be tripped by one bad row.
				//
				// Bounded either way. The plan numberer scans every plan ever to
				// read one integer and is listed in docs/scaling.md for it; there
				// was no reason to copy that.
				//
				// NOT SAFE AGAINST TWO STORE PEOPLE ISSUING IN THE SAME INSTANT -
				// both would read the same last number. There is one store counter
				// and one person at it, and Deluge has no sequence to lock; if that
				// ever changes this needs a different mechanism, not a retry.
				//------------------------------------------------------------
				// sort by on its own assignment, never inline in a for-each header.
				lastVouchers = Material_Issue[ID != 0] sort by ID desc range from 1 to 10;
				lastVNum = 0;
				for each  lv in lastVouchers
				{
					lvTxt = ifnull(lv.Voucher_No,"").toString().trim();
					if(lvTxt != "")
					{
						// Split rather than substring - toList/get is the string
						// idiom this app already relies on, and it does not care how
						// many dashes a hand-edited number picked up.
						vParts = lvTxt.toList("-");
						if(vParts.size() > 1)
						{
							vNumTxt = vParts.get(vParts.size() - 1).trim();
							if(vNumTxt.isNumber() == true)
							{
								vSeen = vNumTxt.toLong();
								if(vSeen > lastVNum)
								{
									lastVNum = vSeen;
								}
							}
						}
					}
				}
				nextVNum = lastVNum + 1;
				if(nextVNum < 10)
				{
					vPad = "0000" + nextVNum;
				}
				else if(nextVNum < 100)
				{
					vPad = "000" + nextVNum;
				}
				else if(nextVNum < 1000)
				{
					vPad = "00" + nextVNum;
				}
				else if(nextVNum < 10000)
				{
					vPad = "0" + nextVNum;
				}
				else
				{
					vPad = "" + nextVNum;
				}
				voucherNo = "SIV-" + vPad;
				// Transfer_Status is set so the state is READABLE on the record.
				// Nothing depends on it: postTransferOrders reads every recent
				// handover and filters in code, because a Creator criteria drops an
				// empty field whether the test is "==" or "!=" - which is how a
				// voucher with a blank status stayed invisible to two different
				// queries in a row.
				//
				// NO COMMENTS INSIDE THE BLOCK BELOW. A Deluge insert-into field
				// list is parsed specially and a "//" line in it is a syntax error -
				// reported against the "try" a thousand lines above, with no hint
				// that an insert is involved at all.
				voucherOut = voucherNo;

				//------------------------------------------------------------
				// BATCH GROUPING. One press of Issue on a big backlog is split
				// into chunks by the widget and each chunk is its own
				// Material_Issue with its own SIV-NNNNN (see the header note -
				// the split is what keeps every Issue_Lines subform small enough
				// to walk). The store person pressed the button ONCE though, so
				// History shows the chunks as ONE handover card.
				//
				// voucherIn is how the widget threads them: chunk 1 sends "" and
				// gets its SIV back, every later chunk sends that same number in.
				//   Batch_Voucher - chunk 1's SIV, on every chunk. Readers group
				//                   on this. A single-chunk press has
				//                   Batch_Voucher == Voucher_No.
				//   Batch_Head    - true on chunk 1 only. getStoreIssueHistory
				//                   pages on head rows and pulls each head's
				//                   siblings by Batch_Voucher, so the paged loop
				//                   stays bounded exactly as it is today.
				// A Creator criteria drops an empty field in BOTH directions
				// (the postTransferOrders lesson), so Batch_Head is written
				// explicitly false on siblings, never left blank.
				//------------------------------------------------------------
				batchVoucherTxt = ifnull(voucherIn,"").toString().trim();
				isBatchHead = false;
				if(batchVoucherTxt == "")
				{
					batchVoucherTxt = voucherNo;
					isBatchHead = true;
				}
				batchVoucherOut = batchVoucherTxt;

				newIssueId = insert into Material_Issue
				[
					Voucher_No=voucherNo
					Issue_Date=zoho.currentdate
					Issue_Status="Issued"
					Transfer_Status="Pending"
					Batch_Voucher=batchVoucherTxt
					Batch_Head=isBatchHead
					Added_User=zoho.loginuser
				];
				for each  mi in Material_Issue[ID == newIssueId.toLong()]
				{
					// Lookups after the insert - a null cannot go in the insert block.
					if(primaryPlanId != 0)
					{
						mi.Plan=primaryPlanId;
					}
					mi.Issued_To=supId;
					// Set here rather than in the insert block - a Time field wants
					// "HH:mm", and this whole block is already inside its own catch.
					mi.Issue_Time=zoho.currenttime.toString("HH:mm");
					for each  lnRaw in issueLines
					{
						liRow = Material_Issue.Issue_Lines();
						liRow.Material=lnRaw.get("matId").toLong();
						// Material_Name gets the readable NAME, not the SKU it used to
						// be given. The field finally says what it contains.
						//
						// The SKU is NOT written to a second field - there is no text
						// field on this subform to hold it. Material is a LOOKUP whose
						// display column happens to be the SKU, which is why Creator's
						// own form shows "RM-00005" there; Deluge reading that field
						// gets the record id instead. getStoreIssueHistory resolves the
						// code from a catalogue map it builds in one query, so nothing
						// here has to.
						liRow.Material_Name=lnRaw.get("matDisp");
						liRow.Qty=lnRaw.get("qty");
						liRow.Unit=lnRaw.get("unit");
						liRow.Cut_Size_Width=lnRaw.get("cutW");
						liRow.Cut_Size_Length=lnRaw.get("cutL");
						// Nothing confirmed yet. receiveMaterials settles against
						// this, oldest line first, to know which lot to take the
						// in-transit cloth off - so it has to start at a real 0
						// rather than the EMPTY a Creator numeric otherwise holds.
						liRow.Settled_Qty=0;
						lotTxt = ifnull(lnRaw.get("lot"),"").toString().trim();
						if(lotTxt != "")
						{
							liRow.Lot=lotTxt.toLong();
						}
						noteTxt = ifnull(lnRaw.get("note"),"").toString().trim();
						if(noteTxt != "")
						{
							fromTxt = ifnull(lnRaw.get("fromLot"),"").toString().trim();
							if(fromTxt != "")
							{
								liRow.Lot_Override_From=fromTxt.toLong();
							}
							liRow.Lot_Override_Note=noteTxt;
						}
						reqTxt = ifnull(lnRaw.get("req"),"").toString().trim();
						if(reqTxt != "")
						{
							liRow.Requirement=reqTxt.toLong();
						}
						piTxt = ifnull(lnRaw.get("planItem"),"").toString().trim();
						if(piTxt != "")
						{
							liRow.Plan_Item=piTxt;
						}
						mi.Issue_Lines.insert(liRow);
					}
				}

				// BACK-FILL THE SIV ONTO THIS CHUNK'S WASTE MOVEMENTS. They were
				// inserted in the per-material loop above, before voucherNo
				// existed. getStoreIssueHistory reads the offcut side of a
				// handover as Waste_Movement[Voucher == <SIV>, Movement_Type ==
				// "Issued"], so every one written this chunk has to carry it.
				for each  wmId in wasteMvIds
				{
					for each  wmRow in Waste_Movement[ID == wmId.toLong()]
					{
						wmRow.Voucher=voucherNo;
					}
				}
			}
		}		catch (e2)
		{
			// Not returned to the widget - the issue succeeded, and telling the store
			// person "handover not logged" would only make him issue it again.
			info "Material_Issue not written: " + e2.toString();
		}
		//------------------------------------------------------------------------
		// TELL THE SUPERVISOR HIS MATERIAL IS READY.
		//
		// ONE mail per handover, not per material - a handover of eight materials is
		// one trip to the counter, and eight mails describing it would be eight
		// chances to stop reading them.
		//
		// Its own try/catch, and last. The cloth is already on the counter and the
		// stock is already moved by this point; a mail that fails - quota, a
		// transient error - must never make a completed handover look failed, and
		// must never leave the store person issuing it a second time.
		//
		// ADDRESSING, and its one honest limitation: there is no Email field on
		// Employee, so this cannot reach the supervisor directly. It goes to the
		// admin address and NAMES him in the subject and the body, which is the
		// agreed behaviour for a missing address - the notification is never lost,
		// and the gap is visible in every mail until it is closed.
		//   TO SWITCH ON once Employee.Email exists: read it in the supName loop
		//   below and use it as `to`, keeping this address as the fallback.
		//------------------------------------------------------------------------
		notifyTo = "gurdhian.helios@gmail.com";
		try
		{
			if(issueLines.size() > 0)
			{
				supName = "";
				for each  supEmp in Employee[ID == supId]
				{
					supName = ifnull(supEmp.Employee_Name,"").toString().replaceAll("\"","'");
				}
				if(supName == "")
				{
					supName = "Supervisor";
				}
				// One row per MATERIAL, summed. issueLines carries a row per plan
				// requirement, so the same material appears several times when one
				// handover feeds several orders - and he carried it once. Same rule
				// his own Receive screen states: one line per physical thing.
				nFont = "-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Roboto,Helvetica,Arial,sans-serif";
				nTh = "padding:8px 12px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#64748b;text-align:left;font-weight:600";
				nThR = "padding:8px 12px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#64748b;text-align:right;font-weight:600";
				nTd = "padding:10px 12px;border-bottom:1px solid #eef2f6;font-size:13px;color:#0f172a";
				nTdR = "padding:10px 12px;border-bottom:1px solid #eef2f6;font-size:13px;color:#0f172a;text-align:right;font-weight:600";
				mailKeys = List();
				mailQty = Map();
				mailUnit = Map();
				for each  mlRaw in issueLines
				{
					// Name AND unit in the key: the same material in Mtr and in Pcs
					// is two different things and must never be added together.
					mlName = ifnull(mlRaw.get("matDisp"),"").toString();
					mlUnitTxt = ifnull(mlRaw.get("unit"),"").toString();
					mlKey = mlName + " | " + mlUnitTxt;
					mlHave = ifnull(mailQty.get(mlKey),"").toString().trim();
					if(mlHave == "")
					{
						mailKeys.add(mlKey);
						mailQty.put(mlKey,ifnull(mlRaw.get("qty"),0));
						mailUnit.put(mlKey,mlUnitTxt);
					}
					else
					{
						mailQty.put(mlKey,mlHave.toDecimal() + ifnull(mlRaw.get("qty"),0));
					}
				}
				rowsHtml = "";
				for each  mlKey2 in mailKeys
				{
					mlShow = mlKey2.substring(0,mlKey2.lastIndexOf(" | "));
					rowsHtml = rowsHtml + "<tr><td style='" + nTd + "'>" + mlShow + "</td><td style='" + nTdR + "'>" + mailQty.get(mlKey2) + " <span style='color:#64748b;font-weight:400'>" + ifnull(mailUnit.get(mlKey2),"") + "</span></td></tr>";
				}
				inner = "<div style='font-size:14px;color:#0f172a'><b>" + supName + "</b>, the store has issued material against your orders. It is ready to collect.</div>";
				inner = inner + "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='border-collapse:collapse;margin-top:14px;border:1px solid #e2e8f0;border-radius:6px'>";
				inner = inner + "<tr><th style='" + nTh + "'>Material</th><th style='" + nThR + "'>Quantity</th></tr>";
				inner = inner + rowsHtml + "</table>";
				inner = inner + "<div style='font-size:12px;color:#64748b;padding-top:14px'>Confirm what you actually received on the <b>Receive</b> tab. Anything short of this goes to a dispute rather than quietly disappearing - stock is only consumed when you confirm it.</div>";
				mailHtml = thisapp.buildNotificationEmail("Collect your material from the store","For " + supName + " &middot; " + zoho.currentdate.toString("dd MMM yyyy") + " " + zoho.currenttime.toString("HH:mm"),"#2563eb",inner);
				// sendmail
				// [
				// 	from :zoho.adminuserid
				// 	to :notifyTo
				// 	subject :"Material ready to collect from the store"
				// 	message :mailHtml
				// ]
				// info "Issue notification sent for " + supName;
			}
		}		catch (e3)
		{
			// Logged, never rethrown, never returned. The handover happened.
			info "Issue notification not sent: " + e3.toString();
		}
	}	catch (e)
	{
		// Surfaces as an alert in the widget via the existing errors[] handling.
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"issued\":[],\"voucher\":\"" + voucherOut + "\",\"batchVoucher\":\"" + batchVoucherOut + "\"}";
	}
	// Built by hand - List.toString() does not reliably wrap in [].
	// "voucher" is the SIV this chunk minted. "batchVoucher" is chunk 1's SIV -
	// the widget sends it back as voucherIn on every later chunk so all of one
	// press's Material_Issue rows share a Batch_Voucher and History shows them
	// as a single handover.
	return "{\"errors\":[" + errJson + "],\"issued\":[" + okJson + "],\"voucher\":\"" + voucherOut + "\",\"batchVoucher\":\"" + batchVoucherOut + "\"}";
}
