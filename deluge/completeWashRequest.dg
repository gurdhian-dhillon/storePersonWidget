void completeWashRequest()
{
	// Report custom action on the Wash Request report, Detail View ->
	// "For Selected Record" -> "Mark washed".
	//
	// Runs against ONE record - the one open in the detail view. Creator gives the
	// script the current record's ID, so nothing has to be passed in.
	//
	// NOTE ON INPUT. A custom action fires the moment it is pressed and cannot
	// prompt for anything, so Washed_Qty has to be typed into the record BEFORE the
	// button is used - either by editing the record, or inline in the list if
	// inline edit is enabled on that column. Left blank it assumes the full
	// requested amount came back, which is the common case but not always true.
	//
	// Completing a job does three things, in this order:
	//   1. moves the cloth from Unwash_Quantity to Wash_Quantity
	//   2. stamps the request Completed
	//   3. resolves the Material_Exception that queued it
	//
	// Washed_Qty is what moves, not Requested_Qty. You send 3.8m and 3.5m survives
	// the wash; moving the requested figure would put stock on the shelf that does
	// not physically exist. It is NOT capped at the amount requested - washing more
	// than was asked for is normal, and the only real ceiling is how much unwashed
	// cloth there actually is.

	// Same debug wrapper as the other functions - Creator collapses every
	// runtime failure into a generic error, so catch the real message.
	try
	{
	// The current record. If the workflow editor rejects a bare ID here, the
	// other form Creator uses is input.ID - one of the two resolves.
	recId = ID;

	for each  wr in Wash_Request[ID == recId]
	{
		// A Completed or Cancelled row must never be processed twice - there
		// is no undo on a quantity move.
		if(wr.Status == "Pending" || wr.Status == "In_Progress")
		{
			// Creator fields that were never written are EMPTY, not null, and
			// toDecimal() throws on empty - normalise to string first.
			reqStr = ifnull(wr.Requested_Qty,"0").toString().trim();
			if(reqStr == "")
			{
				reqStr = "0";
			}
			washStr = ifnull(wr.Washed_Qty,"0").toString().trim();
			if(washStr == "")
			{
				washStr = "0";
			}
			reqQty = reqStr.toDecimal();
			gotQty = washStr.toDecimal();

			// Nothing typed means all of it came back.
			if(gotQty <= 0)
			{
				gotQty = reqQty;
			}

			matRec = null;
			for each  rm in Raw_Material[ID == wr.Material]
			{
				matRec = rm;
			}

			//------------------------------------------------------------
			// WHICH LOT WENT TO THE WASH.
			//
			// Washing does NOT change the lot. A lot is decided when the cloth
			// is bought; the wash converts that lot's greige into that lot's
			// washed cloth and nothing about its identity moves. So this is a
			// transfer inside one lot, not a lot being created or merged.
			//
			// A request raised before lots existed carries no lot. It still
			// works - the parent total moves on its own, exactly as it always
			// did - but the lots underneath will then be short of the parent by
			// that amount, which migrateOpeningLots reports as unaccounted.
			//------------------------------------------------------------
			lotIdTxt = ifnull(wr.Lot,"").toString().trim();
			lotUnw = 0.0;
			lotInWash = 0.0;
			hasLotHere = false;
			// Printed cloth held as discrete pieces. Blank Form means Roll -
			// every lot that existed before printing has it empty.
			lotIsPieces = false;

			if(lotIdTxt != "")
			{
				for each  wLot in Raw_Material_Lot[ID == lotIdTxt.toLong()]
				{
					lwStr = ifnull(wLot.Unwash_Quantity,"0").toString().trim();
					if(lwStr == "")
					{
						lwStr = "0";
					}
					liwStr = ifnull(wLot.In_Wash_Qty,"0").toString().trim();
					if(liwStr == "")
					{
						liwStr = "0";
					}
					lotUnw = lwStr.toDecimal();
					lotInWash = liwStr.toDecimal();
					hasLotHere = true;

					if(ifnull(wLot.Form,"").toString().trim() == "Pieces")
					{
						lotIsPieces = true;
					}
				}
			}

			//----------------------------------------------------------------
			// THE SECOND HALF OF THE PIECES GUARD, and it has to be here as well
			// as at the raise. This is a report action on a form anyone can add a
			// row to by hand, and a ticket raised before that guard shipped is
			// already sitting in the queue - pressing "Mark washed" on one of
			// those is what actually destroys the stock.
			//
			// Moving metres from In_Wash to Wash on a Pieces lot leaves every
			// Fabric_Piece row still saying State = "Unwash" while the header
			// claims washed metres. The allocator reads the pieces and takes only
			// State == "Wash", and lotFill zeroes a Pieces lot's metres budget, so
			// the cloth becomes real, on the rack, and permanently unissuable -
			// with every total still saying it is there.
			//
			// Refused rather than guessed at, exactly as resolveDispute refuses a
			// Store_Correction on one. Doing it properly means naming which pieces
			// came back and at what length, because washing shrinks cloth, and
			// this record does not know either.
			//
			// The request is left OPEN. Cancelling it here would strand the metres
			// in In_Wash_Qty with nothing to bring them back; leaving it open keeps
			// it on the queue where somebody can see it and use "Cancel wash".
			//----------------------------------------------------------------
			if(lotIsPieces == true)
			{
				info "completeWashRequest refused: lot " + lotIdTxt + " is printed cloth held as pieces. Washing pieces moves Fabric_Piece rows, not a metres figure, and that is not built yet - the request has been left open.";
			}
			else if(matRec != null && gotQty > 0)
			{
				unwStr = ifnull(matRec.Unwash_Quantity,"0").toString().trim();
				if(unwStr == "")
				{
					unwStr = "0";
				}
				wshStr = ifnull(matRec.Wash_Quantity,"0").toString().trim();
				if(wshStr == "")
				{
					wshStr = "0";
				}
				unwQty = unwStr.toDecimal();
				wshQty = wshStr.toDecimal();

				inwStr = ifnull(matRec.In_Wash_Qty,"0").toString().trim();
				if(inwStr == "")
				{
					inwStr = "0";
				}
				inwQty = inwStr.toDecimal();

				//----------------------------------------------------------
				// WHAT THE CLOTH COMES OFF.
				//
				// Cloth sent to the wash left the rack when the ticket was
				// raised - Unwash_Quantity went down, In_Wash_Qty went up - so
				// this is In_Wash -> Wash, not Unwash -> Wash.
				//
				// FALLING BACK TO GREIGE IS DELIBERATE. Any ticket raised before
				// In_Wash_Qty existed never moved anything, so its cloth is
				// still sitting in Unwash_Quantity. Taking from In_Wash first
				// and the remainder from Unwash settles both without needing to
				// know which kind of ticket this is.
				//
				// Capped rather than refused: the cloth has physically been
				// washed either way, and driving a counter negative leaves the
				// ledger further from the truth than a capped figure does.
				//----------------------------------------------------------
				capHere = inwQty + unwQty;
				if(hasLotHere == true)
				{
					// AND capped at what THIS LOT holds. If the parent is out of sync 
					// (e.g. from baseline resets), we trust the lot to let the wash complete.
					capHere = lotInWash + lotUnw;
				}

				moveQty = gotQty;
				if(moveQty > capHere)
				{
					moveQty = capHere;
					info "capped: entered " + gotQty + " but only " + capHere + " available to wash";
				}

				if(moveQty > 0)
				{
					// In-wash first, greige for whatever is left over.
					fromInWash = moveQty;
					if(fromInWash > inwQty)
					{
						fromInWash = inwQty;
					}
					fromGreige = moveQty - fromInWash;

					matRec.In_Wash_Qty = inwQty - fromInWash;
					matRec.Unwash_Quantity = unwQty - fromGreige;
					matRec.Wash_Quantity = wshQty + moveQty;
					qW = ifnull(matRec.Wash_Quantity,"0").toString().trim();
					qU = ifnull(matRec.Unwash_Quantity,"0").toString().trim();
					qA = ifnull(matRec.Unallocated_Qty,"0").toString().trim();
					matRec.Quantity = if(qW=="",0.0,qW.toDecimal()) + if(qU=="",0.0,qU.toDecimal()) + if(qA=="",0.0,qA.toDecimal());

					// The same move on the lot, in the same pass, so the lot and
					// the maintained parent total cannot disagree.
					if(hasLotHere == true)
					{
						lotFromWash = moveQty;
						if(lotFromWash > lotInWash)
						{
							lotFromWash = lotInWash;
						}
						lotFromGreige = moveQty - lotFromWash;

						for each  wLotUpd in Raw_Material_Lot[ID == lotIdTxt.toLong()]
						{
							luStr = ifnull(wLotUpd.Unwash_Quantity,"0").toString().trim();
							if(luStr == "")
							{
								luStr = "0";
							}
							liwUpd = ifnull(wLotUpd.In_Wash_Qty,"0").toString().trim();
							if(liwUpd == "")
							{
								liwUpd = "0";
							}
							lwqStr = ifnull(wLotUpd.Wash_Quantity,"0").toString().trim();
							if(lwqStr == "")
							{
								lwqStr = "0";
							}
							wLotUpd.In_Wash_Qty = liwUpd.toDecimal() - lotFromWash;
							wLotUpd.Unwash_Quantity = luStr.toDecimal() - lotFromGreige;
							wLotUpd.Wash_Quantity = lwqStr.toDecimal() + moveQty;
						}
					}
				}

				wr.Washed_Qty = moveQty;
				wr.Status = "Completed";
				wr.Completed_On = zoho.currentdate;

				//------------------------------------------------------
				// Close the ticket that queued this. Resolved rather than
				// deleted - the exception is the record of why the wash
				// happened at all.
				//
				// Closed even when the wash came back short. If the material
				// is still not enough, the store summary shows it as short
				// again on the next load and a fresh request can be raised. A
				// ticket left open on a finished job reads as work in hand.
				//------------------------------------------------------
				if(wr.Exception != null)
				{
					for each  ex in Material_Exception[ID == wr.Exception]
					{
						if(ex.Status == "Open")
						{
							oldNote = ifnull(ex.Note,"").toString();
							addNote = zoho.currentdate.toString("dd-MMM HH:mm") + " - washed " + moveQty + ", request closed";
							if(oldNote != "")
							{
								addNote = oldNote + "\n" + addNote;
							}
							ex.Note = addNote;
							ex.Status = "Resolved";
						}
					}
				}

				info "wash completed: " + wr.Material_Name + " moved " + moveQty;
			}
		}
	}
	}
	catch (e)
	{
		info "completeWashRequest failed: " + e.toString();
	}
}
