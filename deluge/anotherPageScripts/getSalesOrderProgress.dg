	map Admin_Space.getSalesOrderProgress(string salesOrderId, string statusFilter)
	{
		// Employee Report -> Sales Order Pipeline
		// Returns live progress for Sales_Orders matching the requested status (or all live orders).
		// An optional salesOrderId limits the result to one order.
		// An optional statusFilter filters by status ("In Progress", "Production Complete", "Checking Passed", "Finishing Complete", "Packed", "Dispatched").
		response = Map();
		ordersOut = List();

		targetStatus = ifnull(statusFilter,"").toString().trim();
		if(targetStatus == "Prod Complete" || targetStatus == "Production Complete")
		{
			targetStatus = "Production Complete";
		}

		orders = List();
		if(targetStatus == "In Production" || targetStatus == "All" || targetStatus == "In Progress" || targetStatus == "")
		{
			orders = Sales_Order[Order_Status == "In Progress" || Order_Status == "Production Complete" || Order_Status == "Checking Passed" || Order_Status == "Finishing Complete"] sort by Added_Time desc;
		}
		else
		{
			orders = Sales_Order[Order_Status == targetStatus] sort by Added_Time desc;
		}

		for each so in orders
		{
			if(salesOrderId != null && salesOrderId.trim() != "" && so.ID.toString() != salesOrderId.trim())
			{
				continue;
			}

			orderRow = Map();
			orderRow.put("id",so.ID.toString());
			orderRow.put("salesOrder",ifnull(so.Sales_Order,"").toString());
			odTxt = "";
			if(so.Sales_Order_Date != null)
			{
				odTxt = so.Sales_Order_Date.toString("yyyy-MM-dd");
			}
			else if(so.Added_Time != null)
			{
				odTxt = so.Added_Time.toString("yyyy-MM-dd");
			}
			orderRow.put("orderDate",odTxt);

			custName = "";
			if(so.Customer != null)
			{
				for each cust in Customer_Master[ID == so.Customer]
				{
					custName = ifnull(cust.Company_Name, ifnull(cust.Company_Name,"")).toString();
				}
			}
			orderRow.put("customer",custName);

			planNo = "";
			supervisor = "";
			currentStage = "";
			currentStageStatus = "";
			lastCompletedStage = "";
			nextStep = "Production has not started";
			totalOrdered = 0;
			totalProduced = 0;
			itemCount = 0;
			completeItems = 0;
			remakeItems = 0;
			stageOut = 0;
			stageRows = List();

			itemList = List();
			qtyInProgress = 0;
			qtyAwaitingCheck = 0;
			qtyCheckingPassed = 0;
			qtyFinishingComplete = 0;
			qtyInAlteration = 0;
			qtyTotalRejected = 0;

			firstItemName = "";
			groupedMap = Map();
			groupedOrder = List();

			for each plan in Production_Planning[Sales_Order == so.ID]
			{
				planNo = ifnull(plan.Plan_No,"").toString();
				if(plan.Assigned_To != null)
				{
					for each emp in Employee[ID == plan.Assigned_To]
					{
						supervisor = ifnull(emp.Employee_Name,"").toString();
					}
				}

				openLogs = Stage_Log[Plan == plan.ID && Stage_Status == "In_Progress"] sort by Sequence_No desc;
				doneLogs = Stage_Log[Plan == plan.ID && Stage_Status == "Done"] sort by Sequence_No desc;

				// Pre-fetch finishing completion and alteration quantities for each inspected Plan_Item in this plan
				finishedItemIds = Map();
				altQtyByItem = Map();
				for each chkRec in Item_Check[Plan == plan.ID]
				{
					if(chkRec.Plan_Item != null)
					{
						pItemIdStr = chkRec.Plan_Item.toString();
						if(ifnull(chkRec.Qty_Approved,0) > 0)
						{
							for each fdRec in Finishing_Data[Item_Check == chkRec.ID]
							{
								if(ifnull(fdRec.Finishing_Status,"").toString().trim() == "Done")
								{
									finishedItemIds.put(pItemIdStr, "true");
								}
							}
						}
						if(ifnull(chkRec.Qty_Alteration,0) > 0)
						{
							altQtyByItem.put(pItemIdStr, ifnull(chkRec.Qty_Alteration,0).toLong());
						}
					}
				}

				for each item in Plan_Item[Plan == plan.ID]
				{
					isRm = ifnull(item.Is_Remake,false);
					rmReason = ifnull(item.Remake_Reason,"").toString().trim();
					// Alteration batches (garments sent back to fix a stage) are
					// a different thing to remake batches (fresh cloth needed).
					isAlt = (isRm == true && rmReason == "Alteration");
					itStatus = ifnull(item.Item_Status,"").toString();
					itName = ifnull(item.Item_Name,"").toString();
					if(itName == "")
					{
						itName = "Item #" + item.ID.toString();
					}
					if(firstItemName == "" && itName != "")
					{
						firstItemName = itName;
					}
					qOrd = ifnull(item.Qty_Ordered,0);
					qProd = ifnull(item.Qty_Produced,0);
					qAcc = ifnull(item.Qty_Accepted,0);
					qRej = ifnull(item.Qty_Rejected,0);
					qAlt = ifnull(altQtyByItem.get(item.ID.toString()), 0);

					itemCount = itemCount + 1;
					// Remake batches are replacements for rejected pieces, not new
					// ordered items. Adding their qty to the totals would double-count
					// them (the original item already carries the ordered quantity).
					if(isRm == false)
					{
						totalOrdered = totalOrdered + qOrd;
						totalProduced = totalProduced + qProd;
						if(qRej > 0 && Item_Check[Plan_Item == item.ID].count() > 0)
						{
							qtyTotalRejected = qtyTotalRejected + qRej;
						}
					}

					// An item's finishing is done if the order as a whole is at Finishing Complete/Packed/Dispatched,
					// OR if Finishing_Data for this item is Done.
					isItemFinDone = false;
					if(so.Order_Status == "Finishing Complete" || so.Order_Status == "Packed" || so.Order_Status == "Dispatched")
					{
						isItemFinDone = true;
					}
					else if(finishedItemIds.get(item.ID.toString()) == "true")
					{
						isItemFinDone = true;
					}

					if(isRm == true)
					{
						// Only count as active remake/alteration if the batch is still running
						if(itStatus != "Complete" && isItemFinDone == false && qAcc < qOrd)
						{
							remakeItems = remakeItems + 1;
							remLeft = qOrd - qAcc;
							if(isAlt == true)
							{
								qtyInAlteration = qtyInAlteration + remLeft;
							}
							else
							{
								qtyTotalRejected = qtyTotalRejected + remLeft;
							}
						}
					}
					else if(qAlt > 0 && itStatus != "Complete" && isItemFinDone == false)
					{
						qtyInAlteration = qtyInAlteration + qAlt;
					}

					qRmk = if(isRm == true, qOrd, 0);

					if(qAcc > 0)
					{
						// Any accepted pieces (original or finished remake/alteration) count toward checking-passed / finishing-complete.
						if(isItemFinDone == true)
						{
							qtyFinishingComplete = qtyFinishingComplete + qAcc;
						}
						else
						{
							qtyCheckingPassed = qtyCheckingPassed + qAcc;
						}
					}

					// QC Queue is remaining produced pieces that have NOT been accepted, rejected, or altered yet
					awaitingQty = qProd - qAcc - qRej - qAlt;
					if(awaitingQty > 0)
					{
						qtyAwaitingCheck = qtyAwaitingCheck + awaitingQty;
					}

					inProgQty = qOrd - qProd;
					if(inProgQty > 0 && isRm == false)
					{
						qtyInProgress = qtyInProgress + inProgQty;
					}

					if(itStatus == "Complete")
					{
						completeItems = completeItems + 1;
					}

					itemStage = "";
					itemStageStatus = "";

					for each openLog in openLogs
					{
						if(itemStage == "" && openLog.Plan_Item != null && openLog.Plan_Item == item.ID)
						{
							itemStage = ifnull(openLog.Phase_Name,"").toString();
							itemStageStatus = "Running";
						}
					}

					if(itemStage == "")
					{
						for each doneLog in doneLogs
						{
							if(itemStage == "" && doneLog.Plan_Item != null && doneLog.Plan_Item == item.ID)
							{
								itemStage = ifnull(doneLog.Phase_Name,"").toString();
								itemStageStatus = "Completed";
							}
						}
					}

					if(itemStage == "")
					{
						if(isItemFinDone == true)
						{
							itemStage = "Finishing Complete (Awaiting Packing)";
							itemStageStatus = "Completed";
						}
						else if(itStatus == "Complete")
						{
							itemStage = "QC Passed";
							itemStageStatus = "Passed";
						}
						else if(itStatus == "Awaiting_Check")
						{
							itemStage = "Awaiting QC";
							itemStageStatus = "Waiting";
						}
					}

					if(isItemFinDone == true && (itStatus == "Complete" || itStatus == ""))
					{
						itStatus = "Finishing Complete";
						if(itemStage == "QC Passed" || itemStage == "" || itemStage == "Finishing Complete")
						{
							itemStage = "Finishing Complete (Awaiting Packing)";
							itemStageStatus = "Completed";
						}
					}

					batchObj = Map();
					batchObj.put("id",item.ID.toString());
					batchObj.put("itemName",itName);
					batchObj.put("qtyOrdered",qOrd);
					batchObj.put("qtyProduced",qProd);
					batchObj.put("qtyAccepted",qAcc);
					batchObj.put("qtyRejected",qRej);
					// qtyAltered is non-zero for Alteration batches or original items with qAlt > 0.
					batchObj.put("qtyAltered",if(isAlt, qOrd, qAlt));
					// qtyRemake is non-zero only for Check_Reject batches.
					batchObj.put("qtyRemake",if(isRm && !isAlt, qOrd, 0));
					batchObj.put("status",itStatus);
					batchObj.put("currentStage",itemStage);
					batchObj.put("currentStageStatus",itemStageStatus);
					batchObj.put("isRemake",isRm);
					batchObj.put("remakeReason",rmReason);
					batchObj.put("isFinishingComplete",isItemFinDone);

					if(groupedMap.containKey(itName))
					{
						grp = groupedMap.get(itName);
						if(isRm == true)
						{
							grp.put("hasRemake",true);
							if(isAlt == true)
							{
								// Alteration batch: fix existing garments at a stage.
								grp.put("qtyAltered",qOrd);
								grp.put("altStage",itemStage);
								grp.put("altStageStatus",itemStageStatus);
								grp.put("altStatus",itStatus);
							}
							else
							{
								// Check_Reject batch: new cloth needed.
								grp.put("qtyRemake",qOrd);
								grp.put("remakeStatus",itStatus);
								grp.put("remakeStage",itemStage);
								grp.put("remakeStageStatus",itemStageStatus);
							}

							if(itemStageStatus == "Running" || itStatus == "In_Progress")
							{
								grp.put("currentStage",itemStage);
								grp.put("currentStageStatus","Running");
								grp.put("status","In_Progress");
							}
							else if(itStatus == "Awaiting_Check")
							{
								grp.put("currentStage","Awaiting QC");
								grp.put("currentStageStatus","Waiting");
								grp.put("status","Awaiting_Check");
							}
						}
						else
						{
							grp.put("qtyOrdered",qOrd);
							grp.put("qtyProduced",qProd);
							grp.put("qtyAccepted",qAcc);
							grp.put("qtyRejected",qRej);
							if(qAlt > 0)
							{
								grp.put("qtyAltered",qAlt);
							}
							if(grp.get("hasRemake") != true)
							{
								grp.put("currentStage",itemStage);
								grp.put("currentStageStatus",itemStageStatus);
								grp.put("status",itStatus);
							}
						}
						bList = grp.get("batches");
						bList.add(batchObj);
						grp.put("batches",bList);
					}
					else
					{
						grp = Map();
						grp.put("id",item.ID.toString());
						grp.put("itemName",itName);
						grp.put("qtyOrdered",qOrd);
						grp.put("qtyProduced",qProd);
						grp.put("qtyAccepted",qAcc);
						grp.put("qtyRejected",qRej);
						// For a batch that IS itself a remake/alteration, seed both
						// qty fields from its own type so the grouping block above
						// does not have to handle a missing key later.
						grp.put("qtyAltered",if(isAlt, qOrd, 0));
						grp.put("qtyRemake",if(isRm && !isAlt, qOrd, 0));
						grp.put("hasRemake",isRm);
						grp.put("status",itStatus);
						grp.put("currentStage",itemStage);
						grp.put("currentStageStatus",itemStageStatus);
						if(isRm == true)
						{
							if(isAlt == true)
							{
								grp.put("altStage",itemStage);
								grp.put("altStageStatus",itemStageStatus);
								grp.put("altStatus",itStatus);
							}
							else
							{
								grp.put("remakeStatus",itStatus);
								grp.put("remakeStage",itemStage);
								grp.put("remakeStageStatus",itemStageStatus);
							}
						}
						bList = List();
						bList.add(batchObj);
						grp.put("batches",bList);
						groupedMap.put(itName,grp);
						groupedOrder.add(itName);
					}
				}

				hasOpenLog = false;
				for each openLog in openLogs
				{
					if(!hasOpenLog)
					{
						currentStage = ifnull(openLog.Phase_Name,"").toString();
						currentStageStatus = "Running";
						nextStep = "Finish " + currentStage;
						stageOut = ifnull(openLog.Qty_Out,0);
						stageRow = Map();
						stageRow.put("name",currentStage);
						stageRow.put("state","running");
						stageRow.put("qtyIn",ifnull(openLog.Qty_In,0));
						stageRow.put("qtyOut",ifnull(openLog.Qty_Out,0));
						stageRows.add(stageRow);
						hasOpenLog = true;
					}
				}

				if(currentStage == "")
				{
					hasDoneLog = false;
					for each doneLog in doneLogs
					{
						if(!hasDoneLog)
						{
							lastCompletedStage = ifnull(doneLog.Phase_Name,"").toString();
							stageOut = ifnull(doneLog.Qty_Out,0);
							stageRow = Map();
							stageRow.put("name",lastCompletedStage);
							stageRow.put("state","done");
							stageRow.put("qtyIn",ifnull(doneLog.Qty_In,0));
							stageRow.put("qtyOut",ifnull(doneLog.Qty_Out,0));
							stageRows.add(stageRow);
							hasDoneLog = true;
						}
					}
					if(lastCompletedStage != "")
					{
						currentStage = lastCompletedStage;
						currentStageStatus = "Completed";
						nextStep = "Start next production stage";
					}
				}
			}

			if(targetStatus == "Production Complete")
			{
				currentStage = "QC Inspection";
				currentStageStatus = "Pending";
				nextStep = "Awaiting Quality Check (QC)";
			}
			else if(targetStatus == "Checking Passed")
			{
				currentStage = "Quality Check";
				currentStageStatus = "Passed";
				nextStep = "Ready for Finishing";
			}
			else if(targetStatus == "Finishing Complete")
			{
				currentStage = "Finishing";
				currentStageStatus = "Completed";
				nextStep = "Awaiting Packing";
			}
			else if(targetStatus == "Packed")
			{
				currentStage = "Packing";
				currentStageStatus = "Packed";
				nextStep = "Ready for Dispatch";
			}
			else if(targetStatus == "Dispatched")
			{
				currentStage = "Dispatch";
				currentStageStatus = "Shipped";
				nextStep = "Order Fulfilled & Shipped";
			}
			else if(targetStatus == "Pending")
			{
				currentStage = "Plan Creation";
				currentStageStatus = "Pending";
				nextStep = "Convert order to plan";
			}
			else
			{
				if(itemCount > 0 && completeItems == itemCount)
				{
					nextStep = "Complete quality check";
				}
			}

			itemList = List();
			for each key in groupedOrder
			{
				itemList.add(groupedMap.get(key));
			}

			breakdown = Map();
			breakdown.put("inProgress",qtyInProgress);
			breakdown.put("prodComplete",qtyAwaitingCheck);
			breakdown.put("checkingPassed",qtyCheckingPassed);
			breakdown.put("finishingComplete",qtyFinishingComplete);
			breakdown.put("alteration",qtyInAlteration);
			breakdown.put("rejected",qtyTotalRejected);

			orderRow.put("itemName",firstItemName);
			orderRow.put("planNo",planNo);
			orderRow.put("supervisor",supervisor);
			orderRow.put("orderedQty",totalOrdered);
			orderRow.put("producedQty",totalProduced);
			orderRow.put("totalRejected",qtyTotalRejected);
			orderRow.put("itemCount",itemCount);
			orderRow.put("completedItems",completeItems);
			orderRow.put("remakeItems",remakeItems);
			orderRow.put("stageOut",stageOut);
			orderRow.put("currentStage",currentStage);
			orderRow.put("currentStageStatus",currentStageStatus);
			orderRow.put("lastCompletedStage",lastCompletedStage);
			orderRow.put("nextStep",nextStep);
			orderRow.put("stages",stageRows);
			orderRow.put("itemBreakdown",breakdown);
			orderRow.put("items",itemList);
			ordersOut.add(orderRow);
		}

		response.put("orders",ordersOut);
		response.put("count",ordersOut.size());
		return response;
	}
