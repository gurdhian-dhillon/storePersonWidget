map syncSingleSalesOrder(string salesOrderId)
{
	notifyTo = "gurdhian.helios@gmail.com";
	orgId = "60076905558";
	if(salesOrderId == null || salesOrderId.toString().trim() == "")
	{
		return {"status":"error","message":"salesOrderId is missing"};
	}
	soIdTxt = salesOrderId.toString().trim();
	dupIds = Sales_Order[Inventory_sales_order_Id == soIdTxt].ID.getAll();
	if(dupIds.size() > 0)
	{
		return {"status":"skipped","message":"Already synced","salesOrderId":soIdTxt,"recordId":dupIds.get(0).toString()};
	}
	detailResponse = Map();
	try
	{
		detailResponse = invokeurl
		[
			url :"https://www.zohoapis.in/inventory/v1/salesorders/" + soIdTxt + "?organization_id=" + orgId
			type :GET
			connection:"inventory_connection"
		];
	}
	catch (eApi)
	{
		return {"status":"error","message":"Inventory API call failed","error":eApi.toString(),"salesOrderId":soIdTxt};
	}
	respCode = ifnull(detailResponse.get("code"),"0").toString().trim();
	if(respCode != "0")
	{
		return {"status":"error","message":"Inventory API returned an error","code":respCode,"details":ifnull(detailResponse.get("message"),"").toString(),"salesOrderId":soIdTxt};
	}
	salesorder = detailResponse.get("salesorder");
	if(salesorder == null)
	{
		return {"status":"error","message":"Sales order not found in Inventory","salesOrderId":soIdTxt};
	}
	soNumber = ifnull(salesorder.get("salesorder_number"),"").toString().trim();
	invStatus = ifnull(salesorder.get("status"),"").toString().trim().toLowerCase();
	if(invStatus == "draft" || invStatus == "void")
	{
		return {"status":"skipped","message":"Inventory order is " + invStatus + " - not synced","salesOrderId":soIdTxt,"salesOrderNumber":soNumber};
	}
	custId = null;
	custMissTxt = "";
	custName = ifnull(salesorder.get("customer_name"),"").toString().trim();
	if(custName == "")
	{
		custMissTxt = "(no customer name on the Inventory order)";
	}
	else
	{
		custHits = Customer_Master[Display_Name == custName].ID.getAll();
		if(custHits.size() > 0)
		{
			custId = custHits.get(0);
		}
		else
		{
			custMissTxt = custName;
		}
	}
	srcRaw = "";
	shipAddrRaw = "";
	cfList = ifnull(salesorder.get("custom_fields"),List());
	for each  cfRow in cfList
	{
		cfLabel = ifnull(cfRow.get("label"),"").toString().trim().toLowerCase();
		if(cfLabel == "order source" || cfLabel == "source")
		{
			srcRaw = ifnull(cfRow.get("value"),"").toString().trim();
		}
		if(cfLabel == "customer shipping address")
		{
			shipAddrRaw = ifnull(cfRow.get("value"),"").toString().trim();
		}
	}
	if(srcRaw == "")
	{
		srcRaw = ifnull(salesorder.get("source"),"").toString().trim();
	}

	// THE CONTACT NAME IS THE FIRST COMMA-SEPARATED SEGMENT of the "Customer
	// Shipping Address" custom field. Shopify writes it as
	// "<name>, <street>, <area>, <state> <pin>, <country>", so index 0 is the
	// person. Applied to every order, not just Shopify. A field with no comma is
	// taken whole; an empty field leaves Customer_Person_Name blank rather than
	// failing the order.
	custPersonName = "";
	if(shipAddrRaw != "")
	{
		addrParts = shipAddrRaw.toList(",");
		if(addrParts.size() > 0)
		{
			custPersonName = ifnull(addrParts.get(0),"").toString().trim().replaceAll("\r","").replaceAll("\n"," ").replaceAll("\t"," ");
		}
	}
	srcCmp = srcRaw.toLowerCase();
	srcNorm = "";
	if(srcCmp == "shopify")
	{
		srcNorm = "Shopify";
	}
	else if(srcCmp == "faire")
	{
		srcNorm = "Faire";
	}
	else if(srcCmp == "custom")
	{
		srcNorm = "Custom";
	}
	else if(srcCmp == "pr")
	{
		srcNorm = "PR";
	}
	lineItems = ifnull(salesorder.get("line_items"),List());
	rowCollection = Collection();
	noItemTxt = "";
	noBomTxt = "";
	multiBomTxt = "";
	lineCount = 0;
	for each  liRow in lineItems
	{
		lineCount = lineCount + 1;
		liName = ifnull(liRow.get("name"),"").toString();
		liSku = ifnull(liRow.get("sku"),"").toString().trim();
		nameTxt = liName.trim();
		if(nameTxt == "")
		{
			nameTxt = "(unnamed item)";
		}
		newRow = Sales_Order.Item_Table();
		newRow.Item_Name=liName;
		newRow.Rate=liRow.get("rate");
		newRow.Amount=liRow.get("item_total");
		newRow.Quantity=liRow.get("quantity");
		imId = null;
		if(liSku != "")
		{
			imHits = Item_Master[SKU == liSku].ID.getAll();
			if(imHits.size() > 0)
			{
				imId = imHits.get(0);
				newRow.SKU=imId;
			}
		}
		if(imId == null)
		{
			if(noItemTxt != "")
			{
				noItemTxt = noItemTxt + ", ";
			}
			noItemTxt = noItemTxt + nameTxt + " (SKU '" + liSku + "')";
		}
		else
		{
			bomIds = BOM[Item == imId].ID.getAll();
			if(bomIds.size() == 0)
			{
				if(noBomTxt != "")
				{
					noBomTxt = noBomTxt + ", ";
				}
				noBomTxt = noBomTxt + nameTxt;
			}
			else if(bomIds.size() > 1)
			{
				if(multiBomTxt != "")
				{
					multiBomTxt = multiBomTxt + ", ";
				}
				multiBomTxt = multiBomTxt + nameTxt + " (" + bomIds.size() + " BOMs)";
			}
		}
		rowCollection.insert(newRow);
	}
	insertResult = null;
	try
	{
		insertResult = insert into Sales_Order
		[
			Sales_Order_Date=salesorder.get("date")
			Reference=salesorder.get("reference_number")
			Total=salesorder.get("total")
			Inventory_sales_order_Id=soIdTxt
			Customer=custId
			Customer_Person_Name=custPersonName
			Sales_Order=soNumber
			Grand_Total=salesorder.get("total")
			Order_Status="Pending"
			Order_Source=srcNorm
			Item_Table=rowCollection
			Added_User=zoho.loginuser
		];
	}
	catch (eIns)
	{
		return {"status":"error","message":"Insert failed","error":eIns.toString(),"salesOrderId":soIdTxt};
	}
	if(insertResult == null)
	{
		return {"status":"error","message":"Insert returned null - record not created","salesOrderId":soIdTxt};
	}

	//----------------------------------------------------------------------
	// EXPECTED DELIVERY DATE = ORDER DATE + 3 DAYS, SHOPIFY ONLY.
	//
	// Inventory's "date" is an ISO string (yyyy-MM-dd). Deluge parses
	// "dd-MMM-yyyy" the same way whatever the org's locale is set to, while an
	// ISO or a dd/MM string is read differently in the US than here - so it is
	// reformatted through its parts first, the same pattern syncPurchaseInflow
	// uses on the bill date. Set AFTER the insert: a Date field cannot take a
	// null in the insert block, and this is skipped entirely for non-Shopify.
	//
	// A date Inventory sent in a shape we cannot read leaves the field blank
	// rather than failing the sync - the order still plans, just without the
	// expected date, and the note below flags it.
	//----------------------------------------------------------------------
	delivNote = "";
	if(srcNorm == "Shopify")
	{
		invDateTxt = ifnull(salesorder.get("date"),"").toString().trim();
		if(invDateTxt.length() > 10)
		{
			invDateTxt = invDateTxt.substring(0,10);
		}

		// The whole parse is wrapped: a malformed date must never fail the sync,
		// only leave Expected_Delivery_Date blank and say why. .toNumber() on a
		// non-numeric part and .toDate() on a bad string can both throw.
		try
		{
			isoParts = invDateTxt.toList("-");
			if(isoParts.size() != 3)
			{
				delivNote = "could not split date '" + invDateTxt.replaceAll("\"","'") + "'";
			}
			else
			{
				monNames = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
				monIdx = isoParts.get(1).toString().toNumber() - 1;
				if(monIdx < 0 || monIdx > 11)
				{
					delivNote = "month out of range in '" + invDateTxt.replaceAll("\"","'") + "'";
				}
				else
				{
					dmyTxt = isoParts.get(2).toString() + "-" + monNames.get(monIdx) + "-" + isoParts.get(0).toString();
					baseDate = dmyTxt.toDate();
					delivDate = baseDate.addDay(3);
					for each  soUpd in Sales_Order[ID == insertResult]
					{
						soUpd.Expected_Delivery_Date = delivDate;
					}
					delivNote = "set to " + delivDate.toString("dd-MMM-yyyy") + " (order date + 3)";
				}
			}
		}
		catch (eDate)
		{
			delivNote = "FAILED to parse '" + invDateTxt.replaceAll("\"","'") + "' - " + eDate.toString().replaceAll("\"","'");
		}
	}
	else
	{
		delivNote = "not Shopify - left blank";
	}

	issueCount = 0;
	rowsHtml = "";
	if(srcNorm == "")
	{
		issueCount = issueCount + 1;
		shownSrc = srcRaw.replaceAll("\"","'");
		if(shownSrc == "")
		{
			shownSrc = "(empty)";
		}
		rowsHtml = rowsHtml + "<tr><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a;font-weight:600'>Order source</td><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a'>Inventory sent <b>" + shownSrc + "</b>, which is not one of Shopify, Faire, Custom or PR. The order is saved with an empty source and will sort LAST on the store screen.</td></tr>";
	}
	if(noItemTxt != "")
	{
		issueCount = issueCount + 1;
		rowsHtml = rowsHtml + "<tr><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a;font-weight:600'>Not in Item Master</td><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a'>" + noItemTxt.replaceAll("\"","'") + "</td></tr>";
	}
	if(noBomTxt != "")
	{
		issueCount = issueCount + 1;
		rowsHtml = rowsHtml + "<tr><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a;font-weight:600'>No BOM</td><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a'>" + noBomTxt.replaceAll("\"","'") + "</td></tr>";
	}
	if(multiBomTxt != "")
	{
		issueCount = issueCount + 1;
		rowsHtml = rowsHtml + "<tr><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a;font-weight:600'>More than one BOM</td><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a'>" + multiBomTxt.replaceAll("\"","'") + "</td></tr>";
	}

	// A Shopify order whose date could not be read is saved and plans fine, but
	// its expected delivery date is blank - worth flagging so someone sets it by
	// hand rather than shipping late without noticing.
	if(srcNorm == "Shopify" && delivNote.startsWith("set to ") == false)
	{
		issueCount = issueCount + 1;
		rowsHtml = rowsHtml + "<tr><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a;font-weight:600'>Expected delivery date</td><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a'>Could not set it from the Inventory order date (" + delivNote.replaceAll("\"","'") + "). The order is saved without an expected delivery date - set it by hand on the Creator record.</td></tr>";
	}

	// Flagged for Shopify only: Faire / Custom / PR orders may legitimately not
	// carry the "Customer Shipping Address" custom field, and a "needs attention"
	// mail on every one of those would train people to ignore it. The name is
	// still taken whenever the field is present, whatever the source.
	if(srcNorm == "Shopify" && custPersonName == "")
	{
		issueCount = issueCount + 1;
		rowsHtml = rowsHtml + "<tr><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a;font-weight:600'>Customer person name</td><td style='padding:8px 12px;border-bottom:1px solid #e5e7eb;color:#0f172a'>The Inventory order carries no <b>Customer Shipping Address</b> custom field, or it was empty, so no contact name could be taken. Set <b>Customer Person Name</b> by hand on the Creator record.</td></tr>";
	}

	mailNote = "not needed";
	if(issueCount > 0)
	{
		try
		{
			innerHtml = "<div style='font-size:14px;color:#0f172a'>Sales order <b>" + soNumber.replaceAll("\"","'") + "</b> arrived from Inventory and has been saved, but <b>" + issueCount + "</b> thing(s) must be fixed before the next planner run or it cannot be planned.</div>";
			innerHtml = innerHtml + "<table style='width:100%;border-collapse:collapse;margin-top:14px;font-size:13px'>" + rowsHtml + "</table>";
			innerHtml = innerHtml + "<div style='font-size:12px;color:#64748b;padding-top:14px'>The order is sitting at <b>Pending</b>, so the planner will retry it on every run. Nothing is lost - it simply will not be planned until the rows above are fixed.</div>";
			mailBody = thisapp.buildNotificationEmail("Sales order needs attention","SO " + soNumber + " - synced from Inventory","#dc2626",innerHtml);
			sendmail
			[
				from :zoho.adminuserid
				to :notifyTo
				subject :"Action needed: SO " + soNumber + " cannot be planned yet"
				message :mailBody
			]
			mailNote = "accepted, to " + notifyTo;
		}
		catch (eMail)
		{
			mailNote = "FAILED - " + eMail.toString();
		}
	}
	return {"status":"success","salesOrderId":soIdTxt,"recordId":insertResult.toString(),"salesOrderNumber":soNumber,"orderSource":srcNorm,"orderStatus":"Pending","lineItems":lineCount,"issues":issueCount,"noBom":noBomTxt,"multiBom":multiBomTxt,"notInItemMaster":noItemTxt,"customerUnmatched":custMissTxt,"customerPersonName":custPersonName,"expectedDeliveryDate":delivNote,"mail":mailNote};
}
