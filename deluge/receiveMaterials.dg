string receiveMaterials(string supervisorId, string receiptsJson)
{
	// Supervisor confirms what he physically received.
	//
	// SWEEP APPLIER. The widget no longer sends per-line settlements. At
	// 100 items/order a common trim ("care label") fanned across every open
	// item is 10,000 Issue_Lines on one handover; a per-line payload was ~84
	// sequential calls, and each call re-scanned a voucher's whole subform to
	// FIND each line - O(lines squared) per chunk, past the uncatchable
	// statement-execution limit.
	//
	// Instead the widget names the vouchers it is confirming ("vouchers") and,
	// only for a material he marked short, how much of it actually arrived
	// ("shortMaterials"). This function walks each voucher's Issue_Lines ONCE,
	// settling every still-owed line as it goes, in budgeted resumable slices.
	//
	// receiptsJson:
	// {
	//   "vouchers": ["77","78", ...],      // the sweep scope, oldest-first
	//   "sweepCursor": {},                  // {} to start; server returns resume point
	//                                       // {"v":<vIdx>,"l":"<lastLineId>",
	//                                       //  "sd":{matId:leftToCredit},
	//                                       //  "nd":{"planId|matId":openDisputeQtyLeft}}
	//   "shortMaterials": [
	//     { "materialId":"123", "owed":10.0, "received":9.5, "remark":"..." }
	//   ],
	//   "waste":         [ {"rowId":"456","received":1,"remark":""} ],
	//   "printedPieces": [ {"issueLineId":"555","voucherId":"77","received":3,"remark":""} ],
	//   "plansTouched":  ["50","51"],       // for the readiness sweep
	//   "disputeIds":    ["111","222"],     // finalize/notify: disputes this receipt raised
	//   "finalize":      false,
	//   "finalizeCursor": {}                // {} to start; {"ph":"vouchers"|"items"|
	//                                       //  "transfer"|"notify"|"done", ...}
	// }
	//
	// SWEEP SLICE (finalize:false): walk "vouchers" from the cursor up to
	// LINE_BUDGET still-owed lines. Per line: Settled_Qty = Qty (the whole owed
	// amount leaves In_Transit), Requirement.Received_Qty += the part that
	// arrived, the rest is a shortfall. Open disputes are netted per plan+material
	// exactly as getSupervisorMaterials shows him, drawn down in the cursor so a
	// later slice does not re-net the same dispute. Stock (parent + lot
	// In_Transit -> Disputed) is drained once per material / lot at the end of the
	// slice. One Stock_Dispute per (plan, material) with a gap is UPSERTED - a
	// shortfall split across slices is one dispute, not one per slice.
	//
	// WASTE + PRINTED: still explicit, one row per physical piece (bounded), and
	// unchanged. The widget sends them on the first sweep call only.
	//
	// FINALIZE (finalize:true), one phase per call, driven by finalizeCursor.ph:
	//   "vouchers"  - recheck Issue_Status for "vouchers", VOUCHER_BUDGET per call.
	//                 Moved here from every chunk; nothing reads it mid-receipt.
	//   "items"     - readiness sweep over "plansTouched", BUDGETED BY Plan_Item
	//                 COUNT (ITEM_BUDGET), not by plan count - 15 plans x 100
	//                 items was the limit-killer. Item already past
	//                 Awaiting_Material skips the req/waste walk. Plan Order_Status
	//                 rolled from a count query, not a re-walk.
	//   "transfer"  - postTransferOrders("auto"), its own try/catch.
	//   "notify"    - build the dispute digest from "disputeIds" and send the two
	//                 mails, once, for the whole receipt.
	//
	// WRITE-CONTRACT KEPT for getStoreIssueHistory / postTransferOrders /
	// getOrderConsumption / resolveDispute:
	//  - Issue_Lines.Settled_Qty advanced to Qty on every line the sweep touches.
	//  - Material_Requirement.Received_Qty advanced by the arrived part.
	//  - Raw_Material / Raw_Material_Lot: In_Transit_Qty down by the settled part,
	//    Disputed_Qty up by the shortfall.
	//  - Stock_Dispute: one per plan carrying a gap, Direction="Outbound".
	//  - Material_Issue.Issue_Status -> Received / Partially_Received (finalize).

	errJson = "";
	okJson = "";
	// Filled ONLY by the finalize "notify" phase now, so the mail block at the
	// end fires exactly once per receipt rather than once per sweep slice.
	dispRows = List();
	// Dispute ids raised by THIS sweep slice - the widget unions them across
	// slices and hands the full set to the finalize "notify" phase.
	newDispIdsJson = "";

	sweepCursorJson = "null";
	sweepDone = true;
	finalizeCursorJson = "{\"ph\":\"done\"}";
	finalizeDone = true;

	// DEBUG WRAPPER: Creator reports every runtime failure as a generic
	// "code 9430 - There is an error while executing Custom API." Catching it
	// here surfaces the real Deluge message in the widget console instead.
	try
	{
	supId = supervisorId.trim().toLong();
	inp = receiptsJson.toMap();

	vouchersIn = ifnull(inp.get("vouchers"),"[]").toString().toJSONList();
	shortMatsIn = ifnull(inp.get("shortMaterials"),"[]").toString().toJSONList();
	wastes = ifnull(inp.get("waste"),"[]").toString().toJSONList();
	printed = ifnull(inp.get("printedPieces"),"[]").toString().toJSONList();
	plansTouchedIn = ifnull(inp.get("plansTouched"),"[]").toString().toJSONList();
	disputeIdsIn = ifnull(inp.get("disputeIds"),"[]").toString().toJSONList();
	doFinalize = (ifnull(inp.get("finalize"),"false").toString().trim() == "true");
	// toMap() on "{}" / "" is not worth trusting - build empty and only parse a
	// cursor that actually carries something.
	swCur = Map();
	swRawTxt = ifnull(inp.get("sweepCursor"),"").toString().trim();
	if(swRawTxt != "" && swRawTxt != "{}")
	{
		swCur = swRawTxt.toMap();
	}
	fnCur = Map();
	fnRawTxt = ifnull(inp.get("finalizeCursor"),"").toString().trim();
	if(fnRawTxt != "" && fnRawTxt != "{}")
	{
		fnCur = fnRawTxt.toMap();
	}

	LINE_BUDGET = 250;
	VOUCHER_BUDGET = 60;
	ITEM_BUDGET = 250;

	info "receiveMaterials supId=" + supId + " vouchers=" + vouchersIn.size() + " short=" + shortMatsIn.size() + " waste=" + wastes.size() + " printed=" + printed.size() + " finalize=" + doFinalize;

	//------------------------------------------------------------------------
	// SO number per plan - used by dispute messages and the notify digest.
	// Bounded by plansTouched (a receipt touches a handful).
	//------------------------------------------------------------------------
	soNoByPlan = Map();
	for each  ptRaw in plansTouchedIn
	{
		ptTxt = ifnull(ptRaw,"").toString().trim();
		if(ptTxt != "" && ptTxt.isNumber() == true && soNoByPlan.get(ptTxt) == null)
		{
			soTxtP = "";
			for each  ppRec in Production_Planning[ID == ptTxt.toLong()]
			{
				ppSoTxt = ifnull(ppRec.Sales_Order,"").toString().trim();
				if(ppSoTxt != "")
				{
					for each  soRec in Sales_Order[ID == ppSoTxt.toLong()]
					{
						soTxtP = ifnull(soRec.Sales_Order,"").toString().replaceAll("\"","'");
					}
				}
			}
			soNoByPlan.put(ptTxt,soTxtP);
		}
	}

	if(doFinalize == false)
	{
		//================================================================
		// SWEEP SLICE.
		//================================================================
		startV = 0;
		svS = ifnull(swCur.get("v"),"").toString().trim();
		if(svS != "" && svS.isNumber() == true)
		{
			startV = svS.toLong();
		}
		afterLine = ifnull(swCur.get("l"),"").toString().trim();

		// shortLeft: matId -> qty still to credit as "arrived". Seeded from the
		// cursor on a resume so it survives across slices, else from the payload.
		shortLeft = Map();
		shortRemarkByMat = Map();
		shortSeedRaw = ifnull(swCur.get("sd"),"").toString().trim();
		if(shortSeedRaw != "" && shortSeedRaw != "{}")
		{
			sdMap = shortSeedRaw.toMap();
			for each  sdK in sdMap.keys()
			{
				sdVS = ifnull(sdMap.get(sdK),"0").toString().trim();
				if(sdVS == "")
				{
					sdVS = "0";
				}
				shortLeft.put(sdK,sdVS.toDecimal());
			}
		}
		else
		{
			for each  smRaw in shortMatsIn
			{
				sm = smRaw.toMap();
				smId = ifnull(sm.get("materialId"),"").toString().trim();
				if(smId != "")
				{
					smRcvS = ifnull(sm.get("received"),"0").toString().trim();
					if(smRcvS == "")
					{
						smRcvS = "0";
					}
					shortLeft.put(smId,smRcvS.toDecimal());
					shortRemarkByMat.put(smId,ifnull(sm.get("remark"),"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," "));
				}
			}
		}

		// dispNet: "planId|matId" -> still-open disputed qty, netted off the
		// lines the sweep settles (same rule getSupervisorMaterials shows him).
		// Rebuilt from his open disputes on the first slice, then drawn down and
		// carried in the cursor so a later slice cannot re-net the same dispute.
		dispNet = Map();
		dnSeedRaw = ifnull(swCur.get("nd"),"").toString().trim();
		if(dnSeedRaw != "" && dnSeedRaw != "{}")
		{
			dnMap = dnSeedRaw.toMap();
			for each  dnK in dnMap.keys()
			{
				dnVS = ifnull(dnMap.get(dnK),"0").toString().trim();
				if(dnVS == "")
				{
					dnVS = "0";
				}
				dispNet.put(dnK,dnVS.toDecimal());
			}
		}
		else
		{
			for each  odsp in Stock_Dispute[Supervisor == supId && Status == "Open" && Is_Waste == false]
			{
				odDir = ifnull(odsp.Direction,"Outbound").toString().trim();
				if(odDir == "")
				{
					odDir = "Outbound";
				}
				if(odDir == "Outbound" && odsp.Plan != null && odsp.Material != null)
				{
					odqS = ifnull(odsp.Disputed_Qty,"0").toString().trim();
					if(odqS == "")
					{
						odqS = "0";
					}
					odRes = 0.0;
					for each  odrl in odsp.Resolution_Lines
					{
						odrS = ifnull(odrl.Resolved_Qty,"0").toString().trim();
						if(odrS == "")
						{
							odrS = "0";
						}
						odRes = odRes + odrS.toDecimal();
					}
					odLeft = odqS.toDecimal() - odRes;
					if(odLeft > 0)
					{
						odKey = odsp.Plan + "|" + odsp.Material;
						dispNet.put(odKey,ifnull(dispNet.get(odKey),0.0) + odLeft);
					}
				}
			}
		}

		// per-slice accumulators
		settledByMat = Map();
		shortByMat = Map();
		confByMat = Map();
		settledByLot = Map();
		shortByLot = Map();
		matNameById = Map();
		matUnitById = Map();
		dispLotByMat = Map();
		dispLotShareByMat = Map();
		pmKeys = List();
		shortByPM = Map();
		shortPendPM = Map();
		shortGotPM = Map();
		shortItemPM = Map();

		linesDone = 0;
		budgetHit = false;
		vIdx = 0;

		for each  vRaw in vouchersIn
		{
			vTxt = ifnull(vRaw,"").toString().trim();
			if(budgetHit == false && vIdx >= startV && vTxt != "" && vTxt.isNumber() == true)
			{
				// On a resume INTO this exact voucher, step over lines up to and
				// including afterLine; otherwise start fresh.
				reachedResume = true;
				if(vIdx == startV && afterLine != "")
				{
					reachedResume = false;
				}

				for each  vRec in Material_Issue[ID == vTxt.toLong()]
				{
					for each  miLn in vRec.Issue_Lines
					{
						if(budgetHit == false)
						{
							lnIdTxt = miLn.ID + "";
							if(reachedResume == false)
							{
								if(lnIdTxt == afterLine)
								{
									reachedResume = true;
								}
							}
							else
							{
								qS = ifnull(miLn.Qty,"0").toString().trim();
								if(qS == "")
								{
									qS = "0";
								}
								setS = ifnull(miLn.Settled_Qty,"0").toString().trim();
								if(setS == "")
								{
									setS = "0";
								}
								lnQ = qS.toDecimal();
								owed = lnQ - setS.toDecimal();

								matTxt = ifnull(miLn.Material,"").toString().trim();
								reqTxt = ifnull(miLn.Requirement,"").toString().trim();
								lotTxt = ifnull(miLn.Lot,"").toString().trim();
								rPlan = "";
								rItem = "";

								if(owed > 0 && reqTxt != "")
								{
									for each  rq0 in Material_Requirement[ID == reqTxt.toLong()]
									{
										rPlan = ifnull(rq0.Plan,"").toString().trim();
										rItem = ifnull(rq0.Plan_Item,"").toString().trim();
										if(matNameById.get(matTxt) == null)
										{
											matNameById.put(matTxt,ifnull(rq0.Material_Name,"").toString());
										}
										if(matUnitById.get(matTxt) == null)
										{
											matUnitById.put(matTxt,ifnull(rq0.Unit,"").toString());
										}
									}
								}

								// NET off an open dispute for this plan+material.
								if(owed > 0 && rPlan != "" && matTxt != "")
								{
									dnKey = rPlan + "|" + matTxt;
									dnLeft = dispNet.get(dnKey);
									if(dnLeft != null && dnLeft > 0)
									{
										dnTake = dnLeft;
										if(dnTake > owed)
										{
											dnTake = owed;
										}
										owed = owed - dnTake;
										dispNet.put(dnKey,dnLeft - dnTake);
									}
								}

								if(owed > 0)
								{
									if(matNameById.get(matTxt) == null && ifnull(miLn.Material_Name,"").toString().trim() != "")
									{
										matNameById.put(matTxt,ifnull(miLn.Material_Name,"").toString());
									}
									if(matUnitById.get(matTxt) == null && ifnull(miLn.Unit,"").toString().trim() != "")
									{
										matUnitById.put(matTxt,ifnull(miLn.Unit,"").toString());
									}

									conf = owed;
									shortQ = 0.0;
									slLeft = shortLeft.get(matTxt);
									if(slLeft != null)
									{
										if(slLeft >= owed)
										{
											conf = owed;
											shortLeft.put(matTxt,slLeft - owed);
										}
										else
										{
											conf = slLeft;
											if(conf < 0)
											{
												conf = 0.0;
											}
											shortLeft.put(matTxt,0.0);
										}
										shortQ = owed - conf;
									}

									// Settle the line in full - the whole owed
									// amount leaves In_Transit this receipt.
									miLn.Settled_Qty = lnQ;

									if(reqTxt != "")
									{
										for each  rq1 in Material_Requirement[ID == reqTxt.toLong()]
										{
											rcvS = ifnull(rq1.Received_Qty,"0").toString().trim();
											if(rcvS == "")
											{
												rcvS = "0";
											}
											rq1.Received_Qty = rcvS.toDecimal() + conf;
										}
									}

									settledByMat.put(matTxt,ifnull(settledByMat.get(matTxt),0.0) + owed);
									confByMat.put(matTxt,ifnull(confByMat.get(matTxt),0.0) + conf);
									if(shortQ > 0)
									{
										shortByMat.put(matTxt,ifnull(shortByMat.get(matTxt),0.0) + shortQ);
									}
									if(lotTxt != "")
									{
										settledByLot.put(lotTxt,ifnull(settledByLot.get(lotTxt),0.0) + owed);
										if(shortQ > 0)
										{
											shortByLot.put(lotTxt,ifnull(shortByLot.get(lotTxt),0.0) + shortQ);
											if(shortQ > ifnull(dispLotShareByMat.get(matTxt),0.0))
											{
												dispLotShareByMat.put(matTxt,shortQ);
												dispLotByMat.put(matTxt,lotTxt);
											}
										}
									}

									if(shortQ > 0 && rPlan != "")
									{
										pmk = rPlan + "|" + matTxt;
										if(shortByPM.get(pmk) == null)
										{
											pmKeys.add(pmk);
											shortByPM.put(pmk,0.0);
											shortPendPM.put(pmk,0.0);
											shortGotPM.put(pmk,0.0);
											shortItemPM.put(pmk,"");
										}
										shortByPM.put(pmk,shortByPM.get(pmk) + shortQ);
										shortPendPM.put(pmk,shortPendPM.get(pmk) + owed);
										shortGotPM.put(pmk,shortGotPM.get(pmk) + conf);
										if(ifnull(shortItemPM.get(pmk),"").toString() == "" && rItem != "")
										{
											shortItemPM.put(pmk,rItem);
										}
									}

								}

								// Advance the resume point past this line whether
								// or not it owed anything - a resume must not
								// revisit it - and count EVERY visited line toward
								// the budget so a long run of already-settled lines
								// cannot blow the limit either.
								afterLine = lnIdTxt;
								startV = vIdx;
								linesDone = linesDone + 1;
								if(linesDone >= LINE_BUDGET)
								{
									budgetHit = true;
								}
							}
						}
					}
				}

				if(budgetHit == false)
				{
					// Whole voucher consumed - the next slice starts fresh at
					// the next voucher.
					startV = vIdx + 1;
					afterLine = "";
				}
			}
			vIdx = vIdx + 1;
		}

		//------------------------------------------------------------------
		// Drain In_Transit -> (production / Disputed), once per material and
		// once per lot the slice touched. Never below zero.
		//
		// INVENTORY ADJUSTMENT DISABLED FOR NOW. The old materials loop enqueued
		// a Consumption row (settled - short) into Inventory_Post_Queue via
		// thisapp.queueInventoryPost("Consumption", ...). We are not creating Zoho
		// Inventory adjustments at the moment, so receiving material updates
		// Creator only. The warehouse transfer in the finalize "transfer" phase
		// is a separate thing and stays.
		//------------------------------------------------------------------
		for each  mk in settledByMat.keys()
		{
			drainM = settledByMat.get(mk);
			shM = ifnull(shortByMat.get(mk),0.0);
			for each  rmS in Raw_Material[ID == mk.toLong()]
			{
				itS = ifnull(rmS.In_Transit_Qty,"0").toString().trim();
				if(itS == "")
				{
					itS = "0";
				}
				dpS = ifnull(rmS.Disputed_Qty,"0").toString().trim();
				if(dpS == "")
				{
					dpS = "0";
				}
				itV = itS.toDecimal();
				offM = drainM;
				if(offM > itV)
				{
					offM = itV;
				}
				rmS.In_Transit_Qty = itV - offM;
				if(shM > 0)
				{
					rmS.Disputed_Qty = dpS.toDecimal() + shM;
				}
			}
		}
		for each  lk in settledByLot.keys()
		{
			drainL = settledByLot.get(lk);
			shL = ifnull(shortByLot.get(lk),0.0);
			for each  ltS in Raw_Material_Lot[ID == lk.toLong()]
			{
				litS = ifnull(ltS.In_Transit_Qty,"0").toString().trim();
				if(litS == "")
				{
					litS = "0";
				}
				ldpS = ifnull(ltS.Disputed_Qty,"0").toString().trim();
				if(ldpS == "")
				{
					ldpS = "0";
				}
				litV = litS.toDecimal();
				offL = drainL;
				if(offL > litV)
				{
					offL = litV;
				}
				ltS.In_Transit_Qty = litV - offL;
				if(shL > 0)
				{
					ltS.Disputed_Qty = ldpS.toDecimal() + shL;
				}
			}
		}

		//------------------------------------------------------------------
		// UPSERT one Stock_Dispute per (plan, material) with a gap. A shortfall
		// split across sweep slices lands on ONE dispute, not one per slice.
		//------------------------------------------------------------------
		for each  pmk in pmKeys
		{
			pmShort = shortByPM.get(pmk);
			if(pmShort != null && pmShort > 0)
			{
				pmParts = pmk.toList("|");
				pmPlan = pmParts.get(0).toString();
				pmMat = pmParts.get(1).toString();
				pmName = ifnull(matNameById.get(pmMat),"").toString();
				if(pmName == "")
				{
					pmName = "Material " + pmMat;
				}
				pmUnit = ifnull(matUnitById.get(pmMat),"").toString();
				pmSo = ifnull(soNoByPlan.get(pmPlan),"").toString();
				pmRemark = ifnull(shortRemarkByMat.get(pmMat),"").toString();

				existDsp = "";
				for each  exd in Stock_Dispute[Supervisor == supId && Plan == pmPlan.toLong() && Material == pmMat.toLong() && Status == "Open"]
				{
					exDir = ifnull(exd.Direction,"Outbound").toString().trim();
					if(exDir == "")
					{
						exDir = "Outbound";
					}
					if(existDsp == "" && exDir == "Outbound" && ifnull(exd.Is_Waste,false) == false)
					{
						existDsp = exd.ID + "";
						exIq = ifnull(exd.Issued_Qty,"0").toString().trim();
						if(exIq == "")
						{
							exIq = "0";
						}
						exRq = ifnull(exd.Received_Qty,"0").toString().trim();
						if(exRq == "")
						{
							exRq = "0";
						}
						exDq = ifnull(exd.Disputed_Qty,"0").toString().trim();
						if(exDq == "")
						{
							exDq = "0";
						}
						exd.Issued_Qty = exIq.toDecimal() + shortPendPM.get(pmk);
						exd.Received_Qty = exRq.toDecimal() + shortGotPM.get(pmk);
						exd.Disputed_Qty = exDq.toDecimal() + pmShort;
					}
				}

				if(existDsp == "")
				{
					try
					{
						newDId = insert into Stock_Dispute
						[
							Material_Name=pmName
							Unit=pmUnit
							Is_Waste=false
							Direction="Outbound"
							Issued_Qty=shortPendPM.get(pmk)
							Received_Qty=shortGotPM.get(pmk)
							Disputed_Qty=pmShort
							Status="Open"
							Raised_On=zoho.currentdate
							Raised_Note=pmRemark
							Added_User=zoho.loginuser
						];
						for each  nd0 in Stock_Dispute[ID == newDId.toLong()]
						{
							nd0.Material = pmMat.toLong();
							nd0.Supervisor = supId;
							dlot = ifnull(dispLotByMat.get(pmMat),"").toString();
							if(dlot != "")
							{
								nd0.Lot = dlot.toLong();
							}
							nd0.Plan = pmPlan.toLong();
							ditem = ifnull(shortItemPM.get(pmk),"").toString();
							if(ditem != "")
							{
								nd0.Plan_Item = ditem.toLong();
							}
						}
						existDsp = newDId + "";
					}
					catch (edsp)
					{
						info "Stock_Dispute not raised for " + pmName + " plan " + pmPlan + ": " + edsp.toString();
					}
				}

				if(existDsp != "")
				{
					if(newDispIdsJson != "")
					{
						newDispIdsJson = newDispIdsJson + ",";
					}
					newDispIdsJson = newDispIdsJson + "\"" + existDsp + "\"";
				}

				if(errJson != "")
				{
					errJson = errJson + ",";
				}
				errJson = errJson + "\"" + pmName + " (" + pmSo + "): " + pmShort + " short of " + shortPendPM.get(pmk) + " issued - dispute raised\"";
			}
		}

		for each  ck in confByMat.keys()
		{
			if(okJson != "")
			{
				okJson = okJson + ",";
			}
			okJson = okJson + "{\"materialId\":\"" + ck + "\",\"received\":" + confByMat.get(ck) + ",\"short\":" + ifnull(shortByMat.get(ck),0.0) + "}";
		}

		//------------------------------------------------------------------
		// The sweep cursor.
		//------------------------------------------------------------------
		sweepDone = (budgetHit == false);
		if(budgetHit == true)
		{
			sdJson = "{";
			sdFirst = true;
			for each  sk in shortLeft.keys()
			{
				if(sdFirst == false)
				{
					sdJson = sdJson + ",";
				}
				sdJson = sdJson + "\"" + sk + "\":" + shortLeft.get(sk);
				sdFirst = false;
			}
			sdJson = sdJson + "}";

			ndJson = "{";
			ndFirst = true;
			for each  nk in dispNet.keys()
			{
				if(ndFirst == false)
				{
					ndJson = ndJson + ",";
				}
				ndJson = ndJson + "\"" + nk + "\":" + dispNet.get(nk);
				ndFirst = false;
			}
			ndJson = ndJson + "}";

			sweepCursorJson = "{\"v\":" + startV + ",\"l\":\"" + afterLine + "\",\"sd\":" + sdJson + ",\"nd\":" + ndJson + "}";
		}

		//------------------------------------------------------------------------
		// Waste pieces - rowId is a Waste_Movement id, a top-level record, so this
		// is already a true point lookup. Sent on the first sweep call only.
		//------------------------------------------------------------------------
		for each  wRaw in wastes
		{
			wm = wRaw.toMap();
			rowId = ifnull(wm.get("rowId"),"").toString().trim();
			wrStr = ifnull(wm.get("received"),"0").toString().trim();
			if(wrStr == "")
			{
				wrStr = "0";
			}
			gotPcs = wrStr.toDecimal().toLong();
			wRemark = ifnull(wm.get("remark"),"").toString();

			if(rowId != "" && rowId.isNumber() == true)
			{
				for each  wi in Waste_Movement[ID == rowId.toLong() && Movement_Type == "Issued"]
				{
					issuedW = ifnull(wi.Piece_Count,0);

					alreadyW = 0;
					for each  rv in Waste_Movement[Parent_Movement == wi.ID && Movement_Type == "Received"]
					{
						alreadyW = alreadyW + ifnull(rv.Piece_Count,0);
					}

					takePcs = gotPcs;
					if(alreadyW + takePcs > issuedW)
					{
						takePcs = issuedW - alreadyW;
					}
					if(takePcs < 0)
					{
						takePcs = 0;
					}

					if(takePcs > 0)
					{
						newRvId = insert into Waste_Movement
						[
							Movement_Type="Received"
							Piece_Width=ifnull(wi.Piece_Width,0)
							Piece_Length=ifnull(wi.Piece_Length,0)
							Piece_Count=takePcs
							Cut_Size_Width=ifnull(wi.Cut_Size_Width,0)
							Cut_Size_Length=ifnull(wi.Cut_Size_Length,0)
							Moved_On=zoho.currentdate
							Added_User=zoho.loginuser
						];

						for each  rvNew in Waste_Movement[ID == newRvId.toLong()]
						{
							rvNew.Parent_Movement = wi.ID;
							rvNew.Waste_Piece = wi.Waste_Piece;
							rvNew.Plan = wi.Plan;
							rvNew.Plan_Item = wi.Plan_Item;
							rvNew.Moved_By = supId;
						}
					}

					stillOut = issuedW - (alreadyW + takePcs);
					if(stillOut < 0)
					{
						stillOut = 0;
					}

					for each  wmStock in Waste_Master[ID == wi.Waste_Piece]
					{
						witStr = ifnull(wmStock.In_Transit_Count,"0").toString().trim();
						if(witStr == "")
						{
							witStr = "0";
						}
						wdispStr = ifnull(wmStock.Disputed_Count,"0").toString().trim();
						if(wdispStr == "")
						{
							wdispStr = "0";
						}
						witCount = witStr.toDecimal().toLong();
						wdispCount = wdispStr.toDecimal().toLong();

						settlePcs = takePcs + stillOut;
						if(settlePcs > witCount)
						{
							settlePcs = witCount;
						}

						wmStock.In_Transit_Count = witCount - settlePcs;
						if(stillOut > 0)
						{
							wmStock.Disputed_Count = wdispCount + stillOut;
						}

						restStr = ifnull(wmStock.Piece_Count,"0").toString().trim();
						if(restStr == "")
						{
							restStr = "0";
						}
						if(restStr.toDecimal().toLong() <= 0 && (witCount - settlePcs) <= 0 && (wdispCount + stillOut) <= 0)
						{
							wmStock.Status = "Consumed";
						}
					}

					if(stillOut > 0)
					{
						try
						{
							wNoteTxt = "";
							if(wRemark != "")
							{
								wNoteTxt = " - " + wRemark.replaceAll("\"","'");
							}

							wDispMat = null;
							for each  wmRec2 in Waste_Master[ID == wi.Waste_Piece]
							{
								wDispMat = wmRec2.SKU;
							}
							wDispName = "Waste";
							for each  rmw2 in Raw_Material[ID == wDispMat]
							{
								wDispName = ifnull(rmw2.Material_Display_Name,"").toString().trim();
								if(wDispName == "")
								{
									wDispName = ifnull(rmw2.Name,"").toString().trim();
								}
								wDispName = wDispName.replaceAll("\"","'");
							}

							newWDispId = insert into Stock_Dispute
							[
								Material_Name=wDispName
								Unit="pcs"
								Is_Waste=true
								Direction="Outbound"
								Issued_Qty=issuedW
								Received_Qty=alreadyW + takePcs
								Disputed_Qty=stillOut
								Status="Open"
								Raised_On=zoho.currentdate
								Raised_Note=wRemark.replaceAll("\"","'")
								Added_User=zoho.loginuser
							];

							for each  wdsp in Stock_Dispute[ID == newWDispId.toLong()]
							{
								wdsp.Waste_Piece = wi.Waste_Piece;
								wdsp.Supervisor = supId;
								if(wDispMat != null)
								{
									wdsp.Material = wDispMat;
								}
								if(wi.Plan != null)
								{
									wdsp.Plan = wi.Plan;
								}
								if(wi.Plan_Item != null)
								{
									wdsp.Plan_Item = wi.Plan_Item;
								}
							}
							if(newDispIdsJson != "")
							{
								newDispIdsJson = newDispIdsJson + ",";
							}
							newDispIdsJson = newDispIdsJson + "\"" + newWDispId + "\"";
						}
						catch (e3)
						{
							info "Stock_Dispute not raised for waste piece " + wi.Waste_Piece + ": " + e3.toString();
						}

						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"Waste piece " + ifnull(wi.Piece_Width,0) + "x" + ifnull(wi.Piece_Length,0) + ": " + stillOut + " of " + issuedW + " not received" + wNoteTxt + " - dispute raised\"";
					}
				}
			}
		}

		//------------------------------------------------------------------------
		// PRINTED FABRIC PIECES: received per piece, one Issue_Line each. Sent on
		// the first sweep call only.
		//------------------------------------------------------------------------
		for each  pRaw in printed
		{
			pm = pRaw.toMap();
			pIdTxt = ifnull(pm.get("issueLineId"),"").toString().trim();
			pVTxt = ifnull(pm.get("voucherId"),"").toString().trim();
			pGotStr = ifnull(pm.get("received"),"0").toString().trim();
			if(pGotStr == "")
			{
				pGotStr = "0";
			}
			pGot = pGotStr.toDecimal();
			pNoteTxt = ifnull(pm.get("remark"),"").toString();

			if(pIdTxt == "" || pVTxt == "" || pGot < 0)
			{
				if(errJson != "")
				{
					errJson = errJson + ",";
				}
				errJson = errJson + "\"Printed piece: invalid received quantity\"";
			}
			else
			{
				foundLn = false;
				for each  miRec in Material_Issue[ID == pVTxt.toLong()]
				{
					for each  miLn in miRec.Issue_Lines
					{
						if(miLn.ID == pIdTxt.toLong())
						{
							foundLn = true;
							lnQtyS = ifnull(miLn.Qty,"0").toString().trim();
							if(lnQtyS == "")
							{
								lnQtyS = "0";
							}
							lnSetS = ifnull(miLn.Settled_Qty,"0").toString().trim();
							if(lnSetS == "")
							{
								lnSetS = "0";
							}
							lnRemain = lnQtyS.toDecimal() - lnSetS.toDecimal();

							takeP = pGot;
							if(takeP > lnRemain)
							{
								takeP = lnRemain;
							}

							miLn.Settled_Qty = lnSetS.toDecimal() + takeP;
							stillOutP = lnRemain - takeP;

							ppSpill = takeP;
							if(miLn.Requirement != null)
							{
								ppItemId = null;
								ppMatId = "";

								for each  req in Material_Requirement[ID == miLn.Requirement]
								{
									ppItemId = req.Plan_Item;
									ppMatId = ifnull(req.Material,"").toString().trim();

									reqIssS = ifnull(req.Issued_Qty,"0").toString().trim();
									if(reqIssS == "")
									{
										reqIssS = "0";
									}
									reqRcvS = ifnull(req.Received_Qty,"0").toString().trim();
									if(reqRcvS == "")
									{
										reqRcvS = "0";
									}

									ppRoom = reqIssS.toDecimal() - reqRcvS.toDecimal();
									if(ppRoom > ppSpill)
									{
										ppRoom = ppSpill;
									}
									if(ppRoom < 0)
									{
										ppRoom = 0.0;
									}
									req.Received_Qty = reqRcvS.toDecimal() + ppRoom;
									ppSpill = ppSpill - ppRoom;
								}

								if(ppSpill > 0 && ppItemId != null && ppMatId != "")
								{
									for each  reqSib in Material_Requirement[Plan_Item == ppItemId]
									{
										if(ppSpill > 0 && (reqSib.ID + "") != (miLn.Requirement + "") && ifnull(reqSib.Material,"").toString().trim() == ppMatId)
										{
											sibIssS = ifnull(reqSib.Issued_Qty,"0").toString().trim();
											if(sibIssS == "")
											{
												sibIssS = "0";
											}
											sibRcvS = ifnull(reqSib.Received_Qty,"0").toString().trim();
											if(sibRcvS == "")
											{
												sibRcvS = "0";
											}

											sibRoom = sibIssS.toDecimal() - sibRcvS.toDecimal();
											if(sibRoom > ppSpill)
											{
												sibRoom = ppSpill;
											}
											if(sibRoom > 0)
											{
												reqSib.Received_Qty = sibRcvS.toDecimal() + sibRoom;
												ppSpill = ppSpill - sibRoom;
											}
										}
									}
								}
							}

							if(miLn.Material != null)
							{
								for each  rm in Raw_Material[ID == miLn.Material]
								{
									ptiS = ifnull(rm.In_Transit_Qty,"0").toString().trim();
									if(ptiS == "")
									{
										ptiS = "0";
									}
									ptdS = ifnull(rm.Disputed_Qty,"0").toString().trim();
									if(ptdS == "")
									{
										ptdS = "0";
									}
									ptiQty = ptiS.toDecimal();
									ptDrain = lnRemain;
									if(ptDrain > ptiQty)
									{
										ptDrain = ptiQty;
									}
									if(ptDrain < 0)
									{
										ptDrain = 0.0;
									}
									rm.In_Transit_Qty = ptiQty - ptDrain;
									if(stillOutP > 0)
									{
										rm.Disputed_Qty = ptdS.toDecimal() + stillOutP;
									}
								}
							}

							if(miLn.Lot != null)
							{
								for each  lotSet in Raw_Material_Lot[ID == miLn.Lot]
								{
									ltiS = ifnull(lotSet.In_Transit_Qty,"0").toString().trim();
									if(ltiS == "")
									{
										ltiS = "0";
									}
									ltdS = ifnull(lotSet.Disputed_Qty,"0").toString().trim();
									if(ltdS == "")
									{
										ltdS = "0";
									}
									ltiQty = ltiS.toDecimal();
									ltDrain = lnRemain;
									if(ltDrain > ltiQty)
									{
										ltDrain = ltiQty;
									}
									if(ltDrain < 0)
									{
										ltDrain = 0.0;
									}
									lotSet.In_Transit_Qty = ltiQty - ltDrain;
									if(stillOutP > 0)
									{
										lotSet.Disputed_Qty = ltdS.toDecimal() + stillOutP;
									}
								}
							}
							if(okJson != "")
							{
								okJson = okJson + ",";
							}
							okJson = okJson + "{\"id\":\"" + pIdTxt + "\",\"status\":\"success\"}";

							if(stillOutP > 0)
							{
								pNoteShow = "";
								if(pNoteTxt != "")
								{
									pNoteShow = " (" + pNoteTxt + ")";
								}

								try
								{
									pDispName = "";
									pDispUnit = "";
									for each  rm in Raw_Material[ID == miLn.Material]
									{
										pDispName = ifnull(rm.Material_Name,"").toString();
										pDispUnit = ifnull(rm.Unit,"").toString();
									}

									pSoNo = "";
									pPlanId = null;
									if(miLn.Requirement != null)
									{
										for each  req in Material_Requirement[ID == miLn.Requirement]
										{
											if(req.Plan != null)
											{
												pPlanId = req.Plan;
												pSoNo = ifnull(soNoByPlan.get(req.Plan + ""),"").toString();
											}
										}
									}

									newDispId = insert into Stock_Dispute
									[
										Material_Name=pDispName
										Unit=pDispUnit
										Is_Waste=false
										Direction="Outbound"
										Issued_Qty=lnRemain
										Received_Qty=takeP
										Disputed_Qty=stillOutP
										Status="Open"
										Raised_On=zoho.currentdate
										Raised_Note="Short by " + stillOutP + " Mtr on receipt" + pNoteShow
										Added_User=zoho.loginuser
									];

									for each  dsp in Stock_Dispute[ID == newDispId.toLong()]
									{
										dsp.Material = miLn.Material;
										dsp.Supervisor = supId;
										if(miLn.Lot != null)
										{
											dsp.Lot = miLn.Lot;
										}
										if(pPlanId != null)
										{
											dsp.Plan = pPlanId;
										}
										if(miLn.Requirement != null)
										{
											for each  req in Material_Requirement[ID == miLn.Requirement]
											{
												if(req.Plan_Item != null)
												{
													dsp.Plan_Item = req.Plan_Item;
												}
											}
										}
									}

									if(newDispIdsJson != "")
									{
										newDispIdsJson = newDispIdsJson + ",";
									}
									newDispIdsJson = newDispIdsJson + "\"" + newDispId + "\"";
								}
								catch (e3)
								{
									info "Stock_Dispute not raised for printed piece " + pIdTxt + ": " + e3.toString();
								}

								if(errJson != "")
								{
									errJson = errJson + ",";
								}
								errJson = errJson + "\"Printed piece: " + stillOutP + " of " + lnRemain + " Mtr not received" + pNoteShow + " - dispute raised\"";
							}
						}
					}
				}

				if(foundLn == false)
				{
					if(errJson != "")
					{
						errJson = errJson + ",";
					}
					errJson = errJson + "\"Printed piece " + pIdTxt + " not found\"";
				}
			}
		}
	}
	else
	{
		//================================================================
		// FINALIZE - one phase per call.
		//================================================================
		ph = ifnull(fnCur.get("ph"),"vouchers").toString().trim();
		if(ph == "")
		{
			ph = "vouchers";
		}

		if(ph == "vouchers")
		{
			//----------------------------------------------------------
			// Recheck Issue_Status for the vouchers this receipt confirmed.
			// Moved here from every sweep slice - nothing reads voucher
			// status mid-receipt, and re-scanning a voucher's whole subform
			// per slice was O(lines squared).
			//----------------------------------------------------------
			vi = 0;
			viS = ifnull(fnCur.get("vi"),"0").toString().trim();
			if(viS != "" && viS.isNumber() == true)
			{
				vi = viS.toLong();
			}

			vc = 0;
			vProc = 0;
			for each  vRaw in vouchersIn
			{
				if(vc >= vi && vProc < VOUCHER_BUDGET)
				{
					vt2 = ifnull(vRaw,"").toString().trim();
					if(vt2 != "" && vt2.isNumber() == true)
					{
						try
						{
							for each  vR2 in Material_Issue[ID == vt2.toLong()]
							{
								if(ifnull(vR2.Issue_Status,"").toString().trim() != "Received")
								{
									allS = true;
									anyL = false;
									for each  vL2 in vR2.Issue_Lines
									{
										anyL = true;
										q2 = ifnull(vL2.Qty,"0").toString().trim();
										if(q2 == "")
										{
											q2 = "0";
										}
										s2 = ifnull(vL2.Settled_Qty,"0").toString().trim();
										if(s2 == "")
										{
											s2 = "0";
										}
										if(s2.toDecimal() < q2.toDecimal())
										{
											allS = false;
										}
									}
									if(anyL == true && allS == true)
									{
										vR2.Issue_Status = "Received";
									}
									else
									{
										vR2.Issue_Status = "Partially_Received";
									}
								}
							}
						}
						catch (evs)
						{
							info "Issue_Status not set for voucher " + vt2 + ": " + evs.toString();
						}
					}
					vProc = vProc + 1;
				}
				vc = vc + 1;
			}

			newVi = vi + vProc;
			finalizeDone = false;
			if(newVi >= vouchersIn.size())
			{
				finalizeCursorJson = "{\"ph\":\"items\",\"pi\":0,\"ii\":0}";
			}
			else
			{
				finalizeCursorJson = "{\"ph\":\"vouchers\",\"vi\":" + newVi + "}";
			}
		}
		else if(ph == "items")
		{
			//----------------------------------------------------------
			// READINESS SWEEP over plansTouched, BUDGETED BY Plan_Item
			// COUNT. pi = plan index, ii = item offset within that plan.
			//----------------------------------------------------------
			pi = 0;
			piS = ifnull(fnCur.get("pi"),"0").toString().trim();
			if(piS != "" && piS.isNumber() == true)
			{
				pi = piS.toLong();
			}
			ii = 0;
			iiS = ifnull(fnCur.get("ii"),"0").toString().trim();
			if(iiS != "" && iiS.isNumber() == true)
			{
				ii = iiS.toLong();
			}

			itemsThisCall = 0;
			pc = 0;
			nextPi = pi;
			nextIi = ii;
			stopped = false;

			for each  ptRaw in plansTouchedIn
			{
				if(stopped == false && pc >= pi && itemsThisCall < ITEM_BUDGET)
				{
					pTxt2 = ifnull(ptRaw,"").toString().trim();
					if(pTxt2 != "" && pTxt2.isNumber() == true)
					{
						plId = pTxt2.toLong();
						plSt = "";
						for each  plH in Production_Planning[ID == plId]
						{
							plSt = ifnull(plH.Order_Status,"").toString();
						}

						skipN = 0;
						if(pc == pi)
						{
							skipN = ii;
						}
						iC = 0;
						sweptHere = 0;

						for each  pItem in Plan_Item[Plan == plId]
						{
							if(iC >= skipN && itemsThisCall < ITEM_BUDGET)
							{
								iStat = ifnull(pItem.Item_Status,"").toString();
								if(iStat == "Awaiting_Material")
								{
									itemReady = true;
									reqCount = 0;
									for each  row in Material_Requirement[Plan_Item == pItem.ID]
									{
										reqCount = reqCount + 1;
										isFab = row.Is_Fabric;

										issStr = ifnull(row.Issued_Qty,"0").toString().trim();
										if(issStr == "")
										{
											issStr = "0";
										}
										recStr = ifnull(row.Received_Qty,"0").toString().trim();
										if(recStr == "")
										{
											recStr = "0";
										}
										reqStr = ifnull(row.Required_Qty,"0").toString().trim();
										if(reqStr == "")
										{
											reqStr = "0";
										}
										issQty = issStr.toDecimal();
										recQty = recStr.toDecimal();
										reqQty = reqStr.toDecimal();

										if(recQty < issQty)
										{
											itemReady = false;
										}

										if(isFab == true)
										{
											reqPcs = ifnull(row.Required_Pieces,0);
											issPcs = ifnull(row.Pieces_From_Waste,0) + ifnull(row.Pieces_From_Raw,0);
											if(reqPcs <= 0 || issPcs < reqPcs)
											{
												itemReady = false;
											}
										}
										else
										{
											if(reqQty <= 0 || issQty < reqQty)
											{
												itemReady = false;
											}
										}
									}

									if(reqCount == 0)
									{
										itemReady = false;
									}

									for each  wiR in Waste_Movement[Plan_Item == pItem.ID && Movement_Type == "Issued"]
									{
										wC = ifnull(wiR.Piece_Count,0);
										wR = 0;
										for each  rvR in Waste_Movement[Parent_Movement == wiR.ID && Movement_Type == "Received"]
										{
											wR = wR + ifnull(rvR.Piece_Count,0);
										}
										if(wR < wC)
										{
											itemReady = false;
										}
									}

									if(itemReady == true)
									{
										pItem.Item_Status = "Ready_For_Production";
									}
								}
								itemsThisCall = itemsThisCall + 1;
								sweptHere = sweptHere + 1;
							}
							iC = iC + 1;
						}

						doneIi = skipN + sweptHere;
						if(doneIi >= iC)
						{
							// Plan's items fully swept - roll Order_Status off a
							// count, not a re-walk. Forward-only.
							awC = Plan_Item[Plan == plId && Item_Status == "Awaiting_Material"].count();
							if(iC > 0 && plSt != "In Progress" && plSt != "Production Complete")
							{
								if(awC == 0)
								{
									for each  pu in Production_Planning[ID == plId]
									{
										pu.Order_Status = "Material Ready";
									}
								}
								else if(plSt == "Pending" && awC < iC)
								{
									for each  pu in Production_Planning[ID == plId]
									{
										pu.Order_Status = "Partially Received";
									}
								}
							}
							nextPi = pc + 1;
							nextIi = 0;
						}
						else
						{
							nextPi = pc;
							nextIi = doneIi;
							stopped = true;
						}
					}
					else
					{
						nextPi = pc + 1;
						nextIi = 0;
					}
				}
				pc = pc + 1;
			}

			finalizeDone = false;
			if(nextPi >= plansTouchedIn.size())
			{
				finalizeCursorJson = "{\"ph\":\"transfer\"}";
			}
			else
			{
				finalizeCursorJson = "{\"ph\":\"items\",\"pi\":" + nextPi + ",\"ii\":" + nextIi + "}";
			}
		}
		else if(ph == "transfer")
		{
			//----------------------------------------------------------
			// MOVE THE CLOTH TO THE PRODUCTION WAREHOUSE. Its own try/catch;
			// stock has already moved, so a transfer failure must not make a
			// completed receipt look failed.
			//----------------------------------------------------------
			try
			{
				info "transfer after receipt -> " + thisapp.postTransferOrders("auto");
			}
			catch (eto)
			{
				info "postTransferOrders after receipt threw: " + eto.toString();
			}
			finalizeCursorJson = "{\"ph\":\"notify\"}";
			finalizeDone = false;
		}
		else if(ph == "notify")
		{
			//----------------------------------------------------------
			// Build the dispute digest from the ids this receipt raised, so
			// the mail block below sends ONE pair of mails for the whole
			// receipt rather than one per sweep slice.
			//----------------------------------------------------------
			for each  didRaw in disputeIdsIn
			{
				didTxt = ifnull(didRaw,"").toString().trim();
				if(didTxt != "" && didTxt.isNumber() == true)
				{
					for each  ndsp in Stock_Dispute[ID == didTxt.toLong()]
					{
						ndName = ifnull(ndsp.Material_Name,"").toString().replaceAll("\"","'");
						if(ifnull(ndsp.Is_Waste,false) == true)
						{
							ndName = ndName + " (offcuts)";
						}
						ndUnit = ifnull(ndsp.Unit,"").toString();
						ndIss = ifnull(ndsp.Issued_Qty,0);
						ndRcv = ifnull(ndsp.Received_Qty,0);
						ndShort = ifnull(ndsp.Disputed_Qty,0);
						ndSo = "";
						if(ndsp.Plan != null)
						{
							for each  npp in Production_Planning[ID == ndsp.Plan]
							{
								npSo = ifnull(npp.Sales_Order,"").toString().trim();
								if(npSo != "")
								{
									for each  nso in Sales_Order[ID == npSo.toLong()]
									{
										ndSo = ifnull(nso.Sales_Order,"").toString().replaceAll("\"","'");
									}
								}
							}
						}
						dispRows.add(ndName + "|" + ndSo + "|" + ndUnit + "|" + ndIss + "|" + ndRcv + "|" + ndShort);
					}
				}
			}
			finalizeCursorJson = "{\"ph\":\"done\"}";
			finalizeDone = true;
		}
		else
		{
			finalizeCursorJson = "{\"ph\":\"done\"}";
			finalizeDone = true;
		}
	}

	}
	catch (e)
	{
		// Surfaces as an alert in the widget via the existing errors[] handling.
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"received\":[],\"disputeIds\":[],\"sweepCursor\":null,\"sweepDone\":true,\"finalizeCursor\":{\"ph\":\"done\"},\"finalizeDone\":true}";
	}

	//------------------------------------------------------------------------
	// DISPUTE NOTIFICATIONS. Outbound: the SUPERVISOR raised these, so the party
	// that has to answer is the STORE. Admin gets its own copy. Two mails, not
	// one with two recipients - they are not the same message.
	//
	// dispRows is filled ONLY by the finalize "notify" phase, so this fires once
	// per receipt. Outside the main try/catch and wrapped in its own - a mail
	// failure must not turn a completed receipt into an error he retries.
	//------------------------------------------------------------------------
	adminTo = "gurdhian.helios@gmail.com";
	storeTo = "gurdhian.helios@gmail.com";

	try
	{
		if(dispRows.size() > 0)
		{
			dSupName = "";
			for each  dEmp in Employee[ID == supId]
			{
				dSupName = ifnull(dEmp.Employee_Name,"").toString().replaceAll("\"","'");
			}
			if(dSupName == "")
			{
				dSupName = "Supervisor";
			}

			dTh = "padding:8px 12px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#64748b;text-align:left;font-weight:600";
			dThR = "padding:8px 12px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#64748b;text-align:right;font-weight:600";
			dTd = "padding:10px 12px;border-bottom:1px solid #eef2f6;font-size:13px;color:#0f172a";
			dTdR = "padding:10px 12px;border-bottom:1px solid #eef2f6;font-size:13px;color:#0f172a;text-align:right;font-weight:600";
			dTdBad = "padding:10px 12px;border-bottom:1px solid #fee2e2;font-size:13px;color:#991b1b;text-align:right;font-weight:700";

			dRowsHtml = "";
			for each  dr in dispRows
			{
				dp = dr.toList("|");
				dRowsHtml = dRowsHtml + "<tr><td style='" + dTd + "'>" + dp.get(0) + "</td><td style='" + dTd + ";white-space:nowrap'>" + dp.get(1) + "</td><td style='" + dTdR + "'>" + dp.get(3) + " <span style='color:#64748b;font-weight:400'>" + dp.get(2) + "</span></td><td style='" + dTdR + "'>" + dp.get(4) + "</td><td style='" + dTdBad + "'>" + dp.get(5) + "</td></tr>";
			}

			dTable = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='border-collapse:collapse;margin-top:14px;border:1px solid #e2e8f0;border-radius:6px'>";
			dTable = dTable + "<tr><th style='" + dTh + "'>Material</th><th style='" + dTh + "'>Order</th><th style='" + dThR + "'>Issued</th><th style='" + dThR + "'>Received</th><th style='" + dThR + "'>Short by</th></tr>";
			dTable = dTable + dRowsHtml + "</table>";

			dWord = "disputes";
			if(dispRows.size() == 1)
			{
				dWord = "dispute";
			}
			dSubtitle = "Raised by " + dSupName + " &middot; " + zoho.currentdate.toString("dd MMM yyyy") + " " + zoho.currenttime.toString("HH:mm");

			sInner = "<div style='font-size:14px;color:#0f172a'><b>" + dSupName + "</b> has confirmed his receipt and reported <b>" + dispRows.size() + " " + dWord + "</b>. The quantity below left the store but he says it did not reach him.</div>";
			sInner = sInner + dTable;
			sInner = sInner + "<div style='font-size:12px;color:#64748b;padding-top:14px'>Check the shelf and answer on the <b>Disputes</b> tab. If the stock is still with the store, <b>Store correction</b> returns it and re-opens the requirement so it can be issued again. Until someone answers, this quantity is neither on the shelf nor with him.</div>";
			sInner = sInner + "<div style='font-size:12px;color:#94a3b8;padding-top:10px'>Written for the store. No store mailbox is configured yet, so it is being sent here.</div>";

			sendmail
			[
				from :zoho.adminuserid
				to :storeTo
				subject :"Action needed: " + dispRows.size() + " " + dWord + " raised by " + dSupName
				message :thisapp.buildNotificationEmail("Material disputed on receipt",dSubtitle,"#dc2626",sInner)
			]

			aInner = "<div style='font-size:14px;color:#0f172a'><b>" + dispRows.size() + " " + dWord + "</b> raised by <b>" + dSupName + "</b> on receipt. Nobody has answered yet.</div>";
			aInner = aInner + dTable;
			aInner = aInner + "<div style='font-size:12px;color:#64748b;padding-top:14px'>Direction is <b>Outbound</b> - store to supervisor - so the store answers first. This is for visibility; no action is needed from you unless it stays open.</div>";

			sendmail
			[
				from :zoho.adminuserid
				to :adminTo
				subject :"Dispute raised: " + dispRows.size() + " " + dWord + " - " + dSupName + " (outbound)"
				message :thisapp.buildNotificationEmail("Dispute raised",dSubtitle,"#dc2626",aInner)
			]

			info "Dispute notifications sent: " + dispRows.size() + " row(s)";
		}
	}
	catch (eMail)
	{
		info "Dispute notification not sent: " + eMail.toString();
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	//
	// sweepCursor / sweepDone drive the sweep loop; finalizeCursor / finalizeDone
	// drive the finalize loop. disputeIds is THIS slice's new disputes, unioned
	// by the widget and handed to the "notify" phase.
	return "{\"errors\":[" + errJson + "],\"received\":[" + okJson + "],\"disputeIds\":[" + newDispIdsJson + "],\"sweepCursor\":" + sweepCursorJson + ",\"sweepDone\":" + sweepDone + ",\"finalizeCursor\":" + finalizeCursorJson + ",\"finalizeDone\":" + finalizeDone + "}";
}
