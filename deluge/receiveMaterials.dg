string receiveMaterials(string supervisorId, string receiptsJson)
{
	// Supervisor confirms what he physically received.
	//
	// APPLIER, NOT RECONSTRUCTOR. This function used to rebuild the whole receipt
	// server-side: walk every Material_Issue of the supervisor, every Issue_Lines
	// row on each (THREE separate passes), fan the confirmed quantity across
	// Material_Requirement[Plan==] for every open plan, then sweep every plan item
	// and its requirements to roll statuses. On a supervisor holding a large old
	// chunked handover - 1800+ lines on one voucher - each of those passes was
	// 1800+ statement visits, and the statement-execution limit is NOT catchable:
	// it kills the script and the widget gets a bare HTTP 500 with no error card.
	//
	// The widget already rendered exactly what he is confirming, line by line,
	// from the PAGED getSupervisorMaterials - which resolves, per still-owed
	// Issue_Line: the line id, its voucher, the lot, the requirement, the plan,
	// and how much it still owes (already net of open disputes). So the widget now
	// sends explicit per-line SETTLEMENTS and this function applies them with
	// point lookups by record id. Cost is O(lines in THIS receipt), independent of
	// how many vouchers or plans the supervisor has. Same shape issueMaterials and
	// the accessory allocations array already use.
	//
	// receiptsJson:
	// {
	//   "materials":[
	//     { "materialId":"123", "received":9.5, "remark":"half metre short",
	//       "settlements":[
	//         { "issueLineId":"555", "voucherId":"77", "lot":"901",
	//           "requirementId":"888", "planId":"50",
	//           "settle":5.5,      // metres to take off In_Transit for this line
	//           "confirmed":5.5 }  // of that, how much arrived (rest = shortfall)
	//       ] } ],
	//   "waste":[ {"rowId":"456","received":1,"remark":""} ],
	//   "printedPieces":[ {"issueLineId":"555","voucherId":"77","received":3,"remark":""} ],
	//   "plansTouched":["50","51"], // distinct plan ids to run the readiness sweep on
	//   "finalize":true             // see below
	// }
	//
	// CHUNKED, LIKE issueMaterials. A big receipt has hundreds of settlements -
	// too large for one invokeCustomApi payload, and too long for one execution.
	// The widget splits the settlements / waste / printed rows into chunks and
	// calls this once per chunk, sequentially, with rate-limit backoff.
	//
	// Every settlement this function applies is ADDITIVE per line
	// (Settled_Qty += settle, Received_Qty += confirmed, In_Transit -= settle), so
	// splitting them across N calls needs no threading and no shared record - each
	// chunk just writes its own rows. Disputes are raised per chunk as the
	// shortfalls land; each is independent.
	//
	// "finalize" is the ONLY thing that cannot run per chunk: the readiness sweep
	// (Item_Status / Order_Status), the Issue_Status flip, and postTransferOrders.
	// Run per chunk they would sweep on half-applied data and fire N transfer
	// orders. The widget sends finalize:false on every chunk but the last, and
	// finalize:true (with the FULL plansTouched list) on the last one - which does
	// only the sweep + transfer, its settlements arrays already empty or small.
	// A single unchunked receipt sends finalize:true and behaves exactly as
	// before.
	//
	// TRUST THE WIDGET. The only guards kept are the two that stop a genuinely
	// broken write: an unknown record id (point lookup finds nothing -> readable
	// error, skip), and a stock field that would go negative (clamped to 0,
	// reported, the settlement still recorded on the line).
	//
	// A short receipt is RECORDED, never auto-corrected. Stock was already
	// decremented at issue time; quietly adjusting it here would mean the ledger
	// changed under the store person without anyone deciding to. The confirmed
	// part of each settlement comes off In_Transit_Qty into production; the
	// shortfall moves to Disputed_Qty and raises one Stock_Dispute per plan.
	//
	// WRITE-CONTRACT KEPT for getStoreIssueHistory / postTransferOrders /
	// getOrderConsumption / resolveDispute:
	//  - Issue_Lines.Settled_Qty advanced by "settle" (drives postTransferOrders'
	//    Settled_Qty - Transferred_Qty).
	//  - Material_Requirement.Received_Qty advanced by "confirmed" (drives the
	//    readiness test row by row).
	//  - Raw_Material / Raw_Material_Lot: In_Transit_Qty down by the settled part,
	//    Disputed_Qty up by the shortfall.
	//  - Stock_Dispute: one per plan carrying a gap, Direction="Outbound",
	//    Material / Supervisor / Plan / Plan_Item / Lot stamped.
	//  - Material_Issue.Issue_Status -> Received / Partially_Received per plan.

	errJson = "";
	okJson = "";

	// Disputes raised by THIS receipt, gathered for one pair of notification
	// mails at the end. Not one mail per dispute: a receipt three materials short
	// raises three disputes, and six mails describing one trip to the counter is
	// how people learn to ignore them.
	dispRows = List();

	// DEBUG WRAPPER: Creator reports every runtime failure as a generic
	// "code 9430 - There is an error while executing Custom API." Catching it
	// here surfaces the real Deluge message in the widget console instead.
	try
	{
	supId = supervisorId.trim().toLong();
	inp = receiptsJson.toMap();
	mats = ifnull(inp.get("materials"),"[]").toString().toJSONList();
	wastes = ifnull(inp.get("waste"),"[]").toString().toJSONList();
	printed = ifnull(inp.get("printedPieces"),"[]").toString().toJSONList();
	plansTouchedIn = ifnull(inp.get("plansTouched"),"[]").toString().toJSONList();
	// Absent -> true, so an unchunked receipt (no flag) finalizes as it always
	// did. Only an explicit "false" from a non-last chunk suppresses the sweep.
	doFinalize = (ifnull(inp.get("finalize"),"true").toString().trim() != "false");
	// FINALIZE IS ITSELF RESUMABLE. A common trim received against ~100 open
	// plans has ~100 plan ids in plansTouched, and the readiness sweep walks
	// Plan_Item -> Material_Requirement -> Waste_Movement per plan - thousands of
	// statement visits in one call, past the uncatchable limit. So a finalize
	// call sweeps at most SWEEP_BUDGET plans, returns which are still to do, and
	// the widget calls finalize again with just those until none are left. The
	// warehouse transfer runs only on the finalize call that clears the list.
	SWEEP_BUDGET = 15;
	info "supId=" + supId + " matLines=" + mats.size() + " wasteLines=" + wastes.size() + " printedLines=" + printed.size() + " finalize=" + doFinalize + " plansTouched=" + plansTouchedIn.size();

	//------------------------------------------------------------------------
	// THE PLANS THIS RECEIPT TOUCHES, resolved to order numbers ONCE.
	//
	// The widget names them (plansTouched) from the line detail it rendered, so
	// there is no plan walk. A dispute names an order; the readiness sweep at
	// the bottom only runs on these. Empty list -> nothing to sweep, which is
	// correct for a receipt of only loose (no-requirement) lines.
	//------------------------------------------------------------------------
	touchedPlanIds = List();
	soNoByPlan = Map();
	for each  ptRaw in plansTouchedIn
	{
		ptTxt = ifnull(ptRaw,"").toString().trim();
		if(ptTxt != "" && touchedPlanIds.contains(ptTxt) == false)
		{
			touchedPlanIds.add(ptTxt);
			soTxtP = "";
			for each  ppRec in Production_Planning[ID == ptTxt.toLong()]
			{
				ppSoTxt = ifnull(ppRec.Sales_Order,"").toString().trim();
				if(ppSoTxt != "")
				{
					for each  soRec in Sales_Order[ID == ppSoTxt.toLong()]
					{
						soTxtP = ifnull(soRec.Sales_Order,"").toString().replaceAll("\"","'");
					}
				}
			}
			soNoByPlan.put(ptTxt,soTxtP);
		}
	}

	// Vouchers this receipt settled a line on - materials AND printed pieces.
	// After the settlement passes, each of these is re-checked: a voucher whose
	// every Issue_Line now has Settled_Qty >= Qty is flipped to "Received", and
	// one with some still owed to "Partially_Received". This does NOT depend on
	// Material_Issue.Plan, on plansTouched, or on the finalize call - the old
	// flip lived only inside the readiness sweep and missed a voucher whose
	// plan was not in plansTouched or whose Plan field was empty / pointed at a
	// different plan of a multi-plan handover.
	touchedVoucherIds = List();

	//------------------------------------------------------------------------
	// MATERIALS - apply each line settlement the widget computed.
	//
	// The widget has already distributed his confirmed quantity across the
	// still-owed lines oldest-first and worked out, per line, how much to settle
	// and how much of that actually arrived. This loop only writes it.
	//------------------------------------------------------------------------
	for each  mRaw in mats
	{
		// toJSONList() yields JSON objects, NOT Deluge Maps - .get() silently
		// returns null on those. .toMap() converts to a real Map first.
		mm = mRaw.toMap();
		matId = ifnull(mm.get("materialId"),"").toString().trim();

		// Creator fields that were never written are EMPTY, not null, and
		// toDecimal() throws on empty - normalise to string first.
		rStr = ifnull(mm.get("received"),"0").toString().trim();
		if(rStr == "")
		{
			rStr = "0";
		}
		gotQty = rStr.toDecimal();
		remark = ifnull(mm.get("remark"),"").toString();
		setts = ifnull(mm.get("settlements"),"[]").toString().toJSONList();

		if(matId == "" || gotQty < 0)
		{
			if(errJson != "")
			{
				errJson = errJson + ",";
			}
			errJson = errJson + "\"Material " + matId + ": invalid received quantity\"";
		}
		else
		{
			matName = "";
			matUnit = "";
			settledTot = 0.0;
			confirmedTot = 0.0;
			shortTot = 0.0;

			// Shortfall gathered PER PLAN - that is where downstream reads look
			// for it. getSupervisorMaterials discounts open disputes per
			// plan+material; resolveDispute re-opens Material_Requirement[Plan ==
			// dsp.Plan]. Four parallel maps, not a Map of Maps - the latter does
			// not survive being read back reliably in Deluge.
			shortKeys = List();
			shortQty = Map();
			shortPend = Map();
			shortGot = Map();
			shortItem = Map();

			// Which lot carries the largest shortfall share - the one the
			// dispute record names (resolveDispute restores to it; the lots
			// themselves each carry their own share already).
			dispLotId = "";
			dispLotShare = 0.0;

			for each  stRaw in setts
			{
				st = stRaw.toMap();
				liTxt = ifnull(st.get("issueLineId"),"").toString().trim();
				vTxt = ifnull(st.get("voucherId"),"").toString().trim();
				reqTxt = ifnull(st.get("requirementId"),"").toString().trim();
				planTxt = ifnull(st.get("planId"),"").toString().trim();
				lotTxt = ifnull(st.get("lot"),"").toString().trim();

				seStr = ifnull(st.get("settle"),"0").toString().trim();
				if(seStr == "")
				{
					seStr = "0";
				}
				coStr = ifnull(st.get("confirmed"),"0").toString().trim();
				if(coStr == "")
				{
					coStr = "0";
				}
				settleQ = seStr.toDecimal();
				confirmQ = coStr.toDecimal();
				if(confirmQ > settleQ)
				{
					confirmQ = settleQ;
				}
				shortQ = settleQ - confirmQ;

				if(settleQ <= 0)
				{
					continue;
				}

				// --- 1. Settle the Issue_Line, via its voucher (point lookup) ---
				lineFound = false;
				if(vTxt != "" && liTxt != "")
				{
					if(touchedVoucherIds.contains(vTxt) == false)
					{
						touchedVoucherIds.add(vTxt);
					}
					for each  miRec in Material_Issue[ID == vTxt.toLong()]
					{
						for each  miLn in miRec.Issue_Lines
						{
							if(miLn.ID == liTxt.toLong())
							{
								lineFound = true;
								lnSetS = ifnull(miLn.Settled_Qty,"0").toString().trim();
								if(lnSetS == "")
								{
									lnSetS = "0";
								}
								lnQtyS = ifnull(miLn.Qty,"0").toString().trim();
								if(lnQtyS == "")
								{
									lnQtyS = "0";
								}
								room = lnQtyS.toDecimal() - lnSetS.toDecimal();
								applyS = settleQ;
								if(applyS > room)
								{
									// Line already settled past this point by an
									// earlier receipt - never drive Settled_Qty
									// past Qty.
									applyS = room;
									if(applyS < 0)
									{
										applyS = 0.0;
									}
								}
								miLn.Settled_Qty = lnSetS.toDecimal() + applyS;
								if(ifnull(miLn.Material_Name,"").toString().trim() != "")
								{
									matName = ifnull(miLn.Material_Name,"").toString();
								}
								if(ifnull(miLn.Unit,"").toString().trim() != "")
								{
									matUnit = ifnull(miLn.Unit,"").toString();
								}
							}
						}
					}
				}
				if(lineFound == false)
				{
					if(errJson != "")
					{
						errJson = errJson + ",";
					}
					errJson = errJson + "\"Material " + matId + ": issue line " + liTxt + " not found\"";
					continue;
				}

				settledTot = settledTot + settleQ;
				confirmedTot = confirmedTot + confirmQ;
				shortTot = shortTot + shortQ;

				// --- 2. Credit the requirement's Received_Qty (point lookup) ---
				if(reqTxt != "")
				{
					for each  reqRec in Material_Requirement[ID == reqTxt.toLong()]
					{
						rqRcvS = ifnull(reqRec.Received_Qty,"0").toString().trim();
						if(rqRcvS == "")
						{
							rqRcvS = "0";
						}
						reqRec.Received_Qty = rqRcvS.toDecimal() + confirmQ;
						if(matName == "")
						{
							matName = ifnull(reqRec.Material_Name,"").toString();
						}
						if(matUnit == "")
						{
							matUnit = ifnull(reqRec.Unit,"").toString();
						}
					}
				}

				// --- 3. Move the lot's In_Transit -> (production / disputed) ---
				if(lotTxt != "")
				{
					for each  lotSet in Raw_Material_Lot[ID == lotTxt.toLong()]
					{
						ltiS = ifnull(lotSet.In_Transit_Qty,"0").toString().trim();
						if(ltiS == "")
						{
							ltiS = "0";
						}
						ltdS = ifnull(lotSet.Disputed_Qty,"0").toString().trim();
						if(ltdS == "")
						{
							ltdS = "0";
						}
						ltIn = ltiS.toDecimal();
						offIt = settleQ;
						if(offIt > ltIn)
						{
							// Never drive a lot's in-transit negative - a re-run
							// or a race would otherwise take it past zero.
							offIt = ltIn;
						}
						lotSet.In_Transit_Qty = ltIn - offIt;
						if(shortQ > 0)
						{
							lotSet.Disputed_Qty = ltdS.toDecimal() + shortQ;
						}
					}
					if(shortQ > dispLotShare)
					{
						dispLotShare = shortQ;
						dispLotId = lotTxt;
					}
				}

				// --- 4. Gather the shortfall against its plan ---
				if(shortQ > 0 && planTxt != "")
				{
					if(shortQty.get(planTxt) == null)
					{
						shortKeys.add(planTxt);
						shortQty.put(planTxt,0.0);
						shortPend.put(planTxt,0.0);
						shortGot.put(planTxt,0.0);
						shortItem.put(planTxt,"");
					}
					shortQty.put(planTxt,shortQty.get(planTxt) + shortQ);
					shortPend.put(planTxt,shortPend.get(planTxt) + settleQ);
					shortGot.put(planTxt,shortGot.get(planTxt) + confirmQ);
					if(ifnull(shortItem.get(planTxt),"").toString() == "" && reqTxt != "")
					{
						for each  reqPi in Material_Requirement[ID == reqTxt.toLong()]
						{
							shortItem.put(planTxt,ifnull(reqPi.Plan_Item,"").toString());
						}
					}
				}
				else if(shortQ > 0)
				{
					// A settlement with a shortfall but no plan - a loose line.
					// Still has to come off In_Transit on the parent below; it
					// just cannot raise a per-plan dispute.
					shortPend.put("_loose",ifnull(shortPend.get("_loose"),0.0) + settleQ);
				}
			}

			// --- 5. Move the parent Raw_Material stock, once per material ---
			if(settledTot > 0)
			{
				for each  rmStock in Raw_Material[ID == matId.toLong()]
				{
					itStr = ifnull(rmStock.In_Transit_Qty,"0").toString().trim();
					if(itStr == "")
					{
						itStr = "0";
					}
					dispStr = ifnull(rmStock.Disputed_Qty,"0").toString().trim();
					if(dispStr == "")
					{
						dispStr = "0";
					}
					itQty = itStr.toDecimal();
					dispQty = dispStr.toDecimal();

					offParent = settledTot;
					if(offParent > itQty)
					{
						// Cannot settle more than is actually in transit -
						// otherwise a re-run drives it negative, and a negative
						// In_Transit reads as stock the company does not have on
						// every screen that sums it.
						offParent = itQty;
					}
					rmStock.In_Transit_Qty = itQty - offParent;
					if(shortTot > 0)
					{
						rmStock.Disputed_Qty = dispQty + shortTot;
					}
				}

				// INVENTORY ADJUSTMENT DISABLED FOR NOW. This used to enqueue a
				// Consumption row (settleQty - shortBy) into Inventory_Post_Queue
				// via thisapp.queueInventoryPost("Consumption", ...). We are not
				// creating Zoho Inventory adjustments at the moment, so receiving
				// material updates Creator only and leaves the external adjustment
				// queue untouched. The warehouse transfer at the end of this
				// function is a separate thing and stays.
			}

			if(matName == "")
			{
				matName = "Material " + matId;
			}

			// --- 6. Raise one Stock_Dispute per plan that carries a gap ---
			if(shortTot > 0 && shortKeys.size() > 0)
			{
				noteTxt = "";
				if(remark != "")
				{
					noteTxt = " - " + remark.replaceAll("\"","'");
				}

				for each  pKey2 in shortKeys
				{
					planShort = shortQty.get(pKey2);
					if(planShort > 0)
					{
						planSoNo = ifnull(soNoByPlan.get(pKey2),"").toString();

						try
						{
							newDispId = insert into Stock_Dispute
							[
								Material_Name=matName
								Unit=matUnit
								Is_Waste=false
								Direction="Outbound"
								Issued_Qty=shortPend.get(pKey2)
								Received_Qty=shortGot.get(pKey2)
								Disputed_Qty=planShort
								Status="Open"
								Raised_On=zoho.currentdate
								Raised_Note=remark.replaceAll("\"","'")
								Added_User=zoho.loginuser
							];

							for each  dsp in Stock_Dispute[ID == newDispId.toLong()]
							{
								dsp.Material = matId.toLong();
								dsp.Supervisor = supId;
								if(dispLotId != "")
								{
									dsp.Lot = dispLotId.toLong();
								}
								dsp.Plan = pKey2.toLong();
								itemTxt = ifnull(shortItem.get(pKey2),"").toString();
								if(itemTxt != "")
								{
									dsp.Plan_Item = itemTxt.toLong();
								}
							}
							dispRows.add(matName + "|" + planSoNo + "|" + matUnit + "|" + shortPend.get(pKey2) + "|" + shortGot.get(pKey2) + "|" + planShort);
						}
						catch (e2)
						{
							info "Stock_Dispute not raised for " + matName + " on plan " + pKey2 + ": " + e2.toString();
						}

						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + matName + " (" + planSoNo + "): " + planShort + " short of the " + shortPend.get(pKey2) + " issued" + noteTxt + " - dispute raised\"";
					}
				}
			}

			if(okJson != "")
			{
				okJson = okJson + ",";
			}
			okJson = okJson + "{\"materialId\":\"" + matId + "\",\"received\":" + confirmedTot + ",\"short\":" + shortTot + "}";
		}
	}

	//------------------------------------------------------------------------
	// Waste pieces - rowId is a Waste_Movement id, a top-level record, so this
	// is already a true point lookup. Unchanged in shape.
	//------------------------------------------------------------------------
	for each  wRaw in wastes
	{
		wm = wRaw.toMap();
		rowId = ifnull(wm.get("rowId"),"").toString().trim();
		wrStr = ifnull(wm.get("received"),"0").toString().trim();
		if(wrStr == "")
		{
			wrStr = "0";
		}
		gotPcs = wrStr.toDecimal().toLong();
		wRemark = ifnull(wm.get("remark"),"").toString();

		if(rowId != "" && rowId.isNumber() == true)
		{
			for each  wi in Waste_Movement[ID == rowId.toLong() && Movement_Type == "Issued"]
			{
				issuedW = ifnull(wi.Piece_Count,0);

				alreadyW = 0;
				for each  rv in Waste_Movement[Parent_Movement == wi.ID && Movement_Type == "Received"]
				{
					alreadyW = alreadyW + ifnull(rv.Piece_Count,0);
				}

				takePcs = gotPcs;
				if(alreadyW + takePcs > issuedW)
				{
					takePcs = issuedW - alreadyW;
				}
				if(takePcs < 0)
				{
					takePcs = 0;
				}

				if(takePcs > 0)
				{
					newRvId = insert into Waste_Movement
					[
						Movement_Type="Received"
						Piece_Width=ifnull(wi.Piece_Width,0)
						Piece_Length=ifnull(wi.Piece_Length,0)
						Piece_Count=takePcs
						Cut_Size_Width=ifnull(wi.Cut_Size_Width,0)
						Cut_Size_Length=ifnull(wi.Cut_Size_Length,0)
						Moved_On=zoho.currentdate
						Added_User=zoho.loginuser
					];

					for each  rvNew in Waste_Movement[ID == newRvId.toLong()]
					{
						rvNew.Parent_Movement = wi.ID;
						rvNew.Waste_Piece = wi.Waste_Piece;
						rvNew.Plan = wi.Plan;
						rvNew.Plan_Item = wi.Plan_Item;
						rvNew.Moved_By = supId;
					}
				}

				stillOut = issuedW - (alreadyW + takePcs);
				if(stillOut < 0)
				{
					stillOut = 0;
				}

				for each  wmStock in Waste_Master[ID == wi.Waste_Piece]
				{
					witStr = ifnull(wmStock.In_Transit_Count,"0").toString().trim();
					if(witStr == "")
					{
						witStr = "0";
					}
					wdispStr = ifnull(wmStock.Disputed_Count,"0").toString().trim();
					if(wdispStr == "")
					{
						wdispStr = "0";
					}
					witCount = witStr.toDecimal().toLong();
					wdispCount = wdispStr.toDecimal().toLong();

					settlePcs = takePcs + stillOut;
					if(settlePcs > witCount)
					{
						settlePcs = witCount;
					}

					wmStock.In_Transit_Count = witCount - settlePcs;
					if(stillOut > 0)
					{
						wmStock.Disputed_Count = wdispCount + stillOut;
					}

					restStr = ifnull(wmStock.Piece_Count,"0").toString().trim();
					if(restStr == "")
					{
						restStr = "0";
					}
					if(restStr.toDecimal().toLong() <= 0 && (witCount - settlePcs) <= 0 && (wdispCount + stillOut) <= 0)
					{
						wmStock.Status = "Consumed";
					}
				}

				if(stillOut > 0)
				{
					try
					{
						wNoteTxt = "";
						if(wRemark != "")
						{
							wNoteTxt = " - " + wRemark.replaceAll("\"","'");
						}

						wDispMat = null;
						for each  wmRec2 in Waste_Master[ID == wi.Waste_Piece]
						{
							wDispMat = wmRec2.SKU;
						}
						wDispName = "Waste";
						for each  rmw2 in Raw_Material[ID == wDispMat]
						{
							wDispName = ifnull(rmw2.Material_Display_Name,"").toString().trim();
							if(wDispName == "")
							{
								wDispName = ifnull(rmw2.Name,"").toString().trim();
							}
							wDispName = wDispName.replaceAll("\"","'");
						}

						newWDispId = insert into Stock_Dispute
						[
							Material_Name=wDispName
							Unit="pcs"
							Is_Waste=true
							Direction="Outbound"
							Issued_Qty=issuedW
							Received_Qty=alreadyW + takePcs
							Disputed_Qty=stillOut
							Status="Open"
							Raised_On=zoho.currentdate
							Raised_Note=wRemark.replaceAll("\"","'")
							Added_User=zoho.loginuser
						];

						for each  wdsp in Stock_Dispute[ID == newWDispId.toLong()]
						{
							wdsp.Waste_Piece = wi.Waste_Piece;
							wdsp.Supervisor = supId;
							if(wDispMat != null)
							{
								wdsp.Material = wDispMat;
							}
							if(wi.Plan != null)
							{
								wdsp.Plan = wi.Plan;
							}
							if(wi.Plan_Item != null)
							{
								wdsp.Plan_Item = wi.Plan_Item;
							}
						}
						wSoNo = "";
						if(wi.Plan != null)
						{
							wSoNo = ifnull(soNoByPlan.get(wi.Plan + ""),"").toString();
						}
						dispRows.add(wDispName + " (offcuts)|" + wSoNo + "|pcs|" + issuedW + "|" + (alreadyW + takePcs) + "|" + stillOut);
					}
					catch (e3)
					{
						info "Stock_Dispute not raised for waste piece " + wi.Waste_Piece + ": " + e3.toString();
					}

					if(errJson != "")
					{
						errJson = errJson + ",";
					}
					errJson = errJson + "\"Waste piece " + ifnull(wi.Piece_Width,0) + "x" + ifnull(wi.Piece_Length,0) + ": " + stillOut + " of " + issuedW + " not received" + wNoteTxt + " - dispute raised\"";
				}
			}
		}
	}

	//------------------------------------------------------------------------
	// PRINTED FABRIC PIECES: received per piece. issueLineId + voucherId now,
	// so the parent voucher is a point lookup instead of a scan of every
	// handover.
	//------------------------------------------------------------------------
	for each  pRaw in printed
	{
		pm = pRaw.toMap();
		pIdTxt = ifnull(pm.get("issueLineId"),"").toString().trim();
		pVTxt = ifnull(pm.get("voucherId"),"").toString().trim();
		pGotStr = ifnull(pm.get("received"),"0").toString().trim();
		if(pGotStr == "")
		{
			pGotStr = "0";
		}
		pGot = pGotStr.toDecimal();
		pNoteTxt = ifnull(pm.get("remark"),"").toString();

		if(pIdTxt == "" || pVTxt == "" || pGot < 0)
		{
			if(errJson != "")
			{
				errJson = errJson + ",";
			}
			errJson = errJson + "\"Printed piece: invalid received quantity\"";
		}
		else
		{
			if(touchedVoucherIds.contains(pVTxt) == false)
			{
				touchedVoucherIds.add(pVTxt);
			}
			foundLn = false;
			for each  miRec in Material_Issue[ID == pVTxt.toLong()]
			{
				for each  miLn in miRec.Issue_Lines
				{
					if(miLn.ID == pIdTxt.toLong())
					{
						foundLn = true;
						lnQtyS = ifnull(miLn.Qty,"0").toString().trim();
						if(lnQtyS == "")
						{
							lnQtyS = "0";
						}
						lnSetS = ifnull(miLn.Settled_Qty,"0").toString().trim();
						if(lnSetS == "")
						{
							lnSetS = "0";
						}
						lnRemain = lnQtyS.toDecimal() - lnSetS.toDecimal();

						takeP = pGot;
						if(takeP > lnRemain)
						{
							takeP = lnRemain;
						}

						miLn.Settled_Qty = lnSetS.toDecimal() + takeP;
						stillOutP = lnRemain - takeP;

						ppSpill = takeP;
						if(miLn.Requirement != null)
						{
							ppItemId = null;
							ppMatId = "";

							for each  req in Material_Requirement[ID == miLn.Requirement]
							{
								ppItemId = req.Plan_Item;
								ppMatId = ifnull(req.Material,"").toString().trim();

								reqIssS = ifnull(req.Issued_Qty,"0").toString().trim();
								if(reqIssS == "")
								{
									reqIssS = "0";
								}
								reqRcvS = ifnull(req.Received_Qty,"0").toString().trim();
								if(reqRcvS == "")
								{
									reqRcvS = "0";
								}

								ppRoom = reqIssS.toDecimal() - reqRcvS.toDecimal();
								if(ppRoom > ppSpill)
								{
									ppRoom = ppSpill;
								}
								if(ppRoom < 0)
								{
									ppRoom = 0.0;
								}
								req.Received_Qty = reqRcvS.toDecimal() + ppRoom;
								ppSpill = ppSpill - ppRoom;
							}

							if(ppSpill > 0 && ppItemId != null && ppMatId != "")
							{
								for each  reqSib in Material_Requirement[Plan_Item == ppItemId]
								{
									if(ppSpill > 0 && (reqSib.ID + "") != (miLn.Requirement + "") && ifnull(reqSib.Material,"").toString().trim() == ppMatId)
									{
										sibIssS = ifnull(reqSib.Issued_Qty,"0").toString().trim();
										if(sibIssS == "")
										{
											sibIssS = "0";
										}
										sibRcvS = ifnull(reqSib.Received_Qty,"0").toString().trim();
										if(sibRcvS == "")
										{
											sibRcvS = "0";
										}

										sibRoom = sibIssS.toDecimal() - sibRcvS.toDecimal();
										if(sibRoom > ppSpill)
										{
											sibRoom = ppSpill;
										}
										if(sibRoom > 0)
										{
											reqSib.Received_Qty = sibRcvS.toDecimal() + sibRoom;
											ppSpill = ppSpill - sibRoom;
										}
									}
								}
							}
						}

						if(miLn.Material != null)
						{
							for each  rm in Raw_Material[ID == miLn.Material]
							{
								ptiS = ifnull(rm.In_Transit_Qty,"0").toString().trim();
								if(ptiS == "")
								{
									ptiS = "0";
								}
								ptdS = ifnull(rm.Disputed_Qty,"0").toString().trim();
								if(ptdS == "")
								{
									ptdS = "0";
								}
								ptiQty = ptiS.toDecimal();
								ptDrain = lnRemain;
								if(ptDrain > ptiQty)
								{
									ptDrain = ptiQty;
								}
								if(ptDrain < 0)
								{
									ptDrain = 0.0;
								}
								rm.In_Transit_Qty = ptiQty - ptDrain;
								if(stillOutP > 0)
								{
									rm.Disputed_Qty = ptdS.toDecimal() + stillOutP;
								}
							}
						}

						if(miLn.Lot != null)
						{
							for each  lotSet in Raw_Material_Lot[ID == miLn.Lot]
							{
								ltiS = ifnull(lotSet.In_Transit_Qty,"0").toString().trim();
								if(ltiS == "")
								{
									ltiS = "0";
								}
								ltdS = ifnull(lotSet.Disputed_Qty,"0").toString().trim();
								if(ltdS == "")
								{
									ltdS = "0";
								}
								ltiQty = ltiS.toDecimal();
								ltDrain = lnRemain;
								if(ltDrain > ltiQty)
								{
									ltDrain = ltiQty;
								}
								if(ltDrain < 0)
								{
									ltDrain = 0.0;
								}
								lotSet.In_Transit_Qty = ltiQty - ltDrain;
								if(stillOutP > 0)
								{
									lotSet.Disputed_Qty = ltdS.toDecimal() + stillOutP;
								}
							}
						}
						if(okJson != "")
						{
							okJson = okJson + ",";
						}
						okJson = okJson + "{\"id\":\"" + pIdTxt + "\",\"status\":\"success\"}";

						if(stillOutP > 0)
						{
							pNoteShow = "";
							if(pNoteTxt != "")
							{
								pNoteShow = " (" + pNoteTxt + ")";
							}

							try
							{
								pDispName = "";
								pDispUnit = "";
								for each  rm in Raw_Material[ID == miLn.Material]
								{
									pDispName = ifnull(rm.Material_Name,"").toString();
									pDispUnit = ifnull(rm.Unit,"").toString();
								}

								pSoNo = "";
								pPlanId = null;
								if(miLn.Requirement != null)
								{
									for each  req in Material_Requirement[ID == miLn.Requirement]
									{
										if(req.Plan != null)
										{
											pPlanId = req.Plan;
											pSoNo = ifnull(soNoByPlan.get(req.Plan + ""),"").toString();
										}
									}
								}

								newDispId = insert into Stock_Dispute
								[
									Material_Name=pDispName
									Unit=pDispUnit
									Is_Waste=false
									Direction="Outbound"
									Issued_Qty=lnRemain
									Received_Qty=takeP
									Disputed_Qty=stillOutP
									Status="Open"
									Raised_On=zoho.currentdate
									Raised_Note="Short by " + stillOutP + " Mtr on receipt" + pNoteShow
									Added_User=zoho.loginuser
								];

								for each  dsp in Stock_Dispute[ID == newDispId.toLong()]
								{
									dsp.Material = miLn.Material;
									dsp.Supervisor = supId;
									if(miLn.Lot != null)
									{
										dsp.Lot = miLn.Lot;
									}
									if(pPlanId != null)
									{
										dsp.Plan = pPlanId;
									}
									if(miLn.Requirement != null)
									{
										for each  req in Material_Requirement[ID == miLn.Requirement]
										{
											if(req.Plan_Item != null)
											{
												dsp.Plan_Item = req.Plan_Item;
											}
										}
									}
								}

								dispRows.add(pDispName + " (printed piece)|" + pSoNo + "|Mtr|" + lnRemain + "|" + takeP + "|" + stillOutP);
							}
							catch (e3)
							{
								info "Stock_Dispute not raised for printed piece " + pIdTxt + ": " + e3.toString();
							}

							if(errJson != "")
							{
								errJson = errJson + ",";
							}
							errJson = errJson + "\"Printed piece: " + stillOutP + " of " + lnRemain + " Mtr not received" + pNoteShow + " - dispute raised\"";
						}
					}
				}
			}

			if(foundLn == false)
			{
				if(errJson != "")
				{
					errJson = errJson + ",";
				}
				errJson = errJson + "\"Printed piece " + pIdTxt + " not found\"";
			}
		}
	}

	//------------------------------------------------------------------------
	// VOUCHER STATUS, straight off the lines this receipt just settled.
	//
	// Runs on EVERY chunk, not just the finalizing one - the flip is per
	// voucher and each Issue_Line is only ever settled once, so a chunk that
	// happens to settle a voucher's last line closes it there and then. It does
	// not wait for finalize, does not look at Material_Issue.Plan, and does not
	// need the voucher's plan to be in plansTouched - the exact three ways the
	// sweep-only flip below could miss a voucher.
	//
	// Received  = every Issue_Line now has Settled_Qty >= Qty.
	// Partially_Received = at least one line settled, some still owed.
	// A voucher already "Received" is left alone (forward only).
	//------------------------------------------------------------------------
	for each  tvId in touchedVoucherIds
	{
		try
		{
			for each  vRec in Material_Issue[ID == tvId.toLong()]
			{
				if(ifnull(vRec.Issue_Status,"").toString().trim() != "Received")
				{
					allLinesSettled = true;
					anyLine = false;
					for each  vLn in vRec.Issue_Lines
					{
						anyLine = true;
						vlQ = ifnull(vLn.Qty,"0").toString().trim();
						if(vlQ == "")
						{
							vlQ = "0";
						}
						vlS = ifnull(vLn.Settled_Qty,"0").toString().trim();
						if(vlS == "")
						{
							vlS = "0";
						}
						if(vlS.toDecimal() < vlQ.toDecimal())
						{
							allLinesSettled = false;
						}
					}
					if(anyLine == true && allLinesSettled == true)
					{
						vRec.Issue_Status = "Received";
					}
					else
					{
						vRec.Issue_Status = "Partially_Received";
					}
				}
			}
		}
		catch (eVs)
		{
			info "Issue_Status not set for voucher " + tvId + ": " + eVs.toString();
		}
	}

	//------------------------------------------------------------------------
	// READINESS SWEEP - ONLY the plans this receipt touched, and ONLY on the
	// finalizing call. A non-last chunk has only half-applied the settlements,
	// so sweeping now would roll a status on data that is still arriving.
	//
	// The widget named the plans; a receipt touches a handful, so this stays
	// bounded however many plans are open. Same per-item / per-requirement /
	// per-waste checks as before, and the same forward-only status guard.
	//------------------------------------------------------------------------
	// Take at most SWEEP_BUDGET plan ids off the front of the list this call was
	// given; sweepRemaining is everything past that, handed back for the next
	// finalize call. sweepAllDone is true only when nothing was left over.
	sweepPlans = List();
	sweepRemainingJson = "";
	sweepAllDone = true;
	if(doFinalize == true)
	{
		swIdx = 0;
		for each  ptTake in touchedPlanIds
		{
			if(swIdx < SWEEP_BUDGET)
			{
				sweepPlans.add(ptTake);
			}
			else
			{
				sweepAllDone = false;
				if(sweepRemainingJson != "")
				{
					sweepRemainingJson = sweepRemainingJson + ",";
				}
				sweepRemainingJson = sweepRemainingJson + "\"" + ptTake + "\"";
			}
			swIdx = swIdx + 1;
		}
	}
	for each  ptKey in sweepPlans
	{
		planId = ptKey.toLong();
		planStNow = "";
		for each  planHdr in Production_Planning[ID == planId]
		{
			planStNow = ifnull(planHdr.Order_Status,"").toString();
		}

		planItems = Plan_Item[Plan == planId];
		allReadyCount = 0;
		totalItemCount = 0;

		for each  pItem in planItems
		{
			totalItemCount = totalItemCount + 1;
			itemReady = true;
			reqCount = 0;

			for each  row in Material_Requirement[Plan_Item == pItem.ID]
			{
				reqCount = reqCount + 1;
				isFab = row.Is_Fabric;

				reqStr = ifnull(row.Required_Qty,"0").toString().trim();
				if(reqStr == "")
				{
					reqStr = "0";
				}
				issStr = ifnull(row.Issued_Qty,"0").toString().trim();
				if(issStr == "")
				{
					issStr = "0";
				}
				recStr = ifnull(row.Received_Qty,"0").toString().trim();
				if(recStr == "")
				{
					recStr = "0";
				}

				reqQty = reqStr.toDecimal();
				issQty = issStr.toDecimal();
				recQty = recStr.toDecimal();

				if(recQty < issQty)
				{
					itemReady = false;
				}

				if(isFab == true)
				{
					reqPcs = ifnull(row.Required_Pieces,0);
					issPcs = ifnull(row.Pieces_From_Waste,0) + ifnull(row.Pieces_From_Raw,0);
					if(reqPcs <= 0 || issPcs < reqPcs)
					{
						itemReady = false;
					}
				}
				else
				{
					if(reqQty <= 0 || issQty < reqQty)
					{
						itemReady = false;
					}
				}
			}

			if(reqCount == 0)
			{
				itemReady = false;
			}

			itemIssued = Waste_Movement[Plan_Item == pItem.ID && Movement_Type == "Issued"];
			for each  wi in itemIssued
			{
				wCount = ifnull(wi.Piece_Count,0);
				wRecv = 0;
				for each  rv in Waste_Movement[Parent_Movement == wi.ID && Movement_Type == "Received"]
				{
					wRecv = wRecv + ifnull(rv.Piece_Count,0);
				}
				if(wRecv < wCount)
				{
					itemReady = false;
				}
			}

			if(itemReady == true && pItem.Item_Status == "Awaiting_Material")
			{
				pItem.Item_Status = "Ready_For_Production";
			}

			if(pItem.Item_Status != "Awaiting_Material")
			{
				allReadyCount = allReadyCount + 1;
			}
		}

		if(totalItemCount > 0 && allReadyCount > 0 && planStNow != "In Progress" && planStNow != "Production Complete")
		{
			if(allReadyCount == totalItemCount)
			{
				for each  planUpd in Production_Planning[ID == planId]
				{
					planUpd.Order_Status = "Material Ready";
				}
			}
			else if(planStNow == "Pending")
			{
				for each  planUpd in Production_Planning[ID == planId]
				{
					planUpd.Order_Status = "Partially Received";
				}
			}
		}

		// Issue_Status is NOT touched here any more. It used to flip every
		// Material_Issue[Plan == planId] to Received/Partially_Received off the
		// plan-level recvComplete flag - which is wrong for a voucher whose own
		// lines are not all settled, and which missed a voucher whose Plan field
		// was empty or pointed at another plan of a multi-plan handover. The
		// per-voucher block above (driven by touchedVoucherIds and each
		// voucher's own Issue_Lines) is the single place it is set now.
	}

	//--------------------------------------------------------------------
	// MOVE THE CLOTH TO THE PRODUCTION WAREHOUSE IN ZOHO INVENTORY.
	//
	// FINALIZING CALL ONLY - one transfer sweep for the whole receipt, not one
	// per chunk. It reads Settled_Qty - Transferred_Qty off the lines, which
	// every chunk before this has been writing, so by here the full receipt is
	// settled and one "auto" run posts every voucher's difference.
	//
	// Its own try/catch, and last inside the block. Stock has already moved,
	// disputes raised, Item_Status rolled. A transfer that fails must never make
	// a completed receipt look failed.
	//--------------------------------------------------------------------
	if(doFinalize == true && sweepAllDone == true)
	{
		try
		{
			info "transfer after receipt -> " + thisapp.postTransferOrders("auto");
		}
		catch (eTo)
		{
			info "postTransferOrders after receipt threw: " + eTo.toString();
		}
	}

	}
	catch (e)
	{
		// Surfaces as an alert in the widget via the existing errors[] handling.
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"received\":[],\"sweepRemaining\":[],\"sweepDone\":true}";
	}

	//------------------------------------------------------------------------
	// DISPUTE NOTIFICATIONS. Outbound: the SUPERVISOR raised these, so the party
	// that has to answer is the STORE. Admin gets its own copy. Two mails, not
	// one with two recipients - they are not the same message.
	//
	// Outside the main try/catch and wrapped in its own. Everything is already
	// written by here, and a mail failure must not turn a completed receipt into
	// an error the supervisor will try again.
	//------------------------------------------------------------------------
	adminTo = "gurdhian.helios@gmail.com";
	storeTo = "gurdhian.helios@gmail.com";

	try
	{
		if(dispRows.size() > 0)
		{
			dSupName = "";
			for each  dEmp in Employee[ID == supId]
			{
				dSupName = ifnull(dEmp.Employee_Name,"").toString().replaceAll("\"","'");
			}
			if(dSupName == "")
			{
				dSupName = "Supervisor";
			}

			dTh = "padding:8px 12px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#64748b;text-align:left;font-weight:600";
			dThR = "padding:8px 12px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#64748b;text-align:right;font-weight:600";
			dTd = "padding:10px 12px;border-bottom:1px solid #eef2f6;font-size:13px;color:#0f172a";
			dTdR = "padding:10px 12px;border-bottom:1px solid #eef2f6;font-size:13px;color:#0f172a;text-align:right;font-weight:600";
			dTdBad = "padding:10px 12px;border-bottom:1px solid #fee2e2;font-size:13px;color:#991b1b;text-align:right;font-weight:700";

			dRowsHtml = "";
			for each  dr in dispRows
			{
				dp = dr.toList("|");
				dRowsHtml = dRowsHtml + "<tr><td style='" + dTd + "'>" + dp.get(0) + "</td><td style='" + dTd + ";white-space:nowrap'>" + dp.get(1) + "</td><td style='" + dTdR + "'>" + dp.get(3) + " <span style='color:#64748b;font-weight:400'>" + dp.get(2) + "</span></td><td style='" + dTdR + "'>" + dp.get(4) + "</td><td style='" + dTdBad + "'>" + dp.get(5) + "</td></tr>";
			}

			dTable = "<table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='border-collapse:collapse;margin-top:14px;border:1px solid #e2e8f0;border-radius:6px'>";
			dTable = dTable + "<tr><th style='" + dTh + "'>Material</th><th style='" + dTh + "'>Order</th><th style='" + dThR + "'>Issued</th><th style='" + dThR + "'>Received</th><th style='" + dThR + "'>Short by</th></tr>";
			dTable = dTable + dRowsHtml + "</table>";

			dWord = "disputes";
			if(dispRows.size() == 1)
			{
				dWord = "dispute";
			}
			dSubtitle = "Raised by " + dSupName + " &middot; " + zoho.currentdate.toString("dd MMM yyyy") + " " + zoho.currenttime.toString("HH:mm");

			sInner = "<div style='font-size:14px;color:#0f172a'><b>" + dSupName + "</b> has confirmed his receipt and reported <b>" + dispRows.size() + " " + dWord + "</b>. The quantity below left the store but he says it did not reach him.</div>";
			sInner = sInner + dTable;
			sInner = sInner + "<div style='font-size:12px;color:#64748b;padding-top:14px'>Check the shelf and answer on the <b>Disputes</b> tab. If the stock is still with the store, <b>Store correction</b> returns it and re-opens the requirement so it can be issued again. Until someone answers, this quantity is neither on the shelf nor with him.</div>";
			sInner = sInner + "<div style='font-size:12px;color:#94a3b8;padding-top:10px'>Written for the store. No store mailbox is configured yet, so it is being sent here.</div>";

			sendmail
			[
				from :zoho.adminuserid
				to :storeTo
				subject :"Action needed: " + dispRows.size() + " " + dWord + " raised by " + dSupName
				message :thisapp.buildNotificationEmail("Material disputed on receipt",dSubtitle,"#dc2626",sInner)
			]

			aInner = "<div style='font-size:14px;color:#0f172a'><b>" + dispRows.size() + " " + dWord + "</b> raised by <b>" + dSupName + "</b> on receipt. Nobody has answered yet.</div>";
			aInner = aInner + dTable;
			aInner = aInner + "<div style='font-size:12px;color:#64748b;padding-top:14px'>Direction is <b>Outbound</b> - store to supervisor - so the store answers first. This is for visibility; no action is needed from you unless it stays open.</div>";

			sendmail
			[
				from :zoho.adminuserid
				to :adminTo
				subject :"Dispute raised: " + dispRows.size() + " " + dWord + " - " + dSupName + " (outbound)"
				message :thisapp.buildNotificationEmail("Dispute raised",dSubtitle,"#dc2626",aInner)
			]

			info "Dispute notifications sent: " + dispRows.size() + " row(s)";
		}
	}
	catch (eMail)
	{
		info "Dispute notification not sent: " + eMail.toString();
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	//
	// sweepRemaining: plan ids a finalize call did not get to (it caps at
	// SWEEP_BUDGET). The widget calls finalize again with exactly these until the
	// list comes back empty; sweepDone == true means the readiness sweep AND the
	// warehouse transfer are both finished. On a non-finalize chunk both are
	// their empty / done defaults and the widget ignores them.
	return "{\"errors\":[" + errJson + "],\"received\":[" + okJson + "],\"sweepRemaining\":[" + sweepRemainingJson + "],\"sweepDone\":" + sweepAllDone + "}";
}
