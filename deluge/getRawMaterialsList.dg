string getRawMaterialsList()
{
	res = "{\"errors\":[\"Nothing ran\"]}";
	try
	{
		allLots = Raw_Material_Lot[ID != 0] sort by Added_Time;
		lotJsonByMat = Map();
		for each  lt in allLots
		{
			ltMat = ifnull(lt.Material,"").toString().trim();
			if(ltMat != "")
			{
				luS = ifnull(lt.Unwash_Quantity,"0").toString().trim();
				if(luS == "")
				{
					luS = "0";
				}
				lwS = ifnull(lt.Wash_Quantity,"0").toString().trim();
				if(lwS == "")
				{
					lwS = "0";
				}
				liS = ifnull(lt.In_Transit_Qty,"0").toString().trim();
				if(liS == "")
				{
					liS = "0";
				}
				ldS = ifnull(lt.Disputed_Qty,"0").toString().trim();
				if(ldS == "")
				{
					ldS = "0";
				}
				lhS = ifnull(lt.In_Wash_Qty,"0").toString().trim();
				if(lhS == "")
				{
					lhS = "0";
				}

				ltNum = ifnull(lt.Lot_Number,"").toString().trim().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");
				ltLab = ifnull(lt.Lot_Label,"").toString().trim().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");
				ltSt = ifnull(lt.Status,"").toString().trim();
				if(ltSt == "")
				{
					ltSt = "Active";
				}

				oneLot = "{\"lotId\":\"" + lt.ID + "\",\"lotNumber\":\"" + ltNum + "\",\"label\":\"" + ltLab + "\",\"status\":\"" + ltSt + "\",\"unwash\":" + luS.toDecimal() + ",\"wash\":" + lwS.toDecimal() + ",\"inTransit\":" + liS.toDecimal() + ",\"disputed\":" + ldS.toDecimal() + ",\"inWash\":" + lhS.toDecimal() + "}";

				prevJson = ifnull(lotJsonByMat.get(ltMat),"").toString();
				if(prevJson != "")
				{
					prevJson = prevJson + ",";
				}
				lotJsonByMat.put(ltMat,prevJson + oneLot);
			}
		}

		rowsJson = "";
		allMats = Raw_Material[ID != 0] sort by Material_Display_Name;
		for each rm in allMats
		{
			if(rowsJson != "")
			{
				rowsJson = rowsJson + ",";
			}
			
			matName = ifnull(rm.Material_Display_Name, "").toString().trim().replaceAll("\"", "'");
			if(matName == "")
			{
				matName = ifnull(rm.Name, "").toString().trim().replaceAll("\"", "'");
			}
			
			skuText = ifnull(rm.SKU, "").toString().trim().replaceAll("\"", "'");
			isFab = ifnull(rm.Is_Fabric, false);
			
			matType = ifnull(rm.Type_field, "").toString().trim().replaceAll("\"", "'");
			matPattern = ifnull(rm.Pattern, "").toString().trim().replaceAll("\"", "'");
			matColor = ifnull(rm.Color, "").toString().trim().replaceAll("\"", "'");
			if(matColor == "")
			{
				matColor = ifnull(rm.Color, "").toString().trim().replaceAll("\"", "'");
			}
			
			unitVal = ifnull(rm.Unit, "").toString().trim().replaceAll("\"", "'");
			
			washQty = 0.0;
			unwashQty = 0.0;
			totalQty = 0.0;
			if(isFab == true)
			{
				washQty = ifnull(rm.Wash_Quantity, 0.0).toDecimal();
				unwashQty = ifnull(rm.Unwash_Quantity, 0.0).toDecimal();
				unallocQty = ifnull(rm.Unallocated_Qty, 0.0).toDecimal();
				totalQty = washQty + unwashQty + unallocQty;
			}
			else
			{
				totalQty = ifnull(rm.Quantity, 0.0).toDecimal();
			}
			
			matPrice = ifnull(rm.Item_Price, 0.0).toDecimal();
			matLastPurchase = "";
			if(rm.Last_Purchase_Date != null)
			{
				matLastPurchase = rm.Last_Purchase_Date.toString("dd-MMM-yyyy");
			}
			
			widthVal = ifnull(rm.Fabric_Width_Inches, "").toString().trim().replaceAll("\"", "'");
			gsmVal = ifnull(rm.GSM, "").toString().trim().replaceAll("\"", "'");
			qualityVal = ifnull(rm.Quality, "").toString().trim().replaceAll("\"", "'");
			
			rmKey = rm.ID + "";
			myLots = ifnull(lotJsonByMat.get(rmKey),"").toString();

			rowsJson = rowsJson + "{\"id\":\"" + rm.ID + "\","
				+ "\"name\":\"" + matName + "\","
				+ "\"sku\":\"" + skuText + "\","
				+ "\"isFabric\":" + isFab + ","
				+ "\"type\":\"" + matType + "\","
				+ "\"pattern\":\"" + matPattern + "\","
				+ "\"color\":\"" + matColor + "\","
				+ "\"unit\":\"" + unitVal + "\","
				+ "\"stock\":" + totalQty + ","
				+ "\"washQty\":" + washQty + ","
				+ "\"unwashQty\":" + unwashQty + ","
				+ "\"width\":\"" + widthVal + "\","
				+ "\"gsm\":\"" + gsmVal + "\","
				+ "\"quality\":\"" + qualityVal + "\","
				+ "\"price\":" + matPrice + ","
				+ "\"lastPurchaseDate\":\"" + matLastPurchase + "\","
				+ "\"lots\":[" + myLots + "]}";
		}
		res = "{\"errors\":[],\"materials\":[" + rowsJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}
	return res;
}
