string getExpectedWaste(string planId, string planItemId, string qtyOut)
{
	// Remnants the cutting is expected to produce, for one item on one plan.
	//
	// Called when the supervisor ends the Cutting stage. The rows come back as
	// EDITABLE DEFAULTS - he keeps, changes, deletes or adds to them, and only what
	// he confirms is written by saveWasteFromCutting. Nothing here is stored.
	//
	// Computed on the pieces he actually cut (Qty_Out), against the fabric he was
	// actually given: the waste pieces he received first, then fresh cloth.
	//
	// The remnant maths is INLINED rather than calling calcCutPlan - cross-function
	// calls do not work in this app. calcCutPlan now has no caller and can be
	// deleted; this is the only place the generation half is used.
	//
	// Grain is fixed throughout: cut width runs across the piece width, cut length
	// along its length, never rotated.
	//
	// fabricOptions is order-wide, not item-wide, because a supervisor adding a
	// remnant by hand may be holding cloth from any fabric on the order - including
	// a full-width leftover, which he enters as a piece at the full fabric width.

	fabJson = "";
	optJson = "";
	errJson = "";

	// DEBUG WRAPPER: Creator reports every runtime failure as a generic
	// "code 9430 - There is an error while executing Custom API." Catching it
	// here surfaces the real Deluge message in the widget console instead.
	try
	{
	pid = planId.trim().toLong();

	// Creator fields that were never written are EMPTY, not null, and
	// toDecimal() throws on empty - normalise to string first.
	qStr = ifnull(qtyOut,"0").toString().trim();
	if(qStr == "")
	{
		qStr = "0";
	}
	pcsCut = qStr.toDecimal().toLong();

	seenOpt = Map();

	// Trimmed once. planItemId is compared raw further down; this is the same
	// value, normalised, for the lot lookup below.
	itemIdTxt = ifnull(planItemId,"").toString().trim();

	//----------------------------------------------------------------------
	// WHICH LOT THIS ITEM'S CLOTH CAME OFF, so the offcut can go back to it.
	//
	// Read from Material_Requirement.Issued_Lot - the tone pin - the SAME
	// source saveWasteFromCutting now uses, so the dialog and the save agree.
	// Bounded by [Plan_Item == this item]: a handful of rows, no handover walk,
	// no date bound. Both eras populate Issued_Lot, so no branch.
	//
	// A material with two requirement rows pinned to DIFFERENT lots was issued
	// split across lots - both are listed and the supervisor picks, because
	// guessing would put a tone on the piece that might be a lie. Per-lot metres
	// come off each row's Issued_Qty.
	//
	// PRINTED PIECES (Pass 1.5 below) still need a per-piece Issue_Line walk,
	// and the new material x lot lines carry no Plan_Item - so supIssuesW is
	// kept for that pass only. A JS_API handover's printed pieces will not
	// pre-fill in the dialog; the supervisor adds them by hand. The printed-
	// fabric end-to-end work will close that (see docs/issue-receive-model-
	// migration.md).
	//----------------------------------------------------------------------
	lotsByMat = Map();
	lotSeqByMat = Map();
	lotQtyByKey = Map();
	lotNumById = Map();
	// PER-ROLL BREAKDOWN, lot-rolls-model.md Step 4. Material_Requirement.Roll_Label
	// (Step 4's own prerequisite, stamped by issueMaterialsApply) is either one
	// label - the row's whole Issued_Qty came off that one roll - or several
	// joined "L2-R1 5m, L2-R2 1.05m", in DRAIN ORDER (the order the allocator
	// used them, same order Roll_Label was built in). Parsed once here into
	// rollSeqByKey (material|lot -> ordered "~"-joined roll labels, drain order
	// preserved) and rollQtyByKey (material|lot|rollLabel -> summed metres) -
	// same shape as lotSeqByMat/lotQtyByKey one level down. A row with no
	// Roll_Label (offcut-only, or issued before Step 4) contributes nothing;
	// Pass 2 below falls back to its old lot-only behaviour for that lot.
	rollSeqByKey = Map();
	rollQtyByKey = Map();
	// "material|lot|rollLabel" -> "1", once a roll has been added to
	// rollSeqByKey's ordered list for that key. A plain Map lookup rather
	// than testing the joined string for a substring, which cannot tell
	// "R1" from "R10" reliably at the boundary.
	rollSeenKey = Map();

	// Empty by default so Pass 1.5's for-each is safe when there is no
	// supervisor / item to scan for.
	supIssuesW = List();
	wSupId = 0;
	wPlanStart = null;
	for each  wPlan in Production_Planning[ID == pid]
	{
		wSupId = ifnull(wPlan.Assigned_To,0);
		wPlanStart = wPlan.Plan_Start_Date;
	}

	if(itemIdTxt != "" && itemIdTxt.isNumber() == true)
	{
		for each  rqLotE in Material_Requirement[Plan_Item == itemIdTxt.toLong()]
		{
			lnMatW = ifnull(rqLotE.Material,"").toString().trim();
			lnLotW = ifnull(rqLotE.Issued_Lot,"").toString().trim();
			lnqW = ifnull(rqLotE.Issued_Qty,"0").toString().trim();
			if(lnqW == "")
			{
				lnqW = "0";
			}

			//--------------------------------------------------------------
			// THE CLOTH HE IS ACTUALLY HOLDING, NOT WHAT THE STORE SENT.
			//
			// This function predicts the remnants a cutting run throws off,
			// and the TAIL - what is left on the roll once the marker rows are
			// cut - is a straight metres figure. Read off Issued_Qty it is the
			// store's number; read off Received_Qty it is his.
			//
			// They are different whenever a handover came up short.
			// receiveFanOut credits Received_Qty and deliberately leaves
			// Issued_Qty alone ("room on a requirement row is Issued_Qty -
			// Received_Qty"), so the gap sits there as an open Stock_Dispute
			// until somebody resolves it. Issue 10m, receive 8m, and the
			// dialog offered a 5m tail where the true tail is 3m - a 2m
			// remnant that does not exist, pre-filled as a default and
			// therefore likely to be accepted. saveWasteFromCutting writes
			// whatever it is given with no cap, so it lands as a
			// Pending_Receipt Waste_Master row, and the store then raises an
			// INBOUND dispute over a piece nobody ever cut.
			//
			// The side strip and the part-filled row are driven by PIECES, so
			// they were always right; only the tail moved. Capping the metres
			// at what arrived fixes the tail and leaves the rest untouched.
			//
			// THE MINIMUM, not a swap. Received_Qty is 0 on a row issued but
			// not yet confirmed - the ordinary state while cloth is in transit
			// - and the supervisor can legitimately end Cutting before he has
			// pressed Confirm on the receive screen. Taking Received_Qty alone
			// would predict no tail at all for him. So: use the smaller of the
			// two ONLY when a receipt has actually been recorded, and fall back
			// to Issued_Qty when none has. A dispute later resolved Found
			// raises Received_Qty back and the next preview widens again on its
			// own.
			//
			// UNDER-PREDICTING IS THE SAFE DIRECTION. He is holding the cloth:
			// a remnant the dialog missed he adds by hand in the same dialog,
			// while one it invented he has to notice and delete.
			//--------------------------------------------------------------
			lnrW = ifnull(rqLotE.Received_Qty,"0").toString().trim();
			if(lnrW == "")
			{
				lnrW = "0";
			}
			if(lnrW.toDecimal() > 0 && lnrW.toDecimal() < lnqW.toDecimal())
			{
				lnqW = lnrW;
			}
			if(lnMatW != "" && lnLotW != "")
			{
				qKeyW = lnMatW + "|" + lnLotW;
				prevQW = ifnull(lotQtyByKey.get(qKeyW),"0").toString().trim();
				if(prevQW == "")
				{
					prevQW = "0";
				}
				if(prevQW.toDecimal() == 0)
				{
					seqW = ifnull(lotSeqByMat.get(lnMatW),"").toString();
					if(seqW != "")
					{
						seqW = seqW + "~";
					}
					lotSeqByMat.put(lnMatW,seqW + lnLotW);
					if(lotNumById.get(lnLotW) == null)
					{
						lotNumById.put(lnLotW,"");
						for each  lotRefW in Raw_Material_Lot[ID == lnLotW.toLong()]
						{
							lotNumById.put(lnLotW,ifnull(lotRefW.Lot_Number,"").toString().replaceAll("\"","'"));
						}
					}
					haveW = ifnull(lotsByMat.get(lnMatW),"").toString();
					if(haveW != "")
					{
						haveW = haveW + ",";
					}
					lotsByMat.put(lnMatW,haveW + "{\"lotId\":\"" + lnLotW + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(lnLotW),"").toString() + "\"}");
				}
				lotQtyByKey.put(qKeyW,prevQW.toDecimal() + lnqW.toDecimal());

				//----------------------------------------------------------
				// PARSE Roll_Label FOR THIS ROW - Step 4. "L2-R1" (one roll,
				// the whole lnqW came off it) or "L2-R1 5m, L2-R2 1.05m"
				// (several, DRAIN ORDER, metres named per roll - do not
				// re-split lnqW, the row already says the true per-roll
				// share).
				//----------------------------------------------------------
				rlLabelW = ifnull(rqLotE.Roll_Label,"").toString().trim();
				if(rlLabelW != "")
				{
					// Split on "," alone (single-char delimiter, the proven
					// pattern every other .toList() call in this repo uses) -
					// each segment is trimmed below to drop the leading space
					// the ", " join in main.js leaves behind.
					rlParts = rlLabelW.toList(",");
					if(rlParts.size() <= 1)
					{
						// ONE ROLL. No comma, so no "Xm" suffix to parse - the
						// label IS the roll, and the row's whole Issued_Qty
						// came off it.
						rkKey = lnMatW + "|" + lnLotW + "|" + rlLabelW;
						if(rollSeenKey.get(rkKey) == null)
						{
							rollSeenKey.put(rkKey,"1");
							rqSeq = ifnull(rollSeqByKey.get(qKeyW),"").toString();
							if(rqSeq != "")
							{
								rqSeq = rqSeq + "~";
							}
							rollSeqByKey.put(qKeyW,rqSeq + rlLabelW);
						}
						rPrevQ = ifnull(rollQtyByKey.get(rkKey),"0").toString().trim();
						if(rPrevQ == "")
						{
							rPrevQ = "0";
						}
						rollQtyByKey.put(rkKey,rPrevQ.toDecimal() + lnqW.toDecimal());
					}
					else
					{
						// SEVERAL ROLLS. Each segment is "<label> <metres>m" -
						// strip the trailing "m" and split label from metres
						// on the last space, since a label itself may contain
						// spaces (unlikely, but typed by a person).
						//
						// SCALED WHEN THE RECEIPT CAME UP SHORT. Roll_Label records
						// what the store CUT off each roll; if less than that arrived,
						// the shortfall cannot be pinned to any ONE roll - nothing
						// anywhere records which roll the missing metres came off, and
						// guessing would put a tail on the wrong physical piece. So
						// every segment is scaled by the same ratio, which keeps the
						// per-roll shares summing to the cloth he is actually holding.
						//
						// Exactly 1.0 when the receipt was complete or none has been
						// recorded yet - lnqW is Issued_Qty in both cases - so the
						// ordinary path is arithmetically untouched.
						rlScaleW = 1.0;
						rlIssW = ifnull(rqLotE.Issued_Qty,"0").toString().trim();
						if(rlIssW == "")
						{
							rlIssW = "0";
						}
						if(rlIssW.toDecimal() > 0)
						{
							rlScaleW = lnqW.toDecimal() / rlIssW.toDecimal();
						}
						if(rlScaleW > 1)
						{
							rlScaleW = 1.0;
						}
						for each  rlSeg in rlParts
						{
							rlSegT = rlSeg.trim();
							if(rlSegT.endsWith("m"))
							{
								rlSegT = rlSegT.substring(0,rlSegT.length() - 1);
							}
							rlSp = rlSegT.lastIndexOf(" ");
							if(rlSp > 0)
							{
								rlSegLbl = rlSegT.substring(0,rlSp).trim();
								rlSegMtrTxt = rlSegT.substring(rlSp + 1).trim();
								if(rlSegLbl != "" && rlSegMtrTxt != "" && rlSegMtrTxt.isNumber() == true)
								{
									rkKey2 = lnMatW + "|" + lnLotW + "|" + rlSegLbl;
									if(rollSeenKey.get(rkKey2) == null)
									{
										rollSeenKey.put(rkKey2,"1");
										rqSeq2 = ifnull(rollSeqByKey.get(qKeyW),"").toString();
										if(rqSeq2 != "")
										{
											rqSeq2 = rqSeq2 + "~";
										}
										rollSeqByKey.put(qKeyW,rqSeq2 + rlSegLbl);
									}
									rPrevQ2 = ifnull(rollQtyByKey.get(rkKey2),"0").toString().trim();
									if(rPrevQ2 == "")
									{
										rPrevQ2 = "0";
									}
									rollQtyByKey.put(rkKey2,rPrevQ2.toDecimal() + (rlSegMtrTxt.toDecimal() * rlScaleW));
								}
							}
						}
					}
				}
			}
		}

		// Kept for Pass 1.5 printed pieces only.
		if(wSupId != 0)
		{
			if(wPlanStart != null)
			{
				supIssuesW = Material_Issue[Issued_To == wSupId && Issue_Date >= wPlanStart] sort by Added_Time;
			}
			else
			{
				supIssuesW = Material_Issue[Issued_To == wSupId] sort by Added_Time;
			}
		}
	}

	//----------------------------------------------------------------------
	// CUT PIECES PER ITEM, per fabric line. qtyOut counts ITEMS - a duvet set
	// is one - but a fabric line may need two cuts of its size per item (the
	// pair of pillow fronts). BOM Required_Quantity holds that on a fabric row,
	// the same number buildItemRequirements planned the cloth from, so it is
	// read back off the item's BOM rather than inferred from Required_Pieces,
	// which a reissue row would skew.
	//
	// Keyed material|cutW|cutL, sizes in tenths of a cm as whole numbers so
	// 36.8 on the BOM and 36.8 on the requirement land on one key whatever
	// type each field stores it as. Anything unmatched - no BOM, a cut edited
	// on the requirement - reads as 1, which is how it behaved before.
	//----------------------------------------------------------------------
	ppiMap = Map();
	if(itemIdTxt != "" && itemIdTxt.isNumber())
	{
		for each  ppiItem in Plan_Item[ID == itemIdTxt.toLong()]
		{
			if(ppiItem.BOM != null)
			{
				for each  ppiBom in BOM[ID == ppiItem.BOM]
				{
					for each  ppiRow in ppiBom.Material_Required
					{
						if(ppiRow.Item != null)
						{
							ppiW = ifnull(ppiRow.Cut_Size_Width,"0").toString().trim();
							if(ppiW == "")
							{
								ppiW = "0";
							}
							ppiL = ifnull(ppiRow.Cut_Size_Length,"0").toString().trim();
							if(ppiL == "")
							{
								ppiL = "0";
							}
							ppiQ = ifnull(ppiRow.Required_Quantity,"").toString().trim();
							ppiN = 1;
							if(ppiQ != "")
							{
								if(ppiQ.toDecimal() >= 1)
								{
									ppiN = ppiQ.toDecimal().round(0).toLong();
								}
							}
							ppiKey = ppiRow.Item.toString() + "|" + (ppiW.toDecimal() * 10).round(0).toLong() + "|" + (ppiL.toDecimal() * 10).round(0).toLong();
							ppiMap.put(ppiKey,ppiN);
						}
					}
				}
			}
		}
	}

	for each  plan in Production_Planning[ID == pid]
	{
		for each  mr in Material_Requirement[Plan == plan.ID]
		{
			isFab = mr.Is_Fabric;
			matId = mr.Material;

			if(isFab == true && matId != null)
			{
				// Every fabric is called "Linen Fabric", so the name alone tells
				// the supervisor nothing. The SKU is what actually distinguishes
				// them - design and colour can join it later.
				skuText = "";
				for each  rmL in Raw_Material[ID == matId]
				{
					skuText = ifnull(rmL.SKU,"").toString();
				}
				matLabel = mr.Material_Name;
				if(skuText != "")
				{
					matLabel = skuText + " - " + mr.Material_Name;
				}

				// Order-wide picker list, built from every fabric on the plan.
				if(seenOpt.get(matId + "") == null)
				{
					seenOpt.put(matId + "","1");
					if(optJson != "")
					{
						optJson = optJson + ",";
					}
					// IDs forced to string - 18-digit ids break JSON.parse.
					optJson = optJson + "{\"materialId\":\"" + matId + "\",\"material\":\"" + matLabel + "\"}";
				}

				// Only this item's fabric lines get a prediction.
				if(mr.Plan_Item != null && mr.Plan_Item.toString() == planItemId && pcsCut > 0)
				{
					cutW = ifnull(mr.Cut_Size_Width,0);
					cutL = ifnull(mr.Cut_Size_Length,0);

					// Items cut x cut pieces per item for THIS line - see ppiMap.
					rowPpi = 1;
					ppiLook = ppiMap.get(matId.toString() + "|" + (cutW.toString().toDecimal() * 10).round(0).toLong() + "|" + (cutL.toString().toDecimal() * 10).round(0).toLong());
					if(ppiLook != null)
					{
						rowPpi = ppiLook;
					}
					rowPcsCut = pcsCut * rowPpi;

					fabricWidthCm = 0.0;
					for each  rm in Raw_Material[ID == matId]
					{
						// Stored as TEXT, in inches.
						val = rm.Fabric_Width_Inches;
						if(val != null && val.trim() != "")
						{
							fabricWidthCm = val.trim().toDecimal() * 2.54;
						}
					}

					if(cutW <= 0 || cutL <= 0 || fabricWidthCm <= 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + mr.Material_Name + ": missing cut size or fabric width, nothing predicted\"";
					}
					else
					{
						genJson = "";
						remain = rowPcsCut;

						//--------------------------------------------------
						// Pass 1 - the waste pieces he actually received.
						// A piece leaves the store whole, so whatever it does
						// not yield comes back as waste, including its tail.
						//--------------------------------------------------
						// STEP 4b: Issued movements, not the Waste_Issued subform.
						// Hoisted into its own variable - a query cannot be built
						// inline in a for-each header.
						issuedMoves = Waste_Movement[Plan == plan.ID && Movement_Type == "Issued"];

						for each  wi in issuedMoves
						{
							// "Received" is no longer a field. It is the sum of the
							// Received movements pointing back at this issue, which
							// is what makes a short receipt legible instead of just
							// a smaller number.
							avail = 0;
							for each  rv in Waste_Movement[Parent_Movement == wi.ID && Movement_Type == "Received"]
							{
								avail = avail + ifnull(rv.Piece_Count,0);
							}

							// The movement carries the piece, not the material - the
							// material comes off the piece it was cut from.
							wMatId = "";
							// The remnant of a remnant belongs to the SAME lot the
							// original piece was cut from - the cloth never changed
							// tone, it only got smaller.
							wLotJson = "";
							for each  wmRec in Waste_Master[ID == wi.Waste_Piece]
							{
								wMatId = ifnull(wmRec.SKU,"").toString();
								wLotTxt = ifnull(wmRec.Lot,"").toString().trim();
								if(wLotTxt != "")
								{
									// Same lazy resolve as above, cached for the call.
									if(lotNumById.get(wLotTxt) == null)
									{
										lotNumById.put(wLotTxt,"");

										for each  lotRefP in Raw_Material_Lot[ID == wLotTxt.toLong()]
										{
											lotNumById.put(wLotTxt,ifnull(lotRefP.Lot_Number,"").toString().replaceAll("\"","'"));
										}
									}

									wLotJson = ",\"lotId\":\"" + wLotTxt + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(wLotTxt),"").toString() + "\"";
								}
							}

							pieceW = ifnull(wi.Piece_Width,0);
							pieceL = ifnull(wi.Piece_Length,0);

							if(remain > 0 && avail > 0 && wMatId == matId.toString() && wi.Plan_Item != null && wi.Plan_Item.toString() == planItemId && pieceW >= cutW && pieceL >= cutL)
							{
								perRow = (pieceW / cutW).floor();
								maxRows = (pieceL / cutL).floor();
								capacity = perRow * maxRows;
								sideW = pieceW - (perRow * cutW);

								// Pieces spent to their full capacity - each
								// yields the same two remnants, so they collapse
								// into one row carrying a count.
								fullPieces = (remain / capacity).floor();
								if(fullPieces > avail)
								{
									fullPieces = avail;
								}
								if(fullPieces > 0)
								{
									usedLen = maxRows * cutL;
									if(sideW > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideW + ",\"length\":" + usedLen + ",\"count\":" + fullPieces + ",\"origin\":\"side\"" + wLotJson + "}";
									}
									fullTail = pieceL - usedLen;
									if(fullTail > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + pieceW + ",\"length\":" + fullTail + ",\"count\":" + fullPieces + ",\"origin\":\"tail\"" + wLotJson + "}";
									}
									remain = remain - (fullPieces * capacity);
									avail = avail - fullPieces;
								}

								// At most one part-used piece for the remainder.
								if(remain > 0 && avail > 0)
								{
									take = remain;
									partRows = (take / perRow).floor();
									lastRow = take - (partRows * perRow);
									rows = partRows;
									if(lastRow > 0)
									{
										rows = rows + 1;
									}
									lengthUsed = rows * cutL;

									// Side strip - one continuous piece down the
									// full rows, not one per row.
									if(partRows > 0 && sideW > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideW + ",\"length\":" + (partRows * cutL) + ",\"count\":1,\"origin\":\"side\"}";
									}
									// Partial last row - the unused slots and the
									// side strip in that row are contiguous, so
									// it is a single piece.
									if(lastRow > 0)
									{
										partW = pieceW - (lastRow * cutW);
										if(partW > 0)
										{
											if(genJson != "")
											{
												genJson = genJson + ",";
											}
											genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partW + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"}";
										}
									}
									tailL = pieceL - lengthUsed;
									if(tailL > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + pieceW + ",\"length\":" + tailL + ",\"count\":1,\"origin\":\"tail\"}";
									}
									remain = 0;
								}
							}
						}

						//--------------------------------------------------
						// Pass 1.5 - printed pieces from Material_Issue.
						// A printed piece is physically discrete just like a waste piece.
						//--------------------------------------------------
						for each wIssW in supIssuesW
						{
							for each wLnW in wIssW.Issue_Lines
							{
								if(ifnull(wLnW.Plan_Item,"").toString().trim() == planItemId && wLnW.Material.toString() == matId.toString())
								{
									lnNote = ifnull(wLnW.Lot_Override_Note,"").toString().trim();
									if(lnNote.contains("PRINTED_PIECE"))
									{
										wMatId = matId.toString();
										wLotTxt = ifnull(wLnW.Lot,"").toString().trim();
										wLotJson = "";
										if(wLotTxt != "")
										{
											if(lotNumById.get(wLotTxt) == null)
											{
												lotNumById.put(wLotTxt,"");
												for each  lotRefP in Raw_Material_Lot[ID == wLotTxt.toLong()]
												{
													lotNumById.put(wLotTxt,ifnull(lotRefP.Lot_Number,"").toString().replaceAll("\"","'"));
												}
											}
											wLotJson = ",\"lotId\":\"" + wLotTxt + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(wLotTxt),"").toString() + "\"";
										}

										// Qty is in metres. We need pieceL in cm.
										wQtyM = ifnull(wLnW.Qty, 0);
										pieceL = (wQtyM * 100).toDecimal();
										pieceW = fabricWidthCm; // printed pieces are full width of the fabric

										if(remain > 0 && pieceW >= cutW && pieceL >= cutL)
										{
											perRow = (pieceW / cutW).floor();
											maxRows = (pieceL / cutL).floor();
											capacity = perRow * maxRows;
											sideW = pieceW - (perRow * cutW);

											avail = 1; // It's one piece
											fullPieces = (remain / capacity).floor();
											if(fullPieces > avail) { fullPieces = avail; }
											
											if(fullPieces > 0)
											{
												usedLen = maxRows * cutL;
												if(sideW > 0)
												{
													if(genJson != "") { genJson = genJson + ","; }
													genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideW + ",\"length\":" + usedLen + ",\"count\":" + fullPieces + ",\"origin\":\"side\"" + wLotJson + "}";
												}
												fullTail = pieceL - usedLen;
												if(fullTail > 0)
												{
													if(genJson != "") { genJson = genJson + ","; }
													genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + pieceW + ",\"length\":" + fullTail + ",\"count\":" + fullPieces + ",\"origin\":\"tail\"" + wLotJson + "}";
												}
												remain = remain - (fullPieces * capacity);
												avail = avail - fullPieces;
											}

											if(remain > 0 && avail > 0)
											{
												take = remain;
												partRows = (take / perRow).floor();
												lastRow = take - (partRows * perRow);
												rows = partRows;
												if(lastRow > 0) { rows = rows + 1; }
												lengthUsed = rows * cutL;

												if(partRows > 0 && sideW > 0)
												{
													if(genJson != "") { genJson = genJson + ","; }
													genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideW + ",\"length\":" + (partRows * cutL) + ",\"count\":1,\"origin\":\"side\"" + wLotJson + "}";
												}
												if(lastRow > 0)
												{
													partW = pieceW - (lastRow * cutW);
													if(partW > 0)
													{
														if(genJson != "") { genJson = genJson + ","; }
														genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partW + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"" + wLotJson + "}";
													}
												}
												tailL = pieceL - lengthUsed;
												if(tailL > 0)
												{
													if(genJson != "") { genJson = genJson + ","; }
													genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + pieceW + ",\"length\":" + tailL + ",\"count\":1,\"origin\":\"tail\"" + wLotJson + "}";
												}
												remain = 0;
											}
										}

										// NO fabrics ENTRY IS EMITTED HERE, and putting one back is a no-op.
										//
										// A synthetic entry keyed "<matId>-PRINT_<issueLineId>" used to be written
										// at this point to "clear the UI Loading state". It cleared nothing.
										//
										// The printed pieces' predicted waste is appended to the SAME genJson the
										// per-material entry at the bottom of this block emits, and that entry
										// carries the REAL material id - which is the only id the widget matches
										// on: production.js looks up exp-waste-<itemId>-<materialId>, built from
										// the requirement row's own material. A synthetic id matches no element,
										// so the entry only ever added a junk key to wasteLotsByMat carrying an
										// empty lot list.
										//
										// This pass runs INSIDE the cut-size and fabric-width guard, so anything
										// that reaches it also reaches that emit - including a plan item whose
										// only fabric is printed. Its requirement row IS the printed SKU, and the
										// printed SKU's Fabric_Width_Inches is copied from the plain one when it
										// is minted, so the guard passes and the real entry is emitted.
									}
								}
							}
						}

						//--------------------------------------------------
						// Pass 2 - whatever the waste could not cover came off
						// FRESH FABRIC, and that is cut ONE LOT AT A TIME.
						//
						// This is the same rule issueMaterials budgets by, applied
						// to the other end of the job. Each lot's cloth is a
						// separate roll: it gets its own side strip down its own
						// full rows, and its own part-filled last row. Treating the
						// fresh metres as one continuous block predicted ONE strip
						// of 50 rows where the truth is two strips of 30 and 20 -
						// different physical pieces, belonging to different lots -
						// and it under-predicted the waste whenever the pieces did
						// not divide evenly, because each lot has its own partial
						// row rather than the job having one.
						//
						// Lots are walked OLDEST FIRST, the order issueMaterials
						// spent them in, so the pieces are attributed to the same
						// cloth it charged them to.
						//--------------------------------------------------
						freshCm = 0.0;
						if(remain > 0)
						{
							perRowR = (fabricWidthCm / cutW).floor();
							if(perRowR > 0)
							{
								sideWR = fabricWidthCm - (perRowR * cutW);

								seqTxt = ifnull(lotSeqByMat.get(matId.toString()),"").toString();
								lotList = List();
								if(seqTxt != "")
								{
									lotList = seqTxt.toList("~");
								}
								else
								{
									// No lot on the handover - a pre-lot issue, or
									// fabric issued before any of this existed. One
									// nameless pass keeps the old behaviour exactly.
									lotList.add("");
								}

								for each  lotCut in lotList
								{
									if(remain > 0)
									{
										lotIdJson = "";
										if(lotCut != "")
										{
											// Same lazy resolve, cached for the call.
											if(lotNumById.get(lotCut) == null)
											{
												lotNumById.put(lotCut,"");

												for each  lotRefC in Raw_Material_Lot[ID == lotCut.toLong()]
												{
													lotNumById.put(lotCut,ifnull(lotRefC.Lot_Number,"").toString().replaceAll("\"","'"));
												}
											}

											lotIdJson = ",\"lotId\":\"" + lotCut + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(lotCut),"").toString() + "\"";
										}

										//----------------------------------------
										// STEP 4: ONE TAIL PER ROLL, NOT PER LOT.
										// rollSeqByKey has this lot's rolls in DRAIN
										// ORDER (the order Roll_Label recorded them,
										// which is the order the allocator used them)
										// - walk them the same way the lot loop above
										// walks lots, each roll getting its own side
										// strip and its own part-filled row, exactly
										// mirroring the lot-level logic this replaces
										// one level down.
										//
										// FALLS BACK TO LOT-ONLY when this lot has no
										// roll breakdown - a pre-Step-4 issue, or an
										// offcut-only lot with no fresh-cloth row to
										// carry a Roll_Label. One nameless pass keeps
										// the exact old behaviour for that lot.
										//----------------------------------------
										rollSeqTxt = "";
										if(lotCut != "")
										{
											rollSeqTxt = ifnull(rollSeqByKey.get(matId.toString() + "|" + lotCut),"").toString();
										}
										rollList = List();
										if(rollSeqTxt != "")
										{
											rollList = rollSeqTxt.toList("~");
										}
										else
										{
											rollList.add("");
										}

										for each  rollCut in rollList
										{
											if(remain > 0)
											{
												// How many pieces THIS ROLL's cloth
												// yields, off its own metres in whole
												// marker rows. Always a whole multiple
												// of perRow, so a roll never ends
												// mid-row - the part-filled row happens
												// once, on whichever roll the
												// requirement runs out on.
												pcsHere = remain;
												if(rollCut != "")
												{
													rqTxt = ifnull(rollQtyByKey.get(matId.toString() + "|" + lotCut + "|" + rollCut),"0").toString().trim();
													if(rqTxt == "")
													{
														rqTxt = "0";
													}
													rowsHere = ((rqTxt.toDecimal() * 100) / cutL).floor();
													pcsHere = perRowR * rowsHere;
													if(pcsHere > remain)
													{
														pcsHere = remain;
													}
												}
												else if(lotCut != "")
												{
													// No per-roll data for this lot -
													// same figure the pre-Step-4 code
													// used, off the lot's own total.
													lqTxt = ifnull(lotQtyByKey.get(matId.toString() + "|" + lotCut),"0").toString().trim();
													if(lqTxt == "")
													{
														lqTxt = "0";
													}
													rowsHere = ((lqTxt.toDecimal() * 100) / cutL).floor();
													pcsHere = perRowR * rowsHere;
													if(pcsHere > remain)
													{
														pcsHere = remain;
													}
												}

												if(pcsHere > 0)
												{
													rollJson = lotIdJson;
													if(rollCut != "")
													{
														rollJson = rollJson + ",\"rollLabel\":\"" + rollCut.replaceAll("\"","'") + "\"";
													}

													fullRowsR = (pcsHere / perRowR).floor();
													lastRowR = pcsHere - (fullRowsR * perRowR);
													rawRows = fullRowsR;
													if(lastRowR > 0)
													{
														rawRows = rawRows + 1;
													}
													freshCm = freshCm + (rawRows * cutL);

													if(fullRowsR > 0 && sideWR > 0)
													{
														if(genJson != "")
														{
															genJson = genJson + ",";
														}
														genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideWR + ",\"length\":" + (fullRowsR * cutL) + ",\"count\":1,\"origin\":\"side\"" + rollJson + "}";
													}
													if(lastRowR > 0)
													{
														partWR = fabricWidthCm - (lastRowR * cutW);
														if(partWR > 0)
														{
															if(genJson != "")
															{
																genJson = genJson + ",";
															}
															genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partWR + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"" + rollJson + "}";
														}
													}

													remain = remain - pcsHere;
												}
											}
										}
									}
								}

								//------------------------------------------
								// CLOTH THE HANDOVERS DO NOT ACCOUNT FOR.
								//
								// If he cut more pieces than the recorded lines
								// can explain - a pre-lot handover in the mix, or
								// cloth issued outside this item's lines - the
								// remainder still produced real waste, and
								// dropping it would under-predict the return.
								//
								// Predicted with NO LOT rather than charged to the
								// last one. Naming a lot here would be a guess
								// about tone, and a remnant later offered as the
								// wrong shade is the whole thing lots exist to
								// prevent. He can name it in the dialog.
								//------------------------------------------
								if(remain > 0)
								{
									fullRowsX = (remain / perRowR).floor();
									lastRowX = remain - (fullRowsX * perRowR);
									rawRowsX = fullRowsX;
									if(lastRowX > 0)
									{
										rawRowsX = rawRowsX + 1;
									}
									freshCm = freshCm + (rawRowsX * cutL);

									if(fullRowsX > 0 && sideWR > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideWR + ",\"length\":" + (fullRowsX * cutL) + ",\"count\":1,\"origin\":\"side\"}";
									}
									if(lastRowX > 0)
									{
										partWX = fabricWidthCm - (lastRowX * cutW);
										if(partWX > 0)
										{
											if(genJson != "")
											{
												genJson = genJson + ",";
											}
											genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partWX + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"}";
										}
									}

									remain = 0;
								}
							}
						}

						if(fabJson != "")
						{
							fabJson = fabJson + ",";
						}
						fabJson = fabJson + "{\"materialId\":\"" + matId + "\",\"material\":\"" + matLabel + "\",\"cutWidth\":" + cutW + ",\"cutLength\":" + cutL + ",\"fabricWidthCm\":" + fabricWidthCm + ",\"piecesCut\":" + rowPcsCut + ",\"freshMetres\":" + (freshCm / 100) + ",\"lots\":[" + ifnull(lotsByMat.get(matId.toString()),"").toString() + "],\"waste\":[" + genJson + "]}";
					}
				}
			}
		}
	}

	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"fabrics\":[],\"fabricOptions\":[]}";
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	return "{\"errors\":[" + errJson + "],\"fabrics\":[" + fabJson + "],\"fabricOptions\":[" + optJson + "]}";
}
