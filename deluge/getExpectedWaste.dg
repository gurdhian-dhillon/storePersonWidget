string getExpectedWaste(string planId, string planItemId, string qtyOut)
{
	// Remnants the cutting is expected to produce, for one item on one plan.
	//
	// Called when the supervisor ends the Cutting stage. The rows come back as
	// EDITABLE DEFAULTS - he keeps, changes, deletes or adds to them, and only what
	// he confirms is written by saveWasteFromCutting. Nothing here is stored.
	//
	// Computed on the pieces he actually cut (Qty_Out), against the fabric he was
	// actually given: the waste pieces he received first, then fresh cloth.
	//
	// The remnant maths is INLINED rather than calling calcCutPlan - cross-function
	// calls do not work in this app. calcCutPlan now has no caller and can be
	// deleted; this is the only place the generation half is used.
	//
	// Grain is fixed throughout: cut width runs across the piece width, cut length
	// along its length, never rotated.
	//
	// fabricOptions is order-wide, not item-wide, because a supervisor adding a
	// remnant by hand may be holding cloth from any fabric on the order - including
	// a full-width leftover, which he enters as a piece at the full fabric width.

	fabJson = "";
	optJson = "";
	errJson = "";

	// DEBUG WRAPPER: Creator reports every runtime failure as a generic
	// "code 9430 - There is an error while executing Custom API." Catching it
	// here surfaces the real Deluge message in the widget console instead.
	try
	{
	pid = planId.trim().toLong();

	// Creator fields that were never written are EMPTY, not null, and
	// toDecimal() throws on empty - normalise to string first.
	qStr = ifnull(qtyOut,"0").toString().trim();
	if(qStr == "")
	{
		qStr = "0";
	}
	pcsCut = qStr.toDecimal().toLong();

	seenOpt = Map();

	// Trimmed once. planItemId is compared raw further down; this is the same
	// value, normalised, for the lot lookup below.
	itemIdTxt = ifnull(planItemId,"").toString().trim();

	//----------------------------------------------------------------------
	// WHICH LOT THIS ITEM'S CLOTH CAME OFF, so the offcut can go back to it.
	//
	// The SAME derivation saveWasteFromCutting does, and it has to stay the same
	// or the dialog would show one answer and the save would write another. Read
	// via the supervisor rather than the plan: Material_Issue.Plan holds the
	// first plan a handover touched, so an issue spanning two plans would lose
	// the other plan's lines entirely. The line's own Plan_Item is exact.
	//
	// A material issued off TWO lots gets both, and the supervisor picks - only
	// he can know which roll a given remnant came off, and guessing would put a
	// tone on the piece that might be a lie.
	//----------------------------------------------------------------------
	lotsByMat = Map();
	lotSeqByMat = Map();
	lotQtyByKey = Map();
	lotNumById = Map();

	wSupId = 0;
	for each  wPlan in Production_Planning[ID == pid]
	{
		wSupId = ifnull(wPlan.Assigned_To,0);
	}

	if(wSupId != 0 && itemIdTxt != "")
	{
		// The prefetch of every Raw_Material_Lot ever created used to sit here.
		// Lots grow with every purchase and an emptied lot is never deleted, so
		// that was thirteen thousand rows on the cutting screen to print a
		// handful of lot numbers - and the statement-execution limit is NOT
		// catchable, so it would have killed the script with a bare HTTP 500
		// and no error card.
		//
		// lotNumById is now filled lazily at each of the three places that read
		// it, one indexed query per DISTINCT lot, cached for the whole call.

		// OLDEST HANDOVER FIRST - the same order issueMaterials spent them in, so
		// the metres are attributed to the same lots it charged them to.
		supIssuesW = Material_Issue[Issued_To == wSupId] sort by Added_Time;

		for each  wIssW in supIssuesW
		{
			for each  wLnW in wIssW.Issue_Lines
			{
				if(ifnull(wLnW.Plan_Item,"").toString().trim() == itemIdTxt)
				{
					lnMatW = ifnull(wLnW.Material,"").toString().trim();
					lnLotW = ifnull(wLnW.Lot,"").toString().trim();

					lnqW = ifnull(wLnW.Qty,"0").toString().trim();
					if(lnqW == "")
					{
						lnqW = "0";
					}

					if(lnMatW != "" && lnLotW != "" && lnqW.toDecimal() > 0)
					{
						qKeyW = lnMatW + "|" + lnLotW;

						// Two handovers off the SAME roll are one lot with more
						// metres, not two choices. Summed rather than listed twice.
						prevQW = ifnull(lotQtyByKey.get(qKeyW),"0").toString().trim();
						if(prevQW == "")
						{
							prevQW = "0";
						}

						if(prevQW.toDecimal() == 0)
						{
							seqW = ifnull(lotSeqByMat.get(lnMatW),"").toString();
							if(seqW != "")
							{
								seqW = seqW + "~";
							}
							lotSeqByMat.put(lnMatW,seqW + lnLotW);

							// Resolved once per distinct lot, then cached. The
							// miss is cached too, so an unreadable lot is not
							// re-queried by every handover that names it.
							if(lotNumById.get(lnLotW) == null)
							{
								lotNumById.put(lnLotW,"");

								for each  lotRefW in Raw_Material_Lot[ID == lnLotW.toLong()]
								{
									lotNumById.put(lnLotW,ifnull(lotRefW.Lot_Number,"").toString().replaceAll("\"","'"));
								}
							}

							haveW = ifnull(lotsByMat.get(lnMatW),"").toString();
							if(haveW != "")
							{
								haveW = haveW + ",";
							}
							lotsByMat.put(lnMatW,haveW + "{\"lotId\":\"" + lnLotW + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(lnLotW),"").toString() + "\"}");
						}

						lotQtyByKey.put(qKeyW,prevQW.toDecimal() + lnqW.toDecimal());
					}
				}
			}
		}
	}

	for each  plan in Production_Planning[ID == pid]
	{
		for each  mr in Material_Requirement[Plan == plan.ID]
		{
			isFab = mr.Is_Fabric;
			matId = mr.Material;

			if(isFab == true && matId != null)
			{
				// Every fabric is called "Linen Fabric", so the name alone tells
				// the supervisor nothing. The SKU is what actually distinguishes
				// them - design and colour can join it later.
				skuText = "";
				for each  rmL in Raw_Material[ID == matId]
				{
					skuText = ifnull(rmL.SKU,"").toString();
				}
				matLabel = mr.Material_Name;
				if(skuText != "")
				{
					matLabel = skuText + " - " + mr.Material_Name;
				}

				// Order-wide picker list, built from every fabric on the plan.
				if(seenOpt.get(matId + "") == null)
				{
					seenOpt.put(matId + "","1");
					if(optJson != "")
					{
						optJson = optJson + ",";
					}
					// IDs forced to string - 18-digit ids break JSON.parse.
					optJson = optJson + "{\"materialId\":\"" + matId + "\",\"material\":\"" + matLabel + "\"}";
				}

				// Only this item's fabric lines get a prediction.
				if(mr.Plan_Item != null && mr.Plan_Item.toString() == planItemId && pcsCut > 0)
				{
					cutW = ifnull(mr.Cut_Size_Width,0);
					cutL = ifnull(mr.Cut_Size_Length,0);

					fabricWidthCm = 0.0;
					for each  rm in Raw_Material[ID == matId]
					{
						// Stored as TEXT, in inches.
						val = rm.Fabric_Width_Inches;
						if(val != null && val.trim() != "")
						{
							fabricWidthCm = val.trim().toDecimal() * 2.54;
						}
					}

					if(cutW <= 0 || cutL <= 0 || fabricWidthCm <= 0)
					{
						if(errJson != "")
						{
							errJson = errJson + ",";
						}
						errJson = errJson + "\"" + mr.Material_Name + ": missing cut size or fabric width, nothing predicted\"";
					}
					else
					{
						genJson = "";
						remain = pcsCut;

						//--------------------------------------------------
						// Pass 1 - the waste pieces he actually received.
						// A piece leaves the store whole, so whatever it does
						// not yield comes back as waste, including its tail.
						//--------------------------------------------------
						// STEP 4b: Issued movements, not the Waste_Issued subform.
						// Hoisted into its own variable - a query cannot be built
						// inline in a for-each header.
						issuedMoves = Waste_Movement[Plan == plan.ID && Movement_Type == "Issued"];

						for each  wi in issuedMoves
						{
							// "Received" is no longer a field. It is the sum of the
							// Received movements pointing back at this issue, which
							// is what makes a short receipt legible instead of just
							// a smaller number.
							avail = 0;
							for each  rv in Waste_Movement[Parent_Movement == wi.ID && Movement_Type == "Received"]
							{
								avail = avail + ifnull(rv.Piece_Count,0);
							}

							// The movement carries the piece, not the material - the
							// material comes off the piece it was cut from.
							wMatId = "";
							// The remnant of a remnant belongs to the SAME lot the
							// original piece was cut from - the cloth never changed
							// tone, it only got smaller.
							wLotJson = "";
							for each  wmRec in Waste_Master[ID == wi.Waste_Piece]
							{
								wMatId = ifnull(wmRec.SKU,"").toString();
								wLotTxt = ifnull(wmRec.Lot,"").toString().trim();
								if(wLotTxt != "")
								{
									// Same lazy resolve as above, cached for the call.
									if(lotNumById.get(wLotTxt) == null)
									{
										lotNumById.put(wLotTxt,"");

										for each  lotRefP in Raw_Material_Lot[ID == wLotTxt.toLong()]
										{
											lotNumById.put(wLotTxt,ifnull(lotRefP.Lot_Number,"").toString().replaceAll("\"","'"));
										}
									}

									wLotJson = ",\"lotId\":\"" + wLotTxt + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(wLotTxt),"").toString() + "\"";
								}
							}

							pieceW = ifnull(wi.Piece_Width,0);
							pieceL = ifnull(wi.Piece_Length,0);

							if(remain > 0 && avail > 0 && wMatId == matId.toString() && wi.Plan_Item != null && wi.Plan_Item.toString() == planItemId && pieceW >= cutW && pieceL >= cutL)
							{
								perRow = (pieceW / cutW).floor();
								maxRows = (pieceL / cutL).floor();
								capacity = perRow * maxRows;
								sideW = pieceW - (perRow * cutW);

								// Pieces spent to their full capacity - each
								// yields the same two remnants, so they collapse
								// into one row carrying a count.
								fullPieces = (remain / capacity).floor();
								if(fullPieces > avail)
								{
									fullPieces = avail;
								}
								if(fullPieces > 0)
								{
									usedLen = maxRows * cutL;
									if(sideW > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideW + ",\"length\":" + usedLen + ",\"count\":" + fullPieces + ",\"origin\":\"side\"" + wLotJson + "}";
									}
									fullTail = pieceL - usedLen;
									if(fullTail > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + pieceW + ",\"length\":" + fullTail + ",\"count\":" + fullPieces + ",\"origin\":\"tail\"" + wLotJson + "}";
									}
									remain = remain - (fullPieces * capacity);
									avail = avail - fullPieces;
								}

								// At most one part-used piece for the remainder.
								if(remain > 0 && avail > 0)
								{
									take = remain;
									partRows = (take / perRow).floor();
									lastRow = take - (partRows * perRow);
									rows = partRows;
									if(lastRow > 0)
									{
										rows = rows + 1;
									}
									lengthUsed = rows * cutL;

									// Side strip - one continuous piece down the
									// full rows, not one per row.
									if(partRows > 0 && sideW > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideW + ",\"length\":" + (partRows * cutL) + ",\"count\":1,\"origin\":\"side\"}";
									}
									// Partial last row - the unused slots and the
									// side strip in that row are contiguous, so
									// it is a single piece.
									if(lastRow > 0)
									{
										partW = pieceW - (lastRow * cutW);
										if(partW > 0)
										{
											if(genJson != "")
											{
												genJson = genJson + ",";
											}
											genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partW + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"}";
										}
									}
									tailL = pieceL - lengthUsed;
									if(tailL > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + pieceW + ",\"length\":" + tailL + ",\"count\":1,\"origin\":\"tail\"}";
									}
									remain = 0;
								}
							}
						}

						//--------------------------------------------------
						// Pass 2 - whatever the waste could not cover came off
						// FRESH FABRIC, and that is cut ONE LOT AT A TIME.
						//
						// This is the same rule issueMaterials budgets by, applied
						// to the other end of the job. Each lot's cloth is a
						// separate roll: it gets its own side strip down its own
						// full rows, and its own part-filled last row. Treating the
						// fresh metres as one continuous block predicted ONE strip
						// of 50 rows where the truth is two strips of 30 and 20 -
						// different physical pieces, belonging to different lots -
						// and it under-predicted the waste whenever the pieces did
						// not divide evenly, because each lot has its own partial
						// row rather than the job having one.
						//
						// Lots are walked OLDEST FIRST, the order issueMaterials
						// spent them in, so the pieces are attributed to the same
						// cloth it charged them to.
						//--------------------------------------------------
						freshCm = 0.0;
						if(remain > 0)
						{
							perRowR = (fabricWidthCm / cutW).floor();
							if(perRowR > 0)
							{
								sideWR = fabricWidthCm - (perRowR * cutW);

								seqTxt = ifnull(lotSeqByMat.get(matId.toString()),"").toString();
								lotList = List();
								if(seqTxt != "")
								{
									lotList = seqTxt.toList("~");
								}
								else
								{
									// No lot on the handover - a pre-lot issue, or
									// fabric issued before any of this existed. One
									// nameless pass keeps the old behaviour exactly.
									lotList.add("");
								}

								for each  lotCut in lotList
								{
									if(remain > 0)
									{
										// How many pieces THIS lot's cloth yields,
										// off its own metres in whole marker rows.
										//
										// Always a whole multiple of perRow, so a lot
										// never ends mid-row: he cuts full rows off
										// that roll and moves to the next. The
										// part-filled row happens once, on whichever
										// lot the requirement runs out on.
										pcsHere = remain;
										if(lotCut != "")
										{
											lqTxt = ifnull(lotQtyByKey.get(matId.toString() + "|" + lotCut),"0").toString().trim();
											if(lqTxt == "")
											{
												lqTxt = "0";
											}
											rowsHere = ((lqTxt.toDecimal() * 100) / cutL).floor();
											pcsHere = perRowR * rowsHere;
											if(pcsHere > remain)
											{
												pcsHere = remain;
											}
										}

										if(pcsHere > 0)
										{
											lotIdJson = "";
											if(lotCut != "")
											{
												// Same lazy resolve, cached for the call.
												if(lotNumById.get(lotCut) == null)
												{
													lotNumById.put(lotCut,"");

													for each  lotRefC in Raw_Material_Lot[ID == lotCut.toLong()]
													{
														lotNumById.put(lotCut,ifnull(lotRefC.Lot_Number,"").toString().replaceAll("\"","'"));
													}
												}

												lotIdJson = ",\"lotId\":\"" + lotCut + "\",\"lotNumber\":\"" + ifnull(lotNumById.get(lotCut),"").toString() + "\"";
											}

											fullRowsR = (pcsHere / perRowR).floor();
											lastRowR = pcsHere - (fullRowsR * perRowR);
											rawRows = fullRowsR;
											if(lastRowR > 0)
											{
												rawRows = rawRows + 1;
											}
											freshCm = freshCm + (rawRows * cutL);

											if(fullRowsR > 0 && sideWR > 0)
											{
												if(genJson != "")
												{
													genJson = genJson + ",";
												}
												genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideWR + ",\"length\":" + (fullRowsR * cutL) + ",\"count\":1,\"origin\":\"side\"" + lotIdJson + "}";
											}
											if(lastRowR > 0)
											{
												partWR = fabricWidthCm - (lastRowR * cutW);
												if(partWR > 0)
												{
													if(genJson != "")
													{
														genJson = genJson + ",";
													}
													genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partWR + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"" + lotIdJson + "}";
												}
											}

											remain = remain - pcsHere;
										}
									}
								}

								//------------------------------------------
								// CLOTH THE HANDOVERS DO NOT ACCOUNT FOR.
								//
								// If he cut more pieces than the recorded lines
								// can explain - a pre-lot handover in the mix, or
								// cloth issued outside this item's lines - the
								// remainder still produced real waste, and
								// dropping it would under-predict the return.
								//
								// Predicted with NO LOT rather than charged to the
								// last one. Naming a lot here would be a guess
								// about tone, and a remnant later offered as the
								// wrong shade is the whole thing lots exist to
								// prevent. He can name it in the dialog.
								//------------------------------------------
								if(remain > 0)
								{
									fullRowsX = (remain / perRowR).floor();
									lastRowX = remain - (fullRowsX * perRowR);
									rawRowsX = fullRowsX;
									if(lastRowX > 0)
									{
										rawRowsX = rawRowsX + 1;
									}
									freshCm = freshCm + (rawRowsX * cutL);

									if(fullRowsX > 0 && sideWR > 0)
									{
										if(genJson != "")
										{
											genJson = genJson + ",";
										}
										genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + sideWR + ",\"length\":" + (fullRowsX * cutL) + ",\"count\":1,\"origin\":\"side\"}";
									}
									if(lastRowX > 0)
									{
										partWX = fabricWidthCm - (lastRowX * cutW);
										if(partWX > 0)
										{
											if(genJson != "")
											{
												genJson = genJson + ",";
											}
											genJson = genJson + "{\"materialId\":\"" + matId + "\",\"width\":" + partWX + ",\"length\":" + cutL + ",\"count\":1,\"origin\":\"partial_row\"}";
										}
									}

									remain = 0;
								}
							}
						}

						if(fabJson != "")
						{
							fabJson = fabJson + ",";
						}
						fabJson = fabJson + "{\"materialId\":\"" + matId + "\",\"material\":\"" + matLabel + "\",\"cutWidth\":" + cutW + ",\"cutLength\":" + cutL + ",\"fabricWidthCm\":" + fabricWidthCm + ",\"piecesCut\":" + pcsCut + ",\"freshMetres\":" + (freshCm / 100) + ",\"lots\":[" + ifnull(lotsByMat.get(matId.toString()),"").toString() + "],\"waste\":[" + genJson + "]}";
					}
				}
			}
		}
	}

	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"fabrics\":[],\"fabricOptions\":[]}";
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	return "{\"errors\":[" + errJson + "],\"fabrics\":[" + fabJson + "],\"fabricOptions\":[" + optJson + "]}";
}
