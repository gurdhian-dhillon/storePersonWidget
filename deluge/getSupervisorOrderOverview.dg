string getSupervisorOrderOverview(string supervisorId)
{
	// The supervisor's open orders, for the "Order Overview" tab - one row per
	// order so he can decide which to produce next. POST, one argument.
	//
	// PLANS ONLY. Everything this row needs is snapshotted onto
	// Production_Planning at plan creation (createPlanForOneOrder /
	// createProductionPlans):
	//   Sales_Order_No        - the SO number as text
	//   Customer_Person_Name  - the contact person
	//   Plan_End_Date         - the order's Expected_Delivery_Date
	//   Order_Status          - the PLAN's status (Pending / Material Ready /
	//                           Partially Received / In Progress) - this is the
	//                           one the supervisor's decision turns on, and it
	//                           is live on the plan so it is never a stale copy
	//   Order_Source, Priority_Key - already on the plan
	// So this is ONE Production_Planning query and nothing else - no per-plan
	// Sales_Order lookup for ~100 open plans, and no Plan_Item scan (itemCount
	// is a .count() which reads no rows).
	//
	// The 4-status "open" set is the SUPERVISOR set (includes "Material Ready"),
	// same as getProductionWidgetData / getSupervisorMaterials - not the
	// 3-status store-issue set.
	//
	// Sorted by Priority_Key so the order is stable; the widget re-sorts
	// client-side (delivery date / customer / status) since it holds the whole
	// list.

	ordersJson = "";

	// Same debug wrapper as the other functions - Creator collapses every
	// runtime failure into a generic "code 9430", so catch the real message.
	try
	{
		supTxt = ifnull(supervisorId,"").toString().trim();
		if(supTxt == "" || supTxt.isNumber() == false)
		{
			// No supervisor picked is not an error - the widget guards it too,
			// and an empty list is the right answer.
			return "{\"errors\":[],\"orders\":[]}";
		}
		supId = supTxt.toLong();

		// sort by on its own assignment, never inline in a for-each header.
		openPlans = Production_Planning[Assigned_To == supId && (Order_Status == "Pending" || Order_Status == "Material Ready" || Order_Status == "Partially Received" || Order_Status == "In Progress")] sort by Priority_Key;

		for each  plan in openPlans
		{
			// A Date field never written is NULL - toString("...") on null
			// throws, so it is guarded rather than ifnull'd. A plan created
			// before this snapshot existed, or whose order had no delivery
			// date, legitimately has none - the widget sorts those last.
			delivTxt = "";
			if(plan.Plan_End_Date != null)
			{
				delivTxt = plan.Plan_End_Date.toString("dd-MMM-yyyy");
			}

			// Free text - flatten for hand-built JSON (the whole chain, not just
			// the quote - a raw newline is invalid JSON and fails silently).
			custPerson = ifnull(plan.Customer_Person_Name,"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");

			// Sales_Order_No is the snapshot text. Fall back to the lookup only
			// if the snapshot is empty (a plan that predates this change) - one
			// point lookup, and only for those.
			soNo = ifnull(plan.Sales_Order_No,"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");
			if(soNo == "" && plan.Sales_Order != null)
			{
				for each  soFb in Sales_Order[ID == plan.Sales_Order]
				{
					soNo = ifnull(soFb.Sales_Order,"").toString().replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");
				}
			}

			// The PLAN's status, spaces, printed straight to the screen (widget
			// maps it to a pill).
			ordStatus = ifnull(plan.Order_Status,"").toString();
			ordSource = ifnull(plan.Order_Source,"").toString();

			// ORIGINAL LINE COUNT - the order's own items, not counting the
			// remake / alteration batches spun off at check time. Two COUNTs,
			// both read no rows:
			//   total   - every Plan_Item on the plan
			//   remakes - Is_Remake == true. Safe as a criteria BECAUSE
			//             saveItemCheck always writes Is_Remake = true on a
			//             remake explicitly. It is the ORIGINALS that read
			//             EMPTY (not false) on pre-field-era plans, so
			//             "Is_Remake == false" would silently drop them - which
			//             is why this subtracts the remakes instead of counting
			//             the originals directly.
			totalItemCount = Plan_Item[Plan == plan.ID].count();
			remakeItemCount = Plan_Item[Plan == plan.ID && Is_Remake == true].count();
			itemCount = totalItemCount - remakeItemCount;
			if(itemCount < 0)
			{
				itemCount = 0;
			}

			// Priority_Key can be empty on a plan created before backfillPriorityKey
			// ran. Normalise to a big number so it sorts LAST rather than throwing.
			pkS = ifnull(plan.Priority_Key,"").toString().trim();
			if(pkS == "" || pkS.isNumber() == false)
			{
				pkS = "999999999";
			}

			if(ordersJson != "")
			{
				ordersJson = ordersJson + ",";
			}
			// IDs forced to string - 18-digit ids break JSON.parse otherwise.
			ordersJson = ordersJson + "{\"planId\":\"" + plan.ID + "\",\"planNo\":\"" + ifnull(plan.Plan_No,"").toString() + "\",\"salesOrder\":\"" + soNo + "\",\"customerPerson\":\"" + custPerson + "\",\"deliveryDate\":\"" + delivTxt + "\",\"orderStatus\":\"" + ordStatus + "\",\"orderSource\":\"" + ordSource + "\",\"priorityKey\":" + pkS.toLong() + ",\"itemCount\":" + itemCount + "}";
		}
	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"orders\":[]}";
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	return "{\"errors\":[],\"orders\":[" + ordersJson + "]}";
}
