string raiseReissueRequest(string payloadJson)
{
	// The one thing on the Reissue tab that creates real demand. Everything else
	// there is a draft; this is what puts material on the store's issue screen.
	//
	// Custom API, POST, one argument: payloadJson. TWO SHAPES, one per card kind:
	//
	//   damage  { "planItemId":"9", "supervisorId":"5",
	//             "lines":[ {"damageId":"31","lineId":"77"} ] }
	//   remake  { "planItemId":"9", "supervisorId":"5", "kind":"remake" }
	//
	// An absent "kind" means damage - every call made before the remake card
	// existed was one, and the widget still sends none for those.
	//
	// WHY BOTH LIVE HERE rather than in a second function. They differ only in
	// where the numbers come from; everything after the insert is identical, and
	// it is the part that is easy to get wrong - Assigned_To off the plan, the
	// plan pulled out of "Material Ready", the sales order pulled back from
	// "Production Complete". Split in two, one copy quietly loses a step and a
	// requirement nobody can see is worse than no requirement at all, because the
	// supervisor is standing there waiting on it. A second function would also
	// need its own Custom API wrapper in Creator; this needs none - the argument
	// list does not change.
	//
	// THE REMAKE SHAPE PICKS NOTHING, and that is deliberate. A garment being made
	// again needs its whole BOM; there is no per-material decision to make, so
	// there are no ticks and the card is raised whole. The damage shape has ticks
	// because "3 were ruined but I have spares" is a real answer.
	//
	// THE REMAKE SHAPE COVERS BOTH KINDS OF BATCH - Check_Reject, opened by
	// saveItemCheck when the checker rejects garments, and Production_Loss, opened
	// by coverProductionLoss when a stage produces fewer pieces than it received.
	// They need identical treatment and differ only in the Source they write and
	// the why they carry.
	//
	// ONE ROW PER LINE, NEVER SUMMED. He ruined 1.2m on Monday and 0.8m on
	// Wednesday; the store sees two rows, each carrying its own date and its own
	// reason. A single 2.0m row would be fewer rows to work through and would
	// trace back to no particular incident - and tracing back to the incident is
	// the entire reason this feature exists.
	//
	// THE QUANTITIES ARE NOT TAKEN FROM THE PAYLOAD. The widget says WHICH lines
	// to raise; the amounts are read back off Material_Damage. He already decided
	// the numbers when he reported the damage, and re-sending them would let a
	// stale tab - one left open while he edited the report elsewhere - quietly
	// request the old figures.
	//
	// ADDITIVE, NEVER AN EDIT. A reissue is a NEW requirement row, not a bump to
	// the original one. The original stays exactly as it was - issued, received,
	// settled, with its Pieces_From_Raw and Pieces_From_Waste intact - and those
	// counters are what every "anything that re-opens a requirement must wind
	// back every counter" rule is about. Touching them would put this function
	// into that whole class of bug for no gain.
	//
	// FIELDS THIS NEEDS ADDING to Material_Requirement:
	//   Source        Dropdown - Plan / Reissue / Check_Remake /
	//                            Production_Remake / Alteration   (default Plan)
	//   Damage_Ref    Lookup   -> Material_Damage
	//   Reason        Multi Line
	//   Reported_On   Date
	// Source defaulting to Plan is what keeps every existing row correct without
	// touching one of them: an empty field genuinely means "came from the
	// original plan", which every existing row did.

	res = "{\"success\":false,\"error\":\"Nothing was raised\"}";
	madeCount = 0;
	logLines = list();

	try
	{
	inp = payloadJson.toMap();

	itemIdTxt = ifnull(inp.get("planItemId"),"").toString().trim();
	if(itemIdTxt == "" || itemIdTxt.isNumber() == false)
	{
		return "{\"success\":false,\"error\":\"Missing or non-numeric planItemId\"}";
	}
	itemId = itemIdTxt.toLong();

	// Absent means damage - see the header. Normalised once, here, so every test
	// below compares the same two words.
	kindTxt = ifnull(inp.get("kind"),"").toString().trim();
	if(kindTxt == "")
	{
		kindTxt = "damage";
	}
	if(kindTxt != "damage" && kindTxt != "remake")
	{
		return "{\"success\":false,\"error\":\"'" + kindTxt.replaceAll("\"","'") + "' is not a kind of request\"}";
	}

	// The damage records to look through, and the exact subform rows wanted out
	// of them. Keyed as text so ids compare like with like - a mixed-type
	// comparison throws rather than returning false.
	//
	// Left EMPTY on the remake path, which is what makes the damage loop further
	// down a no-op there rather than something that has to be branched around.
	wantLine = Map();
	dmgIds = List();

	if(kindTxt == "damage")
	{
		picked = ifnull(inp.get("lines"),list());
		// size() is right - picked is a List, not a query result.
		if(picked.size() == 0)
		{
			return "{\"success\":false,\"error\":\"No lines were selected\"}";
		}

		for each  pRaw in picked
		{
			pm = pRaw.toMap();
			dIdTxt = ifnull(pm.get("damageId"),"").toString().trim();
			lIdTxt = ifnull(pm.get("lineId"),"").toString().trim();
			if(dIdTxt != "" && lIdTxt != "")
			{
				wantLine.put(lIdTxt,"1");
				if(dmgIds.contains(dIdTxt) == false)
				{
					dmgIds.add(dIdTxt);
				}
			}
		}

		if(dmgIds.size() == 0)
		{
			return "{\"success\":false,\"error\":\"Selected lines carried no ids\"}";
		}
	}

	//----------------------------------------------------------------------
	// The plan and its supervisor. Assigned_To on a requirement is the store's
	// filter, so a row without it is invisible on their screen - it comes off
	// the plan rather than the payload for the same reason the quantities do.
	//----------------------------------------------------------------------
	//
	// The remake path also needs the batch itself - what it is, how many, and
	// what BOM to cost it from - so all of it comes off this one read rather
	// than a second query per field.
	planId = 0;
	itemName = "";
	remakeReason = "";
	itemStatusNow = "";
	bomKey = "";
	qtyOrdS = "0";
	checkRefId = null;

	for each  pi in Plan_Item[ID == itemId]
	{
		itemName = ifnull(pi.Item_Name,"").toString();
		if(pi.Plan != null)
		{
			planId = pi.Plan;
		}
		remakeReason = ifnull(pi.Remake_Reason,"").toString().trim();
		itemStatusNow = ifnull(pi.Item_Status,"").toString().trim();
		if(pi.BOM != null)
		{
			bomKey = pi.BOM.toString();
		}
		// A Creator numeric that was never written is an EMPTY STRING, not
		// null, and toDecimal() throws on it.
		qtyOrdS = ifnull(pi.Qty_Ordered,"0").toString().trim();
		if(qtyOrdS == "")
		{
			qtyOrdS = "0";
		}
		checkRefId = pi.Check_Ref;
	}

	if(planId == 0)
	{
		return "{\"success\":false,\"error\":\"Item " + itemId + " has no plan\"}";
	}

	planSup = null;
	planStatus = "";
	for each  plR in Production_Planning[ID == planId]
	{
		planSup = plR.Assigned_To;
		planStatus = ifnull(plR.Order_Status,"").toString();
	}

	//----------------------------------------------------------------------
	// THE REMAKE PATH. The checker rejected garments, saveItemCheck opened a
	// batch for them and deliberately asked the store for nothing; this is the
	// supervisor saying he wants the cloth now.
	//
	// THE MATERIAL IS REBUILT FROM THE BATCH'S OWN BOM, not sent by the widget.
	// Same shared function createProductionPlans uses, so the remake is costed by
	// exactly the same arithmetic as the original - fabric width, cut size, whole
	// marker rows - and what the tab showed him cannot disagree with what gets
	// written, because both asked this function the same question. A second copy
	// of that maths would drift, and the drift would be silent until the store
	// came up short.
	//
	// THE EXISTING REQUIREMENT ROWS ARE THE ONLY GUARD against raising twice, and
	// they are enough: there is no draft record to mark, so there is no flag to
	// go out of step with them. Filtered on Source so a reissue raised against
	// this same batch from a damage report cannot make it look already asked for.
	//----------------------------------------------------------------------
	if(kindTxt == "remake")
	{
		// Remake_Reason IS the whole test. Is_Remake is deliberately not consulted:
		// the two functions that write a reason - saveItemCheck and
		// coverProductionLoss - both set Is_Remake beside it, so the flag adds
		// nothing; and a Creator field that was never written reads EMPTY rather
		// than false, which makes "== false" a mixed-type comparison, and those
		// THROW rather than returning false.
		//
		// TWO REASONS TAKE THIS PATH, and they need the same thing: the batch's
		// whole BOM, all or nothing, costed by the same arithmetic as the
		// original. Check_Reject is the checker rejecting garments that were
		// made; Production_Loss is coverProductionLoss replacing garments a stage
		// never produced. What differs is the why on the row and the Source, and
		// the Source matters - it is what the draft test reads back.
		if(remakeReason != "Check_Reject" && remakeReason != "Production_Loss")
		{
			return "{\"success\":false,\"error\":\"" + itemName.replaceAll("\"","'") + " is not a remake batch\"}";
		}

		isLossBatch = false;
		remakeSrc = "Check_Remake";

		if(remakeReason == "Production_Loss")
		{
			isLossBatch = true;
			remakeSrc = "Production_Remake";
		}

		// count(), not size() - this is a query result, not a List.
		//
		// A LOSS BATCH TESTS FOR ANY REQUIREMENT AT ALL, not just its own Source.
		// A damage report on the same event points its replacement cloth at this
		// batch through Material_Damage.Remake_Item and writes rows of Source
		// "Reissue" against it; asking only about "Production_Remake" would issue
		// the full BOM on top of those and the store would be asked twice for one
		// loss. getReissueDrafts applies the identical test, and the two must keep
		// agreeing or the tab and the button disagree about whether there is work.
		alreadyAsked = false;

		if(isLossBatch == true)
		{
			if(Material_Requirement[Plan_Item == itemId].count() > 0)
			{
				alreadyAsked = true;
			}
		}
		else if(Material_Requirement[Plan_Item == itemId && Source == "Check_Remake"].count() > 0)
		{
			alreadyAsked = true;
		}

		if(alreadyAsked == true)
		{
			return "{\"success\":false,\"error\":\"The store has already been asked for " + itemName.replaceAll("\"","'") + ". It is on their issue screen.\"}";
		}

		if(bomKey == "")
		{
			return "{\"success\":false,\"error\":\"" + itemName.replaceAll("\"","'") + " has no BOM, so there is nothing to cost the material from\"}";
		}

		//------------------------------------------------------------------
		// The one-line why that travels onto every row, so the store can see it
		// on their own screen without opening anything. Same three-part shape
		// the damage path builds - date, where, what happened.
		//------------------------------------------------------------------
		whyRemakeTxt = "Rejected at checking";
		chkDateVal = null;

		//------------------------------------------------------------------
		// A LOSS BATCH HAS NO CHECK TO QUOTE. Its why comes off the stages that
		// let the pieces go, which is what the store wants to see on their own
		// screen - "we are cutting this again because Stitching lost 2" reads as
		// an account of something, where a bare "reissue" reads as an error.
		//------------------------------------------------------------------
		if(isLossBatch == true)
		{
			whyRemakeTxt = "Lost in production, remake";
			lossWhereTxt = "";
			lossRootId = 0;

			for each  lrIt in Plan_Item[ID == itemId]
			{
				if(lrIt.Remake_Of != null)
				{
					lossRootId = lrIt.Remake_Of;
				}
			}

			if(lossRootId != 0)
			{
				for each  lgW in Stage_Log[Plan_Item == lossRootId && Stage_Status == "Done"]
				{
					// A Creator numeric never written is an EMPTY STRING, not
					// null, and toDecimal() throws on it.
					wiS = ifnull(lgW.Qty_In,"0").toString().trim();
					if(wiS == "")
					{
						wiS = "0";
					}
					woS = ifnull(lgW.Qty_Out,"0").toString().trim();
					if(woS == "")
					{
						woS = "0";
					}

					wGap = wiS.toDecimal().toLong() - woS.toDecimal().toLong();

					if(wGap > 0)
					{
						if(lossWhereTxt != "")
						{
							lossWhereTxt = lossWhereTxt + ", ";
						}
						lossWhereTxt = lossWhereTxt + ifnull(lgW.Phase_Name,"").toString() + " " + wGap;
					}
				}
			}

			if(lossWhereTxt != "")
			{
				whyRemakeTxt = "Lost in production - " + lossWhereTxt + ", remake";
			}
		}
		else if(checkRefId != null)
		{
			for each  icQ in Item_Check[ID == checkRefId]
			{
				cDt = ifnull(icQ.Check_Date,"").toString().trim();
				rNo = ifnull(icQ.Round,"").toString().trim();

				// Held only when there is really a date. A Creator field that was
				// never written is EMPTY, not null, so the null test below would
				// pass an empty string straight into a Date field.
				if(cDt != "")
				{
					chkDateVal = icQ.Check_Date;
				}

				whyRemakeTxt = "Checking - rejected, remake";
				if(rNo != "")
				{
					whyRemakeTxt = "Checking - rejected in round " + rNo + ", remake";
				}
				if(cDt != "")
				{
					whyRemakeTxt = cDt + " - " + whyRemakeTxt;
				}
			}
		}

		matsTxt = thisapp.buildItemRequirements(bomKey,qtyOrdS,remakeSrc + " of " + itemName + " (item " + itemId + ")");
		matsList = matsTxt.toJSONList();

		for each  mRaw in matsList
		{
			mm = mRaw.toMap();

			newRmId = insert into Material_Requirement
			[
				Plan=planId
				Plan_Item=itemId
				Material_Name=mm.get("name")
				Is_Fabric=mm.get("isFab")
				Unit=mm.get("unit")
				Required_Qty=mm.get("req")
				Issued_Qty=0
				Received_Qty=0
				Cut_Size_Length=mm.get("cutLen")
				Cut_Size_Width=mm.get("cutWid")
				Required_Pieces=mm.get("pcs")
				Pieces_From_Waste=0
				Pieces_From_Raw=0
				Source=remakeSrc
				Reason=whyRemakeTxt
				Added_User=zoho.loginuser
			];

			rmReqId = newRmId.toLong();

			// Lookups after the insert - a null one fails the WHOLE block.
			//
			// Check_Ref is what the consumption report follows to answer "why was
			// there extra cloth on this order"; Source alone says a remake, this
			// says which check caused it.
			for each  rmq in Material_Requirement[ID == rmReqId]
			{
				rmq.Material = mm.get("mat").toString().toLong();
				if(checkRefId != null)
				{
					rmq.Check_Ref = checkRefId;
				}
				if(chkDateVal != null)
				{
					rmq.Reported_On = chkDateVal;
				}
				if(planSup != null)
				{
					rmq.Assigned_To = planSup;
				}
			}

			madeCount = madeCount + 1;
			logLines.add(remakeSrc + " -> " + ifnull(mm.get("name"),"").toString() + " | qty " + ifnull(mm.get("req"),0) + " | pieces " + ifnull(mm.get("pcs"),0));
		}

		//------------------------------------------------------------------
		// It owes material again. The batch is already Awaiting_Material on
		// every route the tab offers - this is here for a call that came from
		// anywhere else, because a Custom API is callable from anywhere. Only
		// ever moved BACKWARDS from Ready, never from a batch already in
		// production: denying work that has started is worse than a status that
		// reads slightly ahead of itself.
		//------------------------------------------------------------------
		if(madeCount > 0 && itemStatusNow == "Ready_For_Production")
		{
			for each  tgtR in Plan_Item[ID == itemId]
			{
				tgtR.Item_Status = "Awaiting_Material";
			}
		}
	}

	//----------------------------------------------------------------------
	// THE DAMAGE PATH. One pass. Each picked line becomes its own requirement,
	// and is marked the moment that requirement exists - so a failure part-way
	// through leaves the lines it did not reach still Pending and retryable,
	// rather than marked with nothing behind them.
	//
	// dmgIds is empty on the remake path, so this loop simply does not run.
	//----------------------------------------------------------------------
	for each  dIdTxt2 in dmgIds
	{
		for each  dmg in Material_Damage[ID == dIdTxt2.toLong()]
		{
			//----------------------------------------------------------
			// THE MATERIAL IS FOR THE REMAKE BATCH, not the original.
			//
			// The original item is finishing with what survived; the cloth he
			// is asking for is what the replacements will be cut from. Putting
			// the requirement on the original would leave the remake batch
			// sitting at Awaiting_Material with nothing owed to it - visible to
			// him, invisible to the store - while the finished original was
			// asked for material it no longer needs.
			//
			// Falls back to the original when no remake was wanted: he is
			// replacing consumables on the item he is still working.
			//----------------------------------------------------------
			targetItem = itemId;
			if(dmg.Remake_Item != null)
			{
				targetItem = dmg.Remake_Item;
			}

			//----------------------------------------------------------
			// WHICH BUCKET THE CLOTH FALLS IN.
			//
			// Rework material and production spoilage are the two things the
			// consumption report most needs told apart. Folded into one Source,
			// cloth spent fixing garments becomes indistinguishable from cloth
			// ruined at the cutting table, and "why was there extra?" stops
			// being answerable at all.
			//
			// Derived from the RESOLVED target - the batch the material is
			// actually for - not from the payload and not from the item the
			// damage was reported against. Those differ whenever a damage report
			// spawned a remake batch.
			//
			// Resolved once per damage record. The line loop below runs per
			// Damage_Lines row and every row of one record shares this answer.
			//----------------------------------------------------------
			srcTxt = "Reissue";
			if(Alteration_Stage[Plan_Item == targetItem].count() > 0)
			{
				srcTxt = "Alteration";
			}

			dmgNote = ifnull(dmg.Note,"").toString().trim();
			if(dmgNote == "")
			{
				dmgNote = "damaged during production";
			}
			dmgDate = ifnull(dmg.Reported_On,"").toString();
			dmgPhase = ifnull(dmg.Phase_Name,"").toString().trim();

			// The one-line why that travels onto the requirement, so the store
			// can see it on their own screen without opening anything.
			whyTxt = dmgDate;
			if(dmgPhase != "")
			{
				whyTxt = whyTxt + " - " + dmgPhase;
			}
			whyTxt = whyTxt + " - " + dmgNote;

			stillPending = false;

			for each  dl in dmg.Damage_Lines
			{
				lineKey = dl.ID.toString();
				lnStatus = ifnull(dl.Reissue_Status,"").toString().trim();
				matKey = "";
				if(dl.Material != null)
				{
					matKey = dl.Material.toString();
				}

				// Only lines the widget asked for, still waiting, and pointing at
				// a material. Re-raising an already-Requested line would issue the
				// same material twice against one damage report.
				if(wantLine.get(lineKey) != null && lnStatus == "Pending" && matKey != "")
				{
					// Empty is not null and toDecimal() throws on it.
					qS = ifnull(dl.Damaged_Qty,"0").toString().trim();
					if(qS == "")
					{
						qS = "0";
					}
					pS = ifnull(dl.Damaged_Pieces,"0").toString().trim();
					if(pS == "")
					{
						pS = "0";
					}
					clS = ifnull(dl.Cut_Size_Length,"0").toString().trim();
					if(clS == "")
					{
						clS = "0";
					}
					cwS = ifnull(dl.Cut_Size_Width,"0").toString().trim();
					if(cwS == "")
					{
						cwS = "0";
					}

					newReqId = insert into Material_Requirement
					[
						Plan=planId
						Plan_Item=targetItem
						Material_Name=ifnull(dl.Material_Name,"").toString()
						Is_Fabric=ifnull(dl.Is_Fabric,false)
						Unit=ifnull(dl.Unit,"").toString()
						Required_Qty=qS.toDecimal()
						Issued_Qty=0
						Received_Qty=0
						Cut_Size_Length=clS.toDecimal().toLong()
						Cut_Size_Width=cwS.toDecimal().toLong()
						Required_Pieces=pS.toDecimal().toLong()
						Pieces_From_Waste=0
						Pieces_From_Raw=0
						Source=srcTxt
						Reason=whyTxt
						Added_User=zoho.loginuser
					];

					reqId = newReqId.toLong();

					// Lookups after the insert - a null one fails the whole block.
					for each  mrq in Material_Requirement[ID == reqId]
					{
						mrq.Material = matKey.toLong();
						mrq.Damage_Ref = dmg.ID;
						if(planSup != null)
						{
							mrq.Assigned_To = planSup;
						}
						if(dmgDate != "")
						{
							mrq.Reported_On = dmg.Reported_On;
						}
					}

					dl.Reissue_Status = "Requested";
					dl.Requirement = reqId;

					// It owes material again. Only ever moved BACKWARDS from
					// Ready - a batch already in production is left alone,
					// because denying work that has started is worse than a
					// status that reads slightly ahead of itself.
					for each  tgt in Plan_Item[ID == targetItem]
					{
						if(ifnull(tgt.Item_Status,"").toString() == "Ready_For_Production")
						{
							tgt.Item_Status = "Awaiting_Material";
						}
					}

					madeCount = madeCount + 1;
					logLines.add("REISSUE -> " + ifnull(dl.Material_Name,"").toString() + " | qty " + qS + " | pieces " + pS);
				}
				else if(lnStatus == "Pending")
				{
					stillPending = true;
				}
			}

			// A record closes only when nothing on it is waiting any more. He can
			// raise half an item's materials today and the rest tomorrow, so
			// closing on the first raise would hide the remainder from the tab.
			if(stillPending == false)
			{
				dmg.Status = "Closed";
			}
		}
	}

	if(madeCount == 0)
	{
		if(kindTxt == "remake")
		{
			// The already-raised and no-BOM cases returned further up, so the
			// only way to arrive here is a BOM that lists no material at all.
			return "{\"success\":false,\"error\":\"" + itemName.replaceAll("\"","'") + "'s BOM lists no material, so there is nothing to ask for\"}";
		}
		return "{\"success\":false,\"error\":\"Those lines were already raised, or no longer exist\"}";
	}

	//----------------------------------------------------------------------
	// The plan has to be somewhere the store screen looks.
	//
	// getStoreMaterialRequirements and issueMaterials accept only Pending,
	// Partially Received and In Progress. "Material Ready" is NOT one of them -
	// it means everything asked for has arrived, which stopped being true the
	// moment this ran. A requirement nobody can see is worse than no requirement
	// at all, because the supervisor is standing there waiting on it.
	//----------------------------------------------------------------------
	if(planStatus == "Material Ready" || planStatus == "Production Complete")
	{
		for each  plW in Production_Planning[ID == planId]
		{
			plW.Order_Status = "In Progress";
		}
		logLines.add("PLAN " + planId + " pulled back from '" + planStatus + "' to In Progress");
	}

	//----------------------------------------------------------------------
	// AND THE SALES ORDER WITH IT.
	//
	// saveProductionPhase mirrors the plan onto the order, so pulling only the
	// plan back left the order claiming it was finished while material was
	// still being asked for. Only from Production Complete - the same rule
	// createRemakeItems applies - so an order already past QC is never dragged
	// backwards.
	//----------------------------------------------------------------------
	for each  plO in Production_Planning[ID == planId]
	{
		if(plO.Sales_Order != null)
		{
			for each  soB in Sales_Order[ID == plO.Sales_Order]
			{
				if(ifnull(soB.Order_Status,"").toString() == "Production Complete")
				{
					soB.Order_Status = "In Progress";
					logLines.add("ORDER pulled back to In Progress");
				}
			}
		}
	}

	logLines.add("Done. Requirements created: " + madeCount);
	info logLines;

	res = "{\"success\":true,\"created\":" + madeCount + ",\"item\":\"" + itemName.replaceAll("\"","'") + "\"}";
	}
	catch (e)
	{
		res = "{\"success\":false,\"error\":\"" + e.toString().replaceAll("\"","'") + "\"}";
		logLines.add(res);
		info logLines;
	}

	return res;
}
