string receiveFromThirdParty(string payloadJson)
{
	// Takes a third party's block back: everything comes back at once, he confirms
	// the count, and every share in the block is closed together.
	//
	// Custom API, POST, one argument: payloadJson.
	//   { "outsourceRef":"OS-9-20260806154000",
	//     "returnedOn":"2026-08-09", "returnedTime":"11:20",
	//     "qtyReturned":"9", "remarks":"" }
	//
	// THE PARTY IS AN OPERATOR, so what comes back is HIS SHARE closing - not the
	// stage. A stage he took 40 pieces of, with 60 still being cut in-house, is
	// not finished when the van arrives, and closing it would publish a Qty_Out
	// missing the 60. So this ends the shares and leaves the stage to close the
	// ordinary way, on the End stage button, once every share is in.
	//
	// EXCEPT WHEN THERE IS NOTHING LEFT IN-HOUSE. A block that took the whole
	// stage has no other share to wait for, and making him press End on three
	// stages he was never working himself is ceremony, not information. So the
	// block's stages are walked in order and each one is closed - through
	// saveProductionPhase, so the item, plan and sales order roll forward exactly
	// as they would for an in-house finish - for as long as two things hold: every
	// share on it is done, and the shares add up to everything the stage received.
	// The walk stops at the first stage where they do not, because that stage's
	// output is the next one's input and it is not settled yet.
	//
	// NO PARTIAL RETURNS, deliberately. A partial return is only worth anything if
	// he can carry on producing with what came back, and he cannot: the shares are
	// the stage's output and re-opening one after the stage closed has nowhere to
	// put the late pieces. So he waits, or he closes short.
	//
	// WAITING IS THE RIGHT ANSWER when a delivery is merely split - closing short
	// tells the system the rest are lost, fires a reissue, and he cuts
	// replacements for pieces that are on their way back. The widget says so on
	// the confirm.
	//
	// THE LOSS LANDS ON THE LAST STAGE OF THE BLOCK. A vendor who returns 9 of 10
	// after three operations cannot say which one dropped it, so every earlier
	// share passes the full quantity through and the last one carries the gap. The
	// earlier shares then read "40 given, 40 finished", which is a fiction - the
	// note written on EVERY share in the block is what keeps it honest.
	//
	// TWO SHAPES OF BLOCK. Everything above describes a block sent as shares. A
	// block that went out under the OLD whole-stage model wrote Is_Outsourced,
	// Third_Party and Outsource_Ref on the Stage_Log itself and overwrote its
	// Qty_In; that path is kept below, unchanged, so a van that was already on the
	// road the day this shipped can still be received. Nothing new goes down it -
	// the shape is decided by where the reference is found, not by a flag.

	res = "{\"success\":false,\"error\":\"Nothing was received\"}";
	logLines = list();

	try
	{
	inp = payloadJson.toMap();

	refTxt = ifnull(inp.get("outsourceRef"),"").toString().trim();
	if(refTxt == "")
	{
		return "{\"success\":false,\"error\":\"Missing outsourceRef\"}";
	}

	// Creator fields that were never written are EMPTY, not null.
	qStr = ifnull(inp.get("qtyReturned"),"0").toString().trim();
	if(qStr == "")
	{
		qStr = "0";
	}
	backQty = qStr.toDecimal().toLong();
	if(backQty < 0)
	{
		backQty = 0;
	}

	retOnTxt = ifnull(inp.get("returnedOn"),"").toString().trim();
	retTimeTxt = ifnull(inp.get("returnedTime"),"").toString().trim();
	remarkTxt = ifnull(inp.get("remarks"),"").toString().trim();

	// A stage only closes through saveProductionPhase when an end TIME is
	// present - that is the function's own test for "this is an End, not a
	// Start". An empty one would silently turn every auto-close below into a
	// second Start and leave the block open with no error anywhere.
	if(retTimeTxt == "")
	{
		retTimeTxt = zoho.currenttime.toString("HH:mm");
	}

	// .count() is right here - a query result, not a List.
	shareCount = Stage_Assignment[Outsource_Ref == refTxt].count();

	if(shareCount > 0)
	{
	//======================================================================
	// THE SHARE MODEL. One Stage_Assignment per stage of the block.
	//======================================================================

	// "sort by" must sit on its own assignment - inline in a for-each header
	// it does not reliably parse.
	shareRows = Stage_Assignment[Outsource_Ref == refTxt] sort by Sequence_No;

	sentQty = 0;
	lastAsgId = 0;
	lastPhase = "";
	lastSeq = 0;
	planId = 0;
	itemId = 0;
	alreadyBack = false;

	for each  shN in shareRows
	{
		if(shN.Returned_On != null)
		{
			alreadyBack = true;
		}
		sentQty = ifnull(shN.Assigned_Qty,0);
		if(shN.Plan != null)
		{
			planId = shN.Plan;
		}
		if(shN.Plan_Item != null)
		{
			itemId = shN.Plan_Item;
		}
		// Ascending sort, so the last one read is the highest sequence.
		lastAsgId = shN.ID;
		lastPhase = ifnull(shN.Phase_Name,"").toString();
		lastSeq = ifnull(shN.Sequence_No,0);
	}

	if(alreadyBack == true)
	{
		return "{\"success\":false,\"error\":\"This block has already been received\"}";
	}

	// You cannot get back more than you sent.
	if(backQty > sentQty)
	{
		backQty = sentQty;
	}

	shortBy = sentQty - backQty;

	//------------------------------------------------------------------
	// The note, written on EVERY share in the block.
	//
	// Without it the earlier stages read as clean runs for ever - "40 given,
	// 40 finished" - and the one place the loss is visible is a stage the
	// vendor may well not have been the one to lose it on.
	//------------------------------------------------------------------
	noteTxt = retOnTxt + " - returned " + backQty + " of " + sentQty;
	if(shortBy > 0)
	{
		noteTxt = noteTxt + " - " + shortBy + " lost at third party";
	}
	if(remarkTxt != "")
	{
		noteTxt = noteTxt + " - " + remarkTxt;
	}
	noteTxt = noteTxt.replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");

	//------------------------------------------------------------------
	// Close the shares. Every one at the full quantity except the last,
	// which carries whatever the gap turned out to be.
	//------------------------------------------------------------------
	backCount = 0;

	for each  shC in shareRows
	{
		oldRem = ifnull(shC.Remarks,"").toString().trim();
		if(oldRem != "")
		{
			oldRem = oldRem + "\n";
		}
		shC.Remarks = oldRem + noteTxt;

		if(retOnTxt != "")
		{
			shC.Returned_On = retOnTxt.toDate();
		}
		shC.End_Time = retTimeTxt;
		shC.Assignment_Status = "Done";

		if(shC.ID == lastAsgId)
		{
			shC.Qty_Out = backQty;
		}
		else
		{
			shC.Qty_Out = ifnull(shC.Assigned_Qty,0);
		}

		backCount = backCount + 1;
	}

	//------------------------------------------------------------------
	// Automatically generate Purchase Bill in Zoho Inventory
	//------------------------------------------------------------------
	vendorInventoryId = "";
	vendorName = "";
	partyId = 0;
	
	// Get subcontractor ID
	for each shC in shareRows
	{
		if(shC.Third_Party != null)
		{
			partyId = shC.Third_Party;
		}
	}
	
	if(partyId != 0)
	{
		for each tp in Third_Party[ID == partyId]
		{
			vendorName = ifnull(tp.Party_Name, "").toString();
		}
	}
	
	if(vendorName != "")
	{
		baseUrl = "https://www.zohoapis.in/inventory/v1/";
		orgId = "60076905558";
		
		// 1. Search Zoho Inventory Vendor ID
		searchUrl = baseUrl + "contacts?contact_name=" + zoho.encryption.urlEncode(vendorName) + "&organization_id=" + orgId;
		searchResp = invokeurl
		[
			url :searchUrl
			type :GET
			connection:"inventory_connection"
		];
		
		searchCode = ifnull(searchResp.get("code"), -1).toLong();
		if(searchCode == 0)
		{
			contacts = searchResp.get("contacts");
			if(contacts.size() > 0)
			{
				firstContact = contacts.get(0);
				vendorInventoryId = ifnull(firstContact.get("contact_id"), "").toString();
			}
		}
		
		// 2. Generate line items for each stage in the block
		if(vendorInventoryId != "")
		{
			// Resolve the garment product name and search its Zoho Inventory item ID
			productName = "";
			for each pi in Plan_Item[ID == itemId]
			{
				productName = ifnull(pi.Item_Name, "").toString();
			}
			
			productInventoryId = "";
			productInventoryName = productName;
			
			if(productName != "")
			{
				itemSearchUrl = baseUrl + "items?name=" + zoho.encryption.urlEncode(productName) + "&organization_id=" + orgId;
				itemSearchResp = invokeurl
				[
					url :itemSearchUrl
					type :GET
					connection:"inventory_connection"
				];
				
				itemSearchCode = ifnull(itemSearchResp.get("code"), -1).toLong();
				if(itemSearchCode == 0)
				{
					itemsList = itemSearchResp.get("items");
					if(itemsList.size() > 0)
					{
						firstItem = itemsList.get(0);
						productInventoryId = ifnull(firstItem.get("item_id"), "").toString();
						productInventoryName = ifnull(firstItem.get("name"), "").toString();
					}
				}
			}
			
			// Fallback to "Stitching Service" if the product doesn't exist in Inventory
			if(productInventoryId == "")
			{
				fallbackItemName = "Stitching Service";
				itemSearchUrl = baseUrl + "items?name=" + zoho.encryption.urlEncode(fallbackItemName) + "&organization_id=" + orgId;
				itemSearchResp = invokeurl
				[
					url :itemSearchUrl
					type :GET
					connection:"inventory_connection"
				];
				
				itemSearchCode = ifnull(itemSearchResp.get("code"), -1).toLong();
				if(itemSearchCode == 0)
				{
					itemsList = itemSearchResp.get("items");
					if(itemsList.size() > 0)
					{
						firstItem = itemsList.get(0);
						productInventoryId = ifnull(firstItem.get("item_id"), "").toString();
						productInventoryName = ifnull(firstItem.get("name"), "").toString();
					}
				}
			}

			lineItemsList = list();
			hasBillableLines = false;
			
			for each shC in shareRows
			{
				stageName = ifnull(shC.Phase_Name, "").toString();
				qtyOut = ifnull(shC.Qty_Out, 0);
				rateVal = ifnull(shC.Rate, 0).toDecimal();
				
				if(rateVal > 0 && qtyOut > 0)
				{
					lineItem = map();
					if(productInventoryId != "")
					{
						lineItem.put("item_id", productInventoryId);
					}
					lineItem.put("name", productInventoryName);
					lineItem.put("quantity", qtyOut);
					lineItem.put("rate", rateVal);
					lineItem.put("description", stageName + " Charges (Ref: " + refTxt + ")");
					
					lineItemsList.add(lineItem);
					hasBillableLines = true;
				}
			}
			
			if(hasBillableLines)
			{
				billData = map();
				billData.put("vendor_id", vendorInventoryId);
				billData.put("bill_number", "BILL-" + refTxt);
				billData.put("date", ifnull(retOnTxt, zoho.currentdate.toString("yyyy-MM-dd")));
				billData.put("line_items", lineItemsList);
				
				billUrl = baseUrl + "bills?organization_id=" + orgId;
				billCreateResp = invokeurl
				[
					url :billUrl
					type :POST
					parameters :billData.toString()
					headers : {"Content-Type":"application/json"}
					connection:"inventory_connection"
				];
				
				billCode = ifnull(billCreateResp.get("code"), -1).toLong();
				if(billCode == 0)
				{
					billObj = billCreateResp.get("bill");
					createdBillNumber = ifnull(billObj.get("bill_number"), "").toString();
					
					// Save created bill number in remarks
					for each shC in shareRows
					{
						shC.Remarks = shC.Remarks + " | Auto-generated Inventory Bill: " + createdBillNumber;
					}
					
					// Instantly write bill lines to local Creator Third_Party_Bill form
					for each shC in shareRows
					{
						stageName = ifnull(shC.Phase_Name, "").toString();
						qtyOut = ifnull(shC.Qty_Out, 0);
						rateVal = ifnull(shC.Rate, 0).toDecimal();
						
						if(rateVal > 0 && qtyOut > 0)
						{
							serviceItemName = productInventoryName;
							
							// Check if this line item is already in Creator
							existingCount = Third_Party_Bill[Bill_Number == createdBillNumber && Item_Name == serviceItemName].count();
							if(existingCount == 0)
							{
								insert into Third_Party_Bill
								[
									Vendor_Name = vendorName
									Bill_Number = createdBillNumber
									Bill_Date = ifnull(retOnTxt, zoho.currentdate.toString("yyyy-MM-dd")).toDate()
									Status = "open"
									Item_Name = serviceItemName
									Quantity = qtyOut
									Rate = rateVal
									Total = qtyOut * rateVal
								];
							}
						}
					}
				}
				else
				{
					// Log error directly to Creator remarks so you can see why it failed
					errorMsg = ifnull(billCreateResp.get("message"), "").toString();
					for each shC in shareRows
					{
						shC.Remarks = shC.Remarks + " | Inventory Bill creation failed: " + errorMsg;
					}
				}
			}
		}
	}

	//------------------------------------------------------------------
	// The stages the block touched, in order, with no duplicates.
	//
	// Ids held as TEXT. They are map keys and list members here, and a
	// mixed-type comparison throws in Deluge rather than returning false.
	//------------------------------------------------------------------
	blockLogs = List();
	blockPhase = Map();
	blockSeq = Map();

	for each  shB in shareRows
	{
		if(shB.Stage_Log != null)
		{
			lidT = shB.Stage_Log.toString();
			if(blockLogs.contains(lidT) == false)
			{
				blockLogs.add(lidT);
				blockPhase.put(lidT,ifnull(shB.Phase_Name,"").toString());
				blockSeq.put(lidT,ifnull(shB.Sequence_No,0));
			}
		}
	}

	// The item's final stage, so a block that ends on it rolls the item and
	// the plan forward rather than stopping one press short.
	lastPhaseOfItem = 0;
	for each  piR2 in Plan_Item[ID == itemId]
	{
		if(piR2.BOM != null)
		{
			for each  bm2 in BOM[ID == piR2.BOM]
			{
				for each  stg2 in bm2.Production_Stages
				{
					sqv2 = ifnull(stg2.Sequence_No,0);
					if(sqv2 > lastPhaseOfItem)
					{
						lastPhaseOfItem = sqv2;
					}
				}
			}
		}
	}

	//------------------------------------------------------------------
	// Walk the block forward, closing what can be closed.
	//
	// There is no reliable "break" in a Deluge for-each, so the body is
	// guarded by a flag instead. The walk MUST stop at the first stage it
	// cannot close: the one after it takes its Qty_In from this stage's
	// output, and closing out of order would hand the next stage a figure
	// that is still due to change.
	//------------------------------------------------------------------
	closedCount = 0;
	lastInner = "{}";
	keepGoing = true;
	prevOut = 0;
	prevKnown = false;

	for each  lidTxt in blockLogs
	{
		if(keepGoing == true)
		{
			curPhase = ifnull(blockPhase.get(lidTxt),"").toString();
			curSeq = ifnull(blockSeq.get(lidTxt),0);
			curIn = 0;
			curDone = false;

			for each  lgC in Stage_Log[ID == lidTxt.toLong()]
			{
				curIn = ifnull(lgC.Qty_In,0);
				if(ifnull(lgC.Stage_Status,"").toString().trim() == "Done")
				{
					curDone = true;
				}
			}

			// A later stage of the block was opened with no Qty_In - its input
			// was still being produced when the van left. Now that the stage
			// before it has closed, it is known.
			if(curIn <= 0 && prevKnown == true)
			{
				curIn = prevOut;
			}

			asgSum = 0;
			asgOpen = 0;
			for each  agC in Stage_Assignment[Stage_Log == lidTxt.toLong()]
			{
				asgSum = asgSum + ifnull(agC.Assigned_Qty,0);
				if(ifnull(agC.Assignment_Status,"").toString().trim() != "Done")
				{
					asgOpen = asgOpen + 1;
				}
			}

			if(curDone == true)
			{
				// Already closed by somebody else. Its output still has to be
				// carried forward or the next stage has no input.
				for each  lgD in Stage_Log[ID == lidTxt.toLong()]
				{
					prevOut = ifnull(lgD.Qty_Out,0);
				}
				prevKnown = true;
			}
			else if(asgOpen == 0 && curIn > 0 && asgSum >= curIn)
			{
				//----------------------------------------------------------
				// Nothing is outstanding on this stage and nobody in-house is
				// owed any of it, so the vendor's return finished it.
				//
				// Closed THROUGH saveProductionPhase, never here. If this is
				// the item's last stage, closing it has to roll the item to
				// Awaiting_Check, write Qty_Produced, roll the plan to
				// Production Complete and mirror that onto the sales order.
				// All of that already exists in one place and a second copy
				// would drift.
				//
				// qtyOut is sent as 0 on purpose - saveProductionPhase ignores
				// the payload figure when the stage has shares and adds up
				// what the people actually finished, which is the better
				// authority and the only one that stays right when part of the
				// stage was cut in-house.
				//----------------------------------------------------------
				isLastTxt = "false";
				if(curSeq >= lastPhaseOfItem && lastPhaseOfItem > 0)
				{
					isLastTxt = "true";
				}

				endPayload = "{\"planId\":\"" + planId + "\",\"planItemId\":\"" + itemId + "\",\"phaseName\":\"" + curPhase.replaceAll("\"","'") + "\",\"sequence\":\"" + curSeq + "\",\"isLastStage\":\"" + isLastTxt + "\",\"operatorId\":\"\",\"startTime\":\"\",\"endTime\":\"" + retTimeTxt + "\",\"qtyIn\":\"" + curIn + "\",\"qtyOut\":\"0\",\"remarks\":\"" + noteTxt + "\"}";

				lastInner = thisapp.saveProductionPhase(endPayload);
				logLines.add("closed " + curPhase + " -> " + lastInner);
				closedCount = closedCount + 1;

				for each  lgE in Stage_Log[ID == lidTxt.toLong()]
				{
					prevOut = ifnull(lgE.Qty_Out,0);
				}
				prevKnown = true;
			}
			else
			{
				// Somebody in-house still has pieces of this stage, or it has
				// not been fully handed out. It closes on the End stage button
				// when they are in - and every stage after it waits for that.
				keepGoing = false;
				logLines.add("left open: " + curPhase + " | in " + curIn + " | handed out " + asgSum + " | still working " + asgOpen);
			}
		}
	}

	//------------------------------------------------------------------
	// saveProductionPhase's own reply, forwarded nested under "phase".
	//
	// If the last close finished the last item of the plan, it carries
	// orderComplete and the finished-order summary. All of that was being
	// logged and dropped once, so an order finished at a third party skipped
	// its completion popup and the screen simply moved on with nothing said.
	//
	// Nested rather than re-emitted field by field: the summary is a list of
	// objects, and hand-rebuilding Map -> List -> Map is exactly the shape
	// that does not survive Deluge's own toString(). The inner string is
	// already valid JSON, so it only has to be spliced in. Guarded, because a
	// malformed value here would break JSON.parse on the whole response and
	// lose the receipt result too.
	//------------------------------------------------------------------
	innerTxt = ifnull(lastInner,"").toString().trim();
	if(innerTxt == "" || innerTxt.startsWith("{") == false)
	{
		innerTxt = "{}";
	}

	logLines.add("Done. ref " + refTxt + " | shares closed " + backCount + " | stages closed " + closedCount + " | back " + backQty + " of " + sentQty);
	info logLines;

	res = "{\"success\":true,\"closed\":" + closedCount + ",\"shares\":" + backCount + ",\"returned\":" + backQty + ",\"sent\":" + sentQty + ",\"short\":" + shortBy + ",\"planItemId\":\"" + itemId + "\",\"phaseName\":\"" + lastPhase.replaceAll("\"","'") + "\",\"phase\":" + innerTxt + "}";
	}
	else
	{
	//======================================================================
	// LEGACY: the whole-stage block. Unchanged.
	//
	// Sent before the party became a share, so the flags and the quantity are
	// on the Stage_Log itself and its Qty_In IS the sent quantity. Kept only
	// so a van already on the road can be received; sendToThirdParty writes
	// nothing down this path any more.
	//======================================================================
	blockRows = Stage_Log[Outsource_Ref == refTxt] sort by Sequence_No;

	if(blockRows.count() == 0)
	{
		return "{\"success\":false,\"error\":\"No stages found for " + refTxt.replaceAll("\"","'") + "\"}";
	}

	oSent = 0;
	oLastLogId = 0;
	oLastPhase = "";
	oLastSeq = 0;
	oPlanId = 0;
	oItemId = 0;
	oBack = false;

	for each  b in blockRows
	{
		if(b.Returned_On != null)
		{
			oBack = true;
		}
		oSent = ifnull(b.Qty_In,0);
		if(b.Plan != null)
		{
			oPlanId = b.Plan;
		}
		if(b.Plan_Item != null)
		{
			oItemId = b.Plan_Item;
		}
		oLastLogId = b.ID;
		oLastPhase = ifnull(b.Phase_Name,"").toString();
		oLastSeq = ifnull(b.Sequence_No,0);
	}

	if(oBack == true)
	{
		return "{\"success\":false,\"error\":\"This block has already been received\"}";
	}

	if(backQty > oSent)
	{
		backQty = oSent;
	}

	oShort = oSent - backQty;

	oNote = retOnTxt + " - returned " + backQty + " of " + oSent;
	if(oShort > 0)
	{
		oNote = oNote + " - " + oShort + " lost at third party";
	}
	if(remarkTxt != "")
	{
		oNote = oNote + " - " + remarkTxt;
	}
	oNote = oNote.replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ");

	// Returned_On is set on all of them first, including the last, because
	// saveProductionPhase refuses to touch a stage that is outsourced and
	// still out - which is the guard that stops an in-house Start being
	// recorded against pieces sitting in someone else's workshop.
	oClosed = 0;

	for each  b2 in blockRows
	{
		oRem = ifnull(b2.Remarks,"").toString().trim();
		if(oRem != "")
		{
			oRem = oRem + "\n";
		}
		b2.Remarks = oRem + oNote;

		if(retOnTxt != "")
		{
			b2.Returned_On = retOnTxt.toDate();
		}

		if(b2.ID != oLastLogId)
		{
			b2.Qty_Out = ifnull(b2.Qty_In,0);
			b2.Stage_Status = "Done";
			b2.End_Time = retTimeTxt;
			oClosed = oClosed + 1;
		}
	}

	oLastOfItem = 0;
	for each  piR in Plan_Item[ID == oItemId]
	{
		if(piR.BOM != null)
		{
			for each  bm in BOM[ID == piR.BOM]
			{
				for each  stg in bm.Production_Stages
				{
					sqv = ifnull(stg.Sequence_No,0);
					if(sqv > oLastOfItem)
					{
						oLastOfItem = sqv;
					}
				}
			}
		}
	}

	oIsLast = "false";
	if(oLastSeq >= oLastOfItem && oLastOfItem > 0)
	{
		oIsLast = "true";
	}

	oPayload = "{\"planId\":\"" + oPlanId + "\",\"planItemId\":\"" + oItemId + "\",\"phaseName\":\"" + oLastPhase.replaceAll("\"","'") + "\",\"sequence\":\"" + oLastSeq + "\",\"isLastStage\":\"" + oIsLast + "\",\"operatorId\":\"\",\"machineId\":\"\",\"startTime\":\"\",\"endTime\":\"" + retTimeTxt + "\",\"qtyIn\":\"" + oSent + "\",\"qtyOut\":\"" + backQty + "\",\"remarks\":\"" + oNote + "\"}";

	oInner = thisapp.saveProductionPhase(oPayload);
	logLines.add("legacy last stage via saveProductionPhase -> " + oInner);

	oInnerTxt = ifnull(oInner,"").toString().trim();
	if(oInnerTxt == "" || oInnerTxt.startsWith("{") == false)
	{
		oInnerTxt = "{}";
	}

	oClosed = oClosed + 1;

	logLines.add("Done (legacy). ref " + refTxt + " | closed " + oClosed + " stages | back " + backQty + " of " + oSent);
	info logLines;

	res = "{\"success\":true,\"closed\":" + oClosed + ",\"shares\":0,\"returned\":" + backQty + ",\"sent\":" + oSent + ",\"short\":" + oShort + ",\"planItemId\":\"" + oItemId + "\",\"phaseName\":\"" + oLastPhase.replaceAll("\"","'") + "\",\"phase\":" + oInnerTxt + "}";
	}
	}
	catch (e)
	{
		res = "{\"success\":false,\"error\":\"" + e.toString().replaceAll("\"","'") + "\"}";
		logLines.add(res);
		info logLines;
	}

	return res;
}
