string sendToPrint(string payloadJson)
{
	// Store person cuts full-width pieces off a source lot and sends them to an
	// outside printer. The pieces are PHYSICALLY CUT here - the named source rolls
	// shrink - and the cloth moves state into In_Print_Qty, still ours.
	//
	//   { "sourceMaterialId":"123", "sourceLotId":"901", "sourceState":"Wash",
	//     "targetMaterialId":"456",        // an EXISTING printed SKU
	//     "printerId":"77",
	//     "lines":[ {"lengthCm":300,"count":3}, {"lengthCm":275,"count":4} ],
	//     "rollPlan":[ {"rollId":"111","label":"L2-R1","metres":9.0}, ... ],  // optional
	//     "remarks":"" }
	//
	// NO MINTING. Printed SKUs are created in Zoho Inventory and pushed to Creator.
	// The target is one the store person picked - the widget filters the list to
	// the same width (the "printed fabric" Type_field filter is OFF for now, both
	// here and in the widget). The pick is his and there is no system link (no
	// Print_Base) between plain and printed.
	//
	// NO Fabric_Piece, NO Pattern. Printed stock is ordinary short rolls
	// (Lot_Rolls, Origin "Printed"), created by receiveFromPrint. See
	// docs/printing-v2-plan.md.
	//
	// PRINTING IS A STORE-SIDE CONVERSION, NOT A PRODUCTION STAGE. It does not go
	// near sendToThirdParty, Stage_Log or Stage_Assignment.
	//
	// THE LOT HOLDS THE TRUTH, Raw_Material HOLDS A MAINTAINED TOTAL. Both are
	// written here, in one pass, so they cannot disagree. The parent is not a
	// derived roll-up: recomputing a sum per material on every screen load is a
	// query per material, and that is the road to the statement limit - NOT
	// catchable, shows as a bare 500 with no error card.
	//
	// THE SKU TOTAL DOES NOT CHANGE AT SEND. Wash/Unwash goes down, In_Print_Qty
	// goes up, both mirrored onto the parent - the metres have only walked state.
	//
	// THE ROLLS ARE DECREMENTED HERE. Σ Roll_Length must equal the lot's shelf
	// columns (Wash + Unwash + In_Wash), so cutting pieces off a roll and moving
	// the same metres out of Wash_Quantity happen together. lot-rolls-model.md
	// Step 7.
	//
	// MOVE THE LEDGER FIRST, WRITE THE JOB SECOND. No transaction here, so pick
	// the safer failure: a move with no job leaves metres parked in In_Print_Qty
	// and rolls short - visible to reconcileRawMaterial, correctable by hand,
	// invents nothing. A job with no move could be cancelled and credit cloth
	// that never left. Stuck beats imaginary.
	//
	// ONE EXIT, AT THE BOTTOM. Deluge's "all paths return" check does NOT count a
	// return inside try/catch - a function whose every return sat in the try
	// failed to save with "Missing return statement" against line 3. So nothing
	// returns early: errTxt is set, later blocks guard on it being empty, and the
	// one return is after the catch. Same shape as saveStockInward.

	res = "";
	errTxt = "";

	try
	{
		inp = payloadJson.toMap();

		srcMatId = ifnull(inp.get("sourceMaterialId"),"").toString().trim();
		srcLotId = ifnull(inp.get("sourceLotId"),"").toString().trim();
		tgtMatId = ifnull(inp.get("targetMaterialId"),"").toString().trim();
		printerId = ifnull(inp.get("printerId"),"").toString().trim();
		srcState = ifnull(inp.get("sourceState"),"").toString().trim();
		remarks = ifnull(inp.get("remarks"),"").toString().trim().replaceAll("\"","'");

		// size() is right - these are Lists, not query results.
		linesRaw = ifnull(inp.get("lines"),list());
		rollPlanRaw = ifnull(inp.get("rollPlan"),list());

		if(srcMatId == "" || srcMatId.isNumber() == false)
		{
			errTxt = "No source material given";
		}
		if(errTxt == "" && (srcLotId == "" || srcLotId.isNumber() == false))
		{
			errTxt = "No source lot given - the tone that goes out matters";
		}
		if(errTxt == "" && (tgtMatId == "" || tgtMatId.isNumber() == false))
		{
			errTxt = "No target printed material chosen";
		}
		if(errTxt == "" && srcState != "Wash" && srcState != "Unwash")
		{
			errTxt = "Source state must be Wash or Unwash";
		}
		if(errTxt == "" && (printerId == "" || printerId.isNumber() == false))
		{
			errTxt = "No printer given";
		}
		if(errTxt == "" && linesRaw.size() == 0)
		{
			errTxt = "Nothing to send - add at least one piece line";
		}
		if(errTxt == "" && srcMatId == tgtMatId)
		{
			errTxt = "Source and target are the same material";
		}

		//--------------------------------------------------------------------
		// THE SOURCE MATERIAL. Its width is the check the target must pass.
		// Names first assigned inside an if are not safe to read after it when
		// that branch did not run, so they are initialised here.
		//--------------------------------------------------------------------
		srcName = "";
		srcSku = "";
		srcIsFab = false;
		srcWidth = "";

		if(errTxt == "")
		{
			// A query result needs .count() - .size() is a List method.
			srcRecs = Raw_Material[ID == srcMatId.toLong()];
			if(srcRecs.count() == 0)
			{
				errTxt = "Source material not found";
			}
			else
			{
				for each  smChk in srcRecs
				{
					srcSku = ifnull(smChk.SKU,"").toString().trim().replaceAll("\"","'");
					srcName = ifnull(smChk.Material_Display_Name,"").toString().trim().replaceAll("\"","'");
					if(srcName == "")
					{
						srcName = ifnull(smChk.Name,"").toString().trim().replaceAll("\"","'");
					}

					// Tested AS TEXT - a Decision box gives a boolean, a yes/no
					// dropdown gives "Yes", an untouched field gives EMPTY, and
					// comparing the last two against the boolean true is silently
					// false.
					fabTxt = ifnull(smChk.Is_Fabric,"").toString().trim().toLowerCase();
					if(fabTxt == "true" || fabTxt == "yes" || fabTxt == "1" || fabTxt == "y")
					{
						srcIsFab = true;
					}

					srcWidth = ifnull(smChk.Fabric_Width_Inches,"").toString().trim();
				}
			}
		}

		if(errTxt == "" && srcIsFab != true)
		{
			errTxt = srcSku + " is not a fabric - printing applies to fabric only";
		}

		//--------------------------------------------------------------------
		// THE TARGET MATERIAL. Must be a fabric and the SAME WIDTH as the source
		// - the one invariant the whole design rests on: a piece coming back has
		// to be full width of both, or the allocator is handed cloth it cannot
		// cut as it expects. (The "printed fabric" Type_field check is OFF for
		// now - see the note where it used to be.)
		//
		// Checked server-side and not only on the screen, because a Custom API
		// is callable from anywhere.
		//--------------------------------------------------------------------
		tgtName = "";
		tgtSku = "";
		tgtIsFab = false;
		tgtType = "";
		tgtWidth = "";

		if(errTxt == "")
		{
			tgtRecs = Raw_Material[ID == tgtMatId.toLong()];
			if(tgtRecs.count() == 0)
			{
				errTxt = "Target printed material not found";
			}
			else
			{
				for each  tmChk in tgtRecs
				{
					tgtSku = ifnull(tmChk.SKU,"").toString().trim().replaceAll("\"","'");
					tgtName = ifnull(tmChk.Material_Display_Name,"").toString().trim().replaceAll("\"","'");
					if(tgtName == "")
					{
						tgtName = ifnull(tmChk.Name,"").toString().trim().replaceAll("\"","'");
					}

					tfabTxt = ifnull(tmChk.Is_Fabric,"").toString().trim().toLowerCase();
					if(tfabTxt == "true" || tfabTxt == "yes" || tfabTxt == "1" || tfabTxt == "y")
					{
						tgtIsFab = true;
					}

					tgtType = ifnull(tmChk.Type_field,"").toString().trim().toLowerCase();
					tgtWidth = ifnull(tmChk.Fabric_Width_Inches,"").toString().trim();
				}
			}
		}

		if(errTxt == "" && tgtIsFab != true)
		{
			errTxt = tgtSku + " is not a fabric";
		}
		// THE "printed fabric" TYPE CHECK IS OFF FOR NOW - width is the only guard.
		// tgtType is still read above so re-enabling is one line. When it goes
		// back, the widget's targetsFor() filter must be re-added in the same pass
		// (app/js/main.js).
		// Compared as NUMBERS, not strings - "60" and "60.0" are the same width,
		// and the widget's targetsFor() also compares numerically, so a string
		// compare here would offer a target the server then rejects. A material
		// with no width recorded (0) cannot pair with another width-less one -
		// that is a blank waiting to be filled, not a match.
		srcWidthN = 0.0;
		if(errTxt == "" && srcWidth != "")
		{
			srcWidthN = srcWidth.toDecimal();
		}
		tgtWidthN = 0.0;
		if(errTxt == "" && tgtWidth != "")
		{
			tgtWidthN = tgtWidth.toDecimal();
		}
		if(errTxt == "" && (srcWidthN <= 0 || tgtWidthN <= 0))
		{
			errTxt = "One of these materials has no fabric width on record - set it before printing";
		}
		diffW = srcWidthN - tgtWidthN;
		if(diffW < 0)
		{
			diffW = diffW * -1;
		}
		if(errTxt == "" && diffW > 0.01)
		{
			errTxt = "Width mismatch - source is " + srcWidth + " in, target " + tgtWidth + " in. A printed piece must be full width of both.";
		}

		//--------------------------------------------------------------------
		// THE PRINTER. Nested rather than && onto the errTxt guard - Deluge is
		// not dependable about short-circuiting and .toLong() on an empty
		// printerId would throw out of a block that had decided not to run.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			if(Third_Party[ID == printerId.toLong()].count() == 0)
			{
				errTxt = "Printer not found";
			}
		}

		//--------------------------------------------------------------------
		// THE SOURCE LOT. Must belong to THIS material and not be Blocked.
		// Its Lot_Rolls come back nested on the record - no extra query.
		//--------------------------------------------------------------------
		lotWashHave = 0.0;
		lotUnwashHave = 0.0;
		lotInPrintHave = 0.0;
		lotNumOut = "";
		targetLot = 0;
		lotRollCount = 0;

		if(errTxt == "")
		{
			lotRecs = Raw_Material_Lot[ID == srcLotId.toLong()];
			if(lotRecs.count() == 0)
			{
				errTxt = "Source lot not found";
			}
			else
			{
				for each  lchk in lotRecs
				{
					if(ifnull(lchk.Material,"").toString().trim() != srcMatId)
					{
						errTxt = "That lot belongs to a different material";
					}
					else if(ifnull(lchk.Status,"Active").toString().trim() == "Blocked")
					{
						errTxt = "That lot is blocked - nothing can be sent off it";
					}
					else
					{
						targetLot = lchk.ID;
						lotNumOut = ifnull(lchk.Lot_Number,"").toString().trim().replaceAll("\"","'");

						// Creator fields never written are EMPTY, not null.
						// ifnull() does not catch empty and .toDecimal() throws
						// on it - normalise to string, test, convert.
						lwS = ifnull(lchk.Wash_Quantity,"0").toString().trim();
						if(lwS == "")
						{
							lwS = "0";
						}
						luS = ifnull(lchk.Unwash_Quantity,"0").toString().trim();
						if(luS == "")
						{
							luS = "0";
						}
						lpS = ifnull(lchk.In_Print_Qty,"0").toString().trim();
						if(lpS == "")
						{
							lpS = "0";
						}

						lotWashHave = lwS.toDecimal();
						lotUnwashHave = luS.toDecimal();
						lotInPrintHave = lpS.toDecimal();

						for each  rcCnt in lchk.Lot_Rolls
						{
							lotRollCount = lotRollCount + 1;
						}
					}
				}
			}
		}

		if(errTxt == "" && targetLot == 0)
		{
			errTxt = "Could not resolve a lot to send off";
		}
		if(errTxt == "" && lotRollCount == 0)
		{
			errTxt = "Lot " + lotNumOut + " has no rolls recorded - it must be received into rolls before cloth can be sent to print";
		}

		//--------------------------------------------------------------------
		// THE PIECE LINES. He types the lengths - a physical constraint (how
		// the cloth is cut, what the printer's table takes) - so nothing
		// computes or rounds them. Enforced: a positive length and a WHOLE
		// positive count. No break in Deluge, so the loop runs to the end and
		// errTxt carries the first fault out.
		//--------------------------------------------------------------------
		totalCm = 0.0;
		lineCount = 0;
		piecesSent = 0;

		if(errTxt == "")
		{
			for each  lnRaw in linesRaw
			{
				if(errTxt == "")
				{
					ln = lnRaw.toMap();

					lStr = ifnull(ln.get("lengthCm"),"0").toString().trim();
					if(lStr == "")
					{
						lStr = "0";
					}
					cStr = ifnull(ln.get("count"),"0").toString().trim();
					if(cStr == "")
					{
						cStr = "0";
					}

					lnLen = lStr.toDecimal();
					lnCntDec = cStr.toDecimal();
					lnCnt = lnCntDec.toLong();

					if(lnLen <= 0)
					{
						errTxt = "Every send line needs a piece length in cm";
					}
					else if(lnCntDec <= 0)
					{
						errTxt = "Every send line needs a piece count above zero";
					}
					else if(lnCnt.toDecimal() != lnCntDec)
					{
						errTxt = "Piece count must be a whole number - " + cStr + " is not";
					}
					else
					{
						totalCm = totalCm + (lnLen * lnCnt);
						piecesSent = piecesSent + lnCnt;
						lineCount = lineCount + 1;
					}
				}
			}
		}

		metresSent = 0.0;
		if(errTxt == "")
		{
			metresSent = totalCm / 100;
			if(metresSent <= 0)
			{
				errTxt = "Nothing to send - the lines add up to zero";
			}
		}

		//--------------------------------------------------------------------
		// THE BUDGET. REJECT, NEVER SILENTLY TRIM. A trimmed Metres_Sent that
		// disagrees with the Send_Lines beside it would read as printer loss
		// for ever - the return is checked against those lines.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			stateHave = lotUnwashHave;
			if(srcState == "Wash")
			{
				stateHave = lotWashHave;
			}
			if(metresSent > stateHave)
			{
				errTxt = "Lot " + lotNumOut + " has only " + stateHave + " Mtr " + srcState + " - " + metresSent + " Mtr asked for";
			}
		}

		//--------------------------------------------------------------------
		// THE ROLL PLAN. Which physical rolls get cut, and how much off each.
		//
		// Given in the payload -> validated: every rollId on THIS lot, Available,
		// each metres > 0 and <= the roll's CURRENT length (re-read here, inside
		// this execution - the concurrency guard), and Σ metres == metresSent.
		//
		// Omitted -> auto: SHORTEST Available roll first (consolidates the rack
		// over time - a short roll left sitting becomes scrap), take
		// min(rollLen, remaining) off each until remaining is 0.
		//
		// Held as three parallel Lists indexed together - planRollId / planLabel
		// / planMetres - because a hand-appended List of maps does not reliably
		// survive being iterated later in Deluge (CLAUDE.md).
		//--------------------------------------------------------------------
		planRollId = List();
		planLabel = List();
		planMetres = List();

		// Snapshot the Available rolls once: id, label, current length. Sorted
		// shortest-first for the auto path; the given-plan path looks up by id.
		rollIds = List();
		rollLabels = List();
		rollLens = List();

		if(errTxt == "")
		{
			for each  lsnap in Raw_Material_Lot[ID == targetLot]
			{
				for each  rsnap in lsnap.Lot_Rolls
				{
					// EMPTY is not null - ifnull does not catch it, so a blank
					// status is normalised to Available explicitly here, the same
					// as print-data.js does on the read side. Otherwise the
					// preview offers a roll the server then silently excludes.
					rStatus = ifnull(rsnap.Roll_Status,"Available").toString().trim();
					if(rStatus == "")
					{
						rStatus = "Available";
					}
					rLenS = ifnull(rsnap.Roll_Length,"0").toString().trim();
					if(rLenS == "")
					{
						rLenS = "0";
					}
					rLen = rLenS.toDecimal();
					if(rStatus == "Available" && rLen > 0)
					{
						rollIds.add(rsnap.ID.toString());
						rollLabels.add(ifnull(rsnap.Roll_Label,"").toString().trim().replaceAll("\"","'"));
						rollLens.add(rLen);
					}
				}
			}
		}

		if(errTxt == "" && rollIds.size() == 0)
		{
			errTxt = "Lot " + lotNumOut + " has no cuttable rolls (all consumed or blocked)";
		}

		//---- given plan ---------------------------------------------------
		if(errTxt == "" && rollPlanRaw.size() > 0)
		{
			planSum = 0.0;
			seenRollIds = List();
			for each  rpRaw in rollPlanRaw
			{
				if(errTxt == "")
				{
					rp = rpRaw.toMap();
					rpId = ifnull(rp.get("rollId"),"").toString().trim();
					rpMtrS = ifnull(rp.get("metres"),"0").toString().trim();
					if(rpMtrS == "")
					{
						rpMtrS = "0";
					}
					rpMtr = rpMtrS.toDecimal();

					if(rpId == "" || rpId.isNumber() == false)
					{
						errTxt = "A roll in the plan has no id - reload the screen";
					}
					else if(rpMtr <= 0)
					{
						errTxt = "Every roll in the plan needs metres above zero";
					}
					else if(seenRollIds.contains(rpId))
					{
						errTxt = "The cut plan names one roll twice - reload the screen";
					}
					else
					{
						seenRollIds.add(rpId);
						rpIdx = rollIds.indexOf(rpId);
						if(rpIdx < 0)
						{
							errTxt = "Roll " + rpId + " is not a cuttable roll on lot " + lotNumOut + " - reload the screen";
						}
						else if(rpMtr > rollLens.get(rpIdx))
						{
							errTxt = "Roll " + rollLabels.get(rpIdx) + " has " + rollLens.get(rpIdx) + " Mtr, plan asks " + rpMtr + " - reload the screen";
						}
						else
						{
							planRollId.add(rpId);
							planLabel.add(rollLabels.get(rpIdx));
							planMetres.add(rpMtr);
							planSum = planSum + rpMtr;
						}
					}
				}
			}

			if(errTxt == "")
			{
				diff = planSum - metresSent;
				if(diff < 0)
				{
					diff = diff * -1;
				}
				if(diff > 0.01)
				{
					errTxt = "The roll plan totals " + planSum + " Mtr but the pieces need " + metresSent + " Mtr";
				}
			}
		}

		//---- auto plan --------------------------------------------------
		if(errTxt == "" && rollPlanRaw.size() == 0)
		{
			// Selection sort by length ascending over the parallel Lists.
			// List.set() does NOT exist in Deluge (CLAUDE.md), so the ordered
			// position list is APPEND-ONLY: each outer pass finds the smallest
			// not-yet-used position and add()s it. A counter list (rollIds
			// itself) bounds the outer pass - two live iterators over one list
			// do not work.
			//
			// TIE ON LENGTH IS BROKEN BY LIST POSITION, not by comparing labels -
			// the scan runs low position to high and only takes a STRICTLY
			// shorter roll, so the first-seen of two equal-length rolls wins.
			// This avoids a string "<" relational, which is not verified in
			// Deluge (only date relationals and substring are).
			usedPos = List();
			for each  pcnt in rollIds
			{
				bestPos = -1;
				bestLen = 0.0;
				scanPos = 0;
				for each  sc in rollIds
				{
					if(usedPos.contains(scanPos) == false)
					{
						scLen = rollLens.get(scanPos);
						takeThis = false;
						if(bestPos < 0)
						{
							takeThis = true;
						}
						else if(scLen < bestLen)
						{
							takeThis = true;
						}
						if(takeThis == true)
						{
							bestPos = scanPos;
							bestLen = scLen;
						}
					}
					scanPos = scanPos + 1;
				}
				if(bestPos >= 0)
				{
					usedPos.add(bestPos);
				}
			}

			remain = metresSent;
			for each  op in usedPos
			{
				if(remain > 0.001)
				{
					opLen = rollLens.get(op);
					take = opLen;
					if(take > remain)
					{
						take = remain;
					}
					planRollId.add(rollIds.get(op));
					planLabel.add(rollLabels.get(op));
					planMetres.add(take);
					remain = remain - take;
				}
			}

			if(remain > 0.01)
			{
				totAvail = metresSent - remain;
				errTxt = "Lot " + lotNumOut + " has " + totAvail + " Mtr across its rolls, " + metresSent + " Mtr asked for";
			}
		}

		if(errTxt == "" && planRollId.size() == 0)
		{
			errTxt = "Could not work out which rolls to cut";
		}

		//--------------------------------------------------------------------
		// MOVE THE LEDGER. Rolls first, then lot, then parent - all before the
		// job is written.
		//
		// TWO PASSES OVER THE ROLLS. Pass 1 re-reads every planned roll's
		// CURRENT length (inside this execution - the concurrency guard) and
		// checks the WHOLE plan fits before a single row is touched. Only if all
		// of it fits does pass 2 write. A single-pass "check then write per
		// roll" leaves earlier rolls decremented when a later one comes up
		// short - Σ Roll_Length then disagrees with the shelf columns and the
		// error message ("Nothing was sent") is a lie.
		//--------------------------------------------------------------------
		lotWashOut = 0.0;
		lotUnwashOut = 0.0;
		lotInPrintOut = 0.0;
		matInPrintOut = 0.0;

		// ---- pass 1: verify, no writes ----
		if(errTxt == "")
		{
			pIdx = 0;
			for each  pid in planRollId
			{
				if(errTxt == "")
				{
					pTake = planMetres.get(pIdx);
					pFound = false;
					for each  lotChk in Raw_Material_Lot[ID == targetLot]
					{
						for each  rollChk in lotChk.Lot_Rolls
						{
							if(rollChk.ID.toString() == pid)
							{
								pFound = true;
								rHaveS = ifnull(rollChk.Roll_Length,"0").toString().trim();
								if(rHaveS == "")
								{
									rHaveS = "0";
								}
								if(pTake > rHaveS.toDecimal() + 0.0001)
								{
									errTxt = "Roll " + planLabel.get(pIdx) + " has " + rHaveS.toDecimal() + " Mtr, the cut plan needs " + pTake + " - a concurrent change moved the stock. Nothing was sent; reload and try again.";
									info "sendToPrint: roll " + pid + " short at pre-check - aborting, nothing written";
								}
							}
						}
					}
					if(pFound == false && errTxt == "")
					{
						errTxt = "Roll " + planLabel.get(pIdx) + " vanished before it could be cut - reload the screen";
					}
				}
				pIdx = pIdx + 1;
			}
		}

		// ---- pass 2: write ----
		if(errTxt == "")
		{
			pIdx = 0;
			for each  pid2 in planRollId
			{
				pTake2 = planMetres.get(pIdx);
				for each  lotMv in Raw_Material_Lot[ID == targetLot]
				{
					for each  rollRow in lotMv.Lot_Rolls
					{
						if(rollRow.ID.toString() == pid2)
						{
							rHave2S = ifnull(rollRow.Roll_Length,"0").toString().trim();
							if(rHave2S == "")
							{
								rHave2S = "0";
							}
							rLeft = rHave2S.toDecimal() - pTake2;
							if(rLeft < 0)
							{
								rLeft = 0;
							}
							rollRow.Roll_Length = rLeft;
							if(rLeft <= 0)
							{
								rollRow.Roll_Status = "Consumed";
							}
						}
					}
				}
				pIdx = pIdx + 1;
			}
		}

		if(errTxt == "")
		{
			for each  lotUpd in Raw_Material_Lot[ID == targetLot]
			{
				lotWashOut = lotWashHave;
				lotUnwashOut = lotUnwashHave;
				lotInPrintOut = lotInPrintHave + metresSent;

				if(srcState == "Wash")
				{
					lotWashOut = lotWashHave - metresSent;
					lotUpd.Wash_Quantity = lotWashOut;
				}
				else
				{
					lotUnwashOut = lotUnwashHave - metresSent;
					lotUpd.Unwash_Quantity = lotUnwashOut;
				}

				lotUpd.In_Print_Qty = lotInPrintOut;
			}

			// THE PARENT MIRRORS BOTH MOVES, so the SKU total is unchanged.
			// Read fresh off the record - the parent is the sum over every lot,
			// not over this one.
			for each  rmUpd in Raw_Material[ID == srcMatId.toLong()]
			{
				mwS = ifnull(rmUpd.Wash_Quantity,"0").toString().trim();
				if(mwS == "")
				{
					mwS = "0";
				}
				muS = ifnull(rmUpd.Unwash_Quantity,"0").toString().trim();
				if(muS == "")
				{
					muS = "0";
				}
				mpS = ifnull(rmUpd.In_Print_Qty,"0").toString().trim();
				if(mpS == "")
				{
					mpS = "0";
				}

				matInPrintOut = mpS.toDecimal() + metresSent;

				if(srcState == "Wash")
				{
					rmUpd.Wash_Quantity = mwS.toDecimal() - metresSent;
				}
				else
				{
					rmUpd.Unwash_Quantity = muS.toDecimal() - metresSent;
				}
				qW = ifnull(rmUpd.Wash_Quantity,"0").toString().trim();
				qU = ifnull(rmUpd.Unwash_Quantity,"0").toString().trim();
				qA = ifnull(rmUpd.Unallocated_Qty,"0").toString().trim();
				rmUpd.Quantity = if(qW=="",0.0,qW.toDecimal()) + if(qU=="",0.0,qU.toDecimal()) + if(qA=="",0.0,qA.toDecimal());

				rmUpd.In_Print_Qty = matInPrintOut;
			}
		}

		//--------------------------------------------------------------------
		// THE JOB. Job_Status, not Status - six forms already share that link
		// name. Metres_Returned starts at 0 so the loss figure reads as a real
		// number from the moment the job exists.
		//--------------------------------------------------------------------
		jobId = 0;

		if(errTxt == "")
		{
			newJobId = insert into Print_Job
			[
				Source_State=srcState
				Metres_Sent=metresSent
				Metres_Returned=0
				Sent_On=zoho.currentdate
				Job_Status="At_Printer"
				Remarks=remarks
				Added_User=zoho.loginuser
			];

			jobId = newJobId.toLong();

			// Lookups and subforms set AFTER the insert - a null lookup fails
			// the whole insert block, and subform rows go in as a Collection in
			// one call.
			for each  pjUpd in Print_Job[ID == jobId]
			{
				pjUpd.Source_Material = srcMatId.toLong();
				pjUpd.Source_Lot = targetLot;
				pjUpd.Printed_Material = tgtMatId.toLong();
				pjUpd.Printer = printerId.toLong();

				sendRows = Collection();
				for each  sndRaw in linesRaw
				{
					snd = sndRaw.toMap();
					sLenS = ifnull(snd.get("lengthCm"),"0").toString().trim();
					if(sLenS == "")
					{
						sLenS = "0";
					}
					sCntS = ifnull(snd.get("count"),"0").toString().trim();
					if(sCntS == "")
					{
						sCntS = "0";
					}
					sLen = sLenS.toDecimal();
					sCnt = sCntS.toDecimal().toLong();
					if(sLen > 0 && sCnt > 0)
					{
						sRow = Print_Job.Send_Lines();
						sRow.Piece_Length_Cm=sLen;
						sRow.Piece_Count=sCnt;
						sendRows.insert(sRow);
					}
				}
				pjUpd.Send_Lines.insert(sendRows);

				// Which source rolls were cut, for the audit trail and so a
				// cancel can state what went out. cancelPrintJob does NOT read
				// these back to un-cut (you cannot un-cut) - the bounced bundle
				// re-enters as one new roll.
				srcRollRows = Collection();
				sri = 0;
				for each  srid in planRollId
				{
					srRow = Print_Job.Source_Rolls();
					srRow.Roll_Label = planLabel.get(sri);
					srRow.Metres = planMetres.get(sri);
					srcRollRows.insert(srRow);
					sri = sri + 1;
				}
				pjUpd.Source_Rolls.insert(srcRollRows);
			}

			info "print job " + jobId + " - " + metresSent + " Mtr " + srcState + " off lot " + lotNumOut + " of " + srcSku + " -> " + tgtSku + " (" + piecesSent + " pieces over " + lineCount + " lines, " + planRollId.size() + " rolls cut)";
		}

		if(errTxt == "" && jobId == 0)
		{
			errTxt = "The print job could not be created";
		}

		if(errTxt == "")
		{
			// Ids forced to string - 18-digit ids break JSON.parse on the widget.
			planJson = "";
			pj2 = 0;
			for each  plbl in planLabel
			{
				if(planJson != "")
				{
					planJson = planJson + ",";
				}
				planJson = planJson + "{\"rollId\":\"" + planRollId.get(pj2) + "\",\"label\":\"" + plbl.replaceAll("\"","'") + "\",\"metres\":" + planMetres.get(pj2) + "}";
				pj2 = pj2 + 1;
			}

			res = "{\"success\":true,\"jobId\":\"" + jobId + "\",\"metresSent\":" + metresSent + ",\"rollPlan\":[" + planJson + "],\"lotWash\":" + lotWashOut + ",\"lotUnwash\":" + lotUnwashOut + ",\"lotInPrint\":" + lotInPrintOut + ",\"materialInPrint\":" + matInPrintOut + "}";
		}
	}
	catch (e)
	{
		// Creator reports every runtime failure to a widget as a generic code 9430,
		// so the real message has to travel back inside the payload.
		errTxt = "DELUGE: " + e.toString();
	}

	if(res == "")
	{
		if(errTxt == "")
		{
			errTxt = "Nothing was sent";
		}
		res = "{\"success\":false,\"error\":\"" + errTxt.replaceAll("\"","'") + "\"}";
	}

	return res;
}
