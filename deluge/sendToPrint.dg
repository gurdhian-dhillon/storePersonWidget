string sendToPrint(string payloadJson)
{
	// Creates one print JOB ORDER: the paper the store hands one printer, one row
	// per piece size, exactly as the paper reads -
	//
	//   { "printerId":"78", "remarks":"",
	//     "lines":[
	//       { "sourceMaterialId":"1", "sourceLotId":"10", "sourceState":"Wash",
	//         "targetMaterialId":"3", "lengthCm":550, "count":5, "rate":175 },
	//       { "sourceMaterialId":"1", "sourceLotId":"10", "sourceState":"Wash",
	//         "targetMaterialId":"4", "lengthCm":550, "count":5, "rate":175 },
	//       { "sourceMaterialId":"2", "sourceLotId":"21", "sourceState":"Unwash",
	//         "targetMaterialId":"7", "lengthCm":275, "count":8, "rate":90 } ] }
	//
	// ONE VENDOR PER JOB ORDER, ANY NUMBER OF BASES. Each row names its own base
	// fabric, the lot (the tone) and washed/unwashed, the printed SKU it becomes,
	// the piece length, how many, and the RATE PER PIECE for that size - the
	// printer prices a 5.50 m piece and a 2.75 m piece differently.
	//
	// ROWS BECOME JOBS BY (base lot, state, printed SKU). A Print_Job is still one
	// tone of one base going to one printed SKU, because everything downstream is
	// built on that: receiveFromPrint creates THAT SKU's lot from THAT job's
	// Send_Lines, cancelPrintJob returns THAT job's metres to THAT lot and state,
	// postPrintAdjustments posts -metres on THAT base. Two sizes of one design off
	// one lot are two Send_Lines of one job; the same design off a second lot is a
	// second job. Every job of the press carries Print_Batch = the first job's
	// number - that batch IS the job order, and raisePrintPO turns it into ONE
	// Purchase Order, one line per priced row.
	//
	// THE RATE IS ON THE ROW (Send_Lines.Rate), not on the job. That column is the
	// price history: print-data.js reads it back and the create form fills a row's
	// rate from the last one for the same printer + design + piece length.
	// Blank / 0 = not priced - the row still goes, it just puts no line on the PO.
	//
	// BUDGET AND ROLLS ARE PER LOT. Rows off one lot are summed: each STATE's metres
	// must fit that state's column, and the lot's rolls are cut for the lot's
	// TOTAL - rolls hold washed and unwashed cloth alike (Σ Roll_Length = Wash +
	// Unwash + In_Wash), so one plan per lot, shortest roll first. That plan is
	// then dealt out to the lot's jobs in order for each job's Source_Rolls. There
	// is no hand-edited roll plan any more; the form shows the auto plan.
	//
	// EVERYTHING IS VALIDATED BEFORE ANYTHING IS WRITTEN - every row, every
	// material, every lot, every budget, every roll. A bad tenth row must not leave
	// the first nine sent.
	//
	// NO MINTING. Printed SKUs are created in Zoho Inventory and pushed to Creator.
	// The pick is his; the only system rule is THE SAME WIDTH as the base - a piece
	// coming back has to be full width of both, or the allocator is handed cloth it
	// cannot cut as it expects. (The "printed fabric" Type_field filter is OFF, here
	// and in the widget.) No Fabric_Piece, no Pattern: printed stock is ordinary
	// short rolls, created by receiveFromPrint. See docs/printing-v2-plan.md §14.
	//
	// PRINTING IS A STORE-SIDE CONVERSION, NOT A PRODUCTION STAGE. It does not go
	// near sendToThirdParty, Stage_Log or Stage_Assignment.
	//
	// THE LOT HOLDS THE TRUTH, Raw_Material HOLDS A MAINTAINED TOTAL. Both are
	// written here, in one pass. The SKU total does not change at send: Wash /
	// Unwash goes down, In_Print_Qty goes up, mirrored on the parent.
	//
	// MOVE THE LEDGER FIRST, WRITE THE JOBS SECOND. No transaction here, so pick
	// the safer failure: a move with no job leaves metres parked in In_Print_Qty
	// and rolls short - visible to reconcileRawMaterial, correctable by hand,
	// invents nothing. A job with no move could be cancelled and credit cloth that
	// never left. Stuck beats imaginary.
	//
	// AFTER THE JOBS: postPrintAdjustments per job (-metres on the base, in Zoho
	// Inventory) and raisePrintPO for the batch, each in its own try - neither can
	// make a send that happened look failed.
	//
	// HELD AS PARALLEL LISTS AND MAPS, never a List of Maps - a hand-appended List
	// of maps does not reliably survive being iterated later in Deluge, and
	// List.set() does not exist (CLAUDE.md). Map.put() overwrites, so running
	// totals live in Maps keyed by text.
	//
	// ONE EXIT, AT THE BOTTOM. Deluge's "all paths return" check does NOT count a
	// return inside try/catch, so nothing returns early: errTxt is set, later
	// blocks guard on it, and the one return is after the catch.

	res = "";
	errTxt = "";

	try
	{
		inp = payloadJson.toMap();

		printerId = ifnull(inp.get("printerId"),"").toString().trim();
		remarks = ifnull(inp.get("remarks"),"").toString().trim().replaceAll("\"","'");

		// size() is right - this is a List, not a query result.
		rowsRaw = ifnull(inp.get("lines"),list());

		if(printerId == "" || printerId.isNumber() == false)
		{
			errTxt = "No printer chosen - a job order goes to one printer";
		}
		if(errTxt == "" && rowsRaw.size() == 0)
		{
			errTxt = "Nothing to send - add at least one line";
		}
		// Bounded: every row costs a few statements and every new material or lot
		// a query. An unbounded list is the uncatchable statement limit.
		if(errTxt == "" && rowsRaw.size() > 40)
		{
			errTxt = "At most 40 lines in one job order - split it into two";
		}

		// Nested rather than && onto the guard - Deluge is not dependable about
		// short-circuiting and .toLong() on an empty id would throw.
		if(errTxt == "")
		{
			if(Third_Party[ID == printerId.toLong()].count() == 0)
			{
				errTxt = "Printer not found";
			}
		}

		//--------------------------------------------------------------------
		// PASS 1 - THE ROWS. Each is checked on its own, then its materials and
		// its lot are checked ONCE (cached by id), then it is added to its job
		// group and to its lot's running totals.
		//--------------------------------------------------------------------
		// material id -> "1" once checked, plus what later blocks need
		matOk = Map();
		matSku = Map();
		matWidth = Map();

		// lot id -> facts, read once
		lotOk = Map();
		lotNum = Map();
		lotMat = Map();
		lotWashM = Map();
		lotUnwashM = Map();

		// job groups, in first-seen order: key = lot|state|target
		gKeys = List();
		gSrcMat = List();
		gLot = List();
		gState = List();
		gTgt = List();
		gMetres = Map();
		gPieces = Map();
		gAmount = Map();

		// lot + state budgets, in first-seen order
		lsKeys = List();
		lsLot = List();
		lsState = List();
		lsMat = List();
		needLS = Map();

		// lots, in first-seen order, and each lot's total for the roll plan
		lotOrder = List();
		needLot = Map();

		totalCm = 0.0;
		piecesSent = 0;
		rowNo = 0;

		if(errTxt == "")
		{
			for each  rRaw in rowsRaw
			{
				if(errTxt == "")
				{
					rowNo = rowNo + 1;
					rw = rRaw.toMap();

					sMat = ifnull(rw.get("sourceMaterialId"),"").toString().trim();
					sLot = ifnull(rw.get("sourceLotId"),"").toString().trim();
					sState = ifnull(rw.get("sourceState"),"").toString().trim();
					tMat = ifnull(rw.get("targetMaterialId"),"").toString().trim();

					// Creator / JSON blanks are EMPTY, not null - normalise
					// before .toDecimal(), which throws on empty.
					lStr = ifnull(rw.get("lengthCm"),"0").toString().trim();
					if(lStr == "")
					{
						lStr = "0";
					}
					cStr = ifnull(rw.get("count"),"0").toString().trim();
					if(cStr == "")
					{
						cStr = "0";
					}
					rtStr = ifnull(rw.get("rate"),"0").toString().trim();
					if(rtStr == "")
					{
						rtStr = "0";
					}
					rLen = lStr.toDecimal();
					rCntDec = cStr.toDecimal();
					rCnt = rCntDec.toLong();
					rRate = rtStr.toDecimal();

					if(sMat == "" || sMat.isNumber() == false)
					{
						errTxt = "Line " + rowNo + ": no base fabric chosen";
					}
					else if(sLot == "" || sLot.isNumber() == false)
					{
						errTxt = "Line " + rowNo + ": no lot chosen - the tone that goes out matters";
					}
					else if(sState != "Wash" && sState != "Unwash")
					{
						errTxt = "Line " + rowNo + ": washed or unwashed?";
					}
					else if(tMat == "" || tMat.isNumber() == false)
					{
						errTxt = "Line " + rowNo + ": no print fabric chosen";
					}
					else if(tMat == sMat)
					{
						errTxt = "Line " + rowNo + ": base and print fabric are the same material";
					}
					else if(rLen <= 0)
					{
						errTxt = "Line " + rowNo + ": needs a piece length in cm";
					}
					else if(rCntDec <= 0)
					{
						errTxt = "Line " + rowNo + ": needs a piece count above zero";
					}
					else if(rCnt.toDecimal() != rCntDec)
					{
						errTxt = "Line " + rowNo + ": piece count must be a whole number - " + cStr + " is not";
					}
					else if(rRate < 0)
					{
						errTxt = "Line " + rowNo + ": the rate cannot be negative";
					}

					//---- base fabric, once -----------------------------------
					// Must be a fabric, have a width, and exist in Zoho Inventory
					// (sending posts -metres on it there). Refused HERE, before
					// anything moves - the same reason postTransferOrders refuses a
					// whole voucher with an unmapped line.
					if(errTxt == "" && ifnull(matOk.get(sMat),"") == "")
					{
						bRecs = Raw_Material[ID == sMat.toLong()];
						if(bRecs.count() == 0)
						{
							errTxt = "Line " + rowNo + ": base fabric not found";
						}
						else
						{
							for each  bm in bRecs
							{
								bSku = ifnull(bm.SKU,"").toString().trim().replaceAll("\"","'");
								// Tested AS TEXT - a Decision box gives a boolean, a
								// yes/no dropdown "Yes", an untouched field EMPTY.
								bFab = ifnull(bm.Is_Fabric,"").toString().trim().toLowerCase();
								bWid = ifnull(bm.Fabric_Width_Inches,"").toString().trim();
								bInv = ifnull(bm.Inventory_Item_ID,"").toString().trim();
								if(bWid == "")
								{
									bWid = "0";
								}
								if(bFab != "true" && bFab != "yes" && bFab != "1" && bFab != "y")
								{
									errTxt = bSku + " is not a fabric - printing applies to fabric only";
								}
								else if(bWid.toDecimal() <= 0)
								{
									errTxt = bSku + " has no fabric width on record - set it before printing";
								}
								else if(bInv == "")
								{
									errTxt = bSku + " has no Zoho Inventory item mapped - map it before sending cloth to print";
								}
								else
								{
									matOk.put(sMat,"1");
									matSku.put(sMat,bSku);
									matWidth.put(sMat,bWid);
								}
							}
						}
					}

					//---- print fabric, once ----------------------------------
					// Same three checks - receiving posts +metres on it.
					if(errTxt == "" && ifnull(matOk.get(tMat),"") == "")
					{
						pRecs = Raw_Material[ID == tMat.toLong()];
						if(pRecs.count() == 0)
						{
							errTxt = "Line " + rowNo + ": print fabric not found";
						}
						else
						{
							for each  pm in pRecs
							{
								pSku = ifnull(pm.SKU,"").toString().trim().replaceAll("\"","'");
								pFab = ifnull(pm.Is_Fabric,"").toString().trim().toLowerCase();
								pWid = ifnull(pm.Fabric_Width_Inches,"").toString().trim();
								pInv = ifnull(pm.Inventory_Item_ID,"").toString().trim();
								if(pWid == "")
								{
									pWid = "0";
								}
								if(pFab != "true" && pFab != "yes" && pFab != "1" && pFab != "y")
								{
									errTxt = pSku + " is not a fabric";
								}
								else if(pWid.toDecimal() <= 0)
								{
									errTxt = pSku + " has no fabric width on record - set it before printing";
								}
								else if(pInv == "")
								{
									errTxt = pSku + " has no Zoho Inventory item mapped - map it before sending cloth to print";
								}
								else
								{
									matOk.put(tMat,"1");
									matSku.put(tMat,pSku);
									matWidth.put(tMat,pWid);
								}
							}
						}
					}

					//---- same width ------------------------------------------
					// Compared as NUMBERS - "60" and "60.0" are one width.
					if(errTxt == "")
					{
						wDiff = matWidth.get(sMat).toString().toDecimal() - matWidth.get(tMat).toString().toDecimal();
						if(wDiff < 0)
						{
							wDiff = wDiff * -1;
						}
						if(wDiff > 0.01)
						{
							errTxt = "Line " + rowNo + ": width mismatch - " + matSku.get(sMat) + " is " + matWidth.get(sMat) + " in, " + matSku.get(tMat) + " is " + matWidth.get(tMat) + " in. A printed piece must be full width of both.";
						}
					}

					//---- the lot, once ---------------------------------------
					// Must belong to THIS base, not be Blocked, and have rolls.
					if(errTxt == "" && ifnull(lotOk.get(sLot),"") == "")
					{
						lRecs = Raw_Material_Lot[ID == sLot.toLong()];
						if(lRecs.count() == 0)
						{
							errTxt = "Line " + rowNo + ": lot not found";
						}
						else
						{
							for each  lchk in lRecs
							{
								lNumTxt = ifnull(lchk.Lot_Number,"").toString().trim().replaceAll("\"","'");
								lwS = ifnull(lchk.Wash_Quantity,"0").toString().trim();
								if(lwS == "")
								{
									lwS = "0";
								}
								luS = ifnull(lchk.Unwash_Quantity,"0").toString().trim();
								if(luS == "")
								{
									luS = "0";
								}
								lRollCount = 0;
								for each  rcCnt in lchk.Lot_Rolls
								{
									lRollCount = lRollCount + 1;
								}

								if(ifnull(lchk.Material,"").toString().trim() != sMat)
								{
									errTxt = "Line " + rowNo + ": lot " + lNumTxt + " belongs to a different material";
								}
								else if(ifnull(lchk.Status,"Active").toString().trim() == "Blocked")
								{
									errTxt = "Line " + rowNo + ": lot " + lNumTxt + " is blocked - nothing can be sent off it";
								}
								else if(lRollCount == 0)
								{
									errTxt = "Lot " + lNumTxt + " has no rolls recorded - it must be received into rolls before cloth can be sent to print";
								}
								else
								{
									lotOk.put(sLot,"1");
									lotNum.put(sLot,lNumTxt);
									lotMat.put(sLot,sMat);
									lotWashM.put(sLot,lwS);
									lotUnwashM.put(sLot,luS);
									lotOrder.add(sLot);
									needLot.put(sLot,"0");
								}
							}
						}
					}
					else if(errTxt == "" && ifnull(lotMat.get(sLot),"").toString() != sMat)
					{
						errTxt = "Line " + rowNo + ": lot " + lotNum.get(sLot) + " belongs to a different material";
					}

					//---- add the row to its job and its lot ------------------
					if(errTxt == "")
					{
						rCm = rLen * rCnt;
						rMtr = rCm / 100;

						gk = sLot + "|" + sState + "|" + tMat;
						if(gKeys.contains(gk) == false)
						{
							gKeys.add(gk);
							gSrcMat.add(sMat);
							gLot.add(sLot);
							gState.add(sState);
							gTgt.add(tMat);
							gMetres.put(gk,"0");
							gPieces.put(gk,"0");
							gAmount.put(gk,"0");
						}
						gMetres.put(gk,gMetres.get(gk).toString().toDecimal() + rMtr);
						gPieces.put(gk,gPieces.get(gk).toString().toLong() + rCnt);
						gAmount.put(gk,gAmount.get(gk).toString().toDecimal() + (rCnt * rRate));

						lsk = sLot + "|" + sState;
						if(lsKeys.contains(lsk) == false)
						{
							lsKeys.add(lsk);
							lsLot.add(sLot);
							lsState.add(sState);
							lsMat.add(sMat);
							needLS.put(lsk,"0");
						}
						needLS.put(lsk,needLS.get(lsk).toString().toDecimal() + rMtr);
						needLot.put(sLot,needLot.get(sLot).toString().toDecimal() + rMtr);

						totalCm = totalCm + rCm;
						piecesSent = piecesSent + rCnt;
					}
				}
			}
		}

		// Bounded too: each job is an insert, an Inventory post and a few
		// queries.
		if(errTxt == "" && gKeys.size() > 15)
		{
			errTxt = "At most 15 base/print fabric combinations in one job order - split it into two";
		}

		metresSent = 0.0;
		if(errTxt == "")
		{
			metresSent = totalCm / 100;
			if(metresSent <= 0)
			{
				errTxt = "Nothing to send - the lines add up to zero";
			}
		}

		//--------------------------------------------------------------------
		// THE BUDGETS, per lot and state. REJECT, NEVER SILENTLY TRIM - a
		// trimmed Metres_Sent disagreeing with its Send_Lines would read as
		// printer loss for ever.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			bi = 0;
			for each  bKey in lsKeys
			{
				if(errTxt == "")
				{
					bLot = lsLot.get(bi);
					bState = lsState.get(bi);
					bHave = lotUnwashM.get(bLot).toString().toDecimal();
					bWord = "unwashed";
					if(bState == "Wash")
					{
						bHave = lotWashM.get(bLot).toString().toDecimal();
						bWord = "washed";
					}
					bNeed = needLS.get(bKey).toString().toDecimal();
					if(bNeed > bHave + 0.0001)
					{
						errTxt = "Lot " + lotNum.get(bLot) + " of " + matSku.get(lsMat.get(bi)) + " has only " + bHave + " Mtr " + bWord + " - this job order needs " + bNeed;
					}
				}
				bi = bi + 1;
			}
		}

		//--------------------------------------------------------------------
		// THE ROLL PLAN, one per lot: SHORTEST Available roll first
		// (consolidates the rack - a short roll left sitting becomes scrap),
		// min(rollLen, remaining) off each until the lot's total is covered.
		// All lots' plans go into one set of parallel lists, tagged by lot.
		//--------------------------------------------------------------------
		planLot = List();
		planRollId = List();
		planLabel = List();
		planMetres = List();

		if(errTxt == "")
		{
			for each  pLot in lotOrder
			{
				if(errTxt == "")
				{
					lotNeed = needLot.get(pLot).toString().toDecimal();

					// Snapshot the Available rolls: id, label, current length.
					rollIds = List();
					rollLabels = List();
					rollLens = List();
					rollCounter = List();
					rcI = 0;
					for each  lsnap in Raw_Material_Lot[ID == pLot.toLong()]
					{
						for each  rsnap in lsnap.Lot_Rolls
						{
							// EMPTY is not null - a blank status is Available, the
							// same as print-data.js reads it.
							rStatus = ifnull(rsnap.Roll_Status,"Available").toString().trim();
							if(rStatus == "")
							{
								rStatus = "Available";
							}
							rLenS = ifnull(rsnap.Roll_Length,"0").toString().trim();
							if(rLenS == "")
							{
								rLenS = "0";
							}
							rLen = rLenS.toDecimal();
							if(rStatus == "Available" && rLen > 0)
							{
								rollIds.add(rsnap.ID.toString());
								rollLabels.add(ifnull(rsnap.Roll_Label,"").toString().trim().replaceAll("\"","'"));
								rollLens.add(rLen);
								rollCounter.add(rcI);
								rcI = rcI + 1;
							}
						}
					}

					if(rollIds.size() == 0)
					{
						errTxt = "Lot " + lotNum.get(pLot) + " has no cuttable rolls (all consumed or blocked)";
					}
					else
					{
						// Selection sort by length, append-only (no List.set).
						// rollCounter bounds the outer pass so the inner pass is
						// the only iterator over rollIds - two live iterators over
						// one list do not work. A tie on length goes to the
						// earlier position: only a STRICTLY shorter roll wins.
						usedPos = List();
						for each  pcnt in rollCounter
						{
							bestPos = -1;
							bestLen = 0.0;
							scanPos = 0;
							for each  sc in rollIds
							{
								if(usedPos.contains(scanPos) == false)
								{
									scLen = rollLens.get(scanPos);
									takeThis = false;
									if(bestPos < 0)
									{
										takeThis = true;
									}
									else if(scLen < bestLen)
									{
										takeThis = true;
									}
									if(takeThis == true)
									{
										bestPos = scanPos;
										bestLen = scLen;
									}
								}
								scanPos = scanPos + 1;
							}
							if(bestPos >= 0)
							{
								usedPos.add(bestPos);
							}
						}

						remain = lotNeed;
						for each  op in usedPos
						{
							if(remain > 0.001)
							{
								opLen = rollLens.get(op);
								take = opLen;
								if(take > remain)
								{
									take = remain;
								}
								planLot.add(pLot);
								planRollId.add(rollIds.get(op));
								planLabel.add(rollLabels.get(op));
								planMetres.add(take);
								remain = remain - take;
							}
						}

						if(remain > 0.01)
						{
							errTxt = "Lot " + lotNum.get(pLot) + " has " + (lotNeed - remain) + " Mtr across its rolls, " + lotNeed + " Mtr asked for";
						}
					}
				}
			}
		}

		//--------------------------------------------------------------------
		// MOVE THE LEDGER. Rolls, then lots, then parents - all before any job.
		//
		// TWO PASSES OVER THE ROLLS. Pass 1 re-reads every planned roll's
		// CURRENT length (inside this execution - the concurrency guard) and
		// checks the WHOLE plan fits before a single row is touched. Only then
		// does pass 2 write.
		//--------------------------------------------------------------------
		if(errTxt == "")
		{
			pIdx = 0;
			for each  pid in planRollId
			{
				if(errTxt == "")
				{
					pTake = planMetres.get(pIdx);
					pFound = false;
					for each  lotChk in Raw_Material_Lot[ID == planLot.get(pIdx).toLong()]
					{
						for each  rollChk in lotChk.Lot_Rolls
						{
							if(rollChk.ID.toString() == pid)
							{
								pFound = true;
								rHaveS = ifnull(rollChk.Roll_Length,"0").toString().trim();
								if(rHaveS == "")
								{
									rHaveS = "0";
								}
								if(pTake > rHaveS.toDecimal() + 0.0001)
								{
									errTxt = "Roll " + planLabel.get(pIdx) + " has " + rHaveS.toDecimal() + " Mtr, the cut plan needs " + pTake + " - a concurrent change moved the stock. Nothing was sent; reload and try again.";
								}
							}
						}
					}
					if(pFound == false && errTxt == "")
					{
						errTxt = "Roll " + planLabel.get(pIdx) + " vanished before it could be cut - reload the screen";
					}
				}
				pIdx = pIdx + 1;
			}
		}

		if(errTxt == "")
		{
			pIdx = 0;
			for each  pid2 in planRollId
			{
				pTake2 = planMetres.get(pIdx);
				for each  lotMv in Raw_Material_Lot[ID == planLot.get(pIdx).toLong()]
				{
					for each  rollRow in lotMv.Lot_Rolls
					{
						if(rollRow.ID.toString() == pid2)
						{
							rHave2S = ifnull(rollRow.Roll_Length,"0").toString().trim();
							if(rHave2S == "")
							{
								rHave2S = "0";
							}
							rLeft = rHave2S.toDecimal() - pTake2;
							if(rLeft < 0)
							{
								rLeft = 0;
							}
							rollRow.Roll_Length = rLeft;
							if(rLeft <= 0)
							{
								rollRow.Roll_Status = "Consumed";
							}
						}
					}
				}
				pIdx = pIdx + 1;
			}

			// Lots, then parents, one lot+state at a time. Read FRESH off the
			// record each time - one lot may give washed and unwashed cloth in
			// the same press, and the parent is the sum over every lot.
			mi = 0;
			for each  mKey in lsKeys
			{
				mLot = lsLot.get(mi);
				mState = lsState.get(mi);
				mMat = lsMat.get(mi);
				mNeed = needLS.get(mKey).toString().toDecimal();

				for each  lotUpd in Raw_Material_Lot[ID == mLot.toLong()]
				{
					uwS = ifnull(lotUpd.Wash_Quantity,"0").toString().trim();
					if(uwS == "")
					{
						uwS = "0";
					}
					uuS = ifnull(lotUpd.Unwash_Quantity,"0").toString().trim();
					if(uuS == "")
					{
						uuS = "0";
					}
					upS = ifnull(lotUpd.In_Print_Qty,"0").toString().trim();
					if(upS == "")
					{
						upS = "0";
					}
					if(mState == "Wash")
					{
						lotUpd.Wash_Quantity = uwS.toDecimal() - mNeed;
					}
					else
					{
						lotUpd.Unwash_Quantity = uuS.toDecimal() - mNeed;
					}
					lotUpd.In_Print_Qty = upS.toDecimal() + mNeed;
				}

				for each  rmUpd in Raw_Material[ID == mMat.toLong()]
				{
					mwS = ifnull(rmUpd.Wash_Quantity,"0").toString().trim();
					if(mwS == "")
					{
						mwS = "0";
					}
					muS = ifnull(rmUpd.Unwash_Quantity,"0").toString().trim();
					if(muS == "")
					{
						muS = "0";
					}
					mpS = ifnull(rmUpd.In_Print_Qty,"0").toString().trim();
					if(mpS == "")
					{
						mpS = "0";
					}
					if(mState == "Wash")
					{
						rmUpd.Wash_Quantity = mwS.toDecimal() - mNeed;
					}
					else
					{
						rmUpd.Unwash_Quantity = muS.toDecimal() - mNeed;
					}
					qW = ifnull(rmUpd.Wash_Quantity,"0").toString().trim();
					qU = ifnull(rmUpd.Unwash_Quantity,"0").toString().trim();
					qA = ifnull(rmUpd.Unallocated_Qty,"0").toString().trim();
					rmUpd.Quantity = if(qW=="",0.0,qW.toDecimal()) + if(qU=="",0.0,qU.toDecimal()) + if(qA=="",0.0,qA.toDecimal());
					rmUpd.In_Print_Qty = mpS.toDecimal() + mNeed;
				}
				mi = mi + 1;
			}
		}

		//--------------------------------------------------------------------
		// THE JOBS - one per (lot, state, print fabric). Job_Status, not Status -
		// six forms already share that link name.
		//
		// THE JOB NUMBER, PJ-00001 upward - the reference on the Zoho Inventory
		// adjustments, so the document there and the job here share one
		// identifier. SORTED ON ID, never on Job_No (a text sort reads PJ-99999
		// above PJ-100000), largest parsed number wins. Read once; the jobs take
		// the next numbers in order. THE BATCH is the first one's number.
		//--------------------------------------------------------------------
		lastJNum = 0;
		if(errTxt == "")
		{
			lastJobs = Print_Job[ID != 0] sort by ID desc range from 1 to 10;
			for each  lj in lastJobs
			{
				ljTxt = ifnull(lj.Job_No,"").toString().trim();
				if(ljTxt != "")
				{
					jParts = ljTxt.toList("-");
					if(jParts.size() > 1)
					{
						jNumTxt = jParts.get(jParts.size() - 1).trim();
						if(jNumTxt.isNumber() == true)
						{
							jSeen = jNumTxt.toLong();
							if(jSeen > lastJNum)
							{
								lastJNum = jSeen;
							}
						}
					}
				}
			}
		}

		batchNo = "";
		newJobIds = List();
		newJobNos = List();

		// How much of each planned roll earlier jobs have been dealt, keyed by
		// plan position as text.
		usedOnRoll = Map();

		if(errTxt == "")
		{
			gi = 0;
			for each  gKey in gKeys
			{
				nextJNum = lastJNum + 1 + gi;
				if(nextJNum < 10)
				{
					jPad = "0000" + nextJNum;
				}
				else if(nextJNum < 100)
				{
					jPad = "000" + nextJNum;
				}
				else if(nextJNum < 1000)
				{
					jPad = "00" + nextJNum;
				}
				else if(nextJNum < 10000)
				{
					jPad = "0" + nextJNum;
				}
				else
				{
					jPad = "" + nextJNum;
				}
				jobNo = "PJ-" + jPad;
				if(gi == 0)
				{
					batchNo = jobNo;
				}

				thisSrc = gSrcMat.get(gi);
				thisLot = gLot.get(gi);
				thisState = gState.get(gi);
				thisTgt = gTgt.get(gi);
				thisMetres = gMetres.get(gKey).toString().toDecimal();

				// Inv_Out_Status starts Pending - the OUT adjustment is owed from
				// the moment the cloth leaves. No comments inside the insert block.
				newJobId = insert into Print_Job
				[
					Job_No=jobNo
					Print_Batch=batchNo
					Inv_Out_Status="Pending"
					Source_State=thisState
					Metres_Sent=thisMetres
					Metres_Returned=0
					Sent_On=zoho.currentdate
					Job_Status="At_Printer"
					Remarks=remarks
					Added_User=zoho.loginuser
				];

				jobId = newJobId.toLong();
				newJobIds.add(jobId.toString());
				newJobNos.add(jobNo);

				// Lookups and subforms set AFTER the insert - a null lookup fails
				// the whole insert block, and subform rows go in as a Collection.
				for each  pjUpd in Print_Job[ID == jobId]
				{
					pjUpd.Source_Material = thisSrc.toLong();
					pjUpd.Source_Lot = thisLot.toLong();
					pjUpd.Printed_Material = thisTgt.toLong();
					pjUpd.Printer = printerId.toLong();

					// This job's rows, in the order he typed them, each with
					// its own rate.
					sendRows = Collection();
					for each  sndRaw in rowsRaw
					{
						snd = sndRaw.toMap();
						sk = ifnull(snd.get("sourceLotId"),"").toString().trim() + "|" + ifnull(snd.get("sourceState"),"").toString().trim() + "|" + ifnull(snd.get("targetMaterialId"),"").toString().trim();
						if(sk == gKey)
						{
							sLenS = ifnull(snd.get("lengthCm"),"0").toString().trim();
							if(sLenS == "")
							{
								sLenS = "0";
							}
							sCntS = ifnull(snd.get("count"),"0").toString().trim();
							if(sCntS == "")
							{
								sCntS = "0";
							}
							sRateS = ifnull(snd.get("rate"),"0").toString().trim();
							if(sRateS == "")
							{
								sRateS = "0";
							}
							sRow = Print_Job.Send_Lines();
							sRow.Piece_Length_Cm=sLenS.toDecimal();
							sRow.Piece_Count=sCntS.toDecimal().toLong();
							sRow.Rate=sRateS.toDecimal();
							sendRows.insert(sRow);
						}
					}
					pjUpd.Send_Lines.insert(sendRows);

					// Which rolls this job's pieces came off: its lot's plan,
					// dealt out in order - this job takes whatever earlier jobs
					// on the same lot left on each roll. For the audit trail and
					// so a cancel can say what went out; cancelPrintJob does not
					// read them back (you cannot un-cut).
					srcRollRows = Collection();
					need = thisMetres;
					sri = 0;
					for each  srid in planRollId
					{
						if(need > 0.001 && planLot.get(sri) == thisLot)
						{
							usedS = ifnull(usedOnRoll.get(sri.toString()),"0").toString().trim();
							if(usedS == "")
							{
								usedS = "0";
							}
							usedK = usedS.toDecimal();
							leftK = planMetres.get(sri) - usedK;
							if(leftK > 0.001)
							{
								takeK = leftK;
								if(takeK > need)
								{
									takeK = need;
								}
								srRow = Print_Job.Source_Rolls();
								srRow.Roll_Label = planLabel.get(sri);
								srRow.Metres = takeK;
								srcRollRows.insert(srRow);
								usedOnRoll.put(sri.toString(),usedK + takeK);
								need = need - takeK;
							}
						}
						sri = sri + 1;
					}
					pjUpd.Source_Rolls.insert(srcRollRows);
				}

				info "print job " + jobNo + " (" + jobId + ") - " + thisMetres + " Mtr " + thisState + " off lot " + lotNum.get(thisLot) + " of " + matSku.get(thisSrc) + " -> " + matSku.get(thisTgt) + ", batch " + batchNo;
				gi = gi + 1;
			}
		}

		if(errTxt == "" && newJobIds.size() == 0)
		{
			errTxt = "The print job could not be created";
		}

		//--------------------------------------------------------------------
		// ZOHO INVENTORY: -Metres_Sent on each job's base, now. Its own try per
		// job, never an error for this call - the cloth has left and the jobs
		// exist. A leg that did not post stays Pending with the reason in
		// Inv_Last_Error, and postPrintAdjustments("") retries it. Read back off
		// the record, so what the screen is told is what is stored.
		// `inventory` is Posted only when every job's OUT posted.
		//--------------------------------------------------------------------
		invStatus = "Posted";
		invError = "";
		jobsJson = "";
		if(errTxt == "")
		{
			ji = 0;
			for each  njId in newJobIds
			{
				oneErr = "";
				try
				{
					invRes = thisapp.postPrintAdjustments(njId,"false");
				}
				catch (eInv)
				{
					oneErr = "Inventory post did not run: " + eInv.toString();
				}
				oneSt = "";
				for each  pjInv in Print_Job[ID == njId.toLong()]
				{
					oneSt = ifnull(pjInv.Inv_Out_Status,"").toString().trim();
					if(oneErr == "")
					{
						oneErr = ifnull(pjInv.Inv_Last_Error,"").toString().trim();
					}
				}
				if(oneSt != "Posted")
				{
					invStatus = "Pending";
					if(oneErr != "")
					{
						if(invError != "")
						{
							invError = invError + " | ";
						}
						invError = invError + newJobNos.get(ji) + ": " + oneErr;
					}
				}

				jgKey = gKeys.get(ji);
				if(jobsJson != "")
				{
					jobsJson = jobsJson + ",";
				}
				jobsJson = jobsJson + "{\"jobId\":\"" + njId + "\",\"jobNo\":\"" + newJobNos.get(ji) + "\",\"sourceSku\":\"" + matSku.get(gSrcMat.get(ji)) + "\",\"lotNumber\":\"" + lotNum.get(gLot.get(ji)) + "\",\"state\":\"" + gState.get(ji) + "\",\"sku\":\"" + matSku.get(gTgt.get(ji)) + "\",\"pieces\":" + gPieces.get(jgKey) + ",\"metresSent\":" + gMetres.get(jgKey) + ",\"amount\":" + gAmount.get(jgKey) + ",\"inventory\":\"" + oneSt + "\"}";
				ji = ji + 1;
			}
		}

		//--------------------------------------------------------------------
		// THE PURCHASE ORDER. One per job order, through raisePrintPO, in its
		// own try: the cloth has left and the jobs exist, so a PO failure
		// (service item missing, printer unmapped, Inventory down) must not undo
		// a send that happened. raisePrintPO stamps PO_Number on every job of the
		// batch, or leaves the reason in PO_Last_Error for the card to show, and
		// is safe to run again: raisePrintPO(batchNo,"false").
		//--------------------------------------------------------------------
		poNumberTxt = "";
		poErrTxt = "";
		poNotPriced = false;
		if(errTxt == "")
		{
			try
			{
				poResTxt = thisapp.raisePrintPO(batchNo,"false");
				poResMap = poResTxt.toMap();
				if(ifnull(poResMap.get("success"),"false").toString() == "true")
				{
					poNumberTxt = ifnull(poResMap.get("poNumber"),"").toString();
					if(ifnull(poResMap.get("notPriced"),"false").toString() == "true")
					{
						poNotPriced = true;
					}
				}
				else
				{
					poErrTxt = ifnull(poResMap.get("error"),"PO not raised").toString();
				}
			}
			catch (poErr)
			{
				poErrTxt = "raisePrintPO did not run: " + poErr.toString();
			}
		}

		if(errTxt == "")
		{
			// What was cut, per roll, for the screen. Ids forced to string.
			cutsJson = "";
			ci = 0;
			for each  clbl in planLabel
			{
				if(cutsJson != "")
				{
					cutsJson = cutsJson + ",";
				}
				cutsJson = cutsJson + "{\"lotNumber\":\"" + lotNum.get(planLot.get(ci)) + "\",\"rollId\":\"" + planRollId.get(ci) + "\",\"label\":\"" + clbl.replaceAll("\"","'") + "\",\"metres\":" + planMetres.get(ci) + "}";
				ci = ci + 1;
			}

			res = "{\"success\":true,\"batchNo\":\"" + batchNo + "\",\"jobId\":\"" + newJobIds.get(0) + "\",\"jobNo\":\"" + newJobNos.get(0) + "\",\"jobs\":[" + jobsJson + "],\"poNumber\":\"" + poNumberTxt.replaceAll("\"","'") + "\",\"poError\":\"" + poErrTxt.replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ") + "\",\"poNotPriced\":" + poNotPriced + ",\"inventory\":\"" + invStatus + "\",\"inventoryError\":\"" + invError.replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ") + "\",\"metresSent\":" + metresSent + ",\"pieces\":" + piecesSent + ",\"cuts\":[" + cutsJson + "]}";
		}
	}
	catch (e)
	{
		// Creator reports every runtime failure to a widget as a generic code 9430,
		// so the real message has to travel back inside the payload.
		errTxt = "DELUGE: " + e.toString();
	}

	if(res == "")
	{
		if(errTxt == "")
		{
			errTxt = "Nothing was sent";
		}
		res = "{\"success\":false,\"error\":\"" + errTxt.replaceAll("\"","'").replaceAll("\r","").replaceAll("\n"," | ").replaceAll("\t"," ") + "\"}";
	}

	return res;
}
