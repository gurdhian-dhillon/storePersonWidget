string getPackingHistory(string payloadJson)
{
	// Orders that have been packed, for the packing screen's History tab.
	// POST, one argument: payloadJson. { "supervisorId":"123" } - empty means
	// every supervisor.
	//
	// Reads Packing, the record savePackingRecord writes. The sales order's
	// status can say an order reached "Packed"; only this can say what went into
	// which carton, what it measured, what it weighed and who packed it.
	//
	// EVERYTHING THE RECORD HOLDS COMES BACK. A packed order is answered for
	// months later - a customer query, a damage claim, a courier reweigh - and
	// the answer is always about ONE BOX. So every box returns its carton, the
	// six dimensions actually used, whether an inner carton went in, its three
	// weights, and every item inside it with the unit weight the estimate was
	// built from. Summarising any of that here would mean going to Creator to
	// answer the question the screen exists to answer.
	//
	// TWO SUBFORMS, JOINED BY Box_No. Packed_Boxes is one row per physical box;
	// Packed_Box_Items is one row per item in a box. Creator has no subform
	// inside a subform, so the items are read ONCE into a map keyed by box number
	// and the box loop reads from it - not a query per box, which is the shape
	// that trips the uncatchable statement limit.
	//
	// LEGACY BOXES STILL RENDER, and there are two of them to handle:
	//   - a box packed before the split has no Packed_Box_Items rows at all. Its
	//     single item is still on the box row itself (SKU, Item_Name, Quantity,
	//     Line_No), so it is read from there and shown as a one-item box.
	//   - a box packed before the dimensions were editable stored none of them.
	//     Its outer dimensions read as zero, so they fall back to Box_Master -
	//     which is where they came from at the time, and is therefore the truth
	//     about that box unless somebody has since edited the carton.
	// Neither is a special case on screen. A box is a box.
	//
	// SHAPED ON getFinishingHistory, deliberately, because the two have the same
	// problem and it is not the one getStoreIssueHistory has:
	//
	//   - PACKING HAS NO DATE FIELD. savePackingRecord writes no Packed_On, so
	//     Added_Time is the only record of when it happened, and there is nothing
	//     for a From/To picker to filter on. Adding one is a Creator form change
	//     and a second writer of a fact the record already carries.
	//   - THE SUPERVISOR IS NOT ON THE RECORD EITHER. Packing.Employee is the
	//     person who packed it. Which supervisor's order it was comes off
	//     Production_Planning.Assigned_To, exactly as getPackingQueue stamps the
	//     queue, so the filter cannot go in the query - it is decided in code
	//     after the fetch.
	//
	// That second point is why this pages the newest N and filters afterwards
	// rather than using "range from A to B" as a pager. A page boundary applied
	// before a filter decided in code gives a page of fifty that shows three, and
	// a pager whose numbers do not match what is on screen is worse than none.
	//
	// PAGED ALL THE SAME. The statement-execution limit is NOT catchable - it
	// kills the script and the widget gets a bare HTTP 500 with no error card -
	// so the cost has to stop depending on how much has ever been packed.

	res = "{\"errors\":[\"Nothing ran\"]}";

	try
	{
		// Held as TEXT and compared against Assigned_To as text. Assigned_To is a
		// lookup holding a record id while ID is a long, and comparing them as-is
		// is a mixed-type comparison, which THROWS rather than returning false.
		// Empty means no filter.
		supFilter = "";
		raw = ifnull(payloadJson,"").toString().trim();

		if(raw != "")
		{
			inp = raw.toMap();
			supIdTxt = ifnull(inp.get("supervisorId"),"").toString().trim();

			if(supIdTxt != "" && supIdTxt.isNumber() == true)
			{
				supFilter = supIdTxt;
			}
		}

		//------------------------------------------------------------------
		// The carton catalogue, fetched ONCE.
		//
		// Packed_Boxes.Box_Type is a LOOKUP, so Deluge reads it as the record id -
		// printing it puts an 18-digit number where the carton name belongs, which
		// is the same fault getStoreIssueHistory records for materials.
		//
		// A map rather than a query per box row: one order can be thirty cartons
		// and fifty orders is fifteen hundred lookups, which is exactly the shape
		// that trips the uncatchable limit. Box_Master is master data - a dozen
		// rows that do not grow with trading.
		//
		// The dimensions come along for the LEGACY fallback below, pipe-joined
		// into one value because a Deluge Map holds one thing per key:
		//   outL|outW|outH|hasInner|innL|innW|innH
		//------------------------------------------------------------------
		boxNameMap = Map();
		boxDimMap = Map();

		for each  bmC in Box_Master[ID != 0]
		{
			bmKey = bmC.ID.toString();
			boxNameMap.put(bmKey,ifnull(bmC.Box_Name,"").toString().trim().replaceAll("\"","'"));

			bmHasInner = "false";
			if(ifnull(bmC.Has_Inner_Carton,false) == true)
			{
				bmHasInner = "true";
			}

			// Started from an empty string deliberately - a concatenation whose
			// FIRST term is a Decimal is a mixed-type expression, and those throw
			// rather than coerce.
			boxDimMap.put(bmKey,"" + ifnull(bmC.Outer_Length_Cm,0).toDecimal() + "|" + ifnull(bmC.Outer_Width_Cm,0).toDecimal() + "|" + ifnull(bmC.Outer_Height_Cm,0).toDecimal() + "|" + bmHasInner + "|" + ifnull(bmC.Inner_Length_Cm,0).toDecimal() + "|" + ifnull(bmC.Inner_Width_Cm,0).toDecimal() + "|" + ifnull(bmC.Inner_Height_Cm,0).toDecimal());
		}

		// sort by on its own assignment, never inline in a for-each header.
		packRuns = Packing[ID != 0] sort by Added_Time desc range from 1 to 50;

		// A range holds many orders but only a handful of people, so the same few
		// names were being fetched over and over. Same cache the store history
		// uses, for the same reason.
		empCache = Map();

		rowsJson = "";
		shownCount = 0;
		boxTotal = 0;

		for each  pk in packRuns
		{
			soNo = "";
			soSrc = "";
			planNo = "";
			rowSupKey = "";
			rowSupName = "";

			//--------------------------------------------------------------
			// THE SUPERVISOR, off the plan. Nothing downstream of checking
			// carries one, and the walk is already being made for the order
			// number, so the filter costs nothing extra.
			//
			// One order produces exactly one plan, which is what makes taking
			// the plan's supervisor correct here - the same invariant
			// saveProductionPhase relies on to mirror the plan's completion
			// onto the order.
			//--------------------------------------------------------------
			if(pk.Sales_Order != null)
			{
				for each  so in Sales_Order[ID == pk.Sales_Order]
				{
					soNo = ifnull(so.Sales_Order,"").toString().replaceAll("\"","'");
					soSrc = ifnull(so.Order_Source,"").toString().replaceAll("\"","'");
				}

				for each  pl in Production_Planning[Sales_Order == pk.Sales_Order]
				{
					planNo = ifnull(pl.Plan_No,"").toString().replaceAll("\"","'");
					if(pl.Assigned_To != null)
					{
						rowSupKey = pl.Assigned_To.toString();
					}
				}
			}

			// Text against text - see the note on supFilter above.
			keepRow = true;
			if(supFilter != "" && rowSupKey != supFilter)
			{
				keepRow = false;
			}

			if(keepRow == true)
			{
				if(rowSupKey != "")
				{
					rowSupName = ifnull(empCache.get(rowSupKey),"").toString();
					if(rowSupName == "")
					{
						for each  supE in Employee[ID == rowSupKey.toLong()]
						{
							rowSupName = ifnull(supE.Employee_Name,"").toString().replaceAll("\"","'");
						}
						empCache.put(rowSupKey,rowSupName);
					}
				}

				// Who actually packed it. A different person from the supervisor,
				// and the one a query about a carton goes to.
				packedBy = "";
				pkEmpKey = ifnull(pk.Employee,"").toString().trim();
				if(pkEmpKey != "")
				{
					packedBy = ifnull(empCache.get(pkEmpKey),"").toString();
					if(packedBy == "")
					{
						for each  pkE in Employee[ID == pkEmpKey.toLong()]
						{
							packedBy = ifnull(pkE.Employee_Name,"").toString().replaceAll("\"","'");
						}
						empCache.put(pkEmpKey,packedBy);
					}
				}

				// Added_Time is the only record of when this happened - there is
				// no Packed_On field. Formatted here rather than on the widget so
				// a raw Creator date-time never crosses JSON.
				packedOn = "";
				if(pk.Added_Time != null)
				{
					packedOn = pk.Added_Time.toString("dd-MMM-yyyy HH:mm");
				}

				//----------------------------------------------------------
				// THE CONTENTS, read ONCE into a map keyed by box number.
				// Built as a JSON fragment per box as it goes, so the box loop
				// below concatenates rather than re-walking.
				//----------------------------------------------------------
				itemsByBox = Map();
				piecesByBox = Map();

				for each  bi in pk.Packed_Box_Items
				{
					biKey = ifnull(bi.Box_No,0).toString();

					uwS = ifnull(bi.Unit_Weight_Kg,"0").toString().trim();
					if(uwS == "")
					{
						uwS = "0";
					}

					biQty = ifnull(bi.Quantity,0).toLong();

					biJson = ifnull(itemsByBox.get(biKey),"").toString();
					if(biJson != "")
					{
						biJson = biJson + ",";
					}

					biJson = biJson + "{\"lineNo\":" + ifnull(bi.Line_No,0) + ",\"sku\":\"" + ifnull(bi.SKU,"").toString().replaceAll("\"","'") + "\",\"itemName\":\"" + ifnull(bi.Item_Name,"").toString().replaceAll("\"","'") + "\",\"qty\":" + biQty + ",\"unitWeight\":" + uwS.toDecimal() + "}";

					itemsByBox.put(biKey,biJson);

					havePc = ifnull(piecesByBox.get(biKey),"0").toString().trim();
					if(havePc == "")
					{
						havePc = "0";
					}
					piecesByBox.put(biKey,(havePc.toLong() + biQty).toString());
				}

				//----------------------------------------------------------
				// ONE ROW PER PHYSICAL BOX, which is what Packed_Boxes holds and
				// what answers "what is in box 3" months later.
				//----------------------------------------------------------
				boxesJson = "";
				rowBoxes = 0;
				rowInnerBoxes = 0;
				rowPieces = 0;

				for each  bx in pk.Packed_Boxes
				{
					bxTypeKey = ifnull(bx.Box_Type,"").toString().trim();
					bxName = "";
					if(bxTypeKey != "")
					{
						bxName = ifnull(boxNameMap.get(bxTypeKey),"").toString();
					}
					// A carton later removed from Box_Master misses the map. The
					// box still shipped, so it is named by its number rather than
					// dropped or left blank.
					if(bxName == "")
					{
						bxName = "Carton not on file";
					}

					// Creator fields that were never written are EMPTY, not null,
					// and toDecimal() throws on empty.
					gwS = ifnull(bx.Gross_Weight_Kg,"0").toString().trim();
					if(gwS == "")
					{
						gwS = "0";
					}
					vwS = ifnull(bx.Volumetric_Weight_Kg,"0").toString().trim();
					if(vwS == "")
					{
						vwS = "0";
					}
					ewS = ifnull(bx.Estimated_Weight_Kg,"0").toString().trim();
					if(ewS == "")
					{
						ewS = "0";
					}

					olS = ifnull(bx.Outer_Length_Cm,"0").toString().trim();
					if(olS == "")
					{
						olS = "0";
					}
					owS = ifnull(bx.Outer_Width_Cm,"0").toString().trim();
					if(owS == "")
					{
						owS = "0";
					}
					ohS = ifnull(bx.Outer_Height_Cm,"0").toString().trim();
					if(ohS == "")
					{
						ohS = "0";
					}
					ilS = ifnull(bx.Inner_Length_Cm,"0").toString().trim();
					if(ilS == "")
					{
						ilS = "0";
					}
					iwS = ifnull(bx.Inner_Width_Cm,"0").toString().trim();
					if(iwS == "")
					{
						iwS = "0";
					}
					ihS = ifnull(bx.Inner_Height_Cm,"0").toString().trim();
					if(ihS == "")
					{
						ihS = "0";
					}

					bxOutL = olS.toDecimal();
					bxOutW = owS.toDecimal();
					bxOutH = ohS.toDecimal();
					bxInnL = ilS.toDecimal();
					bxInnW = iwS.toDecimal();
					bxInnH = ihS.toDecimal();

					bxUsesInner = "false";
					if(ifnull(bx.Uses_Inner,false) == true)
					{
						bxUsesInner = "true";
					}

					// LEGACY DIMENSIONS. A box packed before the fields existed
					// stored none of them, and the carton it named is where they
					// came from at the time.
					bxLegacyDims = "false";

					if(bxOutL <= 0 && bxOutW <= 0 && bxOutH <= 0 && bxTypeKey != "")
					{
						dimTxt = ifnull(boxDimMap.get(bxTypeKey),"").toString();

						if(dimTxt != "")
						{
							bxLegacyDims = "true";
							dimParts = dimTxt.toList("|");

							bxOutL = dimParts.get(0).toDecimal();
							bxOutW = dimParts.get(1).toDecimal();
							bxOutH = dimParts.get(2).toDecimal();
							bxUsesInner = dimParts.get(3);
							bxInnL = dimParts.get(4).toDecimal();
							bxInnW = dimParts.get(5).toDecimal();
							bxInnH = dimParts.get(6).toDecimal();
						}
					}

					bxKey = ifnull(bx.Box_No,0).toString();

					bxItemsJson = ifnull(itemsByBox.get(bxKey),"").toString();
					bxPieces = 0;

					if(bxItemsJson == "")
					{
						// LEGACY CONTENTS. One item, on the box row itself.
						legQty = ifnull(bx.Quantity,0).toLong();
						legName = ifnull(bx.Item_Name,"").toString().replaceAll("\"","'");

						if(legQty > 0 || legName != "")
						{
							bxItemsJson = "{\"lineNo\":" + ifnull(bx.Line_No,0) + ",\"sku\":\"" + ifnull(bx.SKU,"").toString().replaceAll("\"","'") + "\",\"itemName\":\"" + legName + "\",\"qty\":" + legQty + ",\"unitWeight\":0}";
							bxPieces = legQty;
						}
					}
					else
					{
						pcTxt = ifnull(piecesByBox.get(bxKey),"0").toString().trim();
						if(pcTxt == "")
						{
							pcTxt = "0";
						}
						bxPieces = pcTxt.toLong();
					}

					if(boxesJson != "")
					{
						boxesJson = boxesJson + ",";
					}

					boxesJson = boxesJson + "{\"boxNo\":" + ifnull(bx.Box_No,0) + ",\"id\":\"" + bx.ID + "\",\"carton\":\"" + bxName + "\","
						+ "\"usesInner\":" + bxUsesInner + ",\"legacyDims\":" + bxLegacyDims + ","
						+ "\"innerLength\":" + bxInnL + ",\"innerWidth\":" + bxInnW + ",\"innerHeight\":" + bxInnH + ","
						+ "\"outerLength\":" + bxOutL + ",\"outerWidth\":" + bxOutW + ",\"outerHeight\":" + bxOutH + ","
						+ "\"pieces\":" + bxPieces + ",\"estimatedWeight\":" + ewS.toDecimal() + ",\"grossWeight\":" + gwS.toDecimal() + ",\"volumetricWeight\":" + vwS.toDecimal() + ","
						+ "\"items\":[" + bxItemsJson + "]}";

					if(bxUsesInner == "true")
					{
						rowInnerBoxes = rowInnerBoxes + 1;
					}

					rowPieces = rowPieces + bxPieces;
					rowBoxes = rowBoxes + 1;
					boxTotal = boxTotal + 1;
				}

				tgS = ifnull(pk.Total_Gross_Weight_Kg,"0").toString().trim();
				if(tgS == "")
				{
					tgS = "0";
				}
				tvS = ifnull(pk.Total_Volumetric_Weight_Kg,"0").toString().trim();
				if(tvS == "")
				{
					tvS = "0";
				}
				teS = ifnull(pk.Total_Estimated_Weight_Kg,"0").toString().trim();
				if(teS == "")
				{
					teS = "0";
				}
				totGross = tgS.toDecimal();
				totVol = tvS.toDecimal();
				totEst = teS.toDecimal();

				// CHARGEABLE IS THE GREATER OF THE TWO - what the courier bills.
				// Computed here rather than stored, the same way savePackingRecord
				// computes it for the message it returns, so the history and the
				// save can never disagree about a figure neither of them keeps.
				chargeable = totGross;
				if(totVol > totGross)
				{
					chargeable = totVol;
				}

				// PHOTOS ARE ON THE PARENT (Packing.Box_Images), a multi-image
				// field, not on a box. Deluge cannot build a widget-renderable URL
				// for one reliably, so only the COUNT travels here; the widget
				// fetches the actual images with getRecords when a card is opened.
				// The stored value is a separator-joined list of file names -
				// newline in most cases, comma in some - so both are tried.
				imgCount = 0;
				imgRaw = ifnull(pk.Box_Images,"").toString().replaceAll("\r","").trim();
				if(imgRaw != "")
				{
					imgList = imgRaw.toList("\n");
					if(imgList.size() <= 1 && imgRaw.contains(","))
					{
						imgList = imgRaw.toList(",");
					}
					for each  ipRow in imgList
					{
						if(ipRow.trim() != "")
						{
							imgCount = imgCount + 1;
						}
					}
				}

				if(rowsJson != "")
				{
					rowsJson = rowsJson + ",";
				}
				// IDs forced to string - 18-digit ids break JSON.parse otherwise.
				rowsJson = rowsJson + "{\"id\":\"" + pk.ID + "\",\"salesOrder\":\"" + soNo + "\",\"source\":\"" + soSrc + "\",\"planNo\":\"" + planNo + "\",\"supervisorId\":\"" + rowSupKey + "\",\"supervisor\":\"" + rowSupName + "\",\"packedBy\":\"" + packedBy + "\",\"packedOn\":\"" + packedOn + "\",\"boxCount\":" + rowBoxes + ",\"innerBoxCount\":" + rowInnerBoxes + ",\"pieces\":" + rowPieces + ",\"estimatedWeight\":" + totEst + ",\"grossWeight\":" + totGross + ",\"volumetricWeight\":" + totVol + ",\"chargeableWeight\":" + chargeable + ",\"imageCount\":" + imgCount + ",\"boxes\":[" + boxesJson + "]}";

				shownCount = shownCount + 1;
			}
		}

		// Built by hand - Map.toString() does not emit valid JSON once the
		// structure nests, and List.toString() does not wrap in [].
		res = "{\"errors\":[],\"packings\":[" + rowsJson + "],\"count\":" + shownCount + ",\"boxCount\":" + boxTotal + "}";
	}
	catch (e)
	{
		// Creator reports every runtime failure to a widget as code 9430, so the
		// real message has to travel inside the payload.
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"packings\":[],\"count\":0,\"boxCount\":0}";
	}

	return res;
}
