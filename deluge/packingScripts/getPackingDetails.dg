string getPackingDetails(string payloadJson)
{
	// What the packer sees for one order: the original lines, how many pieces of
	// each actually cleared finishing, what one piece of each weighs, and the
	// carton catalogue his dimension fields are autofilled from.
	//
	// THE WALK IS DONE ONCE, NOT ONCE PER LINE. This used to re-run
	// Production_Planning -> Plan_Item -> Item_Check -> Finishing_Data inside the
	// loop over the order's item table, with the innermost query eight levels
	// deep. Every line rebuilt the same answer. Now the plan is walked once into
	// a per-root-line total and the line loop just reads it.
	//
	// THE TOTAL IS PER ORIGINAL LINE. A remake batch replaces pieces the customer
	// already bought, so its acceptances belong to the line it was raised
	// against, not to a line of its own. Remake_Of always points at the ROOT,
	// never at the previous batch, so this is one flat pass - Deluge has no
	// recursion. Same arithmetic recheckOrderComplete uses, deliberately: packing
	// must never disagree with the status that let it be packed.
	//
	// "FINISHED" IS Finishing_Status == "Done", not "a row exists".
	// startFinishingJob opens the row when work starts. Done means done; anything
	// else means the job is still open, so a row carrying neither value is left
	// out of the packed quantity rather than quietly counted into it.
	//
	// UNIT WEIGHT RIDES ALONG ON THE LINE. Item_Master.Weight is kilograms for one
	// saleable unit - a napkin set of six is one unit, counted the same way the
	// pieces on this screen are - so it multiplies straight against the quantity
	// in a box. It is sent so the screen can show a running estimate as he types;
	// savePackingRecord resolves it again from the master rather than trusting
	// what comes back, for the same reason it recomputes the quantities.
	//
	// THE CARTON OPTIONS COME FROM Box_Master, and they are AUTOFILL ONLY.
	// Every dimension on the packing screen is editable - the catalogue seeds the
	// six numbers and stops there - so no volumetric weight is computed here any
	// more. It would describe a carton the packer may have already re-measured.
	// The divisor now lives in the widget (live, as he types) and in
	// savePackingRecord (authoritative, from the dimensions actually stored).

	res = "{\"errors\":[\"Nothing ran\"]}";

	try
	{
		inp = payloadJson.toMap();
		salesIdStr = ifnull(inp.get("salesOrderId"),"").toString().trim();

		if(salesIdStr == "" || salesIdStr.isNumber() == false)
		{
			return "{\"errors\":[\"Missing or invalid salesOrderId\"]}";
		}

		salesId = salesIdStr.toLong();

		orderNo = "";
		orderSrc = "";

		for each  so in Sales_Order[ID == salesId]
		{
			orderNo = ifnull(so.Sales_Order,"").toString().replaceAll("\"","'");
			orderSrc = ifnull(so.Order_Source,"").toString().replaceAll("\"","'");
		}

		//------------------------------------------------------------------
		// ONE PASS: which batches are finished, which item each batch belongs
		// to, and which original line each item rolls up to.
		//------------------------------------------------------------------
		// ASKED PER CHECK, not by scanning the whole form.
		//
		// This used to read every Finishing_Data row ever written to build a
		// list of finished batches, on a screen about ONE order. The form grows
		// one row per inspected batch for ever, and the statement-execution
		// limit is NOT catchable - it kills the script and the widget gets a
		// bare HTTP 500 with no error card.
		//
		// Resolved lazily below instead, one indexed query per check on this
		// order, cached so a check consulted twice is read once. "1" means
		// finished, "0" means not; a key that is absent has not been asked yet.
		//
		// DONE MEANS DONE, and the query says so directly. A row carrying
		// neither Done nor In_Progress - hand-made, a mistyped dropdown, a
		// write that half landed - does not match, so the batch reads as
		// UNFINISHED and the order stops short of packing. That is the same
		// way round the old in-code test failed, and the safe direction.
		doneByCheck = Map();

		// Map values kept as STRINGS throughout - a Map holding a mix of Decimal
		// and String is one more chance at a mixed-type comparison further down.
		lineByItem = Map();
		finByLine = Map();

		for each  plan in Production_Planning[Sales_Order == salesId]
		{
			// Root lines first, so a remake read before its root still resolves.
			rootLineById = Map();

			for each  pi in Plan_Item[Plan == plan.ID]
			{
				if(ifnull(pi.Is_Remake,false) == false)
				{
					lnS = ifnull(pi.Line_No,"0").toString().trim();
					if(lnS == "")
					{
						lnS = "0";
					}

					rootLineById.put(pi.ID.toString(),lnS);
				}
			}

			for each  pi2 in Plan_Item[Plan == plan.ID]
			{
				itemKey = pi2.ID.toString();
				lineKey = "";

				if(ifnull(pi2.Is_Remake,false) == false)
				{
					lineKey = ifnull(rootLineById.get(itemKey),"").toString();
				}
				else if(pi2.Remake_Of != null)
				{
					lineKey = ifnull(rootLineById.get(pi2.Remake_Of.toString()),"").toString();
				}

				if(lineKey != "")
				{
					lineByItem.put(itemKey,lineKey);
				}
			}

			for each  chk in Item_Check[Plan == plan.ID && Qty_Approved > 0]
			{
				chkKeyD = chk.ID.toString();

				if(doneByCheck.get(chkKeyD) == null)
				{
					doneByCheck.put(chkKeyD,"0");

					for each  fd in Finishing_Data[Item_Check == chk.ID && Finishing_Status == "Done"]
					{
						doneByCheck.put(chkKeyD,"1");
					}
				}

				if(chk.Plan_Item != null && ifnull(doneByCheck.get(chkKeyD),"0").toString() == "1")
				{
					lineKeyTxt = ifnull(lineByItem.get(chk.Plan_Item.toString()),"").toString();

					if(lineKeyTxt != "")
					{
						haveQ = ifnull(finByLine.get(lineKeyTxt),"0").toString().trim();
						if(haveQ == "")
						{
							haveQ = "0";
						}

						finByLine.put(lineKeyTxt,(haveQ.toLong() + ifnull(chk.Qty_Approved,0).toLong()).toString());
					}
				}
			}
		}

		//------------------------------------------------------------------
		// THE LINES, read straight off the order.
		//------------------------------------------------------------------
		itemsJson = "";

		for each  so2 in Sales_Order[ID == salesId]
		{
			idx = 0;

			for each  soRow in so2.Item_Table
			{
				idx = idx + 1;

				// SKU is a LOOKUP holding a record id, so it has to be resolved
				// through the master or the packer is shown an 18-digit number.
				// The unit weight comes off the same record in the same hop.
				skuTxt = "";
				unitWtTxt = "0";

				for each  im in Item_Master[ID == soRow.SKU]
				{
					skuTxt = ifnull(im.SKU,"").toString().replaceAll("\"","'");

					// A field never written is EMPTY, not null, and toDecimal()
					// throws on empty. An item with no weight on file estimates
					// as zero, which the screen shows as a gap rather than
					// blocking a carton that is physically packed and weighed.
					unitWtTxt = ifnull(im.Weight,"0").toString().trim();
					if(unitWtTxt == "")
					{
						unitWtTxt = "0";
					}
				}

				finQtyTxt = ifnull(finByLine.get(idx.toString()),"0").toString().trim();
				if(finQtyTxt == "")
				{
					finQtyTxt = "0";
				}

				if(itemsJson != "")
				{
					itemsJson = itemsJson + ",";
				}

				itemsJson = itemsJson + "{\"lineNo\":" + idx + ",\"sku\":\"" + skuTxt + "\",\"itemName\":\"" + ifnull(soRow.Item_Name,"").toString().replaceAll("\"","'") + "\",\"qty\":" + finQtyTxt.toLong() + ",\"unitWeight\":" + unitWtTxt.toDecimal() + "}";
			}
		}

			//------------------------------------------------------------------
		// THE CARTON OPTIONS, from Box_Master.
		//
		// AUTOFILL, NOT A CONTRACT. Picking a carton seeds the six dimension
		// fields on the box; the packer can then correct any of them, and what he
		// leaves is what gets stored and what the volumetric weight is computed
		// from. Has_Inner_Carton only decides whether the three inner fields are
		// seeded - whether an inner carton is actually used is a per-box choice,
		// because a branded inner that has run out on the floor must not need a
		// change to master data before the box can ship.
		//
		// This list used to be hardcoded here AND again in the widget. Two
		// copies of the same master data in two languages, and they had already
		// drifted - the widget's box names never matched the ones sent from
		// here, which is why its capacity and points rules silently matched
		// nothing and collapsed to fixed constants.
		//
		// Inactive boxes are left out rather than flagged: a retired size is not
		// a choice, and the packer's dropdown is not the place to explain that.
		//------------------------------------------------------------------
		boxesJson = "";

		// sort by on its own assignment, never inline in a for each header.
		boxRecs = Box_Master[Active == true] sort by Display_Order;

		for each  bm in boxRecs
		{
			hasInnerTxt = "false";
			if(ifnull(bm.Has_Inner_Carton,false) == true)
			{
				hasInnerTxt = "true";
			}

			if(boxesJson != "")
			{
				boxesJson = boxesJson + ",";
			}

			boxesJson = boxesJson + "{\"id\":\"" + bm.ID + "\","
				+ "\"name\":\"" + ifnull(bm.Box_Name,"").toString().replaceAll("\"","'") + "\","
				+ "\"outerLength\":" + ifnull(bm.Outer_Length_Cm,0).toDecimal() + ",\"outerWidth\":" + ifnull(bm.Outer_Width_Cm,0).toDecimal() + ",\"outerHeight\":" + ifnull(bm.Outer_Height_Cm,0).toDecimal() + ","
				+ "\"hasInner\":" + hasInnerTxt + ","
				+ "\"innerLength\":" + ifnull(bm.Inner_Length_Cm,0).toDecimal() + ","
				+ "\"innerWidth\":" + ifnull(bm.Inner_Width_Cm,0).toDecimal() + ","
				+ "\"innerHeight\":" + ifnull(bm.Inner_Height_Cm,0).toDecimal() + "}";
		}

		res = "{\"errors\":[],\"salesOrderId\":\"" + salesIdStr + "\",\"orderNo\":\"" + orderNo + "\",\"source\":\"" + orderSrc + "\",\"items\":[" + itemsJson + "],\"boxes\":[" + boxesJson + "]}";
	}
	catch (e)
	{
		res = "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"]}";
	}

	return res;
}
