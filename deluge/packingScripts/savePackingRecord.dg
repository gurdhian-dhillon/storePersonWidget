string savePackingRecord(string payloadJson)
{
	res = "{\"success\":false,\"error\":\"Nothing was saved\"}";
	try
	{
		inp = payloadJson.toMap();
		salesIdStr = ifnull(inp.get("salesOrderId"), "").toString().trim();
		staffName = ifnull(inp.get("staffName"), "").toString().trim();
		
		if(salesIdStr == "" || salesIdStr.isNumber() == false)
		{
			return "{\"success\":false,\"error\":\"Missing or invalid salesOrderId\"}";
		}
		salesId = salesIdStr.toLong();
		
		// Find employee ID for packer
		empId = null;
		for each emp in Employee[Employee_Name == staffName]
		{
			empId = emp.ID;
		}
		
		// Setup subform collections
		itemsCollection = Collection();
		innerCollection = Collection();
		outerCollection = Collection();
		
		// 1. Map packed items
		itemsList = inp.get("items");
		if(itemsList != null)
		{
			for each itemVal in itemsList
			{
				itemMap = itemVal.toMap();
				skuVal = ifnull(itemMap.get("sku"), "").toString();
				itemNameVal = ifnull(itemMap.get("itemName"), "").toString();
				qtyToPackVal = ifnull(itemMap.get("qtyToPack"), "0").toString().toDecimal().toLong();
				qtyPackedVal = ifnull(itemMap.get("qtyPacked"), "0").toString().toDecimal().toLong();
				
				itemRow = Packing.Packing_Items();
				itemRow.SKU = skuVal;
				itemRow.Item_Name = itemNameVal;
				itemRow.Quantity_Packed = qtyPackedVal;
				itemsCollection.insert(itemRow);
			}
		}
		
		// 2. Map inner boxes
		innerList = inp.get("innerBoxes");
		totalInner = 0;
		if(innerList != null)
		{
			for each innerVal in innerList
			{
				innerMap = innerVal.toMap();
				boxNoVal = ifnull(innerMap.get("boxNo"), "").toString();
				boxSizeName = ifnull(innerMap.get("boxSize"), "").toString();
				skuVal = ifnull(innerMap.get("sku"), "").toString();
				qtyVal = ifnull(innerMap.get("qty"), "0").toString().toDecimal().toLong();
				outerBoxNoVal = ifnull(innerMap.get("outerBoxNo"), "").toString();
				
				// innerRow = Packing.Packed_Inner_Boxes();
				// innerRow.Box_No = boxNoVal;
				// innerRow.SKU = skuVal;
				// innerRow.Quantity_Packed = qtyVal;
				// innerRow.Outer_Box_No = outerBoxNoVal;
				
				// Lookup box size ID from name (commented out to prevent compilation errors if Box_Size_Master form is not in the app)
				// boxSizeId = null;
				// for each bSize in Box_Size_Master[Box_Size_Name == boxSizeName]
				// {
				// 	boxSizeId = bSize.ID;
				// }
				// if(boxSizeId != null)
				// {
				// 	innerRow.Box_Size = boxSizeId;
				// }
				
				// innerCollection.insert(innerRow);
				totalInner = totalInner + 1;
			}
		}
		
		// 3. Map outer boxes
		outerList = inp.get("outerBoxes");
		totalOuter = 0;
		outerLen = 0.0;
		outerWid = 0.0;
		outerHgt = 0.0;
		if(outerList != null)
		{
			for each outerVal in outerList
			{
				outerMap = outerVal.toMap();
				outerBoxNoVal = ifnull(outerMap.get("outerBoxNo"), "").toString();
				volUsedVal = ifnull(outerMap.get("volumeUsed"), "0").toString().toDecimal();
				weightVal = ifnull(outerMap.get("weight"), "0").toString().toDecimal();
				
				if(totalOuter == 0)
				{
					dimMap = outerMap.get("dimensions");
					if(dimMap != null)
					{
						dimMap = dimMap.toMap();
						outerLen = ifnull(dimMap.get("l"), "0").toString().toDecimal();
						outerWid = ifnull(dimMap.get("w"), "0").toString().toDecimal();
						outerHgt = ifnull(dimMap.get("h"), "0").toString().toDecimal();
					}
				}
				
				// outerRow = Packing.Packed_Outer_Boxes();
				// outerRow.Outer_Box_No = outerBoxNoVal;
				// outerRow.Total_Volume_Utilized = volUsedVal;
				// outerRow.Total_Weight = weightVal;
				
				// outerCollection.insert(outerRow);
				totalOuter = totalOuter + 1;
			}
		}
		
		// 4. Create Packing record
		newPack = insert into Packing
		[
			Sales_Order = salesId
			Total_Inner_Boxes = totalInner
			Total_Outer_Boxes = totalOuter
			Outer_Box_Length = outerLen
			Outer_Box_Width = outerWid
			Outer_Box_Height = outerHgt
		];
		
		packId = newPack.toLong();
		
		// Update details/subforms of the created Packing record
		for each packRec in Packing[ID == packId]
		{
			if(empId != null)
			{
				packRec.Employee = empId;
			}
			packRec.Packing_Items.insert(itemsCollection);
			// packRec.Packed_Inner_Boxes.insert(innerCollection);
			// packRec.Packed_Outer_Boxes.insert(outerCollection);
		}
		
		// 5. Update Sales Order status to "Packed"
		for each so in Sales_Order[ID == salesId]
		{
			so.Order_Status = "Packed";
		}
		
		res = "{\"success\":true,\"message\":\"Packing record saved successfully\",\"packingId\":\"" + packId + "\"}";
	}
	catch (e)
	{
		res = "{\"success\":false,\"error\":\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"}";
	}
	return res;
}
