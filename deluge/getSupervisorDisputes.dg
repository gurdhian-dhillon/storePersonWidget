string getSupervisorDisputes(string supervisorId)
{
	// Open stock disputes raised against ONE supervisor's receipts.
	// POST, one argument: supervisorId.
	//
	// Two kinds, and Direction says which. Outbound is raised by receiveMaterials
	// when he confirms less than was issued; his one useful answer there is "I
	// had it after all". Inbound is raised by receiveWastePieces when the store
	// finds fewer offcuts on the rack than he declared; his one useful answer
	// there is the opposite - "I declared more than I actually sent back". An
	// EMPTY Direction means Outbound, because every dispute raised before the
	// field existed was one.
	//
	// Either way he only ever answers for himself. The store's own correction and
	// Lost are claims about the store's shelf and are not his to make.
	//
	// The remaining amount is Disputed_Qty minus what the resolution lines
	// already account for. Disputed_Qty is never edited: it records the size of
	// the problem as raised.

	rowsJson = "";
	errJson = "";
	openCount = 0;

	// Same debug wrapper as the other functions - Creator collapses every
	// runtime failure into a generic "code 9430", so catch the real message.
	try
	{
	supTxt = ifnull(supervisorId,"").toString().trim();

	if(supTxt == "" || supTxt.isNumber() == false)
	{
		return "{\"errors\":[],\"disputes\":[],\"openCount\":0}";
	}

	supId = supTxt.toLong();

	// Oldest first - one nobody has touched for a week is the one worth chasing.
	open = Stock_Dispute[Supervisor == supId && Status == "Open"] sort by Added_Time;
	info "open disputes for " + supId + ": " + open.count();

	for each  d in open
	{
		// One dispute per try. Without this, a single unreadable record takes
		// the whole screen down with it and he sees "nothing in dispute" while
		// the tab badge says otherwise. A row that cannot be built is named and
		// skipped instead.
		try
		{
		// Creator fields that were never written are EMPTY, not null, and
		// toDecimal() throws on empty - normalise to string first.
		dStr = ifnull(d.Disputed_Qty,"0").toString().trim();
		if(dStr == "")
		{
			dStr = "0";
		}
		iStr = ifnull(d.Issued_Qty,"0").toString().trim();
		if(iStr == "")
		{
			iStr = "0";
		}
		rStr = ifnull(d.Received_Qty,"0").toString().trim();
		if(rStr == "")
		{
			rStr = "0";
		}

		// Who has already looked. The second denial writes the material off, so
		// the screen has to say which side is still to answer - and warn him
		// when his own answer is the one that closes it.
		resolvedSoFar = 0.0;
		supDenied = "false";
		storeDenied = "false";
		storeNote = "";

		for each  ln in d.Resolution_Lines
		{
			lqStr = ifnull(ln.Resolved_Qty,"0").toString().trim();
			if(lqStr == "")
			{
				lqStr = "0";
			}
			resolvedSoFar = resolvedSoFar + lqStr.toDecimal();

			lnRes = ifnull(ln.Resolution,"").toString();
			if(lnRes == "Supervisor_Denied")
			{
				supDenied = "true";
			}
			if(lnRes == "Store_Denied")
			{
				storeDenied = "true";
				storeNote = ifnull(ln.Note,"").toString().replaceAll("\"","'");
			}
		}

		remaining = dStr.toDecimal() - resolvedSoFar;
		if(remaining < 0)
		{
			remaining = 0;
		}

		// ID == <empty lookup> is not an empty result, it is an invalid criteria -
		// Deluge answers "UnPredictable exception, Invalid statement found" and
		// kills the whole list. Never guarded because an outbound dispute always
		// carries a plan; an inbound one is built from a Declared movement, and
		// any of those links can be missing.
		soNo = "";
		planNo = "";
		if(d.Plan != null)
		{
			for each  pl in Production_Planning[ID == d.Plan]
			{
				planNo = ifnull(pl.Plan_No,"").toString();
				if(pl.Sales_Order != null)
				{
					for each  so in Sales_Order[ID == pl.Sales_Order]
					{
						soNo = ifnull(so.Sales_Order,"").toString();
					}
				}
			}
		}

		raisedOn = "";
		if(d.Raised_On != null)
		{
			raisedOn = d.Raised_On.toString("dd-MMM-yyyy");
		}

		isW = ifnull(d.Is_Waste,false);
		wasteTxt = "false";
		if(isW == true)
		{
			wasteTxt = "true";
		}

		// Direction and Raised_Note were added with the inbound waste disputes.
		// Reading a field that does not exist THROWS, and the outer catch would
		// then return an empty list for every dispute against him - his screen
		// says nothing is in dispute while the tab badge says otherwise, which is
		// the worst possible way to find out a field is missing.
		//
		// So they get their own catch. A dispute he cannot see is a real
		// problem; a dispute missing its direction badge is a cosmetic one.
		dirTxt = "Outbound";
		raisedNote = "";

		try
		{
			dirTxt = ifnull(d.Direction,"").toString().trim();
			if(dirTxt == "")
			{
				dirTxt = "Outbound";
			}
		}
		catch (eDir)
		{
			dirTxt = "Outbound";
			info "Stock_Dispute.Direction not readable - create the field: " + eDir.toString();
		}

		try
		{
			// Why the store says it is short. Newlines are stripped as well as
			// quotes - a bare newline inside a hand-built JSON string is just as
			// fatal as a bare quote, and this one is free text from a phone.
			raisedNote = ifnull(d.Raised_Note,"").toString().replaceAll("\"","'");
			raisedNote = raisedNote.replaceAll("\n"," ").replaceAll("\r"," ");
		}
		catch (eNote)
		{
			raisedNote = "";
			info "Stock_Dispute.Raised_Note not readable - create the field: " + eNote.toString();
		}

		// A waste dispute is about one specific remnant, and its size is how he
		// remembers which one. "Linen / Olive" alone matches a dozen rows.
		//
		// NOT named pw/pl. "pl" is already the Production_Planning loop record
		// above, and reusing it as a decimal in the same function scope makes
		// Deluge reject the QUERY - "UnPredictable exception, Invalid statement
		// found", reported against the for-each line, not against the assignment
		// that caused it. Loop variables and locals share one namespace here.
		pcW = 0;
		pcL = 0;
		try
		{
			if(isW == true && d.Waste_Piece != null)
			{
				for each  wmS in Waste_Master[ID == d.Waste_Piece]
				{
					pcWs = ifnull(wmS.Piece_Width,"0").toString().trim();
					if(pcWs == "")
					{
						pcWs = "0";
					}
					pcLs = ifnull(wmS.Piece_Length,"0").toString().trim();
					if(pcLs == "")
					{
						pcLs = "0";
					}
					pcW = pcWs.toDecimal();
					pcL = pcLs.toDecimal();
				}
			}
		}
		catch (eSize)
		{
			pcW = 0;
			pcL = 0;
			info "Waste piece size not readable for dispute " + d.ID + ": " + eSize.toString();
		}

		openCount = openCount + 1;

		if(rowsJson != "")
		{
			rowsJson = rowsJson + ",";
		}
		// IDs forced to string - 18-digit ids break JSON.parse otherwise.
		rowsJson = rowsJson + "{\"id\":\"" + d.ID + "\",\"material\":\"" + ifnull(d.Material_Name,"").toString().replaceAll("\"","'") + "\",\"unit\":\"" + ifnull(d.Unit,"").toString() + "\",\"isWaste\":" + wasteTxt + ",\"direction\":\"" + dirTxt + "\",\"width\":" + pcW + ",\"length\":" + pcL + ",\"salesOrder\":\"" + soNo + "\",\"planNo\":\"" + planNo + "\",\"issued\":" + iStr.toDecimal() + ",\"received\":" + rStr.toDecimal() + ",\"remaining\":" + remaining + ",\"raisedOn\":\"" + raisedOn + "\",\"raisedNote\":\"" + raisedNote + "\",\"supervisorDenied\":" + supDenied + ",\"storeDenied\":" + storeDenied + ",\"storeNote\":\"" + storeNote + "\"}";
		}
		catch (eRow)
		{
			if(errJson != "")
			{
				errJson = errJson + ",";
			}
			errJson = errJson + "\"Dispute " + d.ID + " could not be read: " + eRow.toString().replaceAll("\"","'") + "\"";
			info "dispute row skipped: " + d.ID + " - " + eRow.toString();
		}
	}
	}
	catch (e)
	{
		return "{\"errors\":[\"DELUGE: " + e.toString().replaceAll("\"","'") + "\"],\"disputes\":[],\"openCount\":0}";
	}

	// Built by hand - List.toString() does not reliably wrap in [].
	//
	// Errors and rows travel together: a run that could read four disputes out of
	// five has to hand over the four AND say what happened to the fifth.
	return "{\"errors\":[" + errJson + "],\"disputes\":[" + rowsJson + "],\"openCount\":" + openCount + "}";
}
