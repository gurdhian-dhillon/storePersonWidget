string getStoreLots()
{
	// Feeds the store's Stock In tab: every fabric material with the lots
	// currently under it.
	//
	// FABRIC ONLY. Accessories have no lots - their Quantity is their stock
	// exactly as it always was, and none of the lot code runs on them.
	//
	// TWO QUERIES TOTAL, both grouped before use. The obvious shape - loop the
	// materials and query that material's lots inside the loop - is one query per
	// SKU, which is precisely what blew the statement-execution limit in
	// getStoreMaterialRequirements. That limit is NOT catchable: it kills the
	// script, so the try/catch below never runs and the widget gets a bare 500
	// with no error card.

	matsJson = "";

	try
	{
		// Lots first, grouped by material as JSON fragments. Oldest first, which
		// is the order the store person sees them in - and sort by has to be its
		// own assignment, never inline in a for each header.
		//------------------------------------------------------------------
		// LOTS THAT STILL HOLD SOMETHING, not every lot ever created.
		//
		// THIS IS THE ONE FIX ON THIS SCREEN THAT CHANGES WHAT IS DISPLAYED,
		// so it is worth being clear about. A fully emptied lot - all five
		// figures zero - no longer appears under its material, and the lot
		// count beside the material drops accordingly.
		//
		// Why it cannot be fixed the way the other screens were: the header
		// above is right that looping materials and querying each one's lots
		// is wrong HERE. That shape is only safe when the material list is
		// bounded by open work, which is what neededMats is in
		// getStoreMaterialRequirements - a few dozen. This screen lists EVERY
		// fabric material, so per-material querying would be hundreds of
		// queries. Filtering the rows themselves is the only bound available.
		//
		// Why it is the right filter anyway: an emptied lot is kept as a zero
		// row so history still resolves elsewhere - that is about other
		// functions resolving a lot NUMBER, not about this tab drawing a lot
		// with nothing on it. getStoreMaterialRequirements already applies
		// exactly this rule to the issue picker ("An empty lot is not a
		// choice"), so the two store screens now agree rather than disagree.
		//
		// In_Wash_Qty is in the OR deliberately: cloth at the wash house is
		// off the rack but still ours, and a lot that looks empty because its
		// greige is out being washed is precisely what the store person needs
		// told. Disputed and In_Transit likewise - still ours, still shown.
		//
		// An EMPTY field is not matched by any Creator criteria, in either
		// direction - but a lot whose every quantity is empty holds nothing,
		// so excluding it is the intended answer rather than an accident. A
		// lot with one figure written and the rest empty still matches on the
		// figure that was written.
		//
		// TO REVERT: put back Raw_Material_Lot[ID != 0] sort by Added_Time.
		//------------------------------------------------------------------
		allLots = Raw_Material_Lot[Unwash_Quantity > 0 || Wash_Quantity > 0 || In_Transit_Qty > 0 || Disputed_Qty > 0 || In_Wash_Qty > 0] sort by Added_Time;

		lotJsonByMat = Map();
		lotCountByMat = Map();

		for each  lt in allLots
		{
			// A lookup holds a record id, so this is the Raw_Material id as text.
			ltMat = ifnull(lt.Material,"").toString().trim();

			if(ltMat != "")
			{
				// A Creator numeric that was never written is EMPTY, not null.
				// ifnull() does not catch empty and toDecimal() throws on it, so
				// normalise to string, test, then convert - four times, because
				// Deluge has no local functions to put this behind.
				luS = ifnull(lt.Unwash_Quantity,"0").toString().trim();
				if(luS == "")
				{
					luS = "0";
				}
				lwS = ifnull(lt.Wash_Quantity,"0").toString().trim();
				if(lwS == "")
				{
					lwS = "0";
				}
				liS = ifnull(lt.In_Transit_Qty,"0").toString().trim();
				if(liS == "")
				{
					liS = "0";
				}
				ldS = ifnull(lt.Disputed_Qty,"0").toString().trim();
				if(ldS == "")
				{
					ldS = "0";
				}
				// Cloth at the wash house. Off the rack but still ours, so it
				// belongs on this screen - a lot that looks empty because its
				// greige is out being washed needs to say so.
				lhS = ifnull(lt.In_Wash_Qty,"0").toString().trim();
				if(lhS == "")
				{
					lhS = "0";
				}

				ltNum = ifnull(lt.Lot_Number,"").toString().replaceAll("\"","'");
				ltLab = ifnull(lt.Lot_Label,"").toString().replaceAll("\"","'");
				ltSt = ifnull(lt.Status,"").toString().trim();
				if(ltSt == "")
				{
					ltSt = "Active";
				}

				// Ids forced to string - an 18-digit id breaks JSON.parse on the
				// widget side.
				oneLot = "{\"lotId\":\"" + lt.ID + "\",\"lotNumber\":\"" + ltNum + "\",\"label\":\"" + ltLab + "\",\"status\":\"" + ltSt + "\",\"unwash\":" + luS.toDecimal() + ",\"wash\":" + lwS.toDecimal() + ",\"inTransit\":" + liS.toDecimal() + ",\"disputed\":" + ldS.toDecimal() + ",\"inWash\":" + lhS.toDecimal() + "}";

				prevJson = ifnull(lotJsonByMat.get(ltMat),"").toString();
				if(prevJson != "")
				{
					prevJson = prevJson + ",";
				}
				lotJsonByMat.put(ltMat,prevJson + oneLot);

				prevCnt = ifnull(lotCountByMat.get(ltMat),"0").toString().trim();
				if(prevCnt == "")
				{
					prevCnt = "0";
				}
				lotCountByMat.put(ltMat,prevCnt.toLong() + 1);
			}
		}

		// Is_Fabric is tested in code, not filtered in the query - a checkbox that
		// was never ticked is EMPTY, not false, and a query filtering on == true
		// drops those rows silently with no way to notice.
		//
		// AND AS TEXT, not against the boolean true. What a Creator field hands
		// back depends on how it was built: a Decision box gives a boolean, a
		// yes/no dropdown gives the STRING "Yes", an untouched field gives EMPTY.
		// `ifnull(x,false) == true` only matches the first, and silently drops
		// real fabric otherwise - which is how a whole SKU range went missing
		// from this screen while the issue screen still listed it under FABRIC.
		for each  rm in Raw_Material[ID != 0]
		{
			fabTxt = ifnull(rm.Is_Fabric,"").toString().trim().toLowerCase();
			if(fabTxt == "true" || fabTxt == "yes" || fabTxt == "1" || fabTxt == "y")
			{
				rmKey = rm.ID + "";

				muS = ifnull(rm.Unwash_Quantity,"0").toString().trim();
				if(muS == "")
				{
					muS = "0";
				}
				mwS = ifnull(rm.Wash_Quantity,"0").toString().trim();
				if(mwS == "")
				{
					mwS = "0";
				}
				maS = ifnull(rm.Unallocated_Qty,"0").toString().trim();
				if(maS == "")
				{
					maS = "0";
				}
				miwS = ifnull(rm.In_Wash_Qty,"0").toString().trim();
				if(miwS == "")
				{
					miwS = "0";
				}

				// Display name where one is set, else the plain name, else the SKU.
				// Same fallback chain issueMaterials uses when it stamps a handover.
				mDisp = ifnull(rm.Material_Display_Name,"").toString().trim();
				if(mDisp == "")
				{
					mDisp = ifnull(rm.Name,"").toString().trim();
				}
				if(mDisp == "")
				{
					mDisp = ifnull(rm.SKU,"").toString().trim();
				}

				mSku = ifnull(rm.SKU,"").toString().replaceAll("\"","'");
				mUnit = ifnull(rm.Unit,"").toString().replaceAll("\"","'");

				myLots = ifnull(lotJsonByMat.get(rmKey),"").toString();
				myCount = ifnull(lotCountByMat.get(rmKey),"0").toString().trim();
				if(myCount == "")
				{
					myCount = "0";
				}

				if(matsJson != "")
				{
					matsJson = matsJson + ",";
				}
				matsJson = matsJson + "{\"materialId\":\"" + rmKey + "\",\"sku\":\"" + mSku + "\",\"material\":\"" + mDisp.replaceAll("\"","'") + "\",\"unit\":\"" + mUnit + "\",\"unwash\":" + muS.toDecimal() + ",\"wash\":" + mwS.toDecimal() + ",\"unallocated\":" + maS.toDecimal() + ",\"inWash\":" + miwS.toDecimal() + ",\"lotCount\":" + myCount.toLong() + ",\"lots\":[" + myLots + "]}";
			}
		}
	}
	catch (e)
	{
		// Creator reports every runtime failure to a widget as a generic code 9430.
		// Returning the real message is the only way to debug this from the widget.
		return "{\"error\":\"DELUGE: " + e.toString().replaceAll("\"","'") + "\",\"materials\":[]}";
	}

	// Built by hand - Map.toString() does not emit valid JSON once the structure
	// nests, and List.toString() does not wrap in [].
	return "{\"materials\":[" + matsJson + "]}";
}
