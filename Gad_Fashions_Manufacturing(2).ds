				displayname = "Plan Item"
				values  = Plan_Item.ID
    			displayformat = [Item_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Piece_Width
			(
				type = decimal
				displayname = "Piece Width"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Piece_Count
			(
				type = number
				displayname = "Piece Count"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Moved_On
			(
    			type = date
				displayname = "Moved On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cut_Size_Length
			(
				type = decimal
				displayname = "Cut Size Length"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Carton_Number
			(
    			type = text
				displayname = "Carton Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Movement_Type
			(
				type = picklist
				displayname = "Movement Type"
				maxchar = 100
				values = {"Declared","Received","Issued","Consumed","Scrapped"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Plan
			(
				type = picklist	
				values  = Production_Planning.ID
    			displayformat = [Plan_No]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Stage_Log
			(
				type = picklist	
				displayname = "Stage Log"
				values  = Stage_Log.ID
    			displayformat = [Phase_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Piece_Length
			(
				type = decimal
				displayname = "Piece Length"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Moved_By
			(
				type = picklist	
				displayname = "Moved By"
				values  = Employee.ID
    			displayformat = [Employee_Name]
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Cut_Size_Width
			(
				type = decimal
				displayname = "Cut Size Width"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Pieces_Yielded
			(
				type = number
				displayname = "Pieces Yielded"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Voucher
			(
    			type = text
				displayname = "Voucher "
	 			row = 1
	 			column = 2   
				width = medium
			)
			Apply_Key
			(
    			type = text
				displayname = "Apply Key"
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
