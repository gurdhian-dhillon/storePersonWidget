			autoGenerateSequenceNumbe as "autoGenerateSequenceNumber"
			{
				type =  form
				form = BOM

				record event = on add or edit

				on add row of Production_Stages
				{
					actions 
					{
						custom deluge script
						(
											seq = 1;
										newRows = List();
										for each  stage in input.Production_Stages
										{
											if(stage.Sequence_No == null || stage.Sequence_No == 0)
											{
												stage.Sequence_No=seq;
											}
											newRows.add(stage);
											seq = stage.Sequence_No + 1;
										}
						)
					}
				}

			}
			BomAutoCalculateMachineCo as "BomAutoCalculateMachineCost"
			{
				type =  form
				form = BOM

				record event = on add or edit

				on user input of Machine_Cost
				{
					actions 
					{
						custom deluge script
						(
											material = 0.0;
										for each  r in input.Material_Required
										{
											material = material + ifnull(r.Rate,0);
										}
										machine = ifnull(input.Machine_Cost,0);
										labour = ifnull(input.Labour_Cost,0);
										overhead = ifnull(input.Overhead_Cost,0);
										input.Total_Cost = material + machine + labour + overhead;
						)
					}
				}

			}
