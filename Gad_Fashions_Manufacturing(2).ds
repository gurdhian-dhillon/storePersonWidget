			autpPopulateDesignationDr as "autpPopulateDesignationDropdown"
			{
				type =  form
				form = Employee

				record event = on add or edit
					status = inactive

				on user input of Department
				{
					actions 
					{
						custom deluge script
						(
											// Employee form workflow. Builds the Designation dropdown from the list held on
										// the chosen Department, so Production offers Supervisor / Operator / Quality
										// Inspector and Store offers Store Person / Packaging Person / Dispatcher.
										//
										// PASTED TWICE, into two different workflow slots - see the two blocks below.
										// On User Input of Department alone is not enough: opening an existing employee
										// to edit fires On Load only, so the dropdown would come up with no choices at
										// all and saving would blank the designation.
										//
										// Designation is a plain DROPDOWN with no options configured in the form
										// builder. That is correct - every choice it ever shows is added here at
										// runtime. It stores plain TEXT, which is what keeps the picker queries in
										// getSupervisorMaterials and getProductionWidgetData one-liners with no lookup
										// id to resolve first:  Employee[Designation == "Supervisor" && Status == "Active"]
										//
										// THE API, which is not what it looks like. All three of these are wrong and the
										// editor only reports the first one, as "Function applied over invalid
										// expression" on line 1:
										//   input.Designation.clear()   -> clear is a STATEMENT:  clear Designation;
										//   input.Designation.add(nm)   -> a COLON task:          Designation:ui.add(...)
										//   ...add(nm) once per name    -> ui.add takes a LIST, and REPLACES the choices
										// The field is named bare in both - no "input." prefix - even though reading the
										// user's selection on the next line does use it. ui.add and clear are also only
										// available in On Load / On User Input / subform add-delete row; they do nothing
										// in On Validate, so none of this can be moved there later.
										//
										// Link names to check against the actual forms before pasting: the Department
										// subform is assumed to be `Designations`, its columns `Designation_Name` and
										// `Is_Default`.
										//---------------------------------------------------------------------------
										// 1. On User Input of Department
										//---------------------------------------------------------------------------
										clear Designation;
										namesList = List();
										defName = "";
										for each  dRec in Department[ID == input.Department]
										{
											for each  dgRow in dRec.Designations
											{
												// A subform text column that was never filled is EMPTY, not null.
												nm = ifnull(dgRow.Designation_Name,"").toString().trim();
												if(nm != "")
												{
													namesList.add(nm);
													if(ifnull(dgRow.Is_Default,false) == true)
													{
														defName = nm;
													}
												}
											}
										}
										// Guarded - a department with no designations yet must not hand ui.add an
										// empty list.
										if(namesList.size() > 0)
										{
											input.Designation:ui.add(namesList);
										}
										// AFTER ui.add, never before: the value has to be one of the choices that now
										// exist. Assigning the value does use the input. prefix - only clear and
										// ui.add name the field bare.
										//
										// Unconditional here. Switching department must DROP whatever was selected for
										// the old one, or someone moved from Production to Store keeps "Supervisor" and
										// stays in the supervisor picker while sitting in a department that has none.
										input.Designation = defName;
										//---------------------------------------------------------------------------
										// 2. On Load - identical except for the last statement
										//---------------------------------------------------------------------------
										//
										// On a NEW record input.Designation is empty and the department default fills
										// it, exactly as above. On an EXISTING one it already holds what was saved, and
										// that must win - defaulting here would silently rewrite a Quality Inspector to
										// Operator every time someone opened the record to correct a phone number.
										//
										// clear only hides the choices, it does not touch the stored value, so the
										// saved designation survives the rebuild above and is still selected once its
										// name is added back.
										//
										//	if(input.Designation == "")
										//	{
										//		input.Designation = defName;
										//	}
						)
					}
				}

			}
			loadOperators as "loadOperators"
			{
				type =  form
				form = Operator_Assignment

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Operator_Assignment form workflow: On Load ("loadOperators").
										// Narrows the Operators multi-lookup to active operators.
										//
										// WHY THIS EXISTS INSTEAD OF A FILTER CRITERION ON THE FIELD.
										// The form builder cannot filter on Designation. Designation is a dropdown with
										// NO options configured - every choice it shows is added at runtime by
										// autoPopulateDesignation, from the list on the chosen Department - so the
										// filter builder has nothing to offer and no criterion can be saved against it.
										//
										// The lookup is narrowed here instead, with the SAME client task the dropdown
										// uses. ui.add takes record IDs when the target is a lookup, which is the
										// documented dependent-picker shape:  States:ui.add(statelist.ID.getall());
										//
										//---------------------------------------------------------------------------
										// TWO THINGS THIS FILE GOT WRONG, both fixed here. Keep them fixed.
										//---------------------------------------------------------------------------
										//
										// 1. IT WOULD NOT SAVE - "Error at line number: 0, a technical error occurred
										//    while saving the script", naming no statement because Creator failed to
										//    compile the whole thing. Two causes: `sort by` INLINE in a for-each header
										//    (against the rule in CLAUDE.md, and the Zoho example uses a separate
										//    assignment too), and `input.Operators.getAll()`. Both gone.
										//
										// 2. IT BLANKED THE OPERATORS ALREADY ON THE RECORD. Open a saved assignment to
										//    edit and the field came up "-Select-" while the detail view still showed
										//    Aman and Arjun. `clear` is documented as removing the CHOICES, but on a
										//    multi-select lookup it takes the SELECTION with it - and re-adding the
										//    choices afterwards does not bring the selection back. First person to open
										//    that record and press Update would have saved an empty operator list.
										//
										//    Two changes guard it:
										//      - no `clear`. ui.add already "replaces all the existing choices", so the
										//        clear was redundant as well as destructive. (ui.APPEND is the one that
										//        needs an explicit clear first - that is what the docs are warning about,
										//        and it does not apply here.)
										//      - the saved value is captured BEFORE the field is touched and put back
										//        afterwards, so it survives whatever ui.add does to the field.
										//
										// Bare field name and a colon for the client task - `input.` only when reading
										// or writing a value. On Load / On User Input / subform add-delete row only;
										// this cannot move to On Validate.
										//
										// The same shape will narrow Order_Assignment.Employee to supervisors when that
										// is wired - copy this file and change the designation string.
										// BEFORE anything touches the field. On a new record this is simply empty.
										savedOps = input.Operators;
										// Queried on the STORED value, not on the field's configured choices - there are
										// none, and there do not need to be. The text in the record is what the picker
										// in getProductionWidgetData matches on too.
										//
										// sort by on its own assignment, never in a for-each header.
										opList = Employee[Designation == "Operator" && Status == "Active"] sort by Employee_Name;
										input.Operators:ui.add(opList.ID.getall());
										// Put the selection back. Assigning a value uses input., unlike the client task
										// above which names the field bare.
										input.Operators = savedOps;
										// STILL A GAP, and it is the one worth knowing: an operator saved on this record
										// who has since changed designation or gone Inactive is not in opList, so he is
										// not among the choices, and the line above cannot select someone who is not
										// there. He stays in the stored data - reports and getProductionWidgetData still
										// see him - but the field cannot show him, and saving the record drops him.
										//
										// If that bites, widen the query rather than reach for the field: drop
										// `Status == "Active"` so only a designation change can make someone vanish.
						)
					}
				}

			}
			filterSupervisors as "filterSupervisors"
			{
				type =  form
				form = Order_Assignment

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Order_Assignment form workflow: On Load.
										// Narrows the Employee lookup to active supervisors.
										//
										// Copy of filterOperatorLookup with the designation string changed - read that
										// file's header for why this is done in Deluge rather than as a filter
										// criterion on the field. Short version: Designation is a dropdown with no
										// configured options, so the form builder has nothing to build a criterion from.
										//
										// WHY THIS FORM MATTERS MORE THAN IT LOOKS. Order_Assignment is where a plan
										// gets its supervisor - createProductionPlans reads it per Order_Source and
										// stamps the result on Production_Planning.Assigned_To. Every downstream screen
										// filters on that. So a store person picked here does not just look wrong on
										// this form; he ends up owning a production plan, appearing in the production
										// tab's supervisor filter, and being mailed about material he cannot act on.
										// This is the cheapest place to stop that.
										//
										// Not guarded with a fallback, unlike the picker in getSupervisorMaterials. That
										// one is the login stand-in and an empty list there is a dead screen; this is an
										// admin form used occasionally, and an empty picker is a visible prompt to go
										// and set the designations rather than something that blocks the floor.
										// BEFORE anything touches the field - `clear` and ui.add both take the
										// selection with them on a lookup, and re-adding the choices does not bring it
										// back. On a new record this is simply empty.
										savedEmp = input.Employee;
										// sort by on its own assignment, never in a for-each header - inline is what
										// made the first version of the operator file refuse to save at all.
										supList = Employee[Designation == "Supervisor" && Status == "Active"] sort by Employee_Name;
										input.Employee:ui.add(supList.ID.getall());
										// Put the selection back. Assigning a value uses input., unlike the client task
										// above which names the field bare.
										input.Employee = savedEmp;
						)
					}
				}

			}
			RateNoFabricAutoUpdate as "RateNoFabricAutoUpdate"
			{
				type =  form
				form = BOM

				record event = on add or edit

				on user input of Material_Required.Required_Quantity
				{
					actions 
					{
						custom deluge script
						(
											// if(row.Required_Quantity != null && row.SKU != null)
										// {
										// 	rawMat = Raw_Material[ID == row.SKU];
										// 	if(rawMat != null && rawMat.Item_Price != null)
										// 	{
										// 		row.Rate=row.Required_Quantity * rawMat.Item_Price;
										// 	}
										// }
										if(row.Required_Quantity != null && row.SKU != null)
										{
											rawMat = Raw_Material[ID == row.SKU];
											if(rawMat != null && rawMat.Item_Price != null)
											{
												row.Rate=row.Required_Quantity * rawMat.Item_Price;
											}
										}
										// Recalculate Total Cost
										total = 0.0;
										for each  r in input.Material_Required
										{
											if(r.Rate != null)
											{
												total = total + r.Rate;
											}
										}
										input.Total_Cost = total;
						)
					}
				}

			}
			AutoDeleteTheTotalCost as "AutoDeleteTheTotalCost"
			{
				type =  form
				form = BOM

				record event = on add or edit

				on delete row of Material_Required
				{
					actions 
					{
						custom deluge script
						(
											// Get the rate of the row being deleted
										deletedRate = 0.0;
										if(row.Rate != null)
										{
											deletedRate = row.Rate;
										}
										// Start from the current Total Cost
										currentTotal = 0.0;
										if(input.Total_Cost != null)
										{
											currentTotal = input.Total_Cost;
										}
										// Remove the deleted material row's cost
										currentTotal = currentTotal - deletedRate;
										// Update Total Cost
										input.Total_Cost = currentTotal;
						)
					}
				}

			}
			populateProductSpecificat1 as "populateProductSpecificationOnSku"
