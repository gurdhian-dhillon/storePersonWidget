			validateProductionStage as "validateProductionStage"
			{
				type =  form
				form = Production_Stage

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Production_Stage form workflow.
										// Record Event: Created or Edited -> Form Event: On form submission ->
										// Validations on form submission.
										//
										// THREE RULES, each because production matches stages BY NAME:
										//
										// 1. The name is trimmed. "Cutting " is not "Cutting" to an == match, and the
										//    supervisor screen only offers the waste prompt on exactly "Cutting".
										//
										// 2. No second stage with the same name in a DIFFERENT CASE. The field's own
										//    "No duplicate values" property is exact-match only, so "cutting" would get
										//    past it and become a stage that silently never gets the waste prompt.
										//
										// 3. A SAVED NAME CANNOT BE CHANGED. Stage_Log.Phase_Name stores the name the
										//    stage had on the day, and the supervisor screen finds a stage's log by
										//    comparing that text with the BOM's. Rename "Stitching" while an item is
										//    mid-production and its finished Stitching log stops matching - the screen
										//    shows the stage as not started and lets it be started twice. To rename:
										//    set the old stage Inactive, create the new one, change the BOMs.
										//    A typo on a stage nothing uses yet: delete it and create it again
										//    (preventProductionStageDelete allows that while nothing points at it).
										//    lockProductionStageName also greys the field on edit; this is the guard
										//    that holds when the record is changed some other way.
										//
										// Ids forced to string before comparing - mixed-type comparison throws.
										newName = ifnull(input.Stage_Name,"").toString().trim();
										input.Stage_Name = newName;
										if(newName == "")
										{
											alert "Enter the stage name.";
											cancel submit;
										}
										thisId = ifnull(input.ID,"").toString().trim();
										oldName = "";
										if(thisId != "")
										{
											for each  psOld in Production_Stage[ID == thisId.toLong()]
											{
												oldName = ifnull(psOld.Stage_Name,"").toString().trim();
											}
										}
										if(oldName != "" && oldName != newName)
										{
											alert "A stage's name cannot be changed once saved - production history is recorded under \"" + oldName + "\". Set this stage Inactive and create a new one instead.";
											cancel submit;
										}
										clashName = "";
										newLower = newName.toLowerCase();
										for each  psRec in Production_Stage[ID != 0]
										{
											if(psRec.ID.toString() != thisId)
											{
												if(ifnull(psRec.Stage_Name,"").toString().trim().toLowerCase() == newLower)
												{
													clashName = ifnull(psRec.Stage_Name,"").toString().trim();
												}
											}
										}
										if(clashName != "")
										{
											alert "There is already a stage called \"" + clashName + "\". Use that one - stage names are matched exactly, so two spellings would be two different stages.";
											cancel submit;
										}
						)
					}
				}

			}
			lockProductionStageName as "lockProductionStageName"
			{
				type =  form
				form = Production_Stage

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Production_Stage form workflow.
										// Record Event: Edited -> Form Event: Before form submission -> Load of the form.
										//
										// Greys the name out when an existing stage is opened, so nobody types a new
										// one and only finds out at Submit. validateProductionStage is the real guard -
										// it refuses the rename however the record is changed; this only saves the
										// round trip. Why a name is fixed once saved: see that file.
										//
										// Bare field name for a client task, no "input.".
										disable Stage_Name;
						)
					}
				}

			}
			preventProductionStageDel as "preventProductionStageDelete"
			{
				type =  form
				form = Production_Stage

				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Production_Stage form workflow.
										// Record Event: Deleted -> Form Event: Validations on record deletion.
										//
										// REMOVING A STAGE MEANS SETTING IT INACTIVE, NOT DELETING IT.
										// Deleting a record a lookup points at blanks that lookup - so deleting
										// "Stitching" would silently empty the Stitching row on every BOM that has it,
										// and every item of those products would lose the stage mid-production.
										// Is_Active = false takes it out of every picker and leaves the BOMs working.
										//
										// Delete is allowed only while NOTHING points at the stage - which is exactly
										// the "I made a typo a minute ago" case.
										//
										// Production history is not checked: Stage_Log / Stage_Assignment /
										// Alteration_Stage store the stage NAME as text, so deleting the master record
										// cannot change them.
										//
										// Walked rather than queried on the subform field - BOM, Third_Party and
										// Operator_Assignment are master data, a few hundred rows at most, and a loop
										// is certain where criteria on a subform field and on a multi-lookup are not.
										// No reliable break in Deluge, so the loops just count.
										delId = input.ID.toString();
										bomUses = 0;
										for each  bmRec in BOM[ID != 0]
										{
											for each  bsRow in bmRec.Production_Stages
											{
												if(ifnull(bsRow.Stage,"").toString().trim() == delId)
												{
													bomUses = bomUses + 1;
												}
											}
										}
										tpUses = 0;
										for each  tpRec in Third_Party[ID != 0]
										{
											tpLk = ifnull(tpRec.Stages,"");
											if(tpLk.toString().trim() != "")
											{
												for each  tlk in tpLk
												{
													if(tlk.toString() == delId)
													{
														tpUses = tpUses + 1;
													}
												}
											}
										}
										oaUses = 0;
										for each  oaRec in Operator_Assignment[ID != 0]
										{
											if(ifnull(oaRec.Assigned_Stage,"").toString().trim() == delId)
											{
												oaUses = oaUses + 1;
											}
										}
										if(bomUses + tpUses + oaUses > 0)
										{
											alert "\"" + ifnull(input.Stage_Name,"") + "\" is in use (" + bomUses + " BOM rows, " + tpUses + " third parties, " + oaUses + " operator assignments). Untick Active instead - that removes it from every picker without breaking the BOMs that have it.";
											cancel delete;
										}
						)
					}
				}

			}
			preventDuplicateStageAssi as "preventDuplicateStageAssignment"
			{
				type =  form
				form = Operator_Assignment

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Operator_Assignment form workflow: On Validate, on CREATE only.
										// One assignment record per stage.
										//
										// Creator does not offer a Unique constraint on a Drop Down field, so the
										// one-record-per-stage rule cannot be a field property and has to be a
										// validation. Same intent, different place.
										//
										// WHY IT MATTERS, given getProductionWidgetData unions duplicates rather than
										// picking a winner and so copes with two records anyway: the union is there to
										// stop bad data being DANGEROUS, this is here to stop it being CONFUSING. An
										// admin who wanted to change Cutting's operators and created a second record
										// instead ends up with two rows in the report, both looking authoritative,
										// neither one describing what the supervisor actually sees. Telling him at the
										// moment he does it is the only cheap place to fix that.
										//
										// Deliberately NOT latest-wins. That would leave the older record sitting in the
										// report doing nothing, with nothing on screen to say so.
										//
										// SCOPED TO CREATE, NOT "CREATE OR EDIT". On edit the record has to exclude
										// itself from the check, which needs input.ID, and that is not something to rely
										// on unverified after the trouble the client tasks gave. The hole this leaves is
										// small and the union closes it safely: editing an existing record's Stage to
										// one that is already taken makes a duplicate that merges rather than hides.
										// If it ever matters, the edit version is at the bottom.
										//
										// .count() not .size() - size() is a List method, a query result needs count().
										//
										// THE STAGE IS Assigned_Stage, a lookup to Production_Stage. A lookup holds an
										// id, so the message fetches the name to show. The field is mandatory on the
										// form; the empty guard is only there so an empty value never matches every
										// other empty one.
										newStg = ifnull(input.Assigned_Stage,"").toString().trim();
										if(newStg != "")
										{
											if(Operator_Assignment[Assigned_Stage == input.Assigned_Stage].count() > 0)
											{
												stgLabel = newStg;
												for each  psRec in Production_Stage[ID == input.Assigned_Stage]
												{
													stgLabel = ifnull(psRec.Stage_Name,"").toString();
												}
												alert "There is already an assignment for " + stgLabel + ". Open that record and change its operators instead of adding a second one.";
												cancel submit;
											}
										}
										// Create-or-edit version, IF the self-exclusion is ever needed. Ids forced to
										// string before comparing - mixed-type comparison throws, and this app has
										// shipped 18-digit id bugs twice.
										//
										//	thisId = ifnull(input.ID,"").toString();
										//	dupFound = false;
										//	for each  oaRec in Operator_Assignment[Assigned_Stage == input.Assigned_Stage]
										//	{
										//		if(oaRec.ID.toString() != thisId)
										//		{
										//			dupFound = true;
										//		}
										//	}
										//	if(dupFound == true)
										//	{
										//		alert "There is already an assignment for that stage.";
										//		cancel submit;
										//	}
						)
					}
				}

			}
		}

		schedule
		{
			salesorder as "salesorder"
			{
				type =  schedule
					status = inactive
				start = "2026-07-14 12:58:31"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
				}
			}
			Sync_Sale_Order_Data as "Sync Sale Order Data"
			{
				type =  schedule
				start = "2026-08-06 15:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						orgId = "60076905558";
										response = invokeurl
										[
											url :"https://www.zohoapis.in/inventory/v1/salesorders?organization_id=" + orgId
											type :GET
											connection:"inventory_connection"
										];
										salesOrders = response.get("salesorders");
										if(salesOrders == null)
										{
											salesOrders = List();
										}
										for each  row1 in salesOrders
										{
											salesOrderId = row1.get("salesorder_id");
											info salesOrderId;
											// Skip if this sales order has already been synced
											existing = Sales_Order[Inventory_sales_order_Id == salesOrderId];
											existingId = existing.get("ID");
											if(existingId != null)
											{
												info "Already synced, skipping: " + salesOrderId;
												continue;
											}
											detailResponse = invokeurl
											[
												url :"https://www.zohoapis.in/inventory/v1/salesorders/" + salesOrderId + "?organization_id=" + orgId
												type :GET
												connection:"inventory_connection"
											];
											salesorder = detailResponse.get("salesorder");
											customerLookupId = null;
											customerId = salesorder.get("customer_name");
											salesorderNumber = salesorder.get("salesorder_number");
											if(customerId != null)
											{
												customerRecord = Customer_Master[Display_Name == customerId];
												if(customerRecord != null)
												{
													customerLookupId = customerRecord.ID;
													info customerLookupId;
												}
											}
											lineItems = salesorder.get("line_items");
											if(lineItems == null)
											{
												lineItems = List();
											}
											rowCollection = Collection();
											//get the value of the line Items.
											for each  row2 in lineItems
											{
												row = Sales_Order.Item_Table();
												row.Item_Name=row2.get("name");
												row.Rate=row2.get("rate");
												row.Amount=row2.get("item_total");
												row.Quantity=row2.get("quantity");
												skuVal = row2.get("sku");
												info skuVal;
												if(skuVal != null && skuVal != "")
												{
													itemdata = Item_Master[SKU == skuVal];
													if(itemdata != null)
													{
														row.SKU=itemdata.ID;
													}
												}
												rowCollection.insert(row);
											}
											//get the value in the subform 
											insertResult = insert into Sales_Order
											[
												Sales_Order_Date=salesorder.get("date")
												Reference=salesorder.get("reference_number")
												Sub_Total1=salesorder.get("total")
												Inventory_sales_order_Id=salesOrderId
												Customer=customerLookupId
												Sales_Order=salesorderNumber
												Grand_Total=salesorder.get("total")
												Item_Table=rowCollection
												Added_User=zoho.loginuser
											];
											info insertResult;
										}
					)
					}
				}
			}
			postInventoryQueue_ as "postInventoryQueue "
			{
				type =  schedule
				start = "2026-08-18 00:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						res = thisapp.postInventoryQueue("false");
										info res;
					)
					}
				}
			}
		}



